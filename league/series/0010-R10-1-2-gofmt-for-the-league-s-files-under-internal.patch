+	var n uint64
+	count := 0
+	first := byte(0)
+	for {
+		if !p.available(1) {
+			return 0, false
+		}
+		ch := p.buf[p.pos]
+		if ch < '0' || ch > '9' {
+			break
+		}
+		if count == 0 {
+			first = ch
+		}
+		count++
