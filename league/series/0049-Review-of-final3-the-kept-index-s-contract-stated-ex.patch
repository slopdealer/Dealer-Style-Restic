 //     confirmation.
@@ -355,3 +355,16 @@ func (load *repositoryIndexLoad) discard() {
 	load.reports.Drop()
 	load.repo.DiscardIndex()
 }
+
+// The contract of the index kept from the lock wait, in full (this note
+// stands at the end of the file so that no line of code moves).
+//
+// The kept index is validated by a listing, name and size, taken where stock
+// lists. It is NOT validated by reading the files again. On a backend whose
+// listing can still show a file after it was deleted (the directory cache of
+// a network mount, an eventually consistent store), an index file that a
+// concurrent prune deleted is therefore not noticed when its content was
+// read during the wait: the index in memory is kept. Stock notices such a
+// file only when it has no copy of it in its local cache, where it fails
+// loudly on reading the file; with the file in its cache, which is the
+// default, stock uses the cached content and behaves as this build does.
diff --git a/internal/repository/repack_scope_test.go b/internal/repository/repack_scope_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a177719d7b49452103e565ef2f38121d0581a18f
--- /dev/null
+++ b/internal/repository/repack_scope_test.go
@@ -0,0 +1,43 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+// TestAsyncSaveResultSuppressionIsNarrow is the reviewer's witness for red
+// team fix 2 (TestWitnessFinal3Fix2SuppressionIsNarrow): what a save reports
+// to the uploader's group. An error is withheld only when the context of the
+// save is a repack's AND that context is cancelled; on every other context
+// (the archiver's, cancelled or not) and on a live repack context the error
+// is reported as before.
+func TestAsyncSaveResultSuppressionIsNarrow(t *testing.T) {
+	failure := errors.New("a real save error")
+	live := context.Background()
+	dead, cancel := context.WithCancel(context.Background())
+	cancel()
+	markedLive := withRepackSaves(context.Background())
+	markedDead, cancel2 := context.WithCancel(withRepackSaves(context.Background()))
+	cancel2()
+
+	for _, tc := range []struct {
+		name string
+		ctx  context.Context
+		err  error
+		want error
+	}{
+		{"archiver context, save failed", live, failure, failure},
+		{"archiver context, cancelled, save failed", dead, failure, failure},
+		{"archiver context, cancelled, save cancelled", dead, context.Canceled, context.Canceled},
+		{"repack context, alive, save failed", markedLive, failure, failure},
+		{"repack context, alive, no error", markedLive, nil, nil},
+		{"repack context, cancelled, save cancelled", markedDead, context.Canceled, nil},
+		{"repack context, cancelled, save failed for another reason", markedDead, failure, nil},
+		{"repack context, cancelled, no error", markedDead, nil, nil},
+	} {
+		if got := asyncSaveResult(tc.ctx, tc.err); got != tc.want {
+			t.Errorf("%s: the uploader's group gets %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
