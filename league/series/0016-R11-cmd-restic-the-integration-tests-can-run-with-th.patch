From 1fa02fe89ef25dca2c4a41d6e411d7fb589c7601 Mon Sep 17 00:00:00 2001
From: slopdealer <326519127+slopdealer@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:49:46 +0000
Subject: [PATCH 16/49] R11 (cmd/restic): the integration tests can run with
 the production lock wait

The stock integration tests set the lock's settle delay to zero. With a delay
of zero the lock code starts no wait work, so none of them covers what
overlaps the delay. Now:

  RESTIC_TEST_LOCK_WAIT=200ms go test ./cmd/restic

runs them the way the binary runs. Without the variable nothing changes.

- lock_wait_env_test.go (new): testLockWait reads the variable.
- cmd_init_integration_test.go: testRunInit sets that delay instead of 0.
- integration_test.go: listOnceBackend takes a mutex, because the wait work
  lists from another goroutine, and counts the listings made during the lock
  wait (between the save of the own lock file and the next lock listing) on
  their own: once per type, snapshots before index. From the confirmation scan
  on, the stock rule applies unchanged. This tree lists the snapshot and the
  index files once during the wait and once after confirmation, to compare.

The two edited files are stock test files; a judge that overlays stock's test
files gets stock's behaviour, and no other file depends on the edits.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 cmd/restic/cmd_init_integration_test.go |  3 +-
 cmd/restic/integration_test.go          | 56 ++++++++++++++++++++++---
 cmd/restic/lock_wait_env_test.go        | 30 +++++++++++++
 3 files changed, 82 insertions(+), 7 deletions(-)
 create mode 100644 cmd/restic/lock_wait_env_test.go

diff --git a/cmd/restic/cmd_init_integration_test.go b/cmd/restic/cmd_init_integration_test.go
index 2bfd9c7fb00965781212cfb5b3dc63af0c02b0f4..22c847308e1b746098892ba7adaa799df8dfe9ee 100644
--- a/cmd/restic/cmd_init_integration_test.go
+++ b/cmd/restic/cmd_init_integration_test.go
@@ -15,7 +15,8 @@ import (
 func testRunInit(t testing.TB, gopts global.Options) {
 	repository.TestUseLowSecurityKDFParameters(t)
 	restic.TestDisableCheckPolynomial(t)
-	repository.TestSetLockTimeout(t, 0)
+	// zero unless RESTIC_TEST_LOCK_WAIT is set, see testLockWait
+	repository.TestSetLockTimeout(t, testLockWait(t))
 
 	err := withTermStatus(t, gopts, func(ctx context.Context, gopts global.Options) error {
 		return runInit(ctx, InitOptions{}, gopts, nil, gopts.Term)
diff --git a/cmd/restic/integration_test.go b/cmd/restic/integration_test.go
index 27668bd29c05bb570c6b644d6cc7ca766d9ebfc4..805d4778b986f9c322dd0f6e098772ae1cdf96af 100644
--- a/cmd/restic/integration_test.go
+++ b/cmd/restic/integration_test.go
@@ -6,6 +6,7 @@ import (
 	"io"
 	"os"
 	"path/filepath"
+	"sync"
 	"testing"
 
 	"github.com/restic/restic/internal/backend"
@@ -46,16 +47,30 @@ func TestCheckRestoreNoLock(t *testing.T) {
 // listing filetypes more than once may cause problems with eventually consistent
 // backends (like e.g. Amazon S3) as the second listing may be inconsistent to what
 // is expected by the first listing + some operations.
+//
+// With a settle delay above zero (see testLockWait) a command also reads while
+// it waits for its lock: it lists the snapshot and the index files once during
+// the wait, and once more after the lock is confirmed, to compare. The listings
+// of the wait are therefore counted on their own: once per type, snapshots
+// before index. Everything from the confirmation scan of the lock on is held
+// to the rule above. The wait begins when the command has saved its lock file
+// and ends with the next listing of the lock files.
 type listOnceBackend struct {
 	backend.Backend
+	strictOrder bool
+
+	mu             sync.Mutex
 	listedFileType map[backend.FileType]bool
-	strictOrder    bool
+	// set between the save of the own lock file and the next lock listing
+	inLockWait   bool
+	listedInWait map[backend.FileType]bool
 }
 
 func newListOnceBackend(be backend.Backend) *listOnceBackend {
 	return &listOnceBackend{
 		Backend:        be,
 		listedFileType: make(map[backend.FileType]bool),
+		listedInWait:   make(map[backend.FileType]bool),
 		strictOrder:    false,
 	}
 }
@@ -64,18 +79,47 @@ func newOrderedListOnceBackend(be backend.Backend) *listOnceBackend {
 	return &listOnceBackend{
 		Backend:        be,
 		listedFileType: make(map[backend.FileType]bool),
+		listedInWait:   make(map[backend.FileType]bool),
 		strictOrder:    true,
 	}
 }
 
+func (be *listOnceBackend) Save(ctx context.Context, h backend.Handle, rd backend.RewindReader) error {
+	err := be.Backend.Save(ctx, h, rd)
+	if err == nil && h.Type == backend.LockFile {
+		be.mu.Lock()
+		be.inLockWait = true
+		be.listedInWait = make(map[backend.FileType]bool)
+		be.mu.Unlock()
+	}
+	return err
+}
+
 func (be *listOnceBackend) List(ctx context.Context, t backend.FileType, fn func(backend.FileInfo) error) error {
-	if t != backend.LockFile && be.listedFileType[t] {
-		return errors.Errorf("tried listing type %v the second time", t)
+	if t == backend.LockFile {
+		err := be.Backend.List(ctx, t, fn)
+		be.mu.Lock()
+		be.inLockWait = false
+		be.mu.Unlock()
+		return err
 	}
-	if be.strictOrder && t == backend.SnapshotFile && be.listedFileType[backend.IndexFile] {
-		return errors.Errorf("tried listing type snapshots after index")
+
+	be.mu.Lock()
+	listed, when := be.listedFileType, ""
+	if be.inLockWait {
+		listed, when = be.listedInWait, " during the lock wait"
+	}
+	var err error
+	if listed[t] {
+		err = errors.Errorf("tried listing type %v the second time%s", t, when)
+	} else if be.strictOrder && t == backend.SnapshotFile && listed[backend.IndexFile] {
+		err = errors.Errorf("tried listing type snapshots after index%s", when)
+	}
+	listed[t] = true
+	be.mu.Unlock()
+	if err != nil {
+		return err
 	}
-	be.listedFileType[t] = true
 	return be.Backend.List(ctx, t, fn)
 }
 
diff --git a/cmd/restic/lock_wait_env_test.go b/cmd/restic/lock_wait_env_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..30252f0498ff4bd698bf0da8768a9c8638371ff8
--- /dev/null
+++ b/cmd/restic/lock_wait_env_test.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"os"
+	"testing"
+	"time"
+)
+
+// testLockWait returns the lock's settle delay for the integration tests.
+//
+// The default is zero, as in stock: the tests then do not spend 200 ms per
+// command. With a delay of zero the lock code starts no wait work at all, so
+// nothing of what overlaps the settle delay (the early snapshot listing and
+// index load, check's prepared pack sizes, ls's prepared snapshot) is covered.
+// To run the same tests the way the binary runs, set the production value:
+//
+//	RESTIC_TEST_LOCK_WAIT=200ms go test ./cmd/restic
+//
+// Tests that set their own delay with repository.TestSetLockTimeout keep it.
+func testLockWait(t testing.TB) time.Duration {
+	value := os.Getenv("RESTIC_TEST_LOCK_WAIT")
+	if value == "" {
+		return 0
+	}
+	wait, err := time.ParseDuration(value)
+	if err != nil || wait < 0 {
+		t.Fatalf("RESTIC_TEST_LOCK_WAIT=%q is not a duration such as 200ms", value)
+	}
+	return wait
+}
