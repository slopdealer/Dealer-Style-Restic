@@ -155,6 +172,9 @@ func streamPackResponse(ctx context.Context, load backendLoadFn, recoverBlob loa
 	if ctx.Err() != nil {
 		return ctx.Err()
 	}
+	if decodeErr != nil {
+		return decodeErr
+	}
 	if yield {
 		// No live response remains here. The original context and policy allow
 		// ordinary admission and alternate loads without a nested-load cycle.
@@ -200,5 +220,31 @@ func streamPackResponse(ctx context.Context, load backendLoadFn, recoverBlob loa
 		}
 		return streamPackPartWithBuffer(finalCtx, readFinal, recoverBlob, dec, key, packID, finalPart, data, handle)
 	}
+	// Load reported success, but the consumer did not take the range to its
+	// end (it was never called, or its error was dropped): nothing was read for
+	// the blobs that are still open. Fail closed exactly as a decode after Load
+	// does with a buffer that was never filled: the remaining blobs are decoded
+	// from zero bytes, none of them authenticates, and each one goes through
+	// alternate-copy recovery or is reported to the handler with its error.
+	for remaining := blobs[committed:]; len(remaining) > 0; {
+		n := packRangeEnd(remaining, window)
+		if err := streamPackPartWithBuffer(ctx, loadNothing, recoverBlob, dec, key, packID, remaining[:n], data, handle); err != nil {
+			return err
+		}
+		remaining = remaining[n:]
+	}
 	return nil
 }
+
+// loadNothing stands for a Load that delivered no bytes: it fills the window
+// with zeros, which is what a freshly allocated range buffer holds.
+func loadNothing(_ context.Context, _ backend.Handle, _ int, _ int64, consume func(io.Reader) error) error {
+	return consume(zeroReader{})
+}
+
+type zeroReader struct{}
+
+func (zeroReader) Read(p []byte) (int, error) {
+	clear(p)
+	return len(p), nil
+}
diff --git a/internal/repository/stream_pack_coalesced_errors_test.go b/internal/repository/stream_pack_coalesced_errors_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0115f6d8912a301bfde3ad47dc3cfbb3dc9ac643
--- /dev/null
+++ b/internal/repository/stream_pack_coalesced_errors_test.go
@@ -0,0 +1,144 @@
+package repository
+
+import (
+	"context"
+	"io"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/backend/mem"
+	"github.com/restic/restic/internal/backend/retry"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+	"github.com/restic/restic/internal/test"
+)
+
+type loadCountingBackend struct {
+	backend.Backend
+	loads atomic.Int64
+}
+
+func (b *loadCountingBackend) Load(ctx context.Context, h backend.Handle, length int, offset int64, fn func(rd io.Reader) error) error {
+	b.loads.Add(1)
+	return b.Backend.Load(ctx, h, length, offset, fn)
+}
+
+// An error of the decoder that is not a transfer error (here an index entry
+// whose length is not larger than the nonce) inside a window that is decoded
+// within the Load callback must be reported once. It must not be retried as a
+// failed download, and it must not open the retry backend's circuit breaker
+// for the pack.
+func TestStreamPackCoalescedDecodeErrorIsNotRetried(t *testing.T) {
+	retry.TestFastRetries(t)
+	dec, err := zstd.NewReader(nil)
+	test.OK(t, err)
+	defer dec.Close()
+	key := testKey(t)
+
+	// 1.2 MiB, 0.6 MiB, 1.2 MiB, 1.2 MiB: more than one 2 MiB window, no gap
+	good, packfile := buildPackfileWithoutHeader([]int{1200000, 600000, 1200000, 1200000}, &key, false)
+	bad := pack.Blob{
+		BlobHandle: restic.BlobHandle{Type: restic.DataBlob, ID: restic.Hash([]byte("damaged index entry"))},
+		Offset:     good[1].Offset,
+		Length:     10,
+	}
+	packID := restic.Hash(packfile)
+	h := backend.Handle{Type: backend.PackFile, Name: packID.String()}
+
+	for _, tc := range []struct {
+		name   string
+		stream func(ctx context.Context, load backendLoadFn, blobs pack.Blobs, handle func(restic.BlobHandle, []byte, error) error) error
+	}{
+		{"read then decode", func(ctx context.Context, load backendLoadFn, blobs pack.Blobs, handle func(restic.BlobHandle, []byte, error) error) error {
+			return streamPack(ctx, load, nil, dec, &key, packID, blobs, handle)
+		}},
+		{"decode inside Load", func(ctx context.Context, load backendLoadFn, blobs pack.Blobs, handle func(restic.BlobHandle, []byte, error) error) error {
+			return streamPackWithPolicy(ctx, load, nil, dec, &key, packID, blobs, handle, restoreStreamWindow, true)
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			inner := &loadCountingBackend{Backend: mem.New()}
+			test.OK(t, inner.Save(context.TODO(), h, backend.NewByteReader(packfile, inner.Hasher())))
+			be := retry.New(inner, 15*time.Minute, nil, nil)
+
+			delivered := 0
+			err := tc.stream(context.TODO(), be.Load, pack.Blobs{good[0], bad, good[2], good[3]}, func(_ restic.BlobHandle, _ []byte, err error) error {
+				test.OK(t, err)
+				delivered++
+				return nil
+			})
+			if err == nil || !strings.Contains(err.Error(), "invalid blob length") {
+				t.Fatalf("expected the invalid blob length error, got %v", err)
+			}
+			test.Equals(t, 1, delivered)
+			test.Equals(t, int64(1), inner.loads.Load())
+			// the pack must still be readable through the same retry backend
+			test.OK(t, be.Load(context.TODO(), h, 16, 0, func(rd io.Reader) error {
+				_, err := io.Copy(io.Discard, rd)
+				return err
+			}))
+		})
+	}
+}
+
+// A Load that returns nil without calling the consumer has delivered nothing.
+// Every requested blob must then reach the handler with an error (or come
+// from another copy), exactly as when the range is decoded after Load.
+func TestStreamPackCoalescedFailsClosedWithoutConsumer(t *testing.T) {
+	dec, err := zstd.NewReader(nil)
+	test.OK(t, err)
+	defer dec.Close()
+	key := testKey(t)
+
+	blobList, _ := buildPackfileWithoutHeader([]int{1200000, 1200000, 1200000, 1200000}, &key, false)
+	packID := restic.Hash([]byte("pack"))
+	silentLoad := func(_ context.Context, _ backend.Handle, _ int, _ int64, _ func(rd io.Reader) error) error {
+		return nil
+	}
+	recovered := []byte("another copy")
+
+	for _, tc := range []struct {
+		name   string
+		stream func(recoverBlob loadBlobFn, handle func(restic.BlobHandle, []byte, error) error) error
+	}{
+		{"read then decode", func(recoverBlob loadBlobFn, handle func(restic.BlobHandle, []byte, error) error) error {
+			return streamPack(context.TODO(), silentLoad, recoverBlob, dec, &key, packID, append(pack.Blobs(nil), blobList...), handle)
+		}},
+		{"decode inside Load", func(recoverBlob loadBlobFn, handle func(restic.BlobHandle, []byte, error) error) error {
+			return streamPackWithPolicy(context.TODO(), silentLoad, recoverBlob, dec, &key, packID, append(pack.Blobs(nil), blobList...), handle, restoreStreamWindow, true)
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var failed []restic.BlobHandle
+			test.OK(t, tc.stream(nil, func(h restic.BlobHandle, _ []byte, err error) error {
+				if err == nil {
+					t.Errorf("blob %v was delivered although nothing was read", h)
+				} else if !strings.Contains(err.Error(), "decrypting blob") {
+					t.Errorf("unexpected error for blob %v: %v", h, err)
+				}
+				failed = append(failed, h)
+				return nil
+			}))
+			test.Equals(t, len(blobList), len(failed))
+			for i, h := range failed {
+				test.Equals(t, blobList[i].BlobHandle, h)
+			}
+
+			// with another copy available every blob is taken from there
+			calls := 0
+			test.OK(t, tc.stream(func(_ context.Context, _ restic.BlobHandle, _ []byte) ([]byte, error) {
+				return recovered, nil
+			}, func(h restic.BlobHandle, buf []byte, err error) error {
+				test.OK(t, err)
+				test.Equals(t, string(recovered), string(buf))
+				calls++
+				return nil
+			}))
+			test.Equals(t, len(blobList), calls)
+		})
+	}
+}
diff --git a/internal/repository/stream_pack_released.go b/internal/repository/stream_pack_released.go
new file mode 100644
index 0000000000000000000000000000000000000000..e7d9d6989f3a7a494e40aab66cc8d8d074dbb9f3
--- /dev/null
+++ b/internal/repository/stream_pack_released.go
@@ -0,0 +1,22 @@
+package repository
+
+import (
+	"context"
+
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// loadBlobsFromPackReleased is loadBlobsFromPack for handlers that use the
+// backend themselves (repack and copy save the blobs, repair packs uploads
+// them again). Each window is read into memory, the backend connection is
+// released, and only then are the blobs decoded and handed to the handler, so
+// a handler never runs inside the backend's Load callback. With a single
+// backend connection a handler that saves from inside Load waits for the
+// connection its own reader holds.
+//
+// The price is one backend request per window instead of one per pack range.
+// The windows, the range buffer and every check are those of the restore path.
+func (r *Repository) loadBlobsFromPackReleased(ctx context.Context, packID restic.ID, blobs pack.Blobs, handleBlobFn func(blob restic.BlobHandle, buf []byte, err error) error) error {
+	return streamPackWindowed(ctx, r.be.Load, r.LoadBlob, r.getZstdDecoder(), r.key, packID, blobs, handleBlobFn, restoreStreamWindow, true)
+}
diff --git a/internal/repository/stream_pack_released_test.go b/internal/repository/stream_pack_released_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d96f1a6b358ade88673d4e153b3618f0ce314be5
--- /dev/null
+++ b/internal/repository/stream_pack_released_test.go
@@ -0,0 +1,171 @@
+package repository
+
+import (
+	"context"
+	"io"
+	"math/rand"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/backend/mem"
+	"github.com/restic/restic/internal/backend/sema"
+	"github.com/restic/restic/internal/restic"
+	"github.com/restic/restic/internal/test"
+)
+
+// A handler that uses the backend must not run inside the backend's Load
+// callback: with one backend connection the upload it starts waits for the
+// connection that its own pack read holds.
+
+type fixedConnectionsBackend struct {
+	backend.Backend
+	connections uint
+}
+
+func (b fixedConnectionsBackend) Properties() backend.Properties {
+	p := b.Backend.Properties()
+	p.Connections = b.connections
+	return p
+}
+
+func (b fixedConnectionsBackend) Unwrap() backend.Backend { return b.Backend }
+
+// saveIncompressibleBlobs stores count data blobs of 1 MiB and returns their
+// IDs and the packs that hold them.
+func saveIncompressibleBlobs(t *testing.T, repo *Repository, count int) (restic.IDs, restic.IDSet) {
+	rnd := rand.New(rand.NewSource(5))
+	var ids restic.IDs
+	test.OK(t, repo.WithBlobUploader(context.Background(), func(ctx context.Context, up restic.BlobSaverWithAsync) error {
+		for i := 0; i < count; i++ {
+			buf := make([]byte, 1<<20)
+			rnd.Read(buf)
+			id, _, _, err := up.SaveBlob(ctx, restic.DataBlob, buf, restic.ID{}, false)
+			if err != nil {
+				return err
+			}
+			ids = append(ids, id)
+		}
+		return nil
+	}))
+	packs := restic.NewIDSet()
+	for _, id := range ids {
+		for _, pb := range repo.LookupBlob(restic.BlobHandle{Type: restic.DataBlob, ID: id}) {
+			packs.Insert(pb.PackID())
+		}
+	}
+	return ids, packs
+}
+
+// `restic repair packs` on a backend limited to one connection. The pack was
+// written with the default pack size; the repairing run uses the minimum, so
+// the salvaged blobs fill more than one new pack while the pack is read.
+func testRepairPacksConnections(t *testing.T, connections uint) {
+	be := sema.NewBackend(fixedConnectionsBackend{Backend: mem.New(), connections: connections})
+	src, _ := TestRepositoryWithBackend(t, be, 2, Options{})
+	ids, packs := saveIncompressibleBlobs(t, src, 13)
+
+	repo, err := New(be, Options{Compression: CompressionFastest, PackSize: MinPackSize})
+	test.OK(t, err)
+	test.OK(t, repo.SearchKey(context.Background(), test.TestPassword, 10, ""))
+	test.OK(t, repo.LoadIndex(context.Background(), restic.NoopTerminalCounterFactory))
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- RepairPacks(ctx, repo, packs, restic.NewNoopPrinter()) }()
+	select {
+	case err := <-done:
+		test.OK(t, err)
+	case <-time.After(30 * time.Second):
+		t.Fatalf("repair packs did not finish within 30 s with %d backend connection(s): deadlock", connections)
+	}
+
+	check := TestOpenBackend(t, be)
+	test.OK(t, check.LoadIndex(context.Background(), restic.NoopTerminalCounterFactory))
+	for _, id := range ids {
+		_, err := check.LoadBlob(context.Background(), restic.BlobHandle{Type: restic.DataBlob, ID: id}, nil)
+		test.OK(t, err)
+	}
+}
+
+func TestRepairPacksOneConnection(t *testing.T)  { testRepairPacksConnections(t, 1) }
+func TestRepairPacksTwoConnections(t *testing.T) { testRepairPacksConnections(t, 2) }
+
+// packLoadDepthBackend counts the pack reads whose consumer is running.
+type packLoadDepthBackend struct {
+	backend.Backend
+	inLoad atomic.Int32
+	loads  atomic.Int32
+}
+
+func (b *packLoadDepthBackend) Load(ctx context.Context, h backend.Handle, length int, offset int64, fn func(rd io.Reader) error) error {
+	if h.Type != backend.PackFile {
+		return b.Backend.Load(ctx, h, length, offset, fn)
+	}
+	b.loads.Add(1)
+	return b.Backend.Load(ctx, h, length, offset, func(rd io.Reader) error {
+		b.inLoad.Add(1)
+		defer b.inLoad.Add(-1)
+		return fn(rd)
+	})
+}
+
+func (b *packLoadDepthBackend) Unwrap() backend.Backend { return b.Backend }
+
+// insideLoadUploader records saves that are requested while a pack read is
+// inside its Load callback.
+type insideLoadUploader struct {
+	restic.BlobSaverWithAsync
+	be         *packLoadDepthBackend
+	saves      atomic.Int32
+	insideLoad atomic.Int32
+}
+
+func (u *insideLoadUploader) note() {
+	u.saves.Add(1)
+	if u.be.inLoad.Load() != 0 {
+		u.insideLoad.Add(1)
+	}
+}
+
+func (u *insideLoadUploader) SaveBlob(ctx context.Context, tpe restic.BlobType, buf []byte, id restic.ID, storeDuplicate bool) (restic.ID, bool, int, error) {
+	u.note()
+	return u.BlobSaverWithAsync.SaveBlob(ctx, tpe, buf, id, storeDuplicate)
+}
+
+func (u *insideLoadUploader) SaveBlobAsync(ctx context.Context, tpe restic.BlobType, buf []byte, id restic.ID, storeDuplicate bool, cb func(restic.ID, bool, int, error)) {
+	u.note()
+	u.BlobSaverWithAsync.SaveBlobAsync(ctx, tpe, buf, id, storeDuplicate, cb)
+}
+
+// The repack handler (prune and copy) saves blobs. It must be called after
+// the pack read has returned its connection, for every window of the pack.
+func TestRepackHandlerRunsOutsideLoad(t *testing.T) {
+	probe := &packLoadDepthBackend{Backend: mem.New()}
+	// two connections: one repack worker, so no other pack read is in flight
+	be := sema.NewBackend(fixedConnectionsBackend{Backend: probe, connections: 2})
+	repo, _ := TestRepositoryWithBackend(t, be, 2, Options{})
+	ids, packs := saveIncompressibleBlobs(t, repo, 6)
+	test.Equals(t, 1, len(packs))
+
+	keep := restic.NewBlobSet()
+	for _, id := range ids {
+		keep.Insert(restic.BlobHandle{Type: restic.DataBlob, ID: id})
+	}
+	probe.loads.Store(0)
+	var uploader *insideLoadUploader
+	test.OK(t, repo.WithBlobUploader(context.Background(), func(ctx context.Context, up restic.BlobSaverWithAsync) error {
+		uploader = &insideLoadUploader{BlobSaverWithAsync: up, be: probe}
+		return CopyBlobs(ctx, repo, repo, uploader, packs, keep, restic.NoopCounter, nil)
+	}))
+
+	test.Equals(t, int32(len(ids)), uploader.saves.Load())
+	if n := uploader.insideLoad.Load(); n != 0 {
+		t.Fatalf("%d of %d saves were requested inside the backend Load callback of the pack read", n, len(ids))
+	}
+	// 6 blobs of 1 MiB in windows of 2 MiB: one blob per window, one request each
+	test.Equals(t, int32(len(ids)), probe.loads.Load())
+	test.Equals(t, 0, keep.Len())
+}
