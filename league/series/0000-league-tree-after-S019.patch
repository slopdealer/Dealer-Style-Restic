+package repository
+
+import (
+	"bytes"
+	"fmt"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Admission uses the caller's size hint. Both routes must keep the complete
+// content and terminal-error interpretation of the inherited verifier.
+func TestSavedStreamAdmissionBoundaryB18(t *testing.T) {
+	enc, err := zstd.NewWriter(nil, zstd.WithWindowSize(512<<10), zstd.WithEncoderCRC(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer enc.Close()
+	for _, size := range []int{streamedSaveVerifyMinSize - 1, streamedSaveVerifyMinSize, streamedSaveVerifyMinSize + 1} {
+		t.Run(fmt.Sprint(size), func(t *testing.T) {
+			p := bytes.Repeat([]byte{41}, size)
+			frame := enc.EncodeAll(p, nil)
+			r := &Repository{key: crypto.NewRandomKey()}
+			defer func() {
+				if r.dec != nil {
+					r.dec.Close()
+				}
+			}()
+			buf := encryptSaveVerifyTest(r, frame)
+			if err := r.verifyCiphertext(buf, size, restic.Hash(p)); err != nil {
+				t.Fatal(err)
+			}
+			if eager := r.dec != nil; eager != (size < streamedSaveVerifyMinSize) {
+				t.Fatalf("eager decoder initialized=%v at size %d", eager, size)
+			}
+			wrong := restic.Hash([]byte("wrong"))
+			if got := r.verifyCiphertext(buf, size, wrong); got == nil || got.Error() != "hash mismatch" {
+				t.Fatalf("wrong content: %v", got)
+			}
+			frame[len(frame)-1] ^= 1
+			buf = encryptSaveVerifyTest(r, frame)
+			got := r.verifyCiphertext(buf, size, wrong)
+			want := eagerSaveVerifyTest(r, buf, size, wrong)
+			if got == nil || fmt.Sprint(got) != fmt.Sprint(want) {
+				t.Fatalf("terminal failure versus wrong ID: got %v, want %v", got, want)
+			}
+		})
+	}
+}
diff --git a/internal/repository/save_verify_compressed.go b/internal/repository/save_verify_compressed.go
new file mode 100644
index 0000000000000000000000000000000000000000..ca64ca94cbed4a4e8b19e63f9734b25e6803e536
--- /dev/null
+++ b/internal/repository/save_verify_compressed.go
@@ -0,0 +1,51 @@
+package repository
+
+import (
+	"bytes"
+	"crypto/sha256"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/errors"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Decoder construction owns roughly a megabyte of scratch even for small
+// output. Leave those blobs on the shared eager decoder.
+const streamedSaveVerifyMinSize = 2 << 20
+
+// verifySavedCompressedHash consumes authenticated compressed bytes. Large
+// blobs do not need a second complete decoded representation just to hash it.
+// The normal saver encodes with a 512 KiB window. A larger-window frame or
+// any stream error declines this route, preserving the ordinary decoder's
+// interpretation and diagnostic precedence. No partial hash can succeed.
+// Scratch is operation-owned and closed before packer contention begins.
+func verifySavedCompressedHash(compressed []byte, id restic.ID) (bool, error) {
+	return verifySavedCompressedHashLimit(compressed, id, 16*1024*1024*1024)
+}
+
+// Match DecodeAll's cumulative output limit, including concatenated frames.
+// Exact-limit output still requires the decoder to settle its terminal state.
+func verifySavedCompressedHashLimit(compressed []byte, id restic.ID, limit int64) (bool, error) {
+	dec, err := zstd.NewReader(bytes.NewReader(compressed),
+		zstd.WithDecoderConcurrency(1), zstd.WithDecoderLowmem(true),
+		zstd.WithDecoderMaxWindow(512<<10),
+		zstd.WithDecoderMaxMemory(16*1024*1024*1024),
+		zstd.WithDecodeBuffersBelow(0))
+	if err != nil {
+		return false, nil
+	}
+	defer dec.Close()
+	h := sha256.New()
+	bounded := &saveVerifyHashWriter{h: h, remaining: limit}
+	_, err = dec.WriteTo(bounded)
+	if err != nil || bounded.exceeded {
+		return false, nil
+	}
+	var sum [sha256.Size]byte
+	var got restic.ID
+	copy(got[:], h.Sum(sum[:0]))
+	if !got.Equal(id) {
+		return true, errors.New("hash mismatch")
+	}
+	return true, nil
+}
diff --git a/internal/repository/save_verify_compressed_test.go b/internal/repository/save_verify_compressed_test.go
