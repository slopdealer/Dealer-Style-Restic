+	"github.com/restic/restic/internal/ui"
+)
+
+func (b *metadataCommandGate) Unwrap() backend.Backend { return b.Backend }
+
+type metadataCommandGate struct {
+	*waitWorkGateBackend
+	snapshotStarted chan struct{}
+	snapshotStart   sync.Once
+}
+
+func (b *metadataCommandGate) Load(ctx context.Context, h backend.Handle, length int, offset int64, fn func(io.Reader) error) error {
+	err := b.Backend.Load(ctx, h, length, offset, fn)
+	if h.Type == backend.SnapshotFile {
+		b.snapshotStart.Do(func() { close(b.snapshotStarted) })
+	}
+	return err
+}
+
+type metadataSnapshotObserver struct {
+	backend.Backend
+	gate *metadataCommandGate
+}
+
+func (b *metadataSnapshotObserver) Load(ctx context.Context, h backend.Handle, n int, off int64, fn func(io.Reader) error) error {
+	err := b.Backend.Load(ctx, h, n, off, fn)
+	if h.Type == backend.SnapshotFile {
+		b.gate.snapshotStart.Do(func() { close(b.gate.snapshotStarted) })
+	}
+	return err
+}
+
+func TestLsFailedLockConfirmationDiscardsPreparedSnapshotBeforeUnlock(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+	env.gopts.NoCache = true
+	testSetupBackupData(t, env)
+	testRunBackup(t, "", []string{env.testdata}, BackupOptions{}, env.gopts)
+	snapshotIDs := testListSnapshots(t, env.gopts, 1)
+	// testRunInit adds a junk lock filename for listing tests. This test counts
+	// the two real lock owners, so remove that unrelated fixture entry.
+	if err := os.Remove(filepath.Join(env.repo, "locks", "tmp12345")); err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	before := hashRepositoryFiles(t, env.repo)
+
+	repository.TestSetLockTimeout(t, 50*time.Millisecond)
+	defer repository.TestSetLockTimeout(t, 0)
+
+	// Hold a valid exclusive lock through an independent repository handle.
+	// The test backend hides it from the first check, then exposes it to the
+	// second check after the candidate has created its own lock and started
+	// speculative index loading.
+	competitorOptions := env.gopts
+	competitorOptions.BackendTestHook = nil
+	competitorOptions.NoCache = true
+	// OpenRepository is normally called through withTermStatus. The independent
+	// competitor also needs a terminal even with a supplied password.
+	competitorOptions.Term = &ui.MockTerminal{}
+	competitorRepo, err := global.OpenRepository(context.Background(), competitorOptions, restic.NewNoopPrinter())
+	rtest.OK(t, err)
+	unlockCompetitor, _, err := repository.LockRepo(context.Background(), competitorRepo, true, 0, func(string) {}, func(string, ...any) {})
+	rtest.OK(t, err)
+	defer func() {
+		unlockCompetitor()
+		rtest.OK(t, competitorRepo.Close())
+	}()
+	var competitorID restic.ID
+	err = competitorRepo.List(context.Background(), restic.LockFile, func(id restic.ID, _ int64) error {
+		competitorID = id
+		return nil
+	})
+	rtest.OK(t, err)
+	rtest.Assert(t, !competitorID.IsNull(), "expected the competing lock to be present")
+
+	gate := &metadataCommandGate{waitWorkGateBackend: newWaitWorkGateBackend(nil), snapshotStarted: make(chan struct{})}
+	gate.competitorLock = competitorID.String()
+	env.gopts.BackendInnerTestHook = func(be backend.Backend) (backend.Backend, error) {
+		return &metadataSnapshotObserver{Backend: be, gate: gate}, nil
+	}
+	env.gopts.BackendTestHook = func(be backend.Backend) (backend.Backend, error) {
+		gate.Backend = be
+		return gate, nil
+	}
+	defer gate.unblock()
+
+	target := filepath.Join(env.base, "restore-competing-lock")
+	stdout, stderr, err := withCaptureStdoutStderr(t, env.gopts, func(ctx context.Context, gopts global.Options) error {
+		runCtx, cancelCommand := context.WithCancel(ctx)
+		defer cancelCommand()
+		commandDone := make(chan error, 1)
+		go func() {
+			commandDone <- runLs(runCtx, LsOptions{}, gopts, []string{snapshotIDs[0].String()}, gopts.Term)
+		}()
+		fail := func(err error) error {
+			cancelCommand()
+			gate.unblock()
+			select {
+			case <-commandDone:
+			case <-time.After(5 * time.Second):
+			}
+			return err
+		}
+
+		select {
+		case <-gate.indexStarted:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		select {
+		case <-gate.secondLockList:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+
+		select {
+		case <-gate.snapshotStarted:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		gate.continueConfirmation()
+		select {
+		case <-gate.indexCanceled:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		select {
+		case commandErr := <-commandDone:
+			return commandErr
+		default:
+		}
+
+		locks, readErr := os.ReadDir(filepath.Join(env.repo, "locks"))
+		if readErr != nil {
+			return readErr
+		}
+		if len(locks) != 2 {
+			return fmt.Errorf("lock files during index drain = %d, want candidate and competitor locks", len(locks))
+		}
+		if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+			return fmt.Errorf("restore target changed before lock confirmation: stat error = %v", statErr)
+		}
+
+		gate.releaseHeldIndex()
+		return <-commandDone
+	})
+	if !repository.IsAlreadyLocked(err) {
+		t.Fatalf("restore error = %v, want competing-lock error", err)
+	}
+	if strings.Contains(stdout.String()+stderr.String(), "index files loaded") || strings.Contains(stdout.String()+stderr.String(), "snapshot ") {
+		t.Fatalf("unconfirmed restore exposed progress or started restore output: stdout=%q stderr=%q", stdout.String(), stderr.String())
+	}
+	if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+		t.Fatalf("restore target after failed confirmation: stat error = %v, want not-exist", statErr)
+	}
+	locks, err := os.ReadDir(filepath.Join(env.repo, "locks"))
+	rtest.OK(t, err)
+	if len(locks) != 1 || locks[0].Name() != competitorID.String() {
+		t.Fatalf("locks after failed confirmation = %v, want only competitor %s", lockNames(locks), competitorID)
+	}
+	if got := hashRepositoryFiles(t, env.repo); !sameRepositoryFiles(before, got) {
+		t.Fatal("repository objects changed during failed lock confirmation")
+	}
+}
diff --git a/cmd/restic/snapshot_metadata_wait.go b/cmd/restic/snapshot_metadata_wait.go
new file mode 100644
index 0000000000000000000000000000000000000000..d22bca32152a8c2d56cc02ffabe4a8a1420ef745
--- /dev/null
+++ b/cmd/restic/snapshot_metadata_wait.go
@@ -0,0 +1,81 @@
+package main
+
+import (
+	"context"
+	"strings"
+
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+)
+
+// snapshotMetadataLoad retains one ciphertext while index preparation runs.
+// It neither selects a snapshot nor decodes one before lock confirmation.
+type snapshotMetadataLoad struct {
+	cancel context.CancelFunc
+	done   chan struct{}
+	loader restic.LoaderUnpacked
+}
+
+func startSnapshotMetadataLoad(ctx context.Context, repo *repository.Repository, load *repositoryIndexLoad, request string) *snapshotMetadataLoad {
+	if load == nil || load.snapshots == nil || repo.Connections() < 2 {
+		return nil
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	p := &snapshotMetadataLoad{cancel: cancel, done: make(chan struct{}), loader: repo}
+	go func() {
+		defer close(p.done)
+		select {
+		case <-ctx.Done():
+			return
+		case <-load.snapshots.ready:
+		}
+		if load.snapshots.err != nil {
+			return
+		}
+		id, size, ok := snapshotMetadataTarget(ctx, load.snapshots.lister, request)
+		if ok {
+			p.loader = repo.PrepareSnapshot(ctx, id, size)
+		}
+	}()
+	return p
+}
+
+// A full or unambiguous prefix names one demand. "latest" names one demand
+// only when the listing contains one snapshot. Never fetch all snapshots.
+func snapshotMetadataTarget(ctx context.Context, list restic.Lister, request string) (restic.ID, int64, bool) {
+	request, _, _ = strings.Cut(request, ":")
+	var target restic.ID
+	var size int64
+	matches := 0
+	err := list.List(ctx, restic.SnapshotFile, func(id restic.ID, n int64) error {
+		if request == "latest" || strings.HasPrefix(id.String(), request) {
+			matches++
+			target, size = id, n
+		}
+		return nil
+	})
+	return target, size, err == nil && matches == 1 && size > 0 && size <= repository.PreparedSnapshotLimit
+}
+
+func (p *snapshotMetadataLoad) get(fallback restic.LoaderUnpacked) restic.LoaderUnpacked {
+	if p == nil {
+		return fallback
+	}
+	<-p.done
+	return p.loader
+}
+
+func (p *snapshotMetadataLoad) finish() {
+	if p == nil {
+		return
+	}
+	p.cancel()
+	<-p.done
+	p.loader = nil
+}
+
+func (p *snapshotMetadataLoad) settle(confirmed bool) {
+	if !confirmed {
+		p.finish()
+	}
+}
diff --git a/cmd/restic/snapshot_metadata_wait_test.go b/cmd/restic/snapshot_metadata_wait_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..75d9590f921b48082eada3df4bc57817ac715e0f
--- /dev/null
+++ b/cmd/restic/snapshot_metadata_wait_test.go
@@ -0,0 +1,160 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/backend/retry"
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+)
+
+type metadataTargetList struct {
+	ids   []restic.ID
+	sizes []int64
+	err   error
+}
+
+func (l metadataTargetList) List(ctx context.Context, typ restic.FileType, fn func(restic.ID, int64) error) error {
+	if typ != restic.SnapshotFile {
+		return errors.New("unexpected listing")
+	}
+	for i, id := range l.ids {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := fn(id, l.sizes[i]); err != nil {
+			return err
+		}
+	}
+	return l.err
+}
+
+func TestSnapshotMetadataTargetsOnlyOneListedDemand(t *testing.T) {
+	a := restic.ID{0xab, 1}
+	b := restic.ID{0xab, 2}
+	for _, tc := range []struct {
+		name, request string
+		list          metadataTargetList
+		want          bool
+	}{
+		{"full", a.String(), metadataTargetList{ids: []restic.ID{a, b}, sizes: []int64{80, 80}}, true},
+		{"prefix", a.String()[:4], metadataTargetList{ids: []restic.ID{a, b}, sizes: []int64{80, 80}}, true},
+		{"subfolder", a.String() + ":dir", metadataTargetList{ids: []restic.ID{a}, sizes: []int64{80}}, true},
+		{"sole-latest", "latest", metadataTargetList{ids: []restic.ID{a}, sizes: []int64{80}}, true},
+		{"many-latest", "latest", metadataTargetList{ids: []restic.ID{a, b}, sizes: []int64{80, 80}}, false},
+		{"ambiguous", "ab", metadataTargetList{ids: []restic.ID{a, b}, sizes: []int64{80, 80}}, false},
+		{"absent", b.String(), metadataTargetList{ids: []restic.ID{a}, sizes: []int64{80}}, false},
+		{"late-list-error", a.String(), metadataTargetList{ids: []restic.ID{a}, sizes: []int64{80}, err: errors.New("listing failed")}, false},
+		{"oversized", a.String(), metadataTargetList{ids: []restic.ID{a}, sizes: []int64{repository.PreparedSnapshotLimit + 1}}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			id, _, ok := snapshotMetadataTarget(context.Background(), tc.list, tc.request)
+			if ok != tc.want || (ok && id != a) {
+				t.Fatalf("target=%v ok=%v", id, ok)
+			}
+		})
+	}
+}
+
+type metadataWaitBackend struct {
+	backend.Backend
+	active                     bool
+	mu                         sync.Mutex
+	lists                      []backend.FileType
+	started, canceled, release chan struct{}
+	start, cancel              sync.Once
+}
+
+func (b *metadataWaitBackend) Properties() backend.Properties {
+	p := b.Backend.Properties()
+	p.Connections = 2
+	return p
+}
+func (b *metadataWaitBackend) List(ctx context.Context, typ backend.FileType, fn func(backend.FileInfo) error) error {
+	if b.active {
+		b.mu.Lock()
+		b.lists = append(b.lists, typ)
+		b.mu.Unlock()
+	}
+	return b.Backend.List(ctx, typ, fn)
+}
+func (b *metadataWaitBackend) Load(ctx context.Context, h backend.Handle, n int, off int64, fn func(io.Reader) error) error {
+	if b.active && h.Type == backend.SnapshotFile {
+		b.start.Do(func() { close(b.started) })
+		<-ctx.Done()
+		b.cancel.Do(func() { close(b.canceled) })
+		<-b.release
+		return ctx.Err()
+	}
+	return b.Backend.Load(ctx, h, n, off, fn)
+}
+
+func TestSnapshotMetadataFailedConfirmationJoinsResponseBeforeRelease(t *testing.T) {
+	ctx := context.Background()
+	gate := &metadataWaitBackend{Backend: repository.TestBackend(t), started: make(chan struct{}), canceled: make(chan struct{}), release: make(chan struct{})}
+	r, _ := repository.TestRepositoryWithBackend(t, retry.New(gate, time.Second, nil, nil), 2, repository.Options{})
+	id, err := r.SaveUnpacked(ctx, restic.WriteableSnapshotFile, []byte(`{"time":"2026-01-01T00:00:00Z"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	gate.active = true
+	load := startRepositoryIndexLoadAfterSnapshots(ctx, r, true)
+	p := startSnapshotMetadataLoad(ctx, r, load, id.String())
+	var release sync.Once
+	cleanup := func() { release.Do(func() { close(gate.release) }) }
+	defer cleanup()
+	defer load.discard()
+	defer p.finish()
+	select {
+	case <-gate.started:
+	case <-time.After(5 * time.Second):
+		cleanup()
+		t.Fatal("snapshot read did not start")
+	}
+	settled := make(chan struct{})
+	go func() { load.settle(false); p.settle(false); close(settled) }()
+	select {
+	case <-gate.canceled:
+	case <-time.After(5 * time.Second):
+		cleanup()
+		t.Fatal("snapshot read not canceled")
+	}
+	select {
+	case <-settled:
+		t.Fatal("settlement returned with live response")
+	default:
+	}
+	cleanup()
+	select {
+	case <-settled:
+	case <-time.After(5 * time.Second):
+		t.Fatal("settlement did not join response")
+	}
+	if p.loader != nil {
+		t.Fatal("discarded ciphertext still retained")
+	}
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	if len(gate.lists) == 0 || gate.lists[0] != backend.SnapshotFile || (len(gate.lists) > 1 && gate.lists[1] != backend.IndexFile) {
+		t.Fatalf("listing order=%v", gate.lists)
+	}
+}
+
+func TestSnapshotMetadataCancelWhileListingIsPending(t *testing.T) {
+	r := repository.TestRepository(t)
+	load := &repositoryIndexLoad{snapshots: newPreparedSnapshots()}
+	p := startSnapshotMetadataLoad(context.Background(), r, load, "latest")
+	if p == nil {
+		t.Fatal("expected preparation")
+	}
+	p.settle(false)
+	if p.loader != nil {
+		t.Fatal("retained fallback after failed confirmation")
+	}
+}
diff --git a/cmd/restic/wait_index_load.go b/cmd/restic/wait_index_load.go
new file mode 100644
index 0000000000000000000000000000000000000000..3217e9763e85fb7c07795652f9eade1372c8533e
--- /dev/null
+++ b/cmd/restic/wait_index_load.go
@@ -0,0 +1,237 @@
+package main
+
+import (
+	"context"
+
+	"github.com/restic/restic/internal/checker"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+)
+
+// repositoryIndexLoad prepares the repository index during the lock's
+// required settle delay. Progress and the result are exposed only after the
+// second lock check succeeds.
+type repositoryIndexLoad struct {
+	repo      *repository.Repository
+	cancel    context.CancelFunc
+	result    chan error
+	progress  *delayedTerminalCounterFactory
+	snapshots *preparedSnapshots
+	err       error
+	done      bool
+	used      bool
+}
+
+func startRepositoryIndexLoad(ctx context.Context, repo *repository.Repository) *repositoryIndexLoad {
+	return startRepositoryIndexLoadAfterSnapshots(ctx, repo, false)
+}
+
+// startRepositoryIndexLoadAfterSnapshots lists the snapshot files before the
+// index files when listSnapshots is set, keeping the stock listing order
+// (snapshots, then index) for commands that select snapshots under a
+// non-exclusive lock: every listed snapshot's index is in the loaded index.
+func startRepositoryIndexLoadAfterSnapshots(ctx context.Context, repo *repository.Repository, listSnapshots bool) *repositoryIndexLoad {
+	loadCtx, cancel := context.WithCancel(ctx)
+	load := &repositoryIndexLoad{
+		repo:     repo,
+		cancel:   cancel,
+		result:   make(chan error, 1),
+		progress: &delayedTerminalCounterFactory{},
+	}
+	if listSnapshots {
+		load.snapshots = newPreparedSnapshots()
+	}
+	go func() {
+		load.snapshots.list(loadCtx, repo)
+		load.result <- repo.LoadIndex(loadCtx, load.progress)
+	}()
+	return load
+}
+
+// snapshotLister returns the snapshot list prepared before the index load, or
+// fallback if none was prepared.
+func (load *repositoryIndexLoad) snapshotLister(fallback restic.Lister) restic.Lister {
+	if load == nil {
+		return fallback
+	}
+	return load.snapshots.get(fallback)
+}
+
+// preparedSnapshots holds a snapshot file listing taken before the index
+// listing.
+type preparedSnapshots struct {
+	ready  chan struct{}
+	lister restic.Lister
+	err    error
+}
+
+func newPreparedSnapshots() *preparedSnapshots {
+	return &preparedSnapshots{ready: make(chan struct{})}
+}
+
+func (p *preparedSnapshots) list(ctx context.Context, repo restic.Lister) {
+	if p == nil {
+		return
+	}
+	p.lister, p.err = restic.MemorizeList(ctx, repo, restic.SnapshotFile)
+	close(p.ready)
+}
+
+// get waits for the prepared listing. On a listing error it returns fallback,
+// so the command lists again and reports the error exactly as before.
+func (p *preparedSnapshots) get(fallback restic.Lister) restic.Lister {
+	if p == nil {
+		return fallback
+	}
+	<-p.ready
+	if p.err != nil {
+		return fallback
+	}
+	return p.lister
+}
+
+// snapshotListerRepo serves snapshot listings from a prepared listing and
+// everything else from the repository.
+type snapshotListerRepo struct {
+	restic.ListerLoaderUnpacked
+	snapshots restic.Lister
+}
+
+func (r snapshotListerRepo) List(ctx context.Context, t restic.FileType, fn func(restic.ID, int64) error) error {
+	if t == restic.SnapshotFile {
+		return r.snapshots.List(ctx, t, fn)
+	}
+	return r.ListerLoaderUnpacked.List(ctx, t, fn)
+}
+
+func (load *repositoryIndexLoad) settle(confirmed bool) {
+	if load == nil || load.done {
+		return
+	}
+	if !confirmed {
+		load.discard()
+	}
+}
+
+func (load *repositoryIndexLoad) consume(printer restic.TerminalCounterFactory) error {
+	load.progress.activate(printer)
+	if !load.done {
+		load.err = <-load.result
+		load.done = true
+	}
+	load.cancel()
+	if load.err != nil {
+		load.repo.DiscardIndex()
+	}
+	load.used = true
+	return load.err
+}
+
+// discard releases speculative index state if the command reaches a path
+// that never needs the prepared index (for example, forget removes no
+// snapshots and consequently skips prune).
+func (load *repositoryIndexLoad) discard() {
+	if load == nil {
+		return
+	}
+	if !load.done {
+		load.cancel()
+		<-load.result
+		load.done = true
+	}
+	load.cancel()
+	load.repo.DiscardIndex()
+}
+
+type checkerIndexLoadResult struct {
+	hints []error
+	errs  []error
+	packs *repository.PreparedPackSizes
+}
+
+// checkerIndexLoad prepares check's checker-specific index pass during the
+// settle delay. The snapshot listing (LoadSnapshots) runs first, keeping the
+// stock listing order; its error is reported at the existing command position.
+// Progress remains buffered until the command consumes the prepared result.
+type checkerIndexLoad struct {
+	repo         *repository.Repository
+	checker      *checker.Checker
+	cancel       context.CancelFunc
+	result       chan checkerIndexLoadResult
+	progress     *delayedTerminalCounterFactory
+	snapshotsErr chan error
+	packs        *repository.PreparedPackSizes
+	done         bool
+	used         bool
+}
+
+func startCheckerIndexLoad(ctx context.Context, repo *repository.Repository, trackUnused bool, snapshotFilter *data.SnapshotFilter, args []string) *checkerIndexLoad {
+	loadCtx, cancel := context.WithCancel(ctx)
+	chkr := checker.New(repo, trackUnused)
+	load := &checkerIndexLoad{
+		repo:         repo,
+		checker:      chkr,
+		cancel:       cancel,
+		result:       make(chan checkerIndexLoadResult, 1),
+		progress:     &delayedTerminalCounterFactory{},
+		snapshotsErr: make(chan error, 1),
+	}
+	go func() {
+		err := chkr.LoadSnapshots(loadCtx, snapshotFilter, args)
+		load.snapshotsErr <- err
+		if err != nil {
+			load.result <- checkerIndexLoadResult{}
+			return
+		}
+		hints, errs := chkr.LoadIndex(loadCtx, load.progress)
+		var packs *repository.PreparedPackSizes
+		if len(errs) == 0 && loadCtx.Err() == nil {
+			packs = chkr.PreparePackSizes(loadCtx)
+		}
+		load.result <- checkerIndexLoadResult{hints: hints, errs: errs, packs: packs}
+	}()
+	return load
+}
+
+// loadSnapshots returns the result of the prepared LoadSnapshots call.
+func (load *checkerIndexLoad) loadSnapshots() error {
+	return <-load.snapshotsErr
+}
+
+func (load *checkerIndexLoad) settle(confirmed bool) {
+	if load == nil || load.done {
+		return
+	}
+	if !confirmed {
+		load.discard()
+	}
+}
+
+func (load *checkerIndexLoad) checkerForSnapshots() *checker.Checker {
+	return load.checker
+}
+
+func (load *checkerIndexLoad) consume(printer restic.TerminalCounterFactory) ([]error, []error) {
+	load.progress.activate(printer)
+	value := <-load.result
+	load.packs = value.packs
+	load.done = true
+	load.cancel()
+	load.used = true
+	return value.hints, value.errs
+}
+
+func (load *checkerIndexLoad) discard() {
+	if load == nil {
+		return
+	}
+	if !load.done {
+		load.cancel()
+		<-load.result
+		load.done = true
+	}
+	load.cancel()
+	load.packs = nil
+	load.repo.DiscardIndex()
+}
diff --git a/cmd/restic/wait_index_load_integration_test.go b/cmd/restic/wait_index_load_integration_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..235c6e0e961caf0dac05e9f709c2ea75e9222ad6
--- /dev/null
+++ b/cmd/restic/wait_index_load_integration_test.go
@@ -0,0 +1,384 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/global"
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+	rtest "github.com/restic/restic/internal/test"
+	"github.com/restic/restic/internal/ui"
+)
+
+// waitWorkGateBackend holds the speculative index listing until its caller is
+// canceled. The optional lock-list gate lets a test control the second lock
+// confirmation independently of the index worker.
+type waitWorkGateBackend struct {
+	backend.Backend
+
+	indexStarted  chan struct{}
+	indexCanceled chan struct{}
+	releaseIndex  chan struct{}
+	indexStart    sync.Once
+	indexCancel   sync.Once
+	releaseOnce   sync.Once
+
+	competitorLock string
+	lockLists      int
+	lockMu         sync.Mutex
+	secondLockList chan struct{}
+	continueLock   chan struct{}
+	lockStart      sync.Once
+	continueOnce   sync.Once
+}
+
+func newWaitWorkGateBackend(be backend.Backend) *waitWorkGateBackend {
+	return &waitWorkGateBackend{
+		Backend:        be,
+		indexStarted:   make(chan struct{}),
+		indexCanceled:  make(chan struct{}),
+		releaseIndex:   make(chan struct{}),
+		secondLockList: make(chan struct{}),
+		continueLock:   make(chan struct{}),
+	}
+}
+
+func (be *waitWorkGateBackend) List(ctx context.Context, t backend.FileType, fn func(backend.FileInfo) error) error {
+	if t == backend.IndexFile {
+		be.indexStart.Do(func() { close(be.indexStarted) })
+		<-ctx.Done()
+		be.indexCancel.Do(func() { close(be.indexCanceled) })
+		<-be.releaseIndex
+		return ctx.Err()
+	}
+
+	if t == backend.LockFile {
+		be.lockMu.Lock()
+		be.lockLists++
+		lockList := be.lockLists
+		be.lockMu.Unlock()
+
+		if lockList == 1 && be.competitorLock != "" {
+			// Model a lock that becomes visible between the initial check and
+			// confirmation while retaining a real, valid encrypted lock file.
+			return be.Backend.List(ctx, t, func(fi backend.FileInfo) error {
+				if fi.Name == be.competitorLock {
+					return nil
+				}
+				return fn(fi)
+			})
+		}
+
+		if lockList == 2 {
+			be.lockStart.Do(func() { close(be.secondLockList) })
+			select {
+			case <-be.continueLock:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		}
+	}
+
+	return be.Backend.List(ctx, t, fn)
+}
+
+func (be *waitWorkGateBackend) releaseHeldIndex() {
+	be.releaseOnce.Do(func() { close(be.releaseIndex) })
+}
+
+func (be *waitWorkGateBackend) continueConfirmation() {
+	be.continueOnce.Do(func() { close(be.continueLock) })
+}
+
+func (be *waitWorkGateBackend) unblock() {
+	be.continueConfirmation()
+	be.releaseHeldIndex()
+}
+
+func TestRestoreFailedLockConfirmationDrainsPreparedIndexBeforeUnlock(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+	testSetupBackupData(t, env)
+	testRunBackup(t, "", []string{env.testdata}, BackupOptions{}, env.gopts)
+	snapshotIDs := testListSnapshots(t, env.gopts, 1)
+	// testRunInit adds a junk lock filename for listing tests. This test counts
+	// the two real lock owners, so remove that unrelated fixture entry.
+	if err := os.Remove(filepath.Join(env.repo, "locks", "tmp12345")); err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	before := hashRepositoryFiles(t, env.repo)
+
+	repository.TestSetLockTimeout(t, 50*time.Millisecond)
+	defer repository.TestSetLockTimeout(t, 0)
+
+	// Hold a valid exclusive lock through an independent repository handle.
+	// The test backend hides it from the first check, then exposes it to the
+	// second check after the candidate has created its own lock and started
+	// speculative index loading.
+	competitorOptions := env.gopts
+	competitorOptions.BackendTestHook = nil
+	competitorOptions.NoCache = true
+	// OpenRepository is normally called through withTermStatus. The independent
+	// competitor also needs a terminal even with a supplied password.
+	competitorOptions.Term = &ui.MockTerminal{}
+	competitorRepo, err := global.OpenRepository(context.Background(), competitorOptions, restic.NewNoopPrinter())
+	rtest.OK(t, err)
+	unlockCompetitor, _, err := repository.LockRepo(context.Background(), competitorRepo, true, 0, func(string) {}, func(string, ...any) {})
+	rtest.OK(t, err)
+	defer func() {
+		unlockCompetitor()
+		rtest.OK(t, competitorRepo.Close())
+	}()
+	var competitorID restic.ID
+	err = competitorRepo.List(context.Background(), restic.LockFile, func(id restic.ID, _ int64) error {
+		competitorID = id
+		return nil
+	})
+	rtest.OK(t, err)
+	rtest.Assert(t, !competitorID.IsNull(), "expected the competing lock to be present")
+
+	gate := newWaitWorkGateBackend(nil)
+	gate.competitorLock = competitorID.String()
+	env.gopts.BackendTestHook = func(be backend.Backend) (backend.Backend, error) {
+		gate.Backend = be
+		return gate, nil
+	}
+	defer gate.unblock()
+
+	target := filepath.Join(env.base, "restore-competing-lock")
+	stdout, stderr, err := withCaptureStdoutStderr(t, env.gopts, func(ctx context.Context, gopts global.Options) error {
+		runCtx, cancelCommand := context.WithCancel(ctx)
+		defer cancelCommand()
+		commandDone := make(chan error, 1)
+		go func() {
+			commandDone <- runRestore(runCtx, RestoreOptions{Target: target}, gopts, gopts.Term, []string{snapshotIDs[0].String()})
+		}()
+		fail := func(err error) error {
+			cancelCommand()
+			gate.unblock()
+			select {
+			case <-commandDone:
+			case <-time.After(5 * time.Second):
+			}
+			return err
+		}
+
+		select {
+		case <-gate.indexStarted:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		select {
+		case <-gate.secondLockList:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+
+		gate.continueConfirmation()
+		select {
+		case <-gate.indexCanceled:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		select {
+		case commandErr := <-commandDone:
+			return commandErr
+		default:
+		}
+
+		locks, readErr := os.ReadDir(filepath.Join(env.repo, "locks"))
+		if readErr != nil {
+			return readErr
+		}
+		if len(locks) != 2 {
+			return fmt.Errorf("lock files during index drain = %d, want candidate and competitor locks", len(locks))
+		}
+		if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+			return fmt.Errorf("restore target changed before lock confirmation: stat error = %v", statErr)
+		}
+
+		gate.releaseHeldIndex()
+		return <-commandDone
+	})
+	if !repository.IsAlreadyLocked(err) {
+		t.Fatalf("restore error = %v, want competing-lock error", err)
+	}
+	if strings.Contains(stdout.String()+stderr.String(), "index files loaded") || strings.Contains(stdout.String()+stderr.String(), "restoring ") {
+		t.Fatalf("unconfirmed restore exposed progress or started restore output: stdout=%q stderr=%q", stdout.String(), stderr.String())
+	}
+	if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+		t.Fatalf("restore target after failed confirmation: stat error = %v, want not-exist", statErr)
+	}
+	locks, err := os.ReadDir(filepath.Join(env.repo, "locks"))
+	rtest.OK(t, err)
+	if len(locks) != 1 || locks[0].Name() != competitorID.String() {
+		t.Fatalf("locks after failed confirmation = %v, want only competitor %s", lockNames(locks), competitorID)
+	}
+	if got := hashRepositoryFiles(t, env.repo); !sameRepositoryFiles(before, got) {
+		t.Fatal("repository objects changed during failed lock confirmation")
+	}
+}
+
+func TestRestoreSnapshotLookupErrorDrainsPreparedIndexBeforeUnlock(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+	testSetupBackupData(t, env)
+	testRunBackup(t, "", []string{env.testdata}, BackupOptions{}, env.gopts)
+	if err := os.Remove(filepath.Join(env.repo, "locks", "tmp12345")); err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	before := hashRepositoryFiles(t, env.repo)
+
+	repository.TestSetLockTimeout(t, 50*time.Millisecond)
+	defer repository.TestSetLockTimeout(t, 0)
+	gate := newWaitWorkGateBackend(nil)
+	// This case gates index retirement, not successful lock confirmation.
+	gate.continueConfirmation()
+	env.gopts.BackendTestHook = func(be backend.Backend) (backend.Backend, error) {
+		gate.Backend = be
+		return gate, nil
+	}
+	defer gate.unblock()
+
+	target := filepath.Join(env.base, "restore-missing-snapshot")
+	stdout, stderr, err := withCaptureStdoutStderr(t, env.gopts, func(ctx context.Context, gopts global.Options) error {
+		runCtx, cancelCommand := context.WithCancel(ctx)
+		defer cancelCommand()
+		commandDone := make(chan error, 1)
+		go func() {
+			commandDone <- runRestore(runCtx, RestoreOptions{Target: target}, gopts, gopts.Term, []string{strings.Repeat("f", 64)})
+		}()
+		fail := func(err error) error {
+			cancelCommand()
+			gate.unblock()
+			select {
+			case <-commandDone:
+			case <-time.After(5 * time.Second):
+			}
+			return err
+		}
+
+		select {
+		case <-gate.indexStarted:
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		select {
+		case <-gate.indexCanceled:
+		case <-commandDone:
+			gate.releaseHeldIndex()
+			return errors.New("restore returned before its prepared index observed cancellation")
+		case <-time.After(5 * time.Second):
+			return fail(context.DeadlineExceeded)
+		}
+		select {
+		case commandErr := <-commandDone:
+			return commandErr
+		default:
+		}
+
+		locks, readErr := os.ReadDir(filepath.Join(env.repo, "locks"))
+		if readErr != nil {
+			return readErr
+		}
+		if len(locks) != 1 {
+			return fmt.Errorf("lock files during index drain = %d, want the command lock", len(locks))
+		}
+		if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+			return fmt.Errorf("restore target changed before snapshot lookup succeeded: stat error = %v", statErr)
+		}
+
+		gate.releaseHeldIndex()
+		return <-commandDone
+	})
+	if err == nil || repository.IsAlreadyLocked(err) || !strings.Contains(err.Error(), "failed to find snapshot") {
+		t.Fatalf("restore error = %v, want missing-snapshot lookup error", err)
+	}
+	if strings.Contains(stdout.String()+stderr.String(), "index files loaded") || strings.Contains(stdout.String()+stderr.String(), "restoring ") {
+		t.Fatalf("failed restore exposed prepared-index progress: stdout=%q stderr=%q", stdout.String(), stderr.String())
+	}
+	if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+		t.Fatalf("restore target after missing snapshot: stat error = %v, want not-exist", statErr)
+	}
+	locks, err := os.ReadDir(filepath.Join(env.repo, "locks"))
+	rtest.OK(t, err)
+	if len(locks) != 0 {
+		t.Fatalf("locks after missing-snapshot failure = %v, want none", lockNames(locks))
+	}
+	if got := hashRepositoryFiles(t, env.repo); !sameRepositoryFiles(before, got) {
+		t.Fatal("repository objects changed while the missing-snapshot path discarded prepared index state")
+	}
+}
+
+func hashRepositoryFiles(t *testing.T, root string) map[string][sha256.Size]byte {
+	t.Helper()
+	files := make(map[string][sha256.Size]byte)
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if rel == "locks" || strings.HasPrefix(rel, "locks"+string(filepath.Separator)) {
+			if entry.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		file, err := os.Open(path)
+		if err != nil {
+			return err
+		}
+		h := sha256.New()
+		_, copyErr := io.Copy(h, file)
+		closeErr := file.Close()
+		if copyErr != nil {
+			return copyErr
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		var sum [sha256.Size]byte
+		copy(sum[:], h.Sum(nil))
+		files[rel] = sum
+		return nil
+	})
+	rtest.OK(t, err)
+	return files
+}
+
+func sameRepositoryFiles(a, b map[string][sha256.Size]byte) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for path, sum := range a {
+		if b[path] != sum {
+			return false
+		}
+	}
+	return true
+}
+
+func lockNames(entries []os.DirEntry) []string {
+	names := make([]string, len(entries))
+	for i, entry := range entries {
+		names[i] = entry.Name()
+	}
+	return names
+}
