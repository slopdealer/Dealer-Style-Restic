+
+func (u *countingBlobUploader) SaveBlobAsync(ctx context.Context, tpe restic.BlobType, buf []byte, id restic.ID, storeDuplicate bool, cb func(restic.ID, bool, int, error)) {
+	u.mu.Lock()
+	u.asyncSaves++
