+	<-term.closed
+	rtest.Equals(t, []string{"one\n", "two\n"}, w.calls)
+	rtest.Equals(t, "ot", string(w.data))
+}
+
+type shortOutputWriter struct {
+	calls []string
+	data  []byte
+}
+
+func (w *shortOutputWriter) Write(p []byte) (int, error) {
+	w.calls = append(w.calls, string(p))
+	if len(p) == 0 {
+		return 0, nil
