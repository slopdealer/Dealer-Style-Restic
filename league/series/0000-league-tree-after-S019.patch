+func TestRestoreSettledAssociationRetiresWhenDiagnosticStopsLoad(t *testing.T) {
+	ctx := context.Background()
+	h := restic.BlobHandle{Type: restic.DataBlob, ID: restic.Hash([]byte("bad"))}
+	f := &fileInfo{location: "damaged", size: 3}
+	blobs := blobToFileOffsetsMapping{h.ID: {files: map[*fileInfo][]int64{f: {0}}, blob: h}}
+	corruption := errors.New("authentication failed")
+	stop := errors.New("diagnostic requests stop")
+	processed := restic.NewBlobSet()
+	loader := func(_ context.Context, _ restic.ID, _ []restic.BlobHandle, cb func(restic.BlobHandle, []byte, error) error) error {
+		return cb(h, nil, corruption)
+	}
+	r := newFileRestorer(t.TempDir(), loader, nil, 2, false, false, nil, nil, restic.ID{})
+	defer r.filesWriter.flush()
+	reports := 0
+	r.Error = func(path string, err error) error {
+		reports++
+		if path != f.location || !errors.Is(err, corruption) {
+			t.Fatalf("diagnostic changed: %s %v", path, err)
+		}
+		return stop
+	}
+	err := r.downloadBlobs(ctx, restic.ID{}, blobs, processed)
+	if !errors.Is(err, stop) || len(blobs) != 0 || !processed.Has(h) {
+		t.Fatalf("failed diagnostic settlement: err=%v live=%d processed=%v", err, len(blobs), processed.Has(h))
+	}
+	if err := r.reportError(blobs, processed, err); err != nil || reports != 1 {
+		t.Fatalf("callback diagnostic repeated: err=%v reports=%d", err, reports)
+	}
+}
+
+// Refusing the first diagnostic aborts the load. Retirement must not discard
+// the independent mapping that has not received a callback yet.
+func TestRestoreSettledAssociationDiagnosticRefusal(t *testing.T) {
+	first := restic.BlobHandle{Type: restic.DataBlob, ID: restic.Hash([]byte("first"))}
+	last := restic.BlobHandle{Type: restic.DataBlob, ID: restic.Hash([]byte("last"))}
+	f1 := &fileInfo{location: "first", size: 5}
+	f2 := &fileInfo{location: "last", size: 4}
+	blobs := blobToFileOffsetsMapping{
+		first.ID: {files: map[*fileInfo][]int64{f1: {0}}, blob: first},
+		last.ID:  {files: map[*fileInfo][]int64{f2: {0}}, blob: last},
+	}
+	corruption := errors.New("damaged blob")
+	refusal := errors.New("diagnostic refused")
+	calls := 0
+	loader := func(_ context.Context, _ restic.ID, _ []restic.BlobHandle, cb func(restic.BlobHandle, []byte, error) error) error {
+		return cb(first, nil, corruption)
+	}
+	r := newFileRestorer(t.TempDir(), loader, nil, 2, false, false, nil, nil, restic.ID{})
+	defer r.filesWriter.flush()
+	r.Error = func(path string, err error) error {
+		calls++
+		if path != "first" || !errors.Is(err, corruption) {
+			t.Fatalf("diagnostic lost: %s %v", path, err)
+		}
+		return refusal
+	}
+	processed := restic.NewBlobSet()
+	if err := r.downloadBlobs(context.Background(), restic.ID{}, blobs, processed); !errors.Is(err, refusal) {
+		t.Fatalf("callback refusal lost: %v", err)
+	}
+	if calls != 1 || !processed.Has(first) || processed.Has(last) {
+		t.Fatal("callback settlement duplicated or lost")
+	}
+	if _, live := blobs[first.ID]; live {
+		t.Fatal("refused callback retains association")
+	}
+	if _, live := blobs[last.ID]; !live {
+		t.Fatal("unfinished diagnostic owner retired")
+	}
+}
diff --git a/internal/restorer/tree_carry.go b/internal/restorer/tree_carry.go
new file mode 100644
index 0000000000000000000000000000000000000000..4eb28146351bbb3a259d67a65be4282bcebc225f
--- /dev/null
+++ b/internal/restorer/tree_carry.go
@@ -0,0 +1,137 @@
+package restorer
+
+import (
+	"context"
+	"time"
+	"unsafe"
+
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+// This budget is cumulative: handing a node to an iterator or metadata task
+// does not return credit. It bounds admitted estimates, not decoder scratch,
+// a single oversized node, or RSS. No traversal ever waits for carry space.
+const maxRestoreTreeCarryBytes = 512 << 10
+const restoreTreeCarryRecordBytes = 256
+
+type restoreTreeCarry struct {
+	records map[int]preparedRestoreTree
+	next    int
+	charged uint64
+}
+
+func newRestoreTreeCarry() *restoreTreeCarry {
+	return &restoreTreeCarry{records: make(map[int]preparedRestoreTree)}
+}
+
+// Wrap is called only by the first ordered traversal. Occurrences, including
+// failed loads, align with the existing preorder ID list; repeated IDs are
+// intentionally independent. The first-pass visitor reads decoded nodes but
+// does not mutate them. Only complete, successful interpretations are reusable.
+func (c *restoreTreeCarry) Wrap(load restoreTreeLoader) restoreTreeLoader {
+	return func(ctx context.Context, id restic.ID) (data.TreeNodeIterator, error) {
+		occurrence := c.next
+		c.next++
+		tree, err := load(ctx, id)
+		if err != nil {
+			return nil, err
+		}
+		if c.charged > maxRestoreTreeCarryBytes-restoreTreeCarryRecordBytes {
+			return tree, nil
+		}
+		c.charged += restoreTreeCarryRecordBytes
+		return func(yield func(data.NodeOrError) bool) {
+			var nodes []*data.Node
+			var bytes uint64
+			eligible := true
+			defer func() { clear(nodes) }()
+			for item := range tree {
+				if item.Error != nil || ctx.Err() != nil {
+					eligible = false
+					clear(nodes)
+					nodes = nil
+				}
+				if eligible {
+					n := estimateCarriedNodeBytes(item.Node)
+					nextCapacity := cap(nodes)
+					if len(nodes) == nextCapacity {
+						nextCapacity = max(1, 2*nextCapacity)
+						// The node estimate includes one pointer. Charge the new
+						// unused slots as well, before allocating their storage.
+						n += uint64(nextCapacity-cap(nodes)-1) * uint64(unsafe.Sizeof(item.Node))
+					}
+					if n > maxPreparedTreeBytes-bytes || n > maxRestoreTreeCarryBytes-c.charged {
+						eligible = false
+						clear(nodes)
+						nodes = nil
+					} else {
+						bytes += n
+						c.charged += n
+						if nextCapacity != cap(nodes) {
+							grown := make([]*data.Node, len(nodes), nextCapacity)
+							copy(grown, nodes)
+							clear(nodes)
+							nodes = grown
+						}
+						nodes = append(nodes, item.Node)
+					}
+				}
+				// An early visitor stop must not publish a successful prefix.
+				if !yield(item) {
+					return
+				}
+			}
+			if eligible && ctx.Err() == nil {
+				c.records[occurrence] = preparedRestoreTree{id: id, nodes: nodes}
+				nodes = nil // ownership transferred to the shelf
+			}
+		}, nil
+	}
+}
+
+// Only the second-pass prefetch producer calls take, after the first pass has
+// joined its decoder. Delete transfers ownership without replenishing credit.
+func (c *restoreTreeCarry) take(occurrence int, id restic.ID) (preparedRestoreTree, bool) {
+	if c == nil {
+		return preparedRestoreTree{}, false
+	}
+	tree, ok := c.records[occurrence]
+	delete(c.records, occurrence)
+	if !ok {
+		return preparedRestoreTree{}, false
+	}
+	if !tree.id.Equal(id) {
+		clear(tree.nodes)
+		return preparedRestoreTree{}, false
+	}
+	return tree, true
+}
+
+// Call after the prefetch producer has joined; it may otherwise be taking a
+// record. Unused occurrences are released on every restore exit.
+func (c *restoreTreeCarry) Close() {
+	for occurrence, tree := range c.records {
+		clear(tree.nodes)
+		delete(c.records, occurrence)
+	}
+	c.records = nil
+}
+
+func estimateCarriedNodeBytes(node *data.Node) uint64 {
+	size := estimatePreparedNodeBytes(node)
+	// Non-hour offsets can allocate a location per timestamp. Charge even
+	// shared fixed zones rather than borrowing a global-cache assumption.
+	for _, tm := range [...]time.Time{node.ModTime, node.AccessTime, node.ChangeTime} {
+		if loc := tm.Location(); loc != time.UTC && loc != time.Local {
+			size += 256
+		}
+	}
+	// Duplicate JSON fields can shorten a reused xattr slice without clearing
+	// its backing tail. Those invisible attributes still retain their values.
+	attrs := node.ExtendedAttributes
+	for _, attr := range attrs[len(attrs):cap(attrs)] {
+		size += uint64(len(attr.Name))*2 + uint64(cap(attr.Value))*2
+	}
+	return size
+}
diff --git a/internal/restorer/tree_prefetch.go b/internal/restorer/tree_prefetch.go
new file mode 100644
index 0000000000000000000000000000000000000000..0c2a71401a8ddf12dc3bf646a11f3aac1c5f3744
--- /dev/null
+++ b/internal/restorer/tree_prefetch.go
@@ -0,0 +1,210 @@
+package restorer
+
+import (
+	"context"
+	"unsafe"
+
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Keep only a small amount of decoded tree state while file contents are
+// restored. Oversized trees are loaded normally in the second traversal.
+const maxPreparedTreeBytes = 256 << 10
+
+type restoreTreeLoader func(context.Context, restic.ID) (data.TreeNodeIterator, error)
+
+type preparedRestoreTree struct {
+	id          restic.ID
+	nodes       []*data.Node
+	iteratorErr error
+	loadErr     error
+	tooLarge    bool
+}
+
+type restoreTreePrefetch struct {
+	cancel context.CancelFunc
+	done   chan struct{}
+	queue  chan preparedRestoreTree
+	load   restoreTreeLoader
+
+	// Only the restore traversal goroutine calls Load, so this does not need
+	// synchronization.
+	fallback bool
+}
+
+func newRestoreTreePrefetch(ctx context.Context, ids []restic.ID, load restoreTreeLoader) *restoreTreePrefetch {
+	return newRestoreTreePrefetchWithCarry(ctx, ids, load, nil)
+}
+
+func newRestoreTreePrefetchWithCarry(ctx context.Context, ids []restic.ID, load restoreTreeLoader, carry *restoreTreeCarry) *restoreTreePrefetch {
+	prefetchCtx, cancel := context.WithCancel(ctx)
+	p := &restoreTreePrefetch{
+		cancel: cancel,
+		done:   make(chan struct{}),
+		queue:  make(chan preparedRestoreTree, 1),
+		load:   load,
+	}
+
+	go func() {
+		defer close(p.done)
+		defer close(p.queue)
+
+		for occurrence, id := range ids {
+			prepared, carried := carry.take(occurrence, id)
+			terminal := false
+			if !carried {
+				prepared, terminal = p.prepare(prefetchCtx, id)
+			}
+			select {
+			case p.queue <- prepared:
+			case <-prefetchCtx.Done():
+				clear(prepared.nodes)
+				return
+			}
+			if terminal {
+				return
+			}
+		}
+	}()
+
+	return p
+}
+
+func (p *restoreTreePrefetch) prepare(ctx context.Context, id restic.ID) (preparedRestoreTree, bool) {
+	prepared := preparedRestoreTree{id: id}
+	tree, err := p.load(ctx, id)
+	if err != nil {
+		prepared.loadErr = err
+		return prepared, true
+	}
+
+	var retainedBytes uint64
+	for item := range tree {
+		if item.Error != nil {
+			prepared.iteratorErr = item.Error
+			return prepared, true
+		}
+
+		nodeBytes := estimatePreparedNodeBytes(item.Node)
+		if nodeBytes > maxPreparedTreeBytes-retainedBytes {
+			// Do not keep a partial tree. Re-read it through the regular
+			// iterator when the ordered traversal reaches this ID.
+			prepared.nodes = nil
+			prepared.tooLarge = true
+			return prepared, false
+		}
+
+		retainedBytes += nodeBytes
+		prepared.nodes = append(prepared.nodes, item.Node)
+	}
+
+	return prepared, false
+}
+
+func estimatePreparedNodeBytes(node *data.Node) uint64 {
+	// Account for the Node and its pointer in the slice, then estimate the
+	// backing storage decoded from strings, slices, and maps. Doubling the
+	// variable byte fields allows for decoder allocation capacity slack.
+	size := uint64(unsafe.Sizeof(*node) + unsafe.Sizeof(node) + 64)
+	addString := func(value string) {
+		size += uint64(len(value)) * 2
+	}
+	addString(node.Name)
+	size += uint64(len(node.Type)) * 2
+	addString(node.User)
+	addString(node.Group)
+	addString(node.LinkTarget)
+	addString(node.Error)
+	size += uint64(cap(node.LinkTargetRaw)) * 2
+	size += uint64(cap(node.Content)) * uint64(unsafe.Sizeof(restic.ID{}))
+	if node.Subtree != nil {
+		size += uint64(unsafe.Sizeof(*node.Subtree))
+	}
+	size += uint64(cap(node.ExtendedAttributes)) * uint64(unsafe.Sizeof(data.ExtendedAttribute{}))
+	for _, attr := range node.ExtendedAttributes {
+		addString(attr.Name)
+		size += uint64(cap(attr.Value)) * 2
+	}
+	if node.GenericAttributes != nil {
+		size += uint64(len(node.GenericAttributes)) * 128
+		for name, value := range node.GenericAttributes {
+			size += uint64(len(name)) * 2
+			size += uint64(cap(value)) * 2
+		}
+	}
+	return size
+}
+
+func (p *restoreTreePrefetch) Load(ctx context.Context, id restic.ID) (data.TreeNodeIterator, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if p.fallback {
+		return p.load(ctx, id)
+	}
+
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case prepared, ok := <-p.queue:
+		if err := ctx.Err(); err != nil {
+			clear(prepared.nodes)
+			return nil, err
+		}
+		if !ok {
+			p.fallback = true
+			return p.load(ctx, id)
+		}
+		if !prepared.id.Equal(id) {
+			clear(prepared.nodes)
+			// A caller-supplied selection filter can change its answer between
+			// traversals. Abandon the prefetched sequence and preserve the
+			// ordinary loader's behavior from this point on.
+			p.fallback = true
+			p.cancel()
+			return p.load(ctx, id)
+		}
+		if prepared.loadErr != nil {
+			return nil, prepared.loadErr
+		}
+		if prepared.tooLarge {
+			return p.load(ctx, id)
+		}
+		return preparedTreeIterator(prepared.nodes, prepared.iteratorErr), nil
+	}
+}
+
+func preparedTreeIterator(nodes []*data.Node, iteratorErr error) data.TreeNodeIterator {
+	started := false
+	return func(yield func(data.NodeOrError) bool) {
+		if started {
+			panic("tree iterator is single use only")
+		}
+		started = true
+		defer func() {
+			clear(nodes)
+			nodes = nil
+		}()
+		for i, node := range nodes {
+			// The visitor owns this node now. In particular, directory descent
+			// must not retain completed siblings through the ancestor slice.
+			nodes[i] = nil
+			if !yield(data.NodeOrError{Node: node}) {
+				return
+			}
+		}
+		if iteratorErr != nil {
+			yield(data.NodeOrError{Error: iteratorErr})
+		}
+	}
+}
+
+func (p *restoreTreePrefetch) Close() {
+	p.cancel()
+	<-p.done
+	// Joining the sole producer makes draining safe, including repeated Close.
+	for prepared := range p.queue {
+		clear(prepared.nodes)
+	}
+}
