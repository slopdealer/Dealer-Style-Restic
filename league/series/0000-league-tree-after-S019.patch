+	}
+	for _, bad := range []string{"", `null`, `[]`, `{}`, `{"nodes":null}`, `{"nodes":{}}`, `{"nodes":[}`, `{"nodes":[` + good + `,{"name":"b",]}`, `{"nodes":[` + good + `,`, `{"nodes":[` + good + `]`, `{"nodes":[` + good + `],"after":}`, `{"nodes":[` + good + `],"after":[]`, `{"nodes":[` + good + `],"nodes":[false]}`, `{"nodes":[` + good + `]} true`} {
