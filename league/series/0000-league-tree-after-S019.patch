+
+// Mutating a borrowed blob must not overwrite the next blob or the pack tail.
+// Large reads allocate once at the validated hint, small reads allocate nothing.
+func TestOrdinaryCipherReaderOwnership(t *testing.T) {
+	data := bytes.Repeat([]byte("abcdefg"), 100)
+	r := newBufReader(bufio.NewReaderSize(bytes.NewReader(data), 64))
+	r.ordinary = true
+	r.reserve = 200
+	pos := 0
+	var allocation *byte
+	for _, n := range []int{16, 48, 80, 170, 30, 200, 0} {
+		got, err := r.ReadFull(n)
+		if err != nil || !bytes.Equal(got, data[pos:pos+n]) {
+			t.Fatalf("read %d at %d: %v", n, pos, err)
+		}
+		if n > r.rd.Size() {
+			if cap(r.buf) != 200 || (allocation != nil && allocation != &r.buf[0]) {
+				t.Fatal("ciphertext grew through multiple allocations")
+			}
+			allocation = &r.buf[0]
+		} else if pos == 0 && r.buf != nil {
+			t.Fatal("borrowed read allocated ciphertext")
+		}
+		clear(got)
+		pos += n
+	}
+	if !bytes.Equal(data, bytes.Repeat([]byte("abcdefg"), 100)) {
+		t.Fatal("reader modified backend-owned bytes")
+	}
+	var rest bytes.Buffer
+	if _, err := io.Copy(&rest, r.rd); err != nil || !bytes.Equal(rest.Bytes(), data[pos:]) {
+		t.Fatalf("tail damaged: %v", err)
+	}
+}
+
+func TestOrdinaryCipherReaderShortReads(t *testing.T) {
+	for _, size := range []int{0, 1, 15, 16, 17, 63, 64, 65, 100} {
+		for _, n := range []int{0, 1, 16, 32, 64, 80, 128} {
+			data := bytes.Repeat([]byte{1}, size)
+			baseline := bufio.NewReaderSize(bytes.NewReader(data), 64)
+			want := make([]byte, n)
+			_, wantErr := io.ReadFull(baseline, want)
+			r := newBufReader(bufio.NewReaderSize(bytes.NewReader(data), 64))
+			r.ordinary = true
+			got, gotErr := r.ReadFull(n)
+			if gotErr != wantErr || (gotErr == nil && !bytes.Equal(got, want)) {
+				t.Fatalf("size=%d n=%d got=%v want=%v", size, n, gotErr, wantErr)
+			}
+			gotTail, _ := io.ReadAll(r.rd)
+			wantTail, _ := io.ReadAll(baseline)
+			if !bytes.Equal(gotTail, wantTail) {
+				t.Fatalf("size=%d n=%d consumed different prefix", size, n)
+			}
+		}
+	}
+	if ordinaryCheckCipherReserve(pack.Blobs{{Length: 17 << 20}}, 18<<20) != 0 || ordinaryCheckCipherReserve(pack.Blobs{{Length: 100}}, 99) != 0 {
+		t.Fatal("invalid hint allowed speculative allocation")
+	}
+}
+
+type ordinaryCipherInterruptedReader struct {
+	data []byte
+	step int
+	err  error
+}
+
+func (r *ordinaryCipherInterruptedReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, r.err
+	}
+	n := min(len(p), len(r.data), r.step)
+	copy(p, r.data[:n])
+	r.data = r.data[n:]
+	return n, nil
+}
+
+func TestOrdinaryCipherReaderInterruptedInput(t *testing.T) {
+	failure := errors.New("interrupted backend callback")
+	for _, step := range []int{1, 7, 31, 64, 100} {
+		for _, length := range []int{0, 17, 63, 100} {
+			for _, n := range []int{16, 64, 80, 128} {
+				data := bytes.Repeat([]byte{9}, length)
+				baseline := bufio.NewReaderSize(&ordinaryCipherInterruptedReader{data: data, step: step, err: failure}, 64)
+				r := newBufReader(bufio.NewReaderSize(&ordinaryCipherInterruptedReader{data: data, step: step, err: failure}, 64))
+				r.ordinary = true
+				want := make([]byte, n)
+				_, wantErr := io.ReadFull(baseline, want)
+				got, gotErr := r.ReadFull(n)
+				if wantErr != gotErr || (gotErr == nil && !bytes.Equal(got, want)) {
+					t.Fatalf("step=%d length=%d n=%d errors %v / %v", step, length, n, gotErr, wantErr)
+				}
+			}
+		}
+	}
+}
+
+// Compare complete error text and attempts with the old checker, using the
+// same reusable decoder across borrowed, large, corrupt and canceled packs.
+func TestOrdinaryCipherCheckerFailureSettlement(t *testing.T) {
+	key := crypto.NewRandomKey()
+	for _, concurrency := range []int{1, 4} {
+		dec, err := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+		if err != nil {
+			t.Fatal(err)
+		}
+		rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+		for _, n := range []int{128 << 10, 1100 << 10, 3 << 20} {
+			for _, tc := range []struct{ kind, mode string }{
+				{"compressed", ""}, {"ordinary", ""}, {"compressed-corrupt", ""},
+				{"compressed", "backend-retry"}, {"compressed", "partial-good"},
+				{"compressed", "partial-different"}, {"compressed", "partial"},
+				{"compressed", "total"}, {"compressed", "pack-hash"},
+				{"auth", ""}, {"wrong-hash", ""}, {"compressed", "cancel"},
+				{"compressed", ""},
+			} {
+				data, plan, id := b11MakePack(key, n, tc.kind)
+				run := func(old bool) (string, int) {
+					ctx, cancel := context.WithCancel(context.Background())
+					defer cancel()
+					be := &b11ScriptBackend{data: data, mode: tc.mode, cancel: cancel}
+					repo := b11Repository(key, be, id, plan)
+					var e error
+					if old {
+						oldDec, e2 := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+						if e2 != nil {
+							t.Fatal(e2)
+						}
+						e = b11BaselineCheckPack(ctx, repo, id, append(pack.Blobs(nil), plan...), int64(len(data)), bufio.NewReaderSize(nil, maxStreamBufferSize), oldDec)
+						oldDec.Close()
+					} else {
+						e = checkPack(ctx, repo, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+					}
+					if e == nil {
+						return "", be.calls
+					}
+					return fmt.Sprintf("%T:%v", e, e), be.calls
+				}
+				want, wantCalls := run(true)
+				got, gotCalls := run(false)
+				if want != got || wantCalls != gotCalls {
+					t.Fatalf("n=%d %+v errors=%q/%q attempts=%d/%d", n, tc, got, want, gotCalls, wantCalls)
+				}
+			}
+		}
+		dec.Close()
+	}
+}
+
+// A borrowed compressed input is followed by a large ciphertext allocation and
+// another borrowed input in the same backend callback. Corruption in the first
+// blob must remain local while later blobs and the complete pack hash are checked.
+func TestOrdinaryCipherMixedPackSettlement(t *testing.T) {
+	key := crypto.NewRandomKey()
+	for _, corrupt := range []bool{false, true} {
+		var out bytes.Buffer
+		p := pack.NewPacker(key, &out)
+		enc, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1))
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i, n := range []int{128 << 10, 2 << 20, 256 << 10, 4 << 20, 64 << 10} {
+			plain := make([]byte, n)
+			_, _ = rand.New(rand.NewSource(int64(700 + i))).Read(plain)
+			payload, uncompressed := plain, 0
+			if i%2 == 0 {
+				payload, uncompressed = enc.EncodeAll(plain, nil), n
+				if corrupt && i == 0 {
+					payload = []byte("invalid zstd frame")
+				}
+			}
+			nonce := crypto.NewRandomNonce()
+			cipher := key.Seal(append([]byte(nil), nonce...), nonce, payload, nil)
+			if _, err := p.Add(restic.DataBlob, restic.Hash(plain), cipher, uncompressed); err != nil {
+				t.Fatal(err)
+			}
+		}
+		enc.Close()
+		if err := p.Finalize(); err != nil {
+			t.Fatal(err)
+		}
+		data := out.Bytes()
+		blobs, _, err := pack.List(key, bytes.NewReader(data), int64(len(data)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		id := restic.Hash(data)
+		for _, concurrency := range []int{1, 4} {
+			results := [2]string{}
+			calls := [2]int{}
+			for side := range 2 {
+				be := &b11ScriptBackend{data: data}
+				r := b11Repository(key, be, id, blobs)
+				dec, e := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+				if e != nil {
+					t.Fatal(e)
+				}
+				rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+				if side == 0 {
+					e = b11BaselineCheckPack(context.Background(), r, id, append(pack.Blobs(nil), blobs...), int64(len(data)), rd, dec)
+				} else {
+					e = checkPack(context.Background(), r, id, append(pack.Blobs(nil), blobs...), int64(len(data)), rd, dec)
+				}
+				dec.Close()
+				if e != nil {
+					results[side] = fmt.Sprintf("%T:%v", e, e)
+				}
+				calls[side] = be.calls
+			}
+			if results[0] != results[1] || calls[0] != calls[1] || (!corrupt && results[1] != "") || (corrupt && results[1] == "") {
+				t.Fatalf("corrupt=%v concurrency=%d results=%q calls=%v", corrupt, concurrency, results, calls)
+			}
+		}
+	}
+}
diff --git a/internal/repository/checker_cipher_retry_test.go b/internal/repository/checker_cipher_retry_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..59103d783b7d7a1c07bcb4d6c2ba8fa8798c9747
--- /dev/null
+++ b/internal/repository/checker_cipher_retry_test.go
@@ -0,0 +1,114 @@
+package repository
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+)
+
+// A backend can fail after a callback has consumed a complete pack. That
+// callback has released its inputs even though the task has not settled.
+type ordinaryCipherSettlementBackend struct {
+	backend.Backend
+	data                                   []byte
+	rd                                     *bufio.Reader
+	dec                                    *zstd.Decoder
+	t                                      *testing.T
+	calls                                  int
+	corruptFirst, corruptSecond, failFirst bool
+}
+
+func (b *ordinaryCipherSettlementBackend) Load(_ context.Context, _ backend.Handle, _ int, _ int64, consume func(io.Reader) error) error {
+	b.calls++
+	data := bytes.Clone(b.data)
+	if (b.calls == 1 && b.corruptFirst) || (b.calls == 2 && b.corruptSecond) {
+		data[0] ^= 1
+	}
+	err := consume(bytes.NewReader(data))
+	if b.rd.Buffered() != 0 {
+		b.t.Fatal("callback returned with buffered input attached")
+	}
+	if _, e := b.dec.Read(make([]byte, 1)); e != zstd.ErrDecoderNilInput {
+		b.t.Fatalf("callback returned with decoder input attached: %v", e)
+	}
+	clear(data) // Backend storage may be recycled as soon as the callback returns.
+	if b.calls == 1 && b.failFirst {
+		return fmt.Errorf("backend failed after complete callback")
+	}
+	return err
+}
+
+func TestOrdinaryCipherCallbackCommitAndRetry(t *testing.T) {
+	key := crypto.NewRandomKey()
+	for _, concurrency := range []int{1, 4} {
+		for _, size := range []int{128 << 10, 2 << 20} {
+			for _, tc := range []struct {
+				name                                   string
+				corruptFirst, corruptSecond, failFirst bool
+				want                                   string
+			}{
+				{name: "success"},
+				{name: "late-backend-failure", failFirst: true, want: "check successful on second attempt, original error download error: backend failed after complete callback"},
+				{name: "corruption-then-good", corruptFirst: true, want: "check successful on second attempt, original error"},
+				{name: "good-then-corruption", failFirst: true, corruptSecond: true, want: "decrypting blob"},
+				{name: "backend-overrides-callback", failFirst: true, corruptFirst: true, want: "check successful on second attempt, original error download error: backend failed after complete callback"},
+			} {
+				t.Run(fmt.Sprintf("%d/%d/%s", concurrency, size, tc.name), func(t *testing.T) {
+					data, plan, id := b11MakePack(key, size, "compressed")
+					dec, err := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer dec.Close()
+					rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+					be := &ordinaryCipherSettlementBackend{data: data, rd: rd, dec: dec, t: t, corruptFirst: tc.corruptFirst, corruptSecond: tc.corruptSecond, failFirst: tc.failFirst}
+					r := b11Repository(key, be, id, plan)
+					err = checkPack(context.Background(), r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+					if tc.want == "" {
+						if err != nil || be.calls != 1 {
+							t.Fatalf("success err=%v calls=%d", err, be.calls)
+						}
+					} else if err == nil || !strings.Contains(err.Error(), tc.want) || be.calls != 2 {
+						t.Fatalf("settlement err=%v calls=%d want=%q", err, be.calls, tc.want)
+					}
+					// A failed attempt must not poison the worker's next independent task.
+					be.calls = 0
+					be.corruptFirst = false
+					be.corruptSecond = false
+					be.failFirst = false
+					if err := checkPack(context.Background(), r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec); err != nil || be.calls != 1 {
+						t.Fatalf("next pack err=%v calls=%d", err, be.calls)
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestOrdinaryCipherReserveExtents(t *testing.T) {
+	for _, tc := range []struct {
+		blobs pack.Blobs
+		size  int64
+		want  int
+	}{
+		{pack.Blobs{{Offset: 0, Length: 100}, {Offset: 100, Length: 200}}, 300, 200},
+		{pack.Blobs{{Offset: ^uint(0) - 3, Length: 10}}, 100, 0},
+		{pack.Blobs{{Length: 100}}, -1, 0},
+		{pack.Blobs{{Length: 100}}, 99, 0},
+		{pack.Blobs{{Length: 16 << 20}}, 16 << 20, 16 << 20},
+		{pack.Blobs{{Length: (16 << 20) + 1}}, 17 << 20, 0},
+	} {
+		if got := ordinaryCheckCipherReserve(tc.blobs, tc.size); got != tc.want {
+			t.Fatalf("reserve=%d want=%d", got, tc.want)
+		}
+	}
+}
diff --git a/internal/repository/checker_large_header.go b/internal/repository/checker_large_header.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f4a0e45309c1c9b49a9c76b8b6c33516d84df3c
--- /dev/null
+++ b/internal/repository/checker_large_header.go
@@ -0,0 +1,35 @@
+package repository
+
+import (
+	"github.com/restic/restic/internal/debug"
+	"github.com/restic/restic/internal/errors"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Small headers retain the direct slice path. Large headers can avoid the
+// complete decoded entry slice, whose lifetime would overlap membership checks.
+const largeCheckHeaderThreshold = 64 << 10
+
+// Called only after the backend has completed and the full pack hash matches.
+// Input belongs to this completed attempt, so a retry never sees decrypted
+// header bytes from a previous callback.
+func checkLargePackHeader(r *Repository, id restic.ID, idxHdrSize int, tail []byte, errs []error) error {
+	entries, hdrSize, err := pack.ListOwnedTailEntries(r.Key(), tail)
+	if err != nil {
+		return &ErrPackData{PackID: id, errs: append(errs, err)}
+	}
+	if uint32(idxHdrSize) != hdrSize {
+		debug.Log("Pack header size does not match, want %v, got %v", idxHdrSize, hdrSize)
+		errs = append(errs, errors.Errorf("pack header size does not match, want %v, got %v", idxHdrSize, hdrSize))
+	}
+	for blob := range entries {
+		if !r.idx.ContainsPackBlob(id, blob) {
+			errs = append(errs, errors.Errorf("blob %v is not contained in index or position is incorrect", blob.ID))
+		}
+	}
+	if len(errs) > 0 {
+		return &ErrPackData{PackID: id, errs: errs}
+	}
+	return nil
+}
diff --git a/internal/repository/checker_large_header_retry_test.go b/internal/repository/checker_large_header_retry_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3285df8cf9cdf50dc00513af58ab182079cc84f5
--- /dev/null
+++ b/internal/repository/checker_large_header_retry_test.go
@@ -0,0 +1,138 @@
+package repository
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Completed callbacks are attempts, not committed tasks. The backend may retry
+// with different bytes or fail after completion, and owns its recycled input.
+type largeHeaderAttemptBackend struct {
+	backend.Backend
+	data  []byte
+	mode  string
+	calls int
+	rd    *bufio.Reader
+	dec   *zstd.Decoder
+	t     *testing.T
+}
+
+func (b *largeHeaderAttemptBackend) Load(_ context.Context, _ backend.Handle, _ int, _ int64, consume func(io.Reader) error) error {
+	b.calls++
+	attempt := func(corrupt, short bool) error {
+		input := bytes.Clone(b.data)
+		if corrupt {
+			input[len(input)-5] ^= 1
+		}
+		if short {
+			input = input[:len(input)-1]
+		}
+		err := consume(bytes.NewReader(input))
+		if b.rd != nil {
+			if b.rd.Buffered() != 0 {
+				b.t.Fatal("completed callback retained buffered input")
+			}
+			if _, e := b.dec.Read(make([]byte, 1)); e != zstd.ErrDecoderNilInput {
+				b.t.Fatalf("completed callback retained decoder input: %v", e)
+			}
+		}
+		clear(input)
+		return err
+	}
+	switch b.mode {
+	case "complete-then-short":
+		if err := attempt(false, false); err != nil {
+			return err
+		}
+		return attempt(false, true)
+	case "corrupt-then-good":
+		if err := attempt(true, false); err != nil {
+			return err
+		}
+		return attempt(false, false)
+	case "late-failure-then-corrupt":
+		if b.calls == 1 {
+			if err := attempt(false, false); err != nil {
+				return err
+			}
+			return fmt.Errorf("late backend failure")
+		}
+		return attempt(true, false)
+	case "short-then-good":
+		return attempt(false, b.calls == 1)
+	}
+	return attempt(false, false)
+}
+
+func TestLargeCheckHeaderChangingAttempts(t *testing.T) {
+	key := crypto.NewRandomKey()
+	var out bytes.Buffer
+	p := pack.NewPacker(key, &out)
+	for i := range 2000 {
+		plain := binary.LittleEndian.AppendUint32(nil, uint32(i))
+		nonce := crypto.NewRandomNonce()
+		ciphertext := key.Seal(append([]byte(nil), nonce...), nonce, plain, nil)
+		if _, err := p.Add(restic.DataBlob, restic.Hash(plain), ciphertext, 0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := p.Finalize(); err != nil {
+		t.Fatal(err)
+	}
+	data := out.Bytes()
+	plan, _, err := pack.List(key, bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(data)-int(plan[len(plan)-1].Offset+plan[len(plan)-1].Length) < largeCheckHeaderThreshold {
+		t.Fatal("fixture misses large route")
+	}
+	id := restic.Hash(data)
+	for _, concurrency := range []int{1, 4} {
+		for _, mode := range []string{"complete-then-short", "corrupt-then-good", "late-failure-then-corrupt", "short-then-good"} {
+			t.Run(fmt.Sprintf("%d/%s", concurrency, mode), func(t *testing.T) {
+				run := func(old bool) (string, int) {
+					dec, err := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer dec.Close()
+					rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+					be := &largeHeaderAttemptBackend{data: data, mode: mode, dec: dec, t: t}
+					if !old {
+						be.rd = rd
+					}
+					r := b11Repository(key, be, id, plan)
+					check := checkPack
+					if old {
+						check = b11BaselineCheckPack
+					}
+					err = check(context.Background(), r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+					result := fmt.Sprintf("%T:%v", err, err)
+					calls := be.calls
+					be.mode, be.calls = "", 0
+					if err := check(context.Background(), r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec); err != nil || be.calls != 1 {
+						t.Fatalf("next independent pack: err=%v calls=%d", err, be.calls)
+					}
+					return result, calls
+				}
+				want, wc := run(true)
+				got, gc := run(false)
+				if got != want || gc != wc {
+					t.Fatalf("settlement differs: %s/%s calls=%d/%d", got, want, gc, wc)
+				}
+			})
+		}
+	}
+}
diff --git a/internal/repository/checker_large_header_test.go b/internal/repository/checker_large_header_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a38500b5decbc3a9654b3e41282138ac8640251
--- /dev/null
+++ b/internal/repository/checker_large_header_test.go
@@ -0,0 +1,126 @@
+package repository
+
+import (
+	"bytes"
+	"encoding/binary"
+	"strings"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+func TestLargeCheckHeaderSettlement(t *testing.T) {
+	key := crypto.NewRandomKey()
+	var out bytes.Buffer
+	p := pack.NewPacker(key, &out)
+	encoder, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer encoder.Close()
+	for i := range 2000 {
+		plain := binary.LittleEndian.AppendUint32(nil, uint32(i))
+		nonce := crypto.NewRandomNonce()
+		payload, uncompressed := plain, 0
+		if i%2 == 1 {
+			payload, uncompressed = encoder.EncodeAll(plain, nil), len(plain)
+		}
+		cipher := key.Seal(append([]byte(nil), nonce...), nonce, payload, nil)
+		if _, err := p.Add(restic.DataBlob, restic.Hash(plain), cipher, uncompressed); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := p.Finalize(); err != nil {
+		t.Fatal(err)
+	}
+	data := out.Bytes()
+	plan, _, err := pack.List(key, bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	hlen := int(binary.LittleEndian.Uint32(data[len(data)-4:]))
+	if hlen+4 < largeCheckHeaderThreshold {
+		t.Fatal("fixture does not reach large-header route")
+	}
+	compare := func(input []byte, id restic.ID, readPlan, stored pack.Blobs, mode, want string) string {
+		t.Helper()
+		saved := bytes.Clone(input)
+		old, oc := b11OwnedCheckerCall(key, input, id, readPlan, stored, mode, true)
+		got, gc := b11OwnedCheckerCall(key, input, id, readPlan, stored, mode, false)
+		if got != old || gc != oc || !bytes.Equal(saved, input) || (want != "" && !strings.Contains(got, want)) {
+			t.Fatalf("mode=%s: %q/%q calls=%d/%d mutated=%v", mode, old, got, oc, gc, !bytes.Equal(saved, input))
+		}
+		return got
+	}
+	for _, mode := range []string{"", "two-full-callbacks", "full-then-transport-error", "cancel-during-tail"} {
+		compare(data, restic.Hash(data), plan, plan, mode, "")
+	}
+	// A late malformed entry must outrank all earlier membership diagnostics.
+	bad := bytes.Clone(data)
+	start := len(bad) - hlen - 4
+	header := bad[start : len(bad)-4]
+	plain, err := key.Open(nil, header[:key.NonceSize()], header[key.NonceSize():], nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	plain[len(plain)-pack.CalculateEntrySize(plan[len(plan)-1].IsCompressed())] = 255
+	nonce := crypto.NewRandomNonce()
+	copy(header, key.Seal(append([]byte(nil), nonce...), nonce, plain, nil))
+	got := compare(bad, restic.Hash(bad), plan, nil, "", "invalid type 255")
+	if strings.Contains(got, "is not contained in index") {
+		t.Fatal("malformed late entry published earlier membership diagnostics")
+	}
+	wrongID := restic.Hash(bad)
+	wrongID[0] ^= 1
+	compare(bad, wrongID, plan, nil, "", "unexpected pack id")
+	bad = bytes.Clone(data)
+	bad[len(bad)-5] ^= 1
+	compare(bad, restic.Hash(bad), plan, plan, "", "")
+	altered := append(pack.Blobs(nil), plan...)
+	altered[0].UncompressedLength = 1
+	got = compare(data, restic.Hash(data), altered, nil, "", "pack header size does not match")
+	if !strings.Contains(got, "blob ") || strings.Count(got, "is not contained in index") != len(plan) {
+		t.Fatal("competing errors omitted")
+	}
+	t.Log("matched eight large-header transitions: success, repeated callback, late backend error, cancellation, late malformed entry, pack-hash priority and authentication failure")
+}
+
+func TestLargeCheckHeaderDispatchBoundary(t *testing.T) {
+	key := crypto.NewRandomKey()
+	var out bytes.Buffer
+	p := pack.NewPacker(key, &out)
+	for i := range 1770 {
+		plain := binary.LittleEndian.AppendUint32(nil, uint32(i))
+		nonce := crypto.NewRandomNonce()
+		cipher := key.Seal(append([]byte(nil), nonce...), nonce, plain, nil)
+		if _, err := p.Add(restic.DataBlob, restic.Hash(plain), cipher, 0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := p.Finalize(); err != nil {
+		t.Fatal(err)
+	}
+	base := out.Bytes()
+	plan, _, err := pack.List(key, bytes.NewReader(base), int64(len(base)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	headerLen := int(binary.LittleEndian.Uint32(base[len(base)-4:])) + 4
+	start := len(base) - headerLen
+	for _, tailLen := range []int{largeCheckHeaderThreshold - 1, largeCheckHeaderThreshold, largeCheckHeaderThreshold + 1} {
+		data := bytes.Clone(base[:start])
+		data = append(data, make([]byte, tailLen-headerLen)...)
+		data = append(data, base[start:]...)
+		id := restic.Hash(data)
+		old, oc := b11OwnedCheckerCall(key, data, id, plan, plan, "", true)
+		got, gc := b11OwnedCheckerCall(key, data, id, plan, plan, "", false)
+		if old != got || oc != gc || got != "" {
+			t.Fatalf("tail=%d: %q/%q attempts=%d/%d", tailLen, old, got, oc, gc)
+		}
+	}
+	t.Log("matched dispatch below, at and above 64KiB with owned padding before the authenticated header")
+}
diff --git a/internal/repository/checker_membership_baseline_test.go b/internal/repository/checker_membership_baseline_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c9c3b48d8b824bc760c48dff0d1375c1213ac98
--- /dev/null
+++ b/internal/repository/checker_membership_baseline_test.go
@@ -0,0 +1,172 @@
+package repository
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/debug"
+	"github.com/restic/restic/internal/errors"
+	"github.com/restic/restic/internal/repository/hashing"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+	"io"
+)
+
+// checkPack reads a pack and checks the integrity of all blobs.
+func b11BaselineCheckPack(ctx context.Context, r *Repository, id restic.ID, blobs pack.Blobs, size int64, bufRd *bufio.Reader, dec *zstd.Decoder) error {
+	err := b11BaselineCheckPackInner(ctx, r, id, blobs, size, bufRd, dec)
+	if err != nil {
+		if r.cache != nil {
+			// ignore error as there's not much we can do here
+			_ = r.cache.Forget(backend.Handle{Type: backend.PackFile, Name: id.String()})
+		}
+
+		// retry pack verification to detect transient errors
+		err2 := b11BaselineCheckPackInner(ctx, r, id, blobs, size, bufRd, dec)
+		if err2 != nil {
+			err = err2
+		} else {
+			err = fmt.Errorf("check successful on second attempt, original error %w", err)
+		}
+	}
+	return err
+}
+
+func b11BaselineCheckPackInner(ctx context.Context, r *Repository, id restic.ID, blobs pack.Blobs, size int64, bufRd *bufio.Reader, dec *zstd.Decoder) error {
+
+	type partialReadError struct {
+		error
+	}
+
+	debug.Log("checking pack %v", id.String())
+
+	if len(blobs) == 0 {
+		return &ErrPackData{PackID: id, errs: []error{errors.New("pack is empty or not indexed")}}
+	}
+
+	// sanity check blobs in index
+	blobs.Sort()
+	idxHdrSize := pack.CalculateHeaderSize(blobs)
+	lastBlobEnd := 0
+	nonContinuousPack := false
+	for _, blob := range blobs {
+		if lastBlobEnd != int(blob.Offset) {
+			nonContinuousPack = true
+		}
+		lastBlobEnd = int(blob.Offset + blob.Length)
+	}
+	// size was calculated by masterindex.PackSize, thus there's no need to recalculate it here
+
+	var errs []error
+	if nonContinuousPack {
+		debug.Log("Index for pack contains gaps / overlaps, blobs: %v", blobs)
+		errs = append(errs, errors.New("index for pack contains gaps / overlapping blobs"))
+	}
+
+	// calculate hash on-the-fly while reading the pack and capture pack header
+	var hash restic.ID
+	var hdrBuf []byte
+	// must use a separate slice from `errs` here as we're only interested in the last retry
+	var blobErrors []error
+	h := backend.Handle{Type: backend.PackFile, Name: id.String()}
+	err := r.be.Load(ctx, h, int(size), 0, func(rd io.Reader) error {
+		hrd := hashing.NewReader(rd, sha256.New())
+		bufRd.Reset(hrd)
+		// reset blob errors for each retry
+		blobErrors = nil
+
+		it := newPackBlobIterator(id, newBufReader(bufRd), 0, blobs, r.Key(), dec)
+		for {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+
+			val, err := it.NextHash()
+			if err == errPackEOF {
+				break
+			} else if err != nil {
+				return &partialReadError{err}
+			}
+			debug.Log("  check blob %v: %v", val.Handle.ID, val.Handle)
+			if val.Err != nil {
+				debug.Log("  error verifying blob %v: %v", val.Handle.ID, val.Err)
+				blobErrors = append(blobErrors, errors.Errorf("blob %v: %v", val.Handle.ID, val.Err))
+			}
+		}
+
+		// skip enough bytes until we reach the possible header start
+		curPos := lastBlobEnd
+		minHdrStart := int(size) - pack.MaxHeaderSize
+		if minHdrStart > curPos {
+			_, err := bufRd.Discard(minHdrStart - curPos)
+			if err != nil {
+				return &partialReadError{err}
+			}
+			curPos += minHdrStart - curPos
+		}
+
+		// read remainder, which should be the pack header
+		var err error
+		hdrBuf = make([]byte, int(size-int64(curPos)))
+		_, err = io.ReadFull(bufRd, hdrBuf)
+		if err != nil {
+			return &partialReadError{err}
+		}
+
+		hash = restic.IDFromHash(hrd.Sum(nil))
+		return nil
+	})
+	errs = append(errs, blobErrors...)
+	if err != nil {
+		var e *partialReadError
+		isPartialReadError := errors.As(err, &e)
+		// failed to load the pack file, return as further checks cannot succeed anyways
+		debug.Log("  error streaming pack (partial %v): %v", isPartialReadError, err)
+		if isPartialReadError {
+			return &ErrPackData{PackID: id, errs: append(errs, fmt.Errorf("partial download error: %w", err))}
+		}
+
+		// The check command suggests to repair files for which a `ErrPackData` is returned. However, this file
+		// completely failed to download such that there's no point in repairing anything.
+		return fmt.Errorf("download error: %w", err)
+	}
+	if !hash.Equal(id) {
+		debug.Log("pack ID does not match, want %v, got %v", id, hash)
+		return &ErrPackData{PackID: id, errs: append(errs, errors.Errorf("unexpected pack id %v", hash))}
+	}
+
+	blobs, hdrSize, err := pack.List(r.Key(), bytes.NewReader(hdrBuf), int64(len(hdrBuf)))
+	if err != nil {
+		return &ErrPackData{PackID: id, errs: append(errs, err)}
+	}
+
+	if uint32(idxHdrSize) != hdrSize {
+		debug.Log("Pack header size does not match, want %v, got %v", idxHdrSize, hdrSize)
+		errs = append(errs, errors.Errorf("pack header size does not match, want %v, got %v", idxHdrSize, hdrSize))
+	}
+
+	for _, blob := range blobs {
+		// Check if blob is contained in index and position is correct
+		idxHas := false
+		for _, pb := range r.idx.Lookup(blob.BlobHandle) {
+			if pb.PackID().Equal(id) && pb.Blob == blob {
+				idxHas = true
+				break
+			}
+		}
+		if !idxHas {
+			errs = append(errs, errors.Errorf("blob %v is not contained in index or position is incorrect", blob.ID))
+			continue
+		}
+	}
+
+	if len(errs) > 0 {
+		return &ErrPackData{PackID: id, errs: errs}
+	}
+
+	return nil
+}
