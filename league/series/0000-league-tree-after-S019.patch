The league's tree after seasons S001 to S019 and two hand merges, as one patch against
upstream restic 0.19.1-dev at commit ba802d42b7294c98b62c16d1157ea3e80820c019.

This is the diff of commit 2 of this repository against commit 1 (git diff --binary --full-index).
Apply with:  git apply --index 0000-league-tree-after-S019.patch
then apply 0001 onwards in order with:  git am 0*.patch   (after removing this file from the list)

DO NOT USE THE TREE THIS PATCH ALONE PRODUCES. It contains a defect that can lose data when a backup
runs beside a prune (finding R1, league/docs/SOUNDNESS.md). Patches 0001 onwards repair it.

diff --git a/cmd/restic/backup_index_load.go b/cmd/restic/backup_index_load.go
new file mode 100644
index 0000000000000000000000000000000000000000..e8e6a7626ea4888754b376e149279f3d17d57f9e
--- /dev/null
+++ b/cmd/restic/backup_index_load.go
@@ -0,0 +1,160 @@
+package main
+
+import (
+	"context"
+	"sync"
+
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+)
+
+// backupIndexLoad prepares the backup index while the append lock's required
+// settle delay is running. Its result is consumed only after lock validation.
+type backupIndexLoad struct {
+	repo      *repository.Repository
+	cancel    context.CancelFunc
+	result    chan error
+	progress  *delayedTerminalCounterFactory
+	snapshots *preparedSnapshots
+	done      bool
+}
+
+func startBackupIndexLoad(ctx context.Context, repo *repository.Repository) *backupIndexLoad {
+	return startBackupIndexLoadAfterSnapshots(ctx, repo, false)
+}
+
+// startBackupIndexLoadAfterSnapshots lists the snapshot files for the parent
+// snapshot search before the index files when listSnapshots is set, keeping
+// the stock listing order (snapshots, then index).
+func startBackupIndexLoadAfterSnapshots(ctx context.Context, repo *repository.Repository, listSnapshots bool) *backupIndexLoad {
+	loadCtx, cancel := context.WithCancel(ctx)
+	load := &backupIndexLoad{
+		repo:     repo,
+		cancel:   cancel,
+		result:   make(chan error, 1),
+		progress: &delayedTerminalCounterFactory{},
+	}
+	if listSnapshots {
+		load.snapshots = newPreparedSnapshots()
+	}
+	go func() {
+		load.snapshots.list(loadCtx, repo)
+		load.result <- repo.LoadIndex(loadCtx, load.progress)
+	}()
+	return load
+}
+
+// parentSearchRepo returns repo with snapshot listings served from the
+// listing prepared before the index load.
+func (load *backupIndexLoad) parentSearchRepo(repo restic.ListerLoaderUnpacked) restic.ListerLoaderUnpacked {
+	if load == nil || load.snapshots == nil {
+		return repo
+	}
+	return snapshotListerRepo{ListerLoaderUnpacked: repo, snapshots: load.snapshots.get(repo)}
+}
+
+func (load *backupIndexLoad) wait(printer restic.TerminalCounterFactory) error {
+	load.progress.activate(printer)
+	err := <-load.result
+	load.cancel()
+	load.done = true
+	if err != nil {
+		load.repo.DiscardIndex()
+	}
+	return err
+}
+
+func (load *backupIndexLoad) discard() {
+	if load == nil || load.done {
+		return
+	}
+	load.cancel()
+	<-load.result
+	load.repo.DiscardIndex()
+	load.done = true
+}
+
+// delayedTerminalCounterFactory records progress until the lock has been
+// validated and backup reaches its ordinary LoadIndex reporting point.
+type delayedTerminalCounterFactory struct {
+	mu       sync.Mutex
+	target   restic.TerminalCounterFactory
+	counters []*delayedTerminalCounter
+}
+
+func (factory *delayedTerminalCounterFactory) NewCounterTerminalOnly(description string) restic.Counter {
+	factory.mu.Lock()
+	defer factory.mu.Unlock()
+
+	counter := &delayedTerminalCounter{description: description}
+	factory.counters = append(factory.counters, counter)
+	if factory.target != nil {
+		counter.attach(factory.target.NewCounterTerminalOnly(description))
+	}
+	return counter
+}
+
+func (factory *delayedTerminalCounterFactory) activate(target restic.TerminalCounterFactory) {
+	factory.mu.Lock()
+	defer factory.mu.Unlock()
+	if factory.target != nil {
+		return
+	}
+	factory.target = target
+	for _, counter := range factory.counters {
+		counter.attach(target.NewCounterTerminalOnly(counter.description))
+	}
+}
+
+type delayedTerminalCounter struct {
+	mu          sync.Mutex
+	description string
+	target      restic.Counter
+	current     uint64
+	maximum     uint64
+	done        bool
+}
+
+func (counter *delayedTerminalCounter) Add(amount uint64) {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.current += amount
+	if counter.target != nil {
+		counter.target.Add(amount)
+	}
+}
+
+func (counter *delayedTerminalCounter) SetMax(maximum uint64) {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.maximum = maximum
+	if counter.target != nil {
+		counter.target.SetMax(maximum)
+	}
+}
+
+func (counter *delayedTerminalCounter) Get() (uint64, uint64) {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	return counter.current, counter.maximum
+}
+
+func (counter *delayedTerminalCounter) Done() {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.done = true
+	if counter.target != nil {
+		counter.target.Done()
+	}
+}
+
+func (counter *delayedTerminalCounter) attach(target restic.Counter) {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.target = target
+	target.SetMax(counter.maximum)
+	target.Add(counter.current)
+	if counter.done {
+		target.Done()
+	}
+}
diff --git a/cmd/restic/backup_progress_publication_test.go b/cmd/restic/backup_progress_publication_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b38a716fcb3daa87681c3e79ad9348463701ab78
--- /dev/null
+++ b/cmd/restic/backup_progress_publication_test.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/archiver"
+	"github.com/restic/restic/internal/restic"
+	"github.com/restic/restic/internal/ui"
+	"github.com/restic/restic/internal/ui/backup"
+)
+
+type b16ProgressTerminal struct {
+	*ui.MockTerminal
+	output, errors chan string
+}
+
+func (t *b16ProgressTerminal) Print(line string) { t.output <- line }
+func (t *b16ProgressTerminal) Error(line string) { t.errors <- line }
+
+// Exercise the public progress path from the command package as well as the
+// private lock tests: reading completion, save completion, scanner totals and
+// the two error categories must remain distinct.
+func TestBackupProgressPublicationSemantics(t *testing.T) {
+	term := &b16ProgressTerminal{
+		MockTerminal: &ui.MockTerminal{},
+		output: make(chan string, 64),
+		errors: make(chan string, 8),
+	}
+	printer := backup.NewJSONProgress(term, 3)
+	p := backup.NewProgress(printer, false, true, false)
+	defer p.Finish(restic.ID{}, &archiver.Summary{}, false)
+
+	await := func(match func(map[string]any) bool) map[string]any {
+		t.Helper()
+		timer := time.NewTimer(5 * time.Second)
+		defer timer.Stop()
+		for {
+			select {
+			case line := <-term.output:
+				var event map[string]any
+				if err := json.Unmarshal([]byte(line), &event); err != nil {
+					t.Fatal(err)
+				}
+				if match(event) {
+					return event
+				}
+			case <-timer.C:
+				t.Fatal("expected progress event was not emitted")
+			}
+		}
+	}
+
+	p.StartFile("file")
+	p.CompleteBlob(17)
+	p.CompleteItem("file", "", archiver.ItemStats{}, 0)
+	first := await(func(event map[string]any) bool {
+		return event["message_type"] == "status" && event["bytes_done"] == float64(17) && event["current_files"] == nil
+	})
+	if _, ok := first["files_done"]; ok {
+		t.Fatal("reading completion counted as successful item completion")
+	}
+	if _, ok := first["current_files"]; ok {
+		t.Fatal("reading completion did not clear the active file")
+	}
+
+	if err := printer.ScannerError("scan-path", fmt.Errorf("scan failure")); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.Error("archive-path", fmt.Errorf("archive failure")); err != nil {
+		t.Fatal(err)
+	}
+	for _, during := range []string{"scan", "archival"} {
+		select {
+		case line := <-term.errors:
+			var event map[string]any
+			if err := json.Unmarshal([]byte(line), &event); err != nil {
+				t.Fatal(err)
+			}
+			if event["during"] != during {
+				t.Fatalf("error category=%v, want %s", event["during"], during)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatalf("missing %s error", during)
+		}
+	}
+
+	p.ReportTotal("", archiver.ScanStats{Files: 1, Bytes: 17})
+	p.CompleteItem("file", archiver.ActionFileUnchanged, archiver.ItemStats{}, 0)
+	last := await(func(event map[string]any) bool {
+		return event["message_type"] == "status" && event["files_done"] == float64(1)
+	})
+	for field, want := range map[string]float64{
+		"total_files": 1, "files_done": 1,
+		"total_bytes": 17, "bytes_done": 17, "error_count": 1,
+	} {
+		if last[field] != want {
+			t.Errorf("%s=%v, want %v", field, last[field], want)
+		}
+	}
+}
diff --git a/cmd/restic/check_completing_repair_test.go b/cmd/restic/check_completing_repair_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..dfe07681bd5379fd9841e417d7e55d31925e1cd0
--- /dev/null
+++ b/cmd/restic/check_completing_repair_test.go
@@ -0,0 +1,100 @@
+package main
+
+import (
+	"context"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Model a repair that restores an indexed pack before lock confirmation. This
+// controls backend visibility; it is not a stress test of two CLI processes.
+func TestCheckPreparedSizesCompletingPackRepair(t *testing.T) {
+	ctx := context.Background()
+	original, _, be := repository.TestRepositoryWithVersion(t, 0)
+	data.TestCreateSnapshot(t, original, time.Unix(1470492820, 207401672), 1)
+	var h backend.Handle
+	if err := be.List(ctx, backend.PackFile, func(fi backend.FileInfo) error {
+		if h.Name == "" {
+			h = backend.Handle{Type: backend.PackFile, Name: fi.Name}
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if h.Name == "" {
+		t.Fatal("fixture contains no pack")
+	}
+	var payload []byte
+	if err := be.Load(ctx, h, 0, 0, func(r io.Reader) error {
+		var err error
+		payload, err = io.ReadAll(r)
+		return err
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := be.Remove(ctx, h); err != nil {
+		t.Fatal(err)
+	}
+	gate := &packSizesConfirmationGate{Backend: be, confirmation: make(chan struct{}), resume: make(chan struct{})}
+	repo := repository.TestOpenBackend(t, gate)
+	repository.TestSetLockTimeout(t, 5*time.Millisecond)
+	defer repository.TestSetLockTimeout(t, 0)
+	started := make(chan *checkerIndexLoad, 1)
+	type result struct {
+		unlock func()
+		ctx    context.Context
+		err    error
+	}
+	finished := make(chan result, 1)
+	go func() {
+		unlock, lockCtx, err := repository.LockRepoWithWaitWork(ctx, repo, true, 0, func(string) {}, func(string, ...any) {}, func(ctx context.Context) func(bool) {
+			load := startCheckerIndexLoad(ctx, repo, false, &data.SnapshotFilter{}, nil)
+			started <- load
+			return load.settle
+		})
+		finished <- result{unlock, lockCtx, err}
+	}()
+	load := <-started
+	<-gate.confirmation
+	value := <-load.result
+	load.result <- value
+	if value.packs == nil || len(value.errs) != 0 {
+		t.Fatal("index-only preparation failed while pack unavailable")
+	}
+	gate.mu.Lock()
+	packLists := gate.packLists
+	gate.mu.Unlock()
+	if packLists != 0 {
+		t.Fatal("speculative preparation observed pack availability")
+	}
+	// Repair completes and then confirmation proceeds. Subsequent metadata
+	// checking must observe the restored pack, rather than an early absence.
+	if err := be.Save(ctx, h, backend.NewByteReader(payload, be.Hasher())); err != nil {
+		t.Fatal(err)
+	}
+	close(gate.resume)
+	got := <-finished
+	if got.err != nil {
+		t.Fatal(got.err)
+	}
+	defer got.unlock()
+	defer load.discard()
+	if err := load.loadSnapshots(); err != nil {
+		t.Fatal(err)
+	}
+	_, errs := load.consume(restic.NoopTerminalCounterFactory)
+	if len(errs) != 0 {
+		t.Fatal(errs)
+	}
+	errsCh := make(chan error)
+	go load.checker.PacksWithPreparedSizes(got.ctx, load.packs, errsCh)
+	for err := range errsCh {
+		t.Error(err)
+	}
+}
diff --git a/cmd/restic/check_ordinary_wait_test.go b/cmd/restic/check_ordinary_wait_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2543706e825bf329525221e80668142c6f0d2a5d
--- /dev/null
+++ b/cmd/restic/check_ordinary_wait_test.go
@@ -0,0 +1,77 @@
+package main
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Observe the second lock listing without holding it open. This intentionally
+// does not assert completion: host scheduling determines how much finishes.
+type ordinaryWaitObserver struct {
+	backend.Backend
+	mu             sync.Mutex
+	load           *checkerIndexLoad
+	start          time.Time
+	lockLists      int
+	atConfirmation time.Duration
+	completed      bool
+}
+
+func (o *ordinaryWaitObserver) List(ctx context.Context, kind backend.FileType, fn func(backend.FileInfo) error) error {
+	o.mu.Lock()
+	if kind == backend.LockFile {
+		o.lockLists++
+		if o.lockLists == 2 && o.load != nil {
+			o.atConfirmation = time.Since(o.start)
+			select {
+			case value := <-o.load.result:
+				o.completed = value.packs != nil && len(value.errs) == 0
+				o.load.result <- value
+			default:
+			}
+		}
+	}
+	o.mu.Unlock()
+	return o.Backend.List(ctx, kind, fn)
+}
+
+func TestCheckPreparationOrdinaryWaitCoverage(t *testing.T) {
+	original, _, be := repository.TestRepositoryWithVersion(t, 0)
+	data.TestCreateSnapshot(t, original, time.Unix(1470492820, 207401672), 1)
+	o := &ordinaryWaitObserver{Backend: be}
+	repo := repository.TestOpenBackend(t, o)
+	repository.TestSetLockTimeout(t, 200*time.Millisecond)
+	defer repository.TestSetLockTimeout(t, 0)
+	var load *checkerIndexLoad
+	unlock, _, err := repository.LockRepoWithWaitWork(context.Background(), repo, true, 0, func(string) {}, func(string, ...any) {}, func(ctx context.Context) func(bool) {
+		load = startCheckerIndexLoad(ctx, repo, false, &data.SnapshotFilter{}, nil)
+		o.mu.Lock()
+		o.load, o.start = load, time.Now()
+		o.mu.Unlock()
+		return load.settle
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unlock()
+	defer load.discard()
+	o.mu.Lock()
+	completed, elapsed := o.completed, o.atConfirmation
+	o.mu.Unlock()
+	tailStart := time.Now()
+	if err := load.loadSnapshots(); err != nil {
+		t.Fatal(err)
+	}
+	_, errs := load.consume(restic.NoopTerminalCounterFactory)
+	if len(errs) != 0 {
+		t.Fatal(errs)
+	}
+	t.Logf("ordinary wait: elapsed=%v prepared-result-complete=%v post-confirmation-consume=%v (generated test repository only)", elapsed, completed, time.Since(tailStart))
+}
diff --git a/cmd/restic/check_pack_sizes_lifetime_test.go b/cmd/restic/check_pack_sizes_lifetime_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3d1391ab84d833005afacf3c18bfd75a92b5e8a2
--- /dev/null
+++ b/cmd/restic/check_pack_sizes_lifetime_test.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"context"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/repository"
+	rtest "github.com/restic/restic/internal/test"
+)
+
+// Keep a real index-load call alive after it observes cancellation. This
+// distinguishes cancellation delivery from joining the load pipeline.
+type packSizesBlockedIndex struct {
+	backend.Backend
+	entered, canceled, release chan struct{}
+	enterOnce, cancelOnce      sync.Once
+}
+
+func (b *packSizesBlockedIndex) Load(ctx context.Context, h backend.Handle, length int, offset int64, fn func(io.Reader) error) error {
+	if h.Type != backend.IndexFile {
+		return b.Backend.Load(ctx, h, length, offset, fn)
+	}
+	b.enterOnce.Do(func() { close(b.entered) })
+	<-ctx.Done()
+	b.cancelOnce.Do(func() { close(b.canceled) })
+	<-b.release
+	return ctx.Err()
+}
+
+func TestCheckerWaitCancellationJoinsBlockedIndexBeforeUnlock(t *testing.T) {
+	original, _, be := repository.TestRepositoryWithVersion(t, 0)
+	data.TestCreateSnapshot(t, original, time.Unix(1470492820, 207401672), 1)
+	blocked := &packSizesBlockedIndex{Backend: be, entered: make(chan struct{}), canceled: make(chan struct{}), release: make(chan struct{})}
+	gate := &packSizesConfirmationGate{Backend: blocked, confirmation: make(chan struct{}), resume: make(chan struct{})}
+	repo := repository.TestOpenBackend(t, gate)
+	repository.TestSetLockTimeout(t, 5*time.Millisecond)
+	defer repository.TestSetLockTimeout(t, 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var release sync.Once
+	unblock := func() { release.Do(func() { close(blocked.release) }) }
+	defer unblock()
+	done := make(chan error, 1)
+	started := make(chan *checkerIndexLoad, 1)
+	go func() {
+		unlock, _, err := repository.LockRepoWithWaitWork(ctx, repo, true, 0, func(string) {}, func(string, ...any) {}, func(ctx context.Context) func(bool) {
+			load := startCheckerIndexLoad(ctx, repo, false, &data.SnapshotFilter{}, nil)
+			started <- load
+			return load.settle
+		})
+		if unlock != nil {
+			unlock()
+		}
+		done <- err
+	}()
+	wait := func(ch <-chan struct{}, stage string) {
+		t.Helper()
+		select {
+		case <-ch:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("timeout at %s", stage)
+		}
+	}
+	var load *checkerIndexLoad
+	select {
+	case load = <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("preparation did not start")
+	}
+	wait(blocked.entered, "index load")
+	wait(gate.confirmation, "confirmation")
+	cancel()
+	wait(blocked.canceled, "index cancellation")
+	select {
+	case err := <-done:
+		t.Fatalf("returned before index load joined: %v", err)
+	default:
+	}
+	locks := 0
+	rtest.OK(t, be.List(context.Background(), backend.LockFile, func(backend.FileInfo) error { locks++; return nil }))
+	rtest.Equals(t, 1, locks)
+	unblock()
+	select {
+	case err := <-done:
+		rtest.Assert(t, err != nil, "canceled attempt succeeded")
+	case <-time.After(5 * time.Second):
+		t.Fatal("index pipeline did not join")
+	}
+	rtest.Assert(t, load.done && !load.used && load.packs == nil, "canceled result escaped")
+	locks = 0
+	rtest.OK(t, be.List(context.Background(), backend.LockFile, func(backend.FileInfo) error { locks++; return nil }))
+	rtest.Equals(t, 0, locks)
+}
diff --git a/cmd/restic/check_pack_sizes_wait_test.go b/cmd/restic/check_pack_sizes_wait_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bfdd5f09b3cd930175faf145fe3bc909acdfd4e2
--- /dev/null
+++ b/cmd/restic/check_pack_sizes_wait_test.go
@@ -0,0 +1,197 @@
+package main
+
+import (
+	"context"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/repository"
+	"github.com/restic/restic/internal/restic"
+	rtest "github.com/restic/restic/internal/test"
+)
+
+// Unlike a nominal worker-start signal, result publication proves that both
+// checker-index loading and the subsequent size calculation have returned.
+type packSizesConfirmationGate struct {
+	backend.Backend
+	mu           sync.Mutex
+	lockLists    int
+	packLists    int
+	order        []backend.FileType
+	confirmation chan struct{}
+	resume       chan struct{}
+}
+
+func (g *packSizesConfirmationGate) List(ctx context.Context, t backend.FileType, fn func(backend.FileInfo) error) error {
+	g.mu.Lock()
+	g.order = append(g.order, t)
+	if t == backend.PackFile {
+		g.packLists++
+	}
+	if t == backend.LockFile {
+		g.lockLists++
+	}
+	confirming := t == backend.LockFile && g.lockLists == 2
+	g.mu.Unlock()
+	if confirming {
+		close(g.confirmation)
+		select {
+		case <-g.resume:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return g.Backend.List(ctx, t, fn)
+}
+
+func TestPackSizesCompletePrivatelyBeforeConfirmation(t *testing.T) {
+	for _, outcome := range []string{"confirmed", "competing-lock", "canceled"} {
+		t.Run(outcome, func(t *testing.T) {
+			original, unpacked, be := repository.TestRepositoryWithVersion(t, 0)
+			data.TestCreateSnapshot(t, original, time.Unix(1470492820, 207401672), 1)
+			gate := &packSizesConfirmationGate{Backend: be, confirmation: make(chan struct{}), resume: make(chan struct{})}
+			repo := repository.TestOpenBackend(t, gate)
+			repository.TestSetLockTimeout(t, 5*time.Millisecond)
+			defer repository.TestSetLockTimeout(t, 0)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			var resume sync.Once
+			unblock := func() { resume.Do(func() { close(gate.resume) }) }
+			defer unblock()
+			started := make(chan *checkerIndexLoad, 1)
+			type lockResult struct {
+				unlock func()
+				ctx    context.Context
+				err    error
+			}
+			finished := make(chan lockResult, 1)
+			go func() {
+				unlock, lockCtx, err := repository.LockRepoWithWaitWork(ctx, repo, true, 0, func(string) {}, func(string, ...any) {}, func(ctx context.Context) func(bool) {
+					load := startCheckerIndexLoad(ctx, repo, false, &data.SnapshotFilter{}, nil)
+					started <- load
+					return load.settle
+				})
+				finished <- lockResult{unlock, lockCtx, err}
+			}()
+			var load *checkerIndexLoad
+			select {
+			case load = <-started:
+			case <-time.After(5 * time.Second):
+				t.Fatal("preparation did not start")
+			}
+			select {
+			case <-gate.confirmation:
+			case <-time.After(5 * time.Second):
+				t.Fatal("confirmation was not gated")
+			}
+			select {
+			case value := <-load.result:
+				rtest.Assert(t, value.packs != nil && len(value.errs) == 0, "sizes did not complete: %+v", value)
+				load.result <- value
+			case <-time.After(5 * time.Second):
+				t.Fatal("sizes did not complete while confirmation was held")
+			}
+			rtest.Assert(t, load.progress.target == nil && !load.used, "speculative progress/result was published")
+			gate.mu.Lock()
+			packLists := gate.packLists
+			var sawSnapshots, sawIndex bool
+			for _, kind := range gate.order {
+				if kind == backend.SnapshotFile {
+					sawSnapshots = true
+				}
+				if kind == backend.IndexFile {
+					rtest.Assert(t, sawSnapshots, "index listed before snapshots")
+					sawIndex = true
+				}
+			}
+			gate.mu.Unlock()
+			rtest.Assert(t, sawIndex && packLists == 0, "preparation listed backend packs")
+			var competitor restic.ID
+			if outcome == "competing-lock" {
+				hostname, _ := os.Hostname()
+				var err error
+				competitor, err = restic.SaveJSONUnpacked(context.Background(), unpacked, restic.LockFile, &repository.Lock{Time: time.Now(), PID: os.Getpid(), Hostname: hostname, Exclusive: true})
+				rtest.OK(t, err)
+			} else if outcome == "canceled" {
+				cancel()
+			}
+			unblock()
+			var got lockResult
+			select {
+			case got = <-finished:
+			case <-time.After(5 * time.Second):
+				t.Fatal("lock result did not settle")
+			}
+			if outcome == "confirmed" {
+				rtest.OK(t, got.err)
+				defer got.unlock()
+				rtest.OK(t, load.loadSnapshots())
+				_, errs := load.consume(restic.NoopTerminalCounterFactory)
+				rtest.Equals(t, 0, len(errs))
+				errChan := make(chan error)
+				go load.checker.PacksWithPreparedSizes(got.ctx, load.packs, errChan)
+				for err := range errChan {
+					rtest.OK(t, err)
+				}
+				gate.mu.Lock()
+				packLists = gate.packLists
+				gate.mu.Unlock()
+				rtest.Equals(t, 1, packLists)
+			} else {
+				if outcome == "competing-lock" {
+					rtest.Assert(t, repository.IsAlreadyLocked(got.err), "wrong rejection: %v", got.err)
+				} else {
+					rtest.Assert(t, got.err != nil, "cancellation accepted")
+				}
+				rtest.Assert(t, load.done && !load.used && load.packs == nil, "rejected attempt retained sizes")
+				select {
+				case <-load.result:
+					t.Fatal("rejected result not drained")
+				default:
+				}
+				var locks []string
+				rtest.OK(t, be.List(context.Background(), backend.LockFile, func(fi backend.FileInfo) error { locks = append(locks, fi.Name); return nil }))
+				if outcome == "competing-lock" {
+					rtest.Equals(t, []string{competitor.String()}, locks)
+				} else {
+					rtest.Equals(t, 0, len(locks))
+				}
+			}
+		})
+	}
+}
+
+func TestCheckerPackSizesDiscardJoinsPendingResult(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	result := make(chan checkerIndexLoadResult, 1)
+	canceled := make(chan struct{})
+	release := make(chan struct{})
+	load := &checkerIndexLoad{repo: &repository.Repository{}, cancel: cancel, result: result, progress: &delayedTerminalCounterFactory{}}
+	go func() {
+		// Model size computation that has observed cancellation but still owns
+		// its state. The final result is not published until it has returned.
+		<-ctx.Done()
+		close(canceled)
+		<-release
+		result <- checkerIndexLoadResult{packs: &repository.PreparedPackSizes{}}
+	}()
+	settled := make(chan struct{})
+	go func() { load.settle(false); close(settled) }()
+	<-canceled
+	select {
+	case <-settled:
+		t.Fatal("discard returned before pending size work was joined")
+	default:
+	}
+	close(release)
+	select {
+	case <-settled:
+	case <-time.After(5 * time.Second):
+		t.Fatal("discard did not join released work")
+	}
+	rtest.Assert(t, load.done && !load.used && load.packs == nil && load.progress.target == nil, "discard published/retained speculative state")
+}
