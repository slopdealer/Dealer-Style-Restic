+func TestFileSaverBufferCancellationAndFailure(t *testing.T) {
+	for _, cancelDuringSave := range []bool{false, true} {
+		ctx, cancel := context.WithCancel(t.Context())
+		factory := bufferTestFactory{3 * 1024 * 1024}
