index 0000000000000000000000000000000000000000..28e5631951cbf2cd11549dc357afec6cff984cc1
--- /dev/null
+++ b/internal/restic/restore_hold_budget.go
@@ -0,0 +1,36 @@
+package restic
+
+import "context"
+
+// RestoreHoldBudget counts the bytes that the ordinary restore workers of one
+// restore hold at the same time in range windows and decoded blobs. A worker
+// takes what a window will hold before it allocates or reads it and gives it
+// back after the last callback of that window. The configured workers take
+// without waiting (Force), as they always did; the additional worker waits for
+// room (Acquire), so it only adds to what the others hold while that is low.
+// The implementation is the restorer's.
+//
+// This file declares types only, on purpose: this package is placed before
+// the key derivation code in the binary, and that code runs about 3% slower
+// or faster depending on where it lands (6 ms per process).
+type RestoreHoldBudget interface {
+	// Force takes n bytes without waiting and returns the amount taken.
+	Force(n int64) int64
+	// Acquire waits until there is room and returns the amount taken.
+	Acquire(ctx context.Context, n int64) (int64, error)
+	// Release returns bytes taken by Force or Acquire.
+	Release(n int64)
+	// Workers is the number of configured ordinary workers of the restore.
+	Workers() int
+}
+
+// RestoreHoldKey is the context key of a RestoreHoldUse: the pack streams of
+// an ordinary restore worker carry one.
+type RestoreHoldKey struct{}
+
+// RestoreHoldUse is how one ordinary restore worker uses the budget. Wait is
+// true for the additional worker only.
+type RestoreHoldUse struct {
+	Budget RestoreHoldBudget
+	Wait   bool
+}
diff --git a/internal/restic/restore_load.go b/internal/restic/restore_load.go
new file mode 100644
index 0000000000000000000000000000000000000000..806f6169036df8bd5549e6568e296ce9a47b407a
--- /dev/null
+++ b/internal/restic/restore_load.go
@@ -0,0 +1,34 @@
+package restic
+
+import "context"
+
+// SmallRestoreBlobLimit bounds the needed blobs assigned to the extra restore
+// worker. Ciphertext has a separate allowance for encryption framing.
+const SmallRestoreBlobLimit = 1 << 20
+const SmallRestoreCiphertextLimit = SmallRestoreBlobLimit + 64
+
+// Medium uncompressed blobs borrow ciphertext storage. Compressed blobs also
+// own decoder output and scratch, so keep their existing smaller admission bound.
+const MediumRestoreBlobLimit = 3 << 20
+
+func BoundedRestoreBlob(plaintext, ciphertext uint, compressed bool) bool {
+	limit := uint(SmallRestoreBlobLimit)
+	if !compressed {
+		limit = MediumRestoreBlobLimit
+	}
+	return plaintext <= limit && ciphertext <= limit+64
+}
+
+type smallRestoreLoadKey struct{}
+
+// WithSmallRestoreLoad marks a stream with separate range-buffer ownership.
+// acquire reserves ordinary-worker allocation capacity for exceptional recovery.
+// Wrappers still receive and control the ordinary LoadBlobsFromPack call.
+func WithSmallRestoreLoad(ctx context.Context, acquire func(context.Context) (func(), error)) context.Context {
+	return context.WithValue(ctx, smallRestoreLoadKey{}, acquire)
+}
+
+func SmallRestoreLoad(ctx context.Context) (func(context.Context) (func(), error), bool) {
+	acquire, ok := ctx.Value(smallRestoreLoadKey{}).(func(context.Context) (func(), error))
+	return acquire, ok
+}
diff --git a/internal/restic/restore_load_budget_test.go b/internal/restic/restore_load_budget_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..eabdaf5879ad2b0eb5f5d078940ec879a0c14949
--- /dev/null
+++ b/internal/restic/restore_load_budget_test.go
@@ -0,0 +1,21 @@
+package restic
+
+import "testing"
+
+func TestBoundedRestoreBlobWorkingSet(t *testing.T) {
+	for _, tt := range []struct {
+		plain, cipher    uint
+		compressed, want bool
+	}{
+		{1 << 20, 1<<20 + 64, true, true},
+		{1<<20 + 1, 1 << 20, true, false},
+		{1 << 20, 1<<20 + 65, true, false},
+		{3 << 20, 3<<20 + 64, false, true},
+		{3<<20 + 1, 3 << 20, false, false},
+		{3 << 20, 3<<20 + 65, false, false},
+	} {
+		if got := BoundedRestoreBlob(tt.plain, tt.cipher, tt.compressed); got != tt.want {
+			t.Fatalf("%+v: got %v", tt, got)
+		}
+	}
+}
diff --git a/internal/restorer/bounded_restore_test.go b/internal/restorer/bounded_restore_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..714b908f7224ccb64de3f104555e41436801a867
--- /dev/null
+++ b/internal/restorer/bounded_restore_test.go
@@ -0,0 +1,106 @@
+package restorer
+
+import (
+	"context"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+type boundedTestBlob struct {
+	id, pack restic.ID
+	size     uint
+}
+
+func (b boundedTestBlob) PackID() restic.ID { return b.pack }
+func (b boundedTestBlob) Handle() restic.BlobHandle {
+	return restic.BlobHandle{ID: b.id, Type: restic.DataBlob}
+}
+func (b boundedTestBlob) CiphertextLength() uint             { return b.size }
+func (b boundedTestBlob) UncompressedCiphertextLength() uint { return b.size }
+func (b boundedTestBlob) PlaintextLength() uint              { return b.size }
+func (b boundedTestBlob) IsCompressed() bool                 { return false }
+
+// Three packs with a large needed blob occupy the three ordinary workers (the
+// configured two and the additional one); the small pack must still progress
+// on the bounded worker. Recovery admission needs an ordinary permit: it must
+// wait, and must terminate on cancellation.
+func TestBoundedRestoreProgressAndRecoveryCancellation(t *testing.T) {
+	if extraOrdinaryRestoreWorkers(2) != 1 {
+		t.Skip("needs a free core for the additional ordinary worker")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan bool, 4)
+	recovery := make(chan error, 1)
+	ordinaryReady := make(chan struct{})
+	var ordinaryStarted atomic.Int32
+	loader := func(ctx context.Context, _ restic.ID, _ []restic.BlobHandle, _ func(restic.BlobHandle, []byte, error) error) error {
+		acquire, bounded := restic.SmallRestoreLoad(ctx)
+		started <- bounded
+		if bounded {
+			<-ordinaryReady
+			release, err := acquire(ctx)
+			if err == nil {
+				release()
+			}
+			recovery <- err
+			return err
+		}
+		if ordinaryStarted.Add(1) == 3 {
+			close(ordinaryReady)
+		}
+		<-ctx.Done()
+		return ctx.Err()
+	}
+	blobs := make(map[restic.ID]boundedTestBlob)
+	lookup := func(h restic.BlobHandle) []restic.PackBlob { return []restic.PackBlob{blobs[h.ID]} }
+	r := newFileRestorer(t.TempDir(), loader, lookup, 2, false, false, nil, nil, restic.ID{})
+	r.additionalWorker = true
+	for i := 0; i < 4; i++ {
+		id := restic.Hash([]byte(fmt.Sprint("blob", i)))
+		pack := restic.Hash([]byte(fmt.Sprint("pack", i)))
+		size := uint(restic.MediumRestoreBlobLimit + 65)
+		if i == 3 {
+			size = 1
+		}
+		blobs[id] = boundedTestBlob{id: id, pack: pack, size: size}
+		r.addFile(fmt.Sprint(i), restic.IDs{id}, int64(size), nil)
+	}
+	done := make(chan error, 1)
+	go func() { done <- r.restoreFiles(ctx) }()
+	boundedCount := 0
+	for i := 0; i < 4; i++ {
+		select {
+		case bounded := <-started:
+			if bounded {
+				boundedCount++
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("bounded work did not progress")
+		}
+	}
+	if boundedCount != 1 {
+		t.Fatalf("bounded workers: %d", boundedCount)
+	}
+	select {
+	case err := <-recovery:
+		t.Fatalf("recovery bypassed occupied ordinary permits: %v", err)
+	default:
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err != context.Canceled {
+			t.Fatalf("restore: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("workers did not join")
+	}
+	if err := <-recovery; err != context.Canceled {
+		t.Fatalf("recovery: %v", err)
+	}
+}
