+package data
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+type readerTestLoader []byte
+
+func (b readerTestLoader) LoadBlob(context.Context, restic.BlobHandle, []byte) ([]byte, error) {
+	return b, nil
+}
+
+func TestTreeNodeReaderMatchesLoadTree(t *testing.T) {
+	for _, payload := range []string{
+		`{"nodes":[]}`,
+		`{"before":{"nested":1},"nodes":[{"name":"a","type":"file"},{"name":"b","type":"dir"}],"after":[]}`,
+		`{"nodes":[{"name":"a\\\\b","type":"symlink","linktarget_raw":"AP8="}]}`,
+		`{"nodes":[{"name":"a","type":"file"},{"name":1}]}`,
+		`{"nodes":[{"name":"a","type":"file"},{"name":`,
+		`{"nodes":[]`,
+		`{"nodes":[],"tail":`,
+		`{"nodes":false}`,
+		`[]`,
+	} {
+		t.Run(payload, func(t *testing.T) {
+			loader := readerTestLoader(payload)
+			ordinary, oe := LoadTree(context.Background(), loader, restic.ID{})
+			reader, re := LoadTreeNodeReader(context.Background(), loader, restic.ID{})
+			if fmt.Sprintf("%T:%v", oe, oe) != fmt.Sprintf("%T:%v", re, re) {
+				t.Fatalf("initial error differs: %v / %v", oe, re)
+			}
+			if oe != nil {
+				return
+			}
+			defer reader.Close()
+			for want := range ordinary {
+				got, ok := reader.Next()
+				if !ok || !reflect.DeepEqual(got.Node, want.Node) || fmt.Sprintf("%T:%v", got.Error, got.Error) != fmt.Sprintf("%T:%v", want.Error, want.Error) {
+					t.Fatalf("node/error differs: %#v / %#v", got, want)
+				}
+			}
+			if _, ok := reader.Next(); ok {
+				t.Fatal("reader yielded beyond ordinary termination")
+			}
+			if reader.payload != nil || !reader.ended || !reflect.DeepEqual(reader.tree, treeIterator{}) {
+				t.Fatal("reader did not release terminal state")
+			}
+		})
+	}
+}
+
+func TestTreeNodeReaderEarlyClose(t *testing.T) {
+	r, err := LoadTreeNodeReader(context.Background(), readerTestLoader(`{"nodes":[{"name":"a"},{"name":"b"}]}`), restic.ID{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := r.Next(); !ok {
+		t.Fatal("missing first node")
+	}
+	r.Close()
+	r.Close()
+	if _, ok := r.Next(); ok || r.payload != nil || !r.ended {
+		t.Fatal("closed reader retains or yields state")
+	}
+}
diff --git a/internal/data/tree_preparation_size.go b/internal/data/tree_preparation_size.go
new file mode 100644
index 0000000000000000000000000000000000000000..ad200067c5bdd20c9da780938c2eb811ed2af9a3
--- /dev/null
+++ b/internal/data/tree_preparation_size.go
@@ -0,0 +1,59 @@
+package data
+
+import "bytes"
+
+// PreparationSize reports a small, completely framed next JSON object without
+// interpreting it. It is only an allocation admission hint: Next remains the
+// authority for syntax, fields and errors. Unknown or large values stay on the
+// synchronous path. The scan allocates nothing and never changes decoder state.
+func (r *TreeNodeReader) PreparationSize(limit int) (int, bool) {
+	if r.ended || limit <= 0 {
+		return 0, false
+	}
+	start := int(r.tree.dec.InputOffset())
+	for start < len(r.payload) {
+		switch r.payload[start] {
+		case ' ', '\t', '\r', '\n', ',':
+			start++
+		default:
+			goto value
+		}
+	}
+value:
+	if start >= len(r.payload) || r.payload[start] != '{' {
+		return 0, false
+	}
+	depth := 0
+	end := min(len(r.payload), start+limit)
+	for i := start; i < end; i++ {
+		c := r.payload[i]
+		switch c {
+		case '"':
+			// Strings dominate ordinary node input (notably content IDs).
+			// Skip their interiors with the byte search instead of branching
+			// over every byte. An escaped quote does not close the string.
+			for {
+				n := bytes.IndexByte(r.payload[i+1:end], '"')
+				if n < 0 {
+					return 0, false
+				}
+				i += n + 1
+				escapes := 0
+				for j := i - 1; j >= start && r.payload[j] == '\\'; j-- {
+					escapes++
+				}
+				if escapes%2 == 0 {
+					break
+				}
+			}
+		case '{', '[':
+			depth++
+		case '}', ']':
+			depth--
+			if depth == 0 {
+				return i - start + 1, true
+			}
+		}
+	}
+	return 0, false
+}
diff --git a/internal/data/tree_preparation_size_test.go b/internal/data/tree_preparation_size_test.go
new file mode 100644
