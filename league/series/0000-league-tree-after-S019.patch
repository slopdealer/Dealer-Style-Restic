+package archiver
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+// A accepted first span returns an interior suffix on the next read. If that
+// suffix has no cut and extending it fails, cleanup must return the allocation
+// base, not the previous output's shorter capacity, to the pool.
+func TestB18FallbackReadErrorReclaimsAssembly(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input := b06Payload(32*1024*1024+173, 881)
+	ends := b18Cuts(input, pol, 13001)
+	a, b := ends[0], ends[1]-ends[0]+10
+	if a <= chunker.MinSize || b <= chunker.MinSize || a+b > 2<<20 {
+		t.Fatal("fixture does not admit a pair")
+	}
+	parent := &data.Node{}
+	sizes := make(map[restic.ID]uint)
+	for i, n := range []int{a, b, 1} {
+		id := restic.Hash([]byte{byte(i)})
+		parent.Content = append(parent.Content, id)
+		sizes[id] = uint(n)
+	}
+	factory := b18TrialFactory{pol}
+	g := &parentCutReader{parent: parent, factory: factory, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+	state := &fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: t.Context(), guided: g}
+	c := factory.NewChunker()
+	pool := newBufferPool(2 << 20)
+	buf := pool.Get()
+	base := &buf.Data[0]
+	sentinel := errors.New("read failure after paired prefix")
+	rd := &b18FailReader{r: bytes.NewReader(input), left: a + b, err: sentinel}
+	first, err := state.readNextChunk(rd, c, buf.Data)
+	if err != nil || len(first) != a || g.accepted != uint64(a) {
+		t.Fatalf("first len=%d accepted=%d err=%v", len(first), g.accepted, err)
+	}
+	buf.Data = first
+	interior, err := state.readNextChunk(rd, c, buf.Data)
+	if err != nil || len(interior) != b-10 || cap(interior) >= pool.defaultSize {
+		t.Fatalf("no interior fallback cut: len=%d cap=%d err=%v", len(interior), cap(interior), err)
+	}
+	buf.Data = interior
+	second, err := state.readNextChunk(rd, c, buf.Data)
+	if !errors.Is(err, sentinel) {
+		t.Fatalf("fallback returned len=%d err=%v", len(second), err)
+	}
+	g.reclaim(buf)
+	if cap(buf.Data) != pool.defaultSize || &buf.Data[:cap(buf.Data)][0] != base || g.pending != nil || g.root != nil {
+		t.Fatalf("lost base: capacity=%d want=%d", cap(buf.Data), pool.defaultSize)
+	}
+	buf.Release()
+	recycled := pool.Get()
+	defer recycled.Release()
+	if recycled != buf || cap(recycled.Data) != pool.defaultSize {
+		t.Fatal("assembly was not recycled intact")
+	}
+}
+
+// This scripted chunker isolates slice ownership from Rabin cut probabilities.
+// The real-cut test above separately checks this path with the pinned chunker.
+type b18ReclaimFactory struct{}
+
+func (b18ReclaimFactory) MaxChunkSize() int          { return 8 << 20 }
+func (b18ReclaimFactory) ZeroChunk() restic.ID       { return restic.ID{} }
+func (b18ReclaimFactory) NewChunker() restic.Chunker { return b18ReclaimChunker{} }
+
+type b18ReclaimChunker struct{}
+
+func (b18ReclaimChunker) Reset() {}
+func (b18ReclaimChunker) NextSplitPoint(p []byte) int {
+	if len(p) == 0 {
+		return -1
+	}
+	return len(p)
+}
+
+func TestB18NextPairReadErrorReclaimsAssembly(t *testing.T) {
+	const span = 600 << 10
+	parent := &data.Node{}
+	for i := 0; i < 5; i++ {
+		parent.Content = append(parent.Content, restic.Hash([]byte{byte(i)}))
+	}
+	g := &parentCutReader{parent: parent, factory: b18ReclaimFactory{}, lookup: func(restic.BlobHandle) (uint, bool) { return span, true }}
+	state := &fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: t.Context(), guided: g}
+	pool := newBufferPool(2 << 20)
+	buf := pool.Get()
+	base := &buf.Data[0]
+	failure := errors.New("second pair read interrupted")
+	rd := &b18FailReader{r: bytes.NewReader(make([]byte, 2*span)), left: 2 * span, err: failure}
+	c := g.factory.NewChunker()
+	for i := 0; i < 2; i++ {
+		out, err := state.readNextChunk(rd, c, buf.Data)
+		if err != nil || len(out) != span {
+			t.Fatalf("span %d: len=%d err=%v", i, len(out), err)
+		}
+		buf.Data = out
+	}
+	if cap(buf.Data) >= pool.defaultSize {
+		t.Fatal("fixture did not return interior output")
+	}
+	_, err := state.readNextChunk(rd, c, buf.Data)
+	if !errors.Is(err, failure) {
+		t.Fatal(err)
+	}
+	g.reclaim(buf)
+	if cap(buf.Data) != pool.defaultSize || &buf.Data[:cap(buf.Data)][0] != base {
+		t.Fatalf("second pair lost base: %d", cap(buf.Data))
+	}
+	buf.Release()
+	recycled := pool.Get()
+	defer recycled.Release()
+	if recycled != buf {
+		t.Fatal("second pair error did not recycle assembly")
+	}
+}
diff --git a/internal/archiver/parent_cut_reclaim_test.go b/internal/archiver/parent_cut_reclaim_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce28bfd59efeaff948dcbcf51f6f5cb8c0e28252
--- /dev/null
+++ b/internal/archiver/parent_cut_reclaim_test.go
@@ -0,0 +1,102 @@
+package archiver
+
+import (
+	"bytes"
+	"errors"
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+	"testing"
+)
+
+// An ordinary cut inside replay leaves an interior output in the saving buffer.
+// A later input failure must return the original assembly, including any growth,
+// rather than admitting that interior slice to the next file's buffer pool.
+func TestParentCutReplayErrorReclaimsAssembly(t *testing.T) {
+	for _, grow := range []bool{false, true} {
+		t.Run(map[bool]string{false: "existing", true: "grown"}[grow], func(t *testing.T) {
+			pool := newBufferPool(64)
+			buf := pool.Get()
+			root := buf.Data[:cap(buf.Data)]
+			copy(root, bytes.Repeat([]byte{7}, 64))
+			g := &parentCutReader{root: root, pending: root[16:48]}
+			state := &fileChunkState{readBuf: make([]byte, 64)}
+			c := &reclaimScriptChunker{split: 8}
+			out, err := g.pop(state, nil, c)
+			if err != nil || len(out) != 8 || &out[0] != &root[16] {
+				t.Fatal("missing interior replay output", err)
+			}
+			buf.Data = out
+			failure := errors.New("read failure after replay cut")
+			var input []byte
+			if grow {
+				input = bytes.Repeat([]byte{9}, 64)
+			}
+			c.split = -1
+			_, err = g.pop(state, &reclaimErrorReader{input: input, err: failure}, c)
+			if !errors.Is(err, failure) {
+				t.Fatal("input error changed", err)
+			}
+			g.reclaim(buf)
+			if cap(buf.Data) < 64 || (!grow && &buf.Data[:cap(buf.Data)][0] != &root[0]) {
+				t.Fatal("lost assembly base", cap(buf.Data))
+			}
+			if grow && cap(buf.Data) <= 64 {
+				t.Fatal("lost grown replay allocation")
+			}
+			buf.Release()
+			next := pool.Get()
+			defer next.Release()
+			if cap(next.Data) != 64 {
+				t.Fatal("interior assembly admitted to pool", cap(next.Data))
+			}
+		})
+	}
+}
+
+type reclaimScriptChunker struct{ split int }
+
+func (*reclaimScriptChunker) Reset()                      {}
+func (c *reclaimScriptChunker) NextSplitPoint([]byte) int { return c.split }
+
+type reclaimErrorReader struct {
+	input []byte
+	err   error
+}
+
+func (r *reclaimErrorReader) Read(p []byte) (int, error) {
+	if len(r.input) == 0 {
+		return 0, r.err
+	}
+	n := copy(p, r.input)
+	r.input = r.input[n:]
+	return n, nil
+}
+
+func TestParentCutPairReadErrorReclaimsAssembly(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	pool := newBufferPool(2 << 20)
+	buf := pool.Get()
+	root := buf.Data
+	// Model the caller's last output as an accepted interior span. The next
+	// pair transfers the full root back to reading before input can fail.
+	buf.Data = root[768<<10 : 1536<<10]
+	parent := &data.Node{Content: []restic.ID{{1}, {2}, {3}}}
+	g := &parentCutReader{root: root, parent: parent, factory: b18TrialFactory{pol}, lookup: func(restic.BlobHandle) (uint, bool) { return 768 << 10, true }}
+	state := &fileChunkState{readBuf: make([]byte, chunkReadBufSize)}
+	failure := errors.New("next pair input failed")
+	_, err := g.read(t.Context(), state, &reclaimErrorReader{err: failure}, g.factory.NewChunker(), buf.Data)
+	if !errors.Is(err, failure) {
+		t.Fatal(err)
+	}
+	g.reclaim(buf)
+	if cap(buf.Data) != cap(root) || &buf.Data[:cap(buf.Data)][0] != &root[0] {
+		t.Fatal("pair read error lost original assembly", cap(buf.Data))
+	}
+	buf.Release()
+	next := pool.Get()
+	defer next.Release()
+	if cap(next.Data) != pool.defaultSize {
+		t.Fatal("interior buffer admitted", cap(next.Data))
+	}
+}
diff --git a/internal/archiver/parent_cut_trial_test.go b/internal/archiver/parent_cut_trial_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f00aa57b1c521cae3bfebc796e6e0b4ab71097f
--- /dev/null
+++ b/internal/archiver/parent_cut_trial_test.go
@@ -0,0 +1,235 @@
+package archiver
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"sync"
+	"testing"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Research reference: input and output ownership stay with the caller. This is
+// deliberately not wired into saving files. At most two validators are active,
+// and every call joins them before its immutable input can be reused.
+type b18CutTrial struct {
+	c                                            [2]*chunker.BaseChunker
+	initial                                      chunker.BaseChunker
+	pol                                          chunker.Pol
+	parallel                                     bool
+	accepted, discarded, replay, scheduled, live int
+}
+
+func b18NewTrial(pol chunker.Pol, parallel bool) *b18CutTrial {
+	return &b18CutTrial{c: [2]*chunker.BaseChunker{chunker.NewBase(pol), chunker.NewBase(pol)}, initial: *chunker.NewBase(pol), pol: pol, parallel: parallel}
+}
+func (v *b18CutTrial) pair(ctx context.Context, input []byte, first int) ([2]int, error) {
+	result := [2]int{-1, -1}
+	if first <= 0 || first >= len(input) || len(input) > 2*1024*1024 {
+		return result, errors.New("invalid bounded pair")
+	}
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+	v.live = max(v.live, len(input))
+	scan := func(i int, b []byte) { *v.c[i] = v.initial; result[i] = v.c[i].NextSplitPoint(b) }
+	if v.parallel {
+		var wg sync.WaitGroup
+		wg.Add(1)
+		v.scheduled++
+		go func() { defer wg.Done(); scan(1, input[first:]) }()
+		scan(0, input[:first])
+		wg.Wait()
+	} else {
+		scan(0, input[:first])
+		scan(1, input[first:])
+	}
+	return result, ctx.Err()
+}
+
+// Parent endpoints are hints. After any failed prediction, replay from the
+// last proven cut using the current polynomial. Rejoin only at an exact hinted
+// start; EOF-only tails are never accepted as restart certificates.
+func (v *b18CutTrial) cuts(ctx context.Context, payload []byte, parent []int) ([]int, error) {
+	var ends []int
+	ordinary := chunker.NewBase(v.pol)
+	off, hint := 0, 0
+	for off < len(payload) {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		for hint < len(parent) && parent[hint] <= off {
+			hint++
+		}
+		start := 0
+		if hint > 0 {
+			start = parent[hint-1]
+		}
+		if hint+1 < len(parent)-1 && start == off && parent[hint] > off && parent[hint+1] > parent[hint] && parent[hint+1] <= len(payload) && parent[hint+1]-off <= 2*1024*1024 {
+			first, end := parent[hint]-off, parent[hint+1]
+			pair, err := v.pair(ctx, payload[off:end], first)
+			if err != nil {
+				return nil, err
+			}
+			if pair[0] == first {
+				off += first
+				ends = append(ends, off)
+				v.accepted += first
+				if pair[1] == end-off {
+					v.accepted += end - off
+					off = end
+					ends = append(ends, off)
+					continue
+				}
+				v.discarded += end - off
+				v.replay += end - off
+			} else {
+				v.discarded += end - off
+				v.replay += end - off
+			}
+		}
+		*ordinary = v.initial
+		n := ordinary.NextSplitPoint(payload[off:])
+		if n < 0 {
+			n = len(payload) - off
+		}
+		off += n
+		ends = append(ends, off)
+	}
+	return ends, nil
+}
+func b18ContentIDs(payload []byte, ends []int) []restic.ID {
+	ids := make([]restic.ID, 0, len(ends))
+	start := 0
+	for _, end := range ends {
+		ids = append(ids, restic.Hash(payload[start:end]))
+		start = end
+	}
+	return ids
+}
+func TestB18ConditionalCutTrial(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	original := b06Payload(32*1024*1024+173, 881)
+	parent := b18Cuts(original, pol, 13001)
+	mutated := bytes.Clone(original)
+	for i := 700000; i < 710000; i++ {
+		mutated[i] ^= 77
+	}
+	grown := append(bytes.Clone(original), b06Payload(2*1024*1024, 881)...)
+	var reciprocal chunker.Pol
+	for p := pol; p != 0; p >>= 1 {
+		reciprocal = (reciprocal << 1) | (p & 1)
+	}
+	for _, tc := range []struct {
+		name  string
+		data  []byte
+		hints []int
+		pol   chunker.Pol
+	}{
+		{"unchanged", original, parent, pol}, {"mutation", mutated, parent, pol}, {"growth", grown, parent, pol}, {"truncation", original[:700003], parent, pol},
+		{"other-polynomial", original, parent, reciprocal}, {"missing", original, nil, pol}, {"zero", original, []int{0, 0, 0}, pol},
+		{"oversized", original, []int{9 * 1024 * 1024, 18 * 1024 * 1024, len(original)}, pol}, {"overflow", original, []int{int(^uint(0) >> 1), -1, len(original)}, pol},
+		{"EOF-tail-growth", grown, []int{len(original), len(grown)}, pol},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			want := b18Cuts(tc.data, tc.pol, 13001)
+			for _, parallel := range []bool{false, true} {
+				v := b18NewTrial(tc.pol, parallel)
+				got, err := v.cuts(t.Context(), tc.data, tc.hints)
+				if err != nil || !slices.Equal(got, want) || !slices.Equal(b18ContentIDs(tc.data, got), b18ContentIDs(tc.data, want)) {
+					t.Fatalf("parallel=%v cuts %v vs %v err=%v", parallel, got, want, err)
+				}
+				if v.live > 2*1024*1024 {
+					t.Fatal("capacity exceeded")
+				}
+				t.Logf("parallel=%v bytes=%d accepted=%d discarded=%d replay=%d scheduled=%d max_payload=%d", parallel, len(tc.data), v.accepted, v.discarded, v.replay, v.scheduled, v.live)
+			}
+		})
+	}
+}
+func TestB18ConditionalCutCancellation(t *testing.T) {
+	v := b18NewTrial(0x3DA3358B4DC173, true)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, err := v.pair(ctx, make([]byte, 1024*1024), 524288); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	// A scan may finish after cancellation, but pair must join before returning.
+	for i := 0; i < 30; i++ {
+		ctx, cancel := context.WithCancel(t.Context())
+		done := make(chan struct{})
+		go func() { defer close(done); _, _ = v.pair(ctx, make([]byte, 1024*1024), 524288) }()
+		cancel()
+		<-done
+	}
+}
+
+// This isolates the scan/coordination cost, with no speculative content hashing.
+// Same input, same initialized workers, same two scans in both cases.
+func BenchmarkB18CutPair(b *testing.B) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input := b06Payload(2*1024*1024, 881)
+	for _, size := range []int{524288, 786432, 1048576} {
+		for _, parallel := range []bool{false, true} {
+			b.Run(fmt.Sprintf("%d/parallel=%v", size, parallel), func(b *testing.B) {
+				v := b18NewTrial(pol, parallel)
+				ctx := context.Background()
+				b.SetBytes(int64(2 * size))
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					if _, err := v.pair(ctx, input[:2*size], size); err != nil {
+						b.Fatal(err)
+					}
+				}
+			})
+		}
+	}
+}
+
+// Streaming reference for the next construction: short reads must not change
+// endpoints. This uses ordinary fileChunkState, not an untested new read path.
+func TestB18CutShortReadReference(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	payload := b06Payload(2*1024*1024+173, 881)
+	rd := &b18TrialShortReader{r: bytes.NewReader(payload), limit: 37}
+	state := fileChunkState{readBuf: make([]byte, chunkReadBufSize)}
+	c := &b18TrialChunker{chunker.NewBase(pol), pol}
+	var ends []int
+	offset := 0
+	scratch := make([]byte, 0, 2*1024*1024)
+	for {
+		data, err := state.readNextChunk(rd, c, scratch)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		offset += len(data)
+		ends = append(ends, offset)
+		scratch = data
+	}
+	if !slices.Equal(ends, b18Cuts(payload, pol, 13001)) {
+		t.Fatal(ends)
+	}
+}
+
+type b18TrialShortReader struct {
+	r     io.Reader
+	limit int
+}
+
+func (r *b18TrialShortReader) Read(p []byte) (int, error) { return r.r.Read(p[:min(len(p), r.limit)]) }
+
+type b18TrialChunker struct {
+	*chunker.BaseChunker
+	pol chunker.Pol
+}
+
+func (c *b18TrialChunker) Reset() { c.BaseChunker.Reset(c.pol) }
