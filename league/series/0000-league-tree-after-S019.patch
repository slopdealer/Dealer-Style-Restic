index 0000000000000000000000000000000000000000..3a09dd5ab06ee7ba8d0ed3e344de522fe909471b
--- /dev/null
+++ b/internal/repository/index/index_decode_eager.go
@@ -0,0 +1,206 @@
+package index
+
+import (
+	"bytes"
+	"math"
+
+	"github.com/restic/restic/internal/debug"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// decodeIndexEager keeps the ordinary decoder as the compatibility authority.
+// Only the canonical serialization is interpreted directly. Validation settles
+// the entire document before lookup storage exists, including storage overflow.
+// Fallback therefore holds no partial index or typed pack/blob representation.
+func decodeIndexEager(buf []byte, id restic.ID) (*Index, error) {
+	// Preserve the ordinary decoder's instrumentation sites and debug filters.
+	if debug.IsEnabled() {
+		return DecodeIndex(buf, id)
+	}
+	if idx, ok := decodeCanonicalIndex(buf, id); ok {
+		return idx, nil
+	}
+	return DecodeIndex(buf, id)
+}
+
+func decodeCanonicalIndex(buf []byte, id restic.ID) (*Index, bool) {
+	p := canonicalIndexParser{buf: buf}
+	if !p.document(nil) {
+		return nil, false
+	}
+	idx := NewIndex()
+	if p.packs > 0 {
+		idx.packs = make(restic.IDs, 0, p.packs)
+	}
+	for typ, count := range p.counts {
+		idx.Preallocate(restic.BlobType(typ), count)
+	}
+	// The same immutable plaintext is scanned again. No offsets table or typed
+	// records survive the first pass; IDs are decoded only during emission.
+	p = canonicalIndexParser{buf: buf}
+	if !p.document(idx) {
+		return nil, false
+	}
+	idx.ids = append(idx.ids, id)
+	idx.final = true
+	return idx, true
+}
+
+type canonicalIndexParser struct {
+	buf    []byte
+	pos    int
+	packs  int
+	counts [restic.NumBlobTypes]int
+}
+
+func (p *canonicalIndexParser) take(s string) bool {
+	if !bytes.HasPrefix(p.buf[p.pos:], []byte(s)) {
+		return false
+	}
+	p.pos += len(s)
+	return true
+}
+
+func (p *canonicalIndexParser) id(dst *restic.ID) bool {
+	if !p.take(`"`) || len(p.buf)-p.pos < 65 {
+		return false
+	}
+	s := p.buf[p.pos : p.pos+64]
+	if !canonicalHexID(s, dst) {
+		return false
+	}
+	p.pos += 64
+	if !p.take(`"`) {
+		return false
+	}
+	return true
+}
+
+func (p *canonicalIndexParser) number() (uint, bool) {
+	start := p.pos
+	var n uint64
+	for p.pos < len(p.buf) {
+		ch := p.buf[p.pos]
+		if ch < '0' || ch > '9' {
+			break
+		}
+		n = n*10 + uint64(ch-'0')
+		if n > math.MaxUint32 {
+			return 0, false
+		}
+		p.pos++
+	}
+	if p.pos == start || p.pos-start > 1 && p.buf[start] == '0' {
+		return 0, false
+	}
+	return uint(n), true
+}
+
+func (p *canonicalIndexParser) blob(idx *Index, packIndex uint32) bool {
+	if !p.take(`{"id":`) {
+		return false
+	}
+	var blob pack.Blob
+	var dst *restic.ID
+	if idx != nil {
+		dst = &blob.ID
+	}
+	if !p.id(dst) || !p.take(`,"type":`) {
+		return false
+	}
+	if p.take(`"data"`) {
+		blob.Type = restic.DataBlob
+	} else if p.take(`"tree"`) {
+		blob.Type = restic.TreeBlob
+	} else {
+		return false
+	}
+	if !p.take(`,"offset":`) {
+		return false
+	}
+	var ok bool
+	if blob.Offset, ok = p.number(); !ok || !p.take(`,"length":`) {
+		return false
+	}
+	if blob.Length, ok = p.number(); !ok {
+		return false
+	}
+	if p.take(`,"uncompressed_length":`) {
+		if blob.UncompressedLength, ok = p.number(); !ok {
+			return false
+		}
+	}
+	if !p.take(`}`) {
+		return false
+	}
+	p.counts[blob.Type]++
+	if idx != nil {
+		idx.store(packIndex, blob)
+	}
+	return true
+}
+
+func (p *canonicalIndexParser) pack(idx *Index) bool {
+	if !p.take(`{"id":`) {
+		return false
+	}
+	var id restic.ID
+	var dst *restic.ID
+	if idx != nil {
+		dst = &id
+	}
+	if !p.id(dst) || !p.take(`,"blobs":[`) {
+		return false
+	}
+	p.packs++
+	if uint64(p.packs) > math.MaxUint32 {
+		return false
+	}
+	var packIndex uint32
+	if idx != nil {
+		packIndex = idx.addToPacks(id)
+	}
+	if !p.take(`]`) {
+		for {
+			if !p.blob(idx, packIndex) {
+				return false
+			}
+			if p.take(`]`) {
+				break
+			}
+			if !p.take(`,`) {
+				return false
+			}
+		}
+	}
+	return p.take(`}`)
+}
+
+func (p *canonicalIndexParser) document(idx *Index) bool {
+	if !p.take(`{"packs":[`) {
+		return false
+	}
+	if !p.take(`]`) {
+		for {
+			if !p.pack(idx) {
+				return false
+			}
+			if p.take(`]`) {
+				break
+			}
+			if !p.take(`,`) {
+				return false
+			}
+		}
+	}
+	if !p.take(`}`) {
+		return false
+	}
+	for _, ch := range p.buf[p.pos:] {
+		if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t' {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/repository/index/index_decode_reader.go b/internal/repository/index/index_decode_reader.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f0fb7c4b306c4e94ad75b8e7fe65f988311732e
--- /dev/null
+++ b/internal/repository/index/index_decode_reader.go
@@ -0,0 +1,143 @@
+package index
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// DecodeIndexReader attempts to decode a single-field packs document without
+// retaining all its plaintext or typed packs. On false, the caller must use
+// DecodeIndex on the complete plaintext to preserve diagnostics and precedence.
+// No partial index is returned, including on a read error after the document.
+func DecodeIndexReader(rd io.Reader, id restic.ID) (*Index, bool) {
+	return decodeIndexReaderLimited(rd, id, 16*1024*1024*1024)
+}
+
+func decodeIndexReaderLimited(rd io.Reader, id restic.ID, maxBytes uint64) (*Index, bool) {
+	guard := &indexJSONGuardReader{rd: rd, maxBytes: maxBytes}
+	dec := json.NewDecoder(guard)
+	if tok, err := dec.Token(); err != nil || tok != json.Delim('{') {
+		return nil, false
+	}
+	if tok, err := dec.Token(); err != nil || tok != "packs" {
+		return nil, false
+	}
+	if tok, err := dec.Token(); err != nil || tok != json.Delim('[') {
+		return nil, false
+	}
+	idx := NewIndex()
+	var scratch packJSON
+	for dec.More() {
+		clear(scratch.Blobs[:cap(scratch.Blobs)])
+		scratch = packJSON{Blobs: scratch.Blobs[:0]}
+		if err := dec.Decode(&scratch); err != nil {
+			return nil, false
+		}
+		for _, blob := range scratch.Blobs {
+			if blob.Type >= restic.NumBlobTypes || blob.Offset > math.MaxUint32 || blob.Length > math.MaxUint32 || blob.UncompressedLength > math.MaxUint32 {
+				return nil, false
+			}
+		}
+		// Defer any pack-count overflow panic until eager parsing has resolved
+		// errors later in the complete document.
+		if uint64(len(idx.packs)) >= math.MaxUint32 {
+			return nil, false
+		}
+		packID := idx.addToPacks(scratch.ID)
+		for _, blob := range scratch.Blobs {
+			idx.store(packID, pack.Blob{
+				BlobHandle: restic.BlobHandle{Type: blob.Type, ID: blob.ID},
+				Offset:     blob.Offset, Length: blob.Length,
+				UncompressedLength: blob.UncompressedLength,
+			})
+		}
+	}
+	if tok, err := dec.Token(); err != nil || tok != json.Delim(']') {
+		return nil, false
+	}
+	if tok, err := dec.Token(); err != nil || tok != json.Delim('}') {
+		return nil, false
+	}
+	// Decode(&extra) could retain an arbitrarily long whitespace trailer. Check
+	// buffered and remaining bytes with bounded scratch, preserving terminal
+	// reader errors already observed by Decoder during read-ahead.
+	var tail [8192]byte
+	_, err := io.CopyBuffer(indexJSONWhitespaceWriter{}, io.MultiReader(dec.Buffered(), guard), tail[:])
+	if err != nil || guard.failed != nil {
+		return nil, false
+	}
+	idx.ids = append(idx.ids, id)
+	idx.final = true
+	return idx, true
+}
+
+var errIndexJSONStreamGuard = errors.New("index JSON stream exceeds eager limits")
+var errIndexJSONTrailing = errors.New("non-whitespace after index JSON")
+
+// Eager JSON limits nesting over the complete document. Enforce that limit
+// independently of whether this Go build's Decoder counts enclosing tokens
+// during per-pack decoding. Count all output bytes as well, matching the
+// DecodeAll cumulative output ceiling.
+type indexJSONGuardReader struct {
+	rd              io.Reader
+	maxBytes, bytes uint64
+	depth           int
+	quoted, escaped bool
+	failed          error
+}
+
+func (r *indexJSONGuardReader) Read(p []byte) (int, error) {
+	if r.failed != nil {
+		return 0, r.failed
+	}
+	n, err := r.rd.Read(p)
+	if uint64(n) > r.maxBytes-r.bytes {
+		r.failed = errIndexJSONStreamGuard
+		return n, r.failed
+	}
+	r.bytes += uint64(n)
+	for _, ch := range p[:n] {
+		if r.quoted {
+			if r.escaped {
+				r.escaped = false
+			} else if ch == '\\' {
+				r.escaped = true
+			} else if ch == '"' {
+				r.quoted = false
+			}
+		} else {
+			switch ch {
+			case '"':
+				r.quoted = true
+			case '{', '[':
+				r.depth++
+				if r.depth > 10000 {
+					r.failed = errIndexJSONStreamGuard
+					return n, r.failed
+				}
+			case '}', ']':
+				r.depth--
+			}
+		}
+	}
+	if err != nil && err != io.EOF {
+		r.failed = err
+	}
+	return n, err
+}
+
+type indexJSONWhitespaceWriter struct{}
+
+func (indexJSONWhitespaceWriter) Write(p []byte) (int, error) {
+	for i, ch := range p {
+		if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t' {
+			return i, errIndexJSONTrailing
+		}
+	}
+	return len(p), nil
+}
diff --git a/internal/repository/index/index_decode_reader_test.go b/internal/repository/index/index_decode_reader_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..200f61d611ac09598633a77d088e18fc698a1673
--- /dev/null
+++ b/internal/repository/index/index_decode_reader_test.go
@@ -0,0 +1,204 @@
+package index
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Short and terminal-error readers exercise publication only after full settlement.
+type diagnosticShortReader struct {
+	io.Reader
+	limit int
+}
+
+func (r diagnosticShortReader) Read(p []byte) (int, error) {
+	if len(p) > r.limit {
+		p = p[:r.limit]
+	}
+	return r.Reader.Read(p)
+}
+
+type diagnosticErrorReader struct{ data []byte }
+
+func (r *diagnosticErrorReader) Read(p []byte) (int, error) {
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	if len(r.data) == 0 {
+		return n, fmt.Errorf("terminal stream error")
+	}
+	return n, nil
+}
+
+func diagnosticPerPackAccepted(rd io.Reader) bool {
+	d := json.NewDecoder(rd)
+	for _, want := range []any{json.Delim('{'), "packs", json.Delim('[')} {
+		if tok, err := d.Token(); err != nil || tok != want {
+			return false
+		}
+	}
+	for d.More() {
+		var p packJSON
+		if err := d.Decode(&p); err != nil {
+			return false
+		}
+	}
+	for _, want := range []any{json.Delim(']'), json.Delim('}')} {
+		if tok, err := d.Token(); err != nil || tok != want {
+			return false
+		}
+	}
+	var extra json.RawMessage
+	return d.Decode(&extra) == io.EOF
+}
+
+func TestDecodeIndexReaderCompatibility(t *testing.T) {
+	id := restic.Hash([]byte("reader identity"))
+	for _, input := range diagnosticDecodeCases() {
+		for _, size := range []int{1, 7, 1024} {
+			decode := func(buf []byte, id restic.ID) (*Index, error) {
+				idx, ok := DecodeIndexReader(diagnosticShortReader{bytes.NewReader(buf), size}, id)
+				if !ok {
+					if idx != nil {
+						panic("published partial reader index")
+					}
+					return DecodeIndex(buf, id)
+				}
+				return idx, nil
+			}
+			got := diagnosticDecodeOutcome(decode, []byte(input))
+			want := diagnosticDecodeOutcome(DecodeIndex, []byte(input))
+			if !reflect.DeepEqual(got, want) {
+				panic("streaming decoder differs on " + input)
+			}
+		}
+	}
+	for _, n := range []int{9996, 9997, 9998, 10000} {
+		input := `{"packs":[{"ignored":` + strings.Repeat("[", n) + `0` + strings.Repeat("]", n) + `}]}`
+		_, eagerErr := DecodeIndex([]byte(input), id)
+		_, guardedOK := DecodeIndexReader(diagnosticShortReader{strings.NewReader(input), 7}, id)
+		if guardedOK != (eagerErr == nil) {
+			panic(fmt.Sprintf("depth %d: eager=%v guarded=%v", n, eagerErr, guardedOK))
+		}
+	}
+	for _, input := range []string{`{"packs":[]}`, `{"packs":[]} `, `{"packs":[]}true`} {
+		if idx, ok := DecodeIndexReader(&diagnosticErrorReader{data: []byte(input)}, id); ok || idx != nil {
+			panic("reader accepted terminal error")
+		}
+	}
+	if _, ok := decodeIndexReaderLimited(strings.NewReader(`{"packs":[]}`+strings.Repeat(" ", 100)), id, 64); ok {
+		panic("cumulative byte limit not enforced")
+	}
+	enc, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1), zstd.WithEncoderLevel(zstd.SpeedFastest), zstd.WithWindowSize(1024))
+	if err != nil {
+		panic(err)
+	}
+	first := enc.EncodeAll([]byte(`{"packs":[]}`+strings.Repeat(" ", 600000)), nil)
+	frames := append(first, enc.EncodeAll([]byte(strings.Repeat(" ", 600000)), nil)...)
+	enc.Close()
+	opts := []zstd.DOption{zstd.WithDecoderConcurrency(1), zstd.WithDecoderMaxMemory(1024 * 1024)}
+	dec, err := zstd.NewReader(nil, opts...)
+	if err != nil {
+		panic(err)
+	}
+	if _, err := dec.DecodeAll(frames, nil); err == nil {
+		panic("DecodeAll did not enforce cumulative output ceiling")
+	}
+	dec.Close()
+	dec, err = zstd.NewReader(bytes.NewReader(frames), opts...)
+	if err != nil {
+		panic(err)
+	}
+	if _, ok := DecodeIndexReader(dec, id); !ok {
+		panic("streaming did not expose lower-limit cumulative discrepancy")
+	}
+	dec.Close()
+	dec, err = zstd.NewReader(bytes.NewReader(frames), opts...)
+	if err != nil {
+		panic(err)
+	}
+	if _, ok := decodeIndexReaderLimited(dec, id, 1024*1024); ok {
+		panic("guarded reader accepted oversized concatenated output")
+	}
+	dec.Close()
+}
+
+func TestDecodeIndexReaderDepthEngine(t *testing.T) {
+	for _, n := range []int{9997, 9998} {
+		input := `{"packs":[{"ignored":` + strings.Repeat("[", n) + `0` + strings.Repeat("]", n) + `}]}`
+		_, err := DecodeIndex([]byte(input), restic.ID{})
+		t.Logf("n=%d eager=%v unguarded=%v", n, err, diagnosticPerPackAccepted(strings.NewReader(input)))
+	}
+}
+
+func FuzzDecodeIndexReaderCompatibility(f *testing.F) {
+	for _, input := range diagnosticDecodeCases() {
+		f.Add([]byte(input))
+	}
+	f.Fuzz(func(t *testing.T, input []byte) {
+		if len(input) > 65536 {
+			t.Skip()
+		}
+		decode := func(buf []byte, id restic.ID) (*Index, error) {
+			idx, ok := DecodeIndexReader(diagnosticShortReader{bytes.NewReader(buf), 7}, id)
+			if !ok {
+				if idx != nil {
+					t.Fatal("partial index")
+				}
+				return DecodeIndex(buf, id)
+			}
+			return idx, nil
+		}
+		got := diagnosticDecodeOutcome(decode, input)
+		want := diagnosticDecodeOutcome(DecodeIndex, input)
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("input=%q got=%+v want=%+v", input, got, want)
+		}
+	})
+}
+
+func TestDecodeIndexReaderFastPathAndSettlement(t *testing.T) {
+	id := restic.Hash([]byte("identity"))
+	inputs := diagnosticDecodeCases()[:8]
+	blob := `{"id":"` + strings.Repeat("2", 64) + `","type":"tree","offset":5,"length":31}`
+	p := `{"id":"` + strings.Repeat("1", 64) + `","blobs":[` + blob + `]}`
+	inputs = append(inputs, `{"packs":[`+strings.Repeat(p+",", 999)+p+`]}`)
+	p = `{"id":"` + strings.Repeat("1", 64) + `","blobs":[` + strings.Repeat(blob+",", 999) + blob + `]}`
+	inputs = append(inputs, `{"packs":[`+p+`,{"blobs":[{}]}]}`)
+	for _, input := range inputs {
+		idx, ok := DecodeIndexReader(diagnosticShortReader{strings.NewReader(input), 7}, id)
+		if !ok || idx == nil {
+			t.Fatalf("supported shape missed stream path: %.200s", input)
+		}
+		decode := func([]byte, restic.ID) (*Index, error) { return idx, nil }
+		// The outcome helper uses a fixed identity, so compare with that identity.
+		want := diagnosticDecodeOutcome(DecodeIndex, []byte(input))
+		idx.ids = want.ids
+		got := diagnosticDecodeOutcome(decode, nil)
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("pack result differs: got=%+v want=%+v", got, want)
+		}
+	}
+	representative := inputs[0]
+	for end := range len(representative) {
+		if idx, ok := DecodeIndexReader(strings.NewReader(representative[:end]), id); ok || idx != nil {
+			t.Fatalf("accepted truncation %d", end)
+		}
+	}
+	// Neither a long trailer nor an error delivered only after it can complete a
+	// partial or invalid index. The whitespace scan does not use Decode(&extra).
+	trailer := `{"packs":[]}` + strings.Repeat(" \n\r\t", 1<<18)
+	if _, ok := DecodeIndexReader(strings.NewReader(trailer), id); !ok {
+		t.Fatal("valid whitespace trailer rejected")
+	}
+	if idx, ok := DecodeIndexReader(&diagnosticErrorReader{data: []byte(trailer)}, id); ok || idx != nil {
+		t.Fatal("late terminal error ignored")
+	}
+}
