@@ -0,0 +1,245 @@
+package repository
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/index"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// This is the selected-base pipe implementation, with optional producer
+// buffering as a competing construction. It remains independent of the new
+// verification helper. Decoder errors precede encoder errors; only successful
+// encoding drains the remaining decoder output.
+func verifyIndexPipeReference(compressed []byte, encode func(io.Writer) error, buffered bool) error {
+	dec, err := zstd.NewReader(bytes.NewReader(compressed), zstd.WithDecoderConcurrency(1), zstd.WithDecoderMaxMemory(16*1024*1024*1024))
+	if err != nil {
+		return fmt.Errorf("decompression failed: %w", err)
+	}
+	defer dec.Close()
+	expected, writer := io.Pipe()
+	done := make(chan error, 1)
+	go func() {
+		var encodeErr error
+		if buffered {
+			w := bufio.NewWriterSize(writer, 32*1024)
+			encodeErr = encode(w)
+			// Flush even on encoder failure: otherwise the accepted prefix is
+			// lost and decoder/encoder error precedence can change.
+			flushErr := w.Flush()
+			if encodeErr == nil {
+				encodeErr = flushErr
+			}
+		} else {
+			encodeErr = encode(writer)
+		}
+		_ = writer.CloseWithError(encodeErr)
+		done <- encodeErr
+	}()
+	cmp := streamCompareWriter{actual: dec, buf: make([]byte, 32*1024), equal: true}
+	_, copyErr := io.Copy(&cmp, expected)
+	_ = expected.Close()
+	encodeErr := <-done
+	if cmp.err != nil {
+		return fmt.Errorf("decompression failed: %w", cmp.err)
+	}
+	if encodeErr != nil {
+		return fmt.Errorf("encoding failed: %w", encodeErr)
+	}
+	if copyErr != nil {
+		return fmt.Errorf("encoding failed: %w", copyErr)
+	}
+	extra, err := io.Copy(io.Discard, dec)
+	if err != nil {
+		return fmt.Errorf("decompression failed: %w", err)
+	}
+	if extra != 0 || !cmp.equal {
+		return errors.New("data mismatch")
+	}
+	return nil
+}
+
+func TestIndexVerifyDirectBoundaries(t *testing.T) {
+	enc, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1), zstd.WithEncoderCRC(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer enc.Close()
+	data := bytes.Repeat([]byte("index\x00entry\xff,"), 9000)
+	frame := enc.EncodeAll(data, nil)
+	badCRC := bytes.Clone(frame)
+	badCRC[len(badCRC)-1] ^= 0xff
+	concat := enc.EncodeAll(data[:12345], nil)
+	concat = append(concat, enc.EncodeAll(data[12345:], nil)...)
+	for _, tc := range []struct {
+		name                 string
+		compressed, expected []byte
+		want                 string
+	}{
+		{"equal", frame, data, ""},
+		{"empty", enc.EncodeAll(nil, nil), nil, ""},
+		{"short", frame, data[:len(data)-1], "data mismatch"},
+		{"long", frame, append(bytes.Clone(data), 'x'), "data mismatch"},
+		{"mismatch", frame, bytes.Repeat([]byte("x"), len(data)), "data mismatch"},
+		{"concatenated", concat, data, ""},
+		{"checksum", badCRC, data, "decompression failed:"},
+		{"checksum after mismatch", badCRC, bytes.Repeat([]byte("x"), len(data)), "decompression failed:"},
+		{"checksum on drain", badCRC, nil, "decompression failed:"},
+		{"trailing junk", append(bytes.Clone(frame), 0xde, 0xad), data, "decompression failed:"},
+		{"truncated", frame[:len(frame)-1], data, "decompression failed:"},
+	} {
+		for _, fragment := range []int{1, 7, 32768, 65537, len(data) + 1} {
+			t.Run(fmt.Sprintf("%s/%d", tc.name, fragment), func(t *testing.T) {
+				encode := func(w io.Writer) error {
+					for off := 0; off < len(tc.expected); {
+						end := min(off+fragment, len(tc.expected))
+						if _, err := w.Write(tc.expected[off:end]); err != nil {
+							return err
+						}
+						off = end
+					}
+					return nil
+				}
+				got := verifyCompressedIndexStream(tc.compressed, encode)
+				ref := verifyIndexPipeReference(tc.compressed, encode, false)
+				buffered := verifyIndexPipeReference(tc.compressed, encode, true)
+				if errorText(got) != errorText(ref) || errorText(got) != errorText(buffered) {
+					t.Fatalf("direct %v, reference %v, buffered %v", got, ref, buffered)
+				}
+				if tc.want == "" && got != nil || tc.want != "" && (got == nil || !bytes.HasPrefix([]byte(got.Error()), []byte(tc.want))) {
+					t.Fatalf("got %v, want %q", got, tc.want)
+				}
+			})
+		}
+	}
+}
+
+func errorText(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
+
+func TestIndexVerifyDirectEncoderFailures(t *testing.T) {
+	enc, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1), zstd.WithEncoderCRC(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer enc.Close()
+	data := bytes.Repeat([]byte("payload"), 10000)
+	frame := enc.EncodeAll(data, nil)
+	bad := bytes.Clone(frame)
+	bad[len(bad)-1] ^= 0xff
+	wantErr := errors.New("encoder failure")
+	for _, compressed := range [][]byte{frame, bad, {0xff}} {
+		for _, prefix := range []int{0, 1, 32768, len(data)} {
+			encode := func(w io.Writer) error {
+				if _, err := w.Write(data[:prefix]); err != nil {
+					return err
+				}
+				return wantErr
+			}
+			got := verifyCompressedIndexStream(compressed, encode)
+			ref := verifyIndexPipeReference(compressed, encode, false)
+			buffered := verifyIndexPipeReference(compressed, encode, true)
+			if errorText(got) != errorText(ref) || errorText(got) != errorText(buffered) {
+				t.Fatalf("prefix %d: direct %v, reference %v, buffered %v", prefix, got, ref, buffered)
+			}
+			if got == nil {
+				t.Fatal("encoder failure accepted")
+			}
+		}
+	}
+}
+
+func TestIndexVerifyDirectAuthenticationAndCancellation(t *testing.T) {
+	repo, _ := TestRepositoryWithBackend(t, nil, 2, Options{})
+	// Authentication failure must not invoke the encoder.
+	buf := sealUnpackedForTest(t, repo, []byte{2, 0xff})
+	buf[len(buf)-1] ^= 1
+	if err := repo.verifyCompressedIndexStream(buf, func(io.Writer) error { t.Fatal("encoder called before authentication"); return nil }); err == nil {
+		t.Fatal("unauthenticated ciphertext accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := repo.saveIndexStream(ctx, func(w io.Writer) error { _, err := w.Write([]byte("{\"packs\":[]}\n")); return err })
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled save: %v", err)
+	}
+}
+
+// Full save includes both index encodes, compression, encryption, verification,
+// ciphertext hashing and backend Save. The reference and buffered arms differ
+// only in verification, not in the first encoding or persisted representation.
+func BenchmarkIndexVerifyCompleteSave(b *testing.B) {
+	for _, shape := range []struct{ packs, blobs int }{{1000, 1}, {10, 1000}} {
+		idx := index.NewIndex()
+		for i := 0; i < shape.packs; i++ {
+			blobs := make(pack.Blobs, shape.blobs)
+			for j := range blobs {
+				blobs[j] = pack.Blob{BlobHandle: restic.BlobHandle{Type: restic.DataBlob, ID: restic.Hash([]byte(fmt.Sprint(i, ":", j)))}, Offset: uint(j * 1234), Length: 1234}
+			}
+			idx.StorePack(restic.Hash([]byte(fmt.Sprint("pack", i))), blobs)
+		}
+		for _, mode := range []string{"direct", "pipe", "buffered"} {
+			b.Run(fmt.Sprintf("packs%d-blobs%d/%s", shape.packs, shape.blobs, mode), func(b *testing.B) {
+				repo, _ := TestRepositoryWithBackend(b, nil, 2, Options{})
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					if mode == "direct" {
+						id, err := repo.saveIndexStream(context.Background(), idx.Encode)
+						if err != nil {
+							b.Fatal(err)
+						}
+						if err := repo.be.Remove(context.Background(), backend.Handle{Type: backend.IndexFile, Name: id.String()}); err != nil {
+							b.Fatal(err)
+						}
+						continue
+					}
+					var payload bytes.Buffer
+					payload.WriteByte(2)
+					enc, err := zstd.NewWriter(&payload, zstd.WithEncoderLevel(repo.zstdEncoderLevel()), zstd.WithEncoderCRC(false), zstd.WithWindowSize(512*1024), zstd.WithEncoderConcurrency(1))
+					if err != nil {
+						b.Fatal(err)
+					}
+					if err := idx.Encode(enc); err != nil {
+						b.Fatal(err)
+					}
+					if err := enc.Close(); err != nil {
+						b.Fatal(err)
+					}
+					nonce := crypto.NewRandomNonce()
+					ciphertext := crypto.NewBlobBuffer(payload.Len())[:0]
+					ciphertext = append(ciphertext, nonce...)
+					ciphertext = repo.key.Seal(ciphertext, nonce, payload.Bytes(), nil)
+					plain, err := repo.key.Open(nil, nonce, ciphertext[len(nonce):], nil)
+					if err != nil {
+						b.Fatal(err)
+					}
+					if err := verifyIndexPipeReference(plain[1:], idx.Encode, mode == "buffered"); err != nil {
+						b.Fatal(err)
+					}
+					id := restic.Hash(ciphertext)
+					if err := repo.be.Save(context.Background(), backend.Handle{Type: backend.IndexFile, Name: id.String()}, backend.NewByteReader(ciphertext, repo.be.Hasher())); err != nil {
+						b.Fatal(err)
+					}
+					if err := repo.be.Remove(context.Background(), backend.Handle{Type: backend.IndexFile, Name: id.String()}); err != nil {
+						b.Fatal(err)
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/internal/repository/index_verify_save_contract_b23_test.go b/internal/repository/index_verify_save_contract_b23_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c9aae9c5c3304101a0423e7cd2aba8da03e80300
--- /dev/null
+++ b/internal/repository/index_verify_save_contract_b23_test.go
@@ -0,0 +1,107 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/restic"
+)
+
+type b23IndexSaveCounter struct {
+	backend.Backend
+	saves atomic.Int64
+}
+
+func (b *b23IndexSaveCounter) Save(ctx context.Context, h backend.Handle, rd backend.RewindReader) error {
+	if h.Type == backend.IndexFile {
+		b.saves.Add(1)
+	}
+	return b.Backend.Save(ctx, h, rd)
+}
+
+// These are complete-save acceptance tests, independent of the comparison
+// writer. A divergent second encode must never reach persistent storage.
+func TestB23IndexSaveAcceptance(t *testing.T) {
+	for _, mode := range []string{"equal", "different", "short", "long", "encoder-error"} {
+		t.Run(mode, func(t *testing.T) {
+			repo, be := TestRepositoryWithBackend(t, nil, 2, Options{})
+			counter := &b23IndexSaveCounter{Backend: be}
+			repo.be = counter
+			expected := []byte("{\"packs\":[]}\n")
+			calls := 0
+			sentinel := errors.New("second encode rejected")
+			id, err := repo.saveIndexStream(t.Context(), func(w io.Writer) error {
+				calls++
+				value := bytes.Clone(expected)
+				if calls == 2 {
+					switch mode {
+					case "different":
+						value[1] = 'x'
+					case "short":
+						value = value[:len(value)-1]
+					case "long":
+						value = append(value, 'x')
+					case "encoder-error":
+						return sentinel
+					}
+				}
+				// Reuse one byte of scratch after every Write. The writer may borrow it
+				// during the call, but retaining it would change this independent result.
+				var scratch [1]byte
+				for _, v := range value {
+					scratch[0] = v
+					if _, err := w.Write(scratch[:]); err != nil {
+						return err
+					}
+					scratch[0] = 0xff
+				}
+				return nil
+			})
+			if calls != 2 {
+				t.Fatalf("encodes %d, want 2", calls)
+			}
+			if mode == "equal" {
+				if err != nil || id.IsNull() || counter.saves.Load() != 1 {
+					t.Fatalf("accepted save: %v %v %d", id, err, counter.saves.Load())
+				}
+				got, err := repo.LoadUnpacked(t.Context(), restic.IndexFile, id)
+				if err != nil || !bytes.Equal(got, expected) {
+					t.Fatalf("stored bytes %q: %v", got, err)
+				}
+			} else {
+				if err == nil || !id.IsNull() || counter.saves.Load() != 0 {
+					t.Fatalf("rejected save persisted: %v %v %d", id, err, counter.saves.Load())
+				}
+				if mode == "encoder-error" {
+					if !errors.Is(err, sentinel) {
+						t.Fatalf("lost encoder error: %v", err)
+					}
+				} else if !strings.Contains(err.Error(), "data mismatch") {
+					t.Fatalf("lost mismatch distinction: %v", err)
+				}
+			}
+		})
+	}
+}
+
+func TestB23IndexSaveLegacyFallback(t *testing.T) {
+	repo, be := TestRepositoryWithBackend(t, nil, 1, Options{})
+	counter := &b23IndexSaveCounter{Backend: be}
+	repo.be = counter
+	expected := []byte("{\"packs\":[]}\n")
+	calls := 0
+	id, err := repo.saveIndexStream(t.Context(), func(w io.Writer) error { calls++; _, err := w.Write(expected); return err })
+	if err != nil || calls != 1 || counter.saves.Load() != 1 {
+		t.Fatalf("legacy save: %v calls%d saves%d", err, calls, counter.saves.Load())
+	}
+	got, err := repo.LoadUnpacked(t.Context(), restic.IndexFile, id)
+	if err != nil || !bytes.Equal(got, expected) {
+		t.Fatalf("legacy bytes %q: %v", got, err)
+	}
+}
diff --git a/internal/repository/known_completion_integration_test.go b/internal/repository/known_completion_integration_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b60ae2ffe8a47dd9c952a634bbd9ef705ed8d963
--- /dev/null
+++ b/internal/repository/known_completion_integration_test.go
@@ -0,0 +1,144 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Deliberately stalled callbacks fill the actual uploader's payload admission,
+// rather than reproducing the lane in a separate errgroup fixture.
+func TestIntegratedKnownCompletionSaturatedUploaderCancellation(t *testing.T) {
+	repo := TestRepository(t)
+	outer, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	result := make(chan error, 1)
+	var callbacks atomic.Int64
+	go func() {
+		result <- repo.WithBlobUploader(outer, func(ctx context.Context, u restic.BlobSaverWithAsync) error {
+			entered := make(chan struct{}, runtime.GOMAXPROCS(0))
+			for i := range runtime.GOMAXPROCS(0) {
+				payload := []byte{byte(i), 17, 29}
+				u.SaveBlobAsync(ctx, restic.DataBlob, payload, restic.Hash(payload), false, func(_ restic.ID, _ bool, _ int, err error) {
+					if err != nil {
+						t.Errorf("payload save: %v", err)
+					}
+					entered <- struct{}{}
+					<-ctx.Done()
+					callbacks.Add(1)
+				})
+			}
+			for range runtime.GOMAXPROCS(0) {
+				<-entered
+			}
+			child, stop := context.WithCancel(ctx)
+			stop()
+			u.(*blobSaverRepo).SaveKnownBlobAsync(child, restic.ID{7}, func(id restic.ID, known bool, size int, err error) {
+				if !id.IsNull() || known || size != 0 || !errors.Is(err, context.Canceled) {
+					t.Errorf("canceled known callback: %v %v %d %v", id, known, size, err)
+				}
+				callbacks.Add(1)
+			})
+			<-ctx.Done()
+			return ctx.Err()
+		})
+	}()
+	select {
+	case err := <-result:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("uploader error: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		cancel() // Release deliberately stalled callbacks before reporting a failure.
+		<-result
+		t.Fatal("known completion could not cancel a saturated actual uploader")
+	}
+	if want := int64(runtime.GOMAXPROCS(0) + 1); callbacks.Load() != want {
+		t.Fatalf("settled %d callbacks, want %d", callbacks.Load(), want)
+	}
+}
+
+func TestIntegratedKnownCompletionAsyncAndSettlement(t *testing.T) {
+	repo := TestRepository(t)
+	submitted := make(chan struct{})
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	commandReturned := make(chan struct{})
+	result := make(chan error, 1)
+	var calls atomic.Int64
+	var flushes atomic.Int64
+	repo.be = &completionFlushObserver{Backend: repo.be, settled: &calls, flushes: &flushes, t: t}
+	go func() {
+		result <- repo.WithBlobUploader(t.Context(), func(ctx context.Context, u restic.BlobSaverWithAsync) error {
+			payload := []byte("force pack and index flush after completion")
+			if _, _, _, err := u.SaveBlob(ctx, restic.DataBlob, payload, restic.Hash(payload), false); err != nil {
+				return err
+			}
+			u.(*blobSaverRepo).SaveKnownBlobAsync(ctx, restic.ID{9}, func(id restic.ID, known bool, size int, err error) {
+				<-submitted // Inline execution cannot reach the close below.
+				close(entered)
+				<-release
+				if id != (restic.ID{9}) || !known || size != 0 || err != nil {
+					t.Error("known result changed")
+				}
+				calls.Add(1)
+			})
+			close(submitted)
+			close(commandReturned)
+			return nil
+		})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("known callback was not asynchronous")
+	}
+	<-commandReturned
+	select {
+	case err := <-result:
+		t.Fatalf("uploader returned before accepted callback settled: %v", err)
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("uploader failed to join completion")
+	}
+	if flushes.Load() == 0 {
+		t.Fatal("test did not exercise index flush")
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("callback count = %d", calls.Load())
+	}
+	if repo.mainWg != nil || repo.packerWg != nil || repo.blobSaver != nil {
+		t.Fatal("uploader returned before flushing its state")
+	}
+}
+
+// Index persistence is part of Flush; it must not begin before accepted known
+// completions have settled. The wrapper observes the real backend boundary.
+type completionFlushObserver struct {
+	backend.Backend
+	settled, flushes *atomic.Int64
+	t                *testing.T
+}
+
+func (b *completionFlushObserver) Save(ctx context.Context, h backend.Handle, rd backend.RewindReader) error {
+	if h.Type == backend.IndexFile {
+		b.flushes.Add(1)
+		if b.settled.Load() != 1 {
+			b.t.Error("index flush started before known callback settlement")
+		}
+	}
+	return b.Backend.Save(ctx, h, rd)
+}
diff --git a/internal/repository/known_completion_lane.go b/internal/repository/known_completion_lane.go
new file mode 100644
index 0000000000000000000000000000000000000000..5213b74c677b31f46f650581470498c2ba536470
--- /dev/null
+++ b/internal/repository/known_completion_lane.go
@@ -0,0 +1,80 @@
+package repository
+
+import (
+	"context"
+	"sync"
+
+	"github.com/restic/restic/internal/restic"
+	"golang.org/x/sync/errgroup"
+)
+
+// This queue owns descriptors only. Callback closures must follow the saver
+// contract: they must not block and must not retain blob payloads. Accepted
+// descriptors settle even after cancellation, before the repository is flushed.
+const knownCompletionQueueSize = 16
+
+type knownCompletion struct {
+	ctx      context.Context
+	id       restic.ID
+	callback func(restic.ID, bool, int, error)
+}
+
+type knownCompletionLane struct {
+	jobs      chan knownCompletion
+	done      chan struct{}
+	closeOnce sync.Once
+}
+
+func newKnownCompletionLane(wg *errgroup.Group) *knownCompletionLane {
+	lane := &knownCompletionLane{
+		jobs: make(chan knownCompletion, knownCompletionQueueSize),
+		done: make(chan struct{}),
+	}
+	// A publisher owns its group slot before payload admission can saturate
+	// the group. Publishing from the completion worker with another wg.Go
+	// could block behind savers that themselves wait for this cancellation.
+	errors := make(chan error, 1)
+	wg.Go(func() error {
+		select {
+		case err := <-errors:
+			return err
+		case <-lane.done:
+			// A completed drain and its pending error can be ready together.
+			// Always report that error rather than losing it to select order.
+			select {
+			case err := <-errors:
+				return err
+			default:
+				return nil
+			}
+		}
+	})
+	wg.Go(func() error {
+		defer close(lane.done)
+		reportedError := false
+		for job := range lane.jobs {
+			if err := job.ctx.Err(); err != nil {
+				job.callback(restic.ID{}, false, 0, err)
+				if !reportedError {
+					errors <- err
+					reportedError = true
+				}
+			} else {
+				job.callback(job.id, true, 0, nil)
+			}
+		}
+		return nil
+	})
+	return lane
+}
+
+func (l *knownCompletionLane) submit(ctx context.Context, id restic.ID, cb func(restic.ID, bool, int, error)) {
+	// The worker remains alive through cancellation. Enqueuing even a cancelled
+	// job keeps callback execution asynchronous without spawning unbounded jobs.
+	l.jobs <- knownCompletion{ctx: ctx, id: id, callback: cb}
+}
+
+func (l *knownCompletionLane) finish() {
+	l.closeOnce.Do(func() { close(l.jobs) })
+	<-l.done
+}
