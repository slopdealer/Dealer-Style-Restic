+func TestRunWithoutStatusKeepsCustomWriterCallsSeparate(t *testing.T) {
+	w := &shortOutputWriter{}
+	term := new(nil, w, io.Discard, true)
+	ctx, cancel := context.WithCancel(context.Background())
+	go term.Run(ctx)
+
