@@ -0,0 +1,123 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/backend/mock"
+	"github.com/restic/restic/internal/backend/sema"
+	"github.com/restic/restic/internal/restic"
+	"io"
+	"testing"
+	"time"
+)
+
+// Request extent and resident ciphertext extent are independent. A full span
+// travels in one response while callbacks borrow only one processing window.
+func TestCoalescedRestoreProcessingBudget(t *testing.T) {
+	key := testKey(t)
+	blobs, data := buildPackfileWithoutHeader([]int{600000, 600000, 600000}, &key, true)
+	dec, err := zstd.NewReader(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dec.Close()
+	var scratch []byte
+	loads, callbacks := 0, 0
+	load := func(_ context.Context, _ backend.Handle, n int, off int64, consume func(io.Reader) error) error {
+		loads++
+		if n <= int(restic.SmallRestoreCiphertextLimit) {
+			t.Fatal("request did not combine windows")
+		}
+		return consume(bytes.NewReader(data[int(off) : int(off)+n]))
+	}
+	err = streamPackResponse(context.Background(), load, nil, dec, &key, restic.ID{}, blobs, &scratch,
+		func(h restic.BlobHandle, b []byte, err error) error {
+			callbacks++
+			if cap(scratch) > restic.SmallRestoreCiphertextLimit {
+				t.Fatalf("ciphertext capacity %d exceeds window", cap(scratch))
+			}
+			if err != nil {
+				return err
+			}
+			if restic.Hash(b) != h.ID {
+				t.Fatal("wrong plaintext")
+			}
+			return nil
+		}, restic.SmallRestoreCiphertextLimit)
+	if err != nil || loads != 1 || callbacks != 3 {
+		t.Fatalf("err=%v loads=%d callbacks=%d", err, loads, callbacks)
+	}
+}
+
+// The extended worker borrows medium uncompressed data, including blobs larger than its
+// aggregation window. Decoder promotion must occur after releasing the sole
+// backend connection, including when the index understates decoded size.
+func TestMediumRestoreBudgetAndPromotion(t *testing.T) {
+	for _, variant := range []string{"medium", "compressed", "understated", "oversized"} {
+		t.Run(variant, func(t *testing.T) {
+			key := testKey(t)
+			size := 2500000
+			if variant == "oversized" {
+				size = 4000000
+			}
+			blobs, data := buildPackfileWithoutHeader([]int{size, 600000}, &key, variant != "medium")
+			if variant == "understated" || variant == "oversized" {
+				blobs[0].UncompressedLength = 1
+			}
+			m := mock.NewBackend()
+			m.PropertiesFn = func() backend.Properties { return backend.Properties{Connections: 1} }
+			loads, admissions, callbacks := 0, 0, 0
+			m.OpenReaderFn = func(_ context.Context, _ backend.Handle, n int, off int64) (io.ReadCloser, error) {
+				loads++
+				if variant == "oversized" && admissions != 1 {
+					t.Fatal("oversized selected copy entered without admission")
+				}
+				return io.NopCloser(bytes.NewReader(data[int(off) : int(off)+n])), nil
+			}
+			r := &Repository{be: sema.NewBackend(m), key: &key}
+			defer r.Close()
+			ctx := restic.WithSmallRestoreLoad(context.Background(), func(context.Context) (func(), error) {
+				// Prove the sole connection is free by taking it synchronously.
+				// Promotion from inside a consumer would deadlock here.
+				if variant == "understated" {
+					probeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+					defer cancel()
+					if err := r.be.Load(sema.WithAdditionalLoadSlot(probeCtx), backend.Handle{Type: backend.PackFile, Name: "probe"}, 1, 0,
+						func(rd io.Reader) error { _, err := io.Copy(io.Discard, rd); return err }); err != nil {
+						return nil, err
+					}
+				}
+				admissions++
+				return func() {}, nil
+			})
+			err := r.loadBlobsFromPack(ctx, restic.ID{}, blobs, func(h restic.BlobHandle, b []byte, err error) error {
+				if callbacks >= len(blobs) || h != blobs[callbacks].BlobHandle {
+					t.Fatal("repeated or reordered delivery")
+				}
+				callbacks++
+				if err != nil {
+					return err
+				}
+				if restic.Hash(b) != h.ID {
+					t.Fatal("wrong medium plaintext")
+				}
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if callbacks != 2 || loads == 0 {
+				t.Fatalf("loads/callbacks %d/%d", loads, callbacks)
+			}
+			wantAdmission := 0
+			if variant != "medium" {
+				wantAdmission = 1
+			}
+			if admissions != wantAdmission {
+				t.Fatalf("admissions %d, want %d", admissions, wantAdmission)
+			}
+		})
+	}
+}
diff --git a/internal/repository/restore_window_hold.go b/internal/repository/restore_window_hold.go
new file mode 100644
index 0000000000000000000000000000000000000000..ac8a64385d1a1b6936fb423eb8aaffee9a0ca6c0
--- /dev/null
+++ b/internal/repository/restore_window_hold.go
@@ -0,0 +1,91 @@
+package repository
+
+import (
+	"context"
+
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// restoreWindowHold accounts one range window of an ordinary restore worker
+// against the restore's hold budget (restic.RestoreHoldBudget). What a window
+// holds is its ciphertext range and the largest decoded copy of a compressed
+// blob in it.
+//
+// The configured workers only report what they hold and never wait. The
+// additional worker waits for room before it allocates or reads a window, and
+// does not keep a window buffer above the ordinary window afterwards.
+//
+// The bytes are taken inside the backend Load callback, never before Load: a
+// worker that waits for bytes may hold a backend connection, but a worker that
+// holds bytes never waits for a connection, so the two waits cannot form a
+// cycle. Streams without a budget in their context are untouched.
+type restoreWindowHold struct {
+	budget restic.RestoreHoldBudget
+	wait   bool
+	need   int64
+	held   int64
+	taken  bool
+}
+
+type restoreHoldTakenKey struct{}
+
+// restoreWindowNeed is the ciphertext range plus the largest decoded copy.
+func restoreWindowNeed(blobs pack.Blobs) int64 {
+	last := blobs[len(blobs)-1]
+	need := int64(last.Offset + last.Length - blobs[0].Offset)
+	var plain uint
+	for _, blob := range blobs {
+		if blob.IsCompressed() && blob.DataLength() > plain {
+			plain = blob.DataLength()
+		}
+	}
+	return need + int64(plain)
+}
+
+func newRestoreWindowHold(ctx context.Context, blobs pack.Blobs) *restoreWindowHold {
+	use, _ := ctx.Value(restic.RestoreHoldKey{}).(restic.RestoreHoldUse)
+	if use.Budget == nil {
+		return nil
+	}
+	h := &restoreWindowHold{budget: use.Budget, wait: use.Wait, need: restoreWindowNeed(blobs)}
+	if taken, ok := ctx.Value(restoreHoldTakenKey{}).(*restoreWindowHold); ok && taken != nil {
+		// The caller read this window itself and already holds its bytes.
+		h.held, h.taken = taken.held, true
+		taken.held, taken.taken = 0, false
+	}
+	return h
+}
+
+// admit takes the window's bytes once; a replayed Load keeps what it holds.
+func (h *restoreWindowHold) admit(ctx context.Context) error {
+	if h == nil || h.taken {
+		return nil
+	}
+	if !h.wait {
+		h.held, h.taken = h.budget.Force(h.need), true
+		return nil
+	}
+	held, err := h.budget.Acquire(ctx, h.need)
+	if err != nil {
+		return err
+	}
+	h.held, h.taken = held, true
+	return nil
+}
+
+// release returns the bytes. The additional worker also drops a window buffer
+// above the ordinary window, so that between windows it retains one ordinary
+// window at most.
+func (h *restoreWindowHold) release(data *[]byte) {
+	if h == nil {
+		return
+	}
+	if h.wait && data != nil && cap(*data) > restoreStreamWindow {
+		*data = nil
+	}
+	if h.taken {
+		h.budget.Release(h.held)
+		h.held, h.taken = 0, false
+	}
+}
diff --git a/internal/repository/restore_window_hold_test.go b/internal/repository/restore_window_hold_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0451d02adecd171096e6d37b55654c8ec2dfec76
--- /dev/null
+++ b/internal/repository/restore_window_hold_test.go
@@ -0,0 +1,111 @@
+package repository
+
+import (
+	"context"
+	"testing"
+
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// holdTestBudget is a non-blocking stand-in: Acquire fails with the context
+// error when there is no room (the test only waits with a cancelled context).
+type holdTestBudget struct{ size, free int64 }
+
+func (b *holdTestBudget) Force(n int64) int64 { b.free -= n; return n }
+func (b *holdTestBudget) Acquire(ctx context.Context, n int64) (int64, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	if n > b.size/2 {
+		n = (b.size + 1) / 2
+	}
+	if b.free < n {
+		if err := ctx.Err(); err != nil {
+			return 0, err
+		}
+		panic("holdTestBudget: no room and nothing to wait for")
+	}
+	b.free -= n
+	return n, nil
+}
+func (b *holdTestBudget) Release(n int64) { b.free += n }
+func (b *holdTestBudget) Workers() int    { return 2 }
+
+func holdCtx(b *holdTestBudget, wait bool) context.Context {
+	return context.WithValue(context.Background(), restic.RestoreHoldKey{}, restic.RestoreHoldUse{Budget: b, Wait: wait})
+}
+
+func holdTestBlobs() pack.Blobs {
+	// offsets 0..300: raw 100, compressed 100 (plain 500), raw 100
+	return pack.Blobs{
+		{BlobHandle: restic.BlobHandle{Type: restic.DataBlob}, Offset: 0, Length: 100},
+		{BlobHandle: restic.BlobHandle{Type: restic.DataBlob}, Offset: 100, Length: 100, UncompressedLength: 500},
+		{BlobHandle: restic.BlobHandle{Type: restic.DataBlob}, Offset: 200, Length: 100},
+	}
+}
+
+func TestRestoreWindowHoldAccounting(t *testing.T) {
+	blobs := holdTestBlobs()
+	if need := restoreWindowNeed(blobs); need != 300+500 {
+		t.Fatalf("need %d, want ciphertext range 300 + largest decoded copy 500", need)
+	}
+	// no budget in the context: nothing is accounted, the buffer is kept
+	var none *restoreWindowHold = newRestoreWindowHold(context.Background(), blobs)
+	if none != nil {
+		t.Fatal("hold without a budget")
+	}
+	buf := make([]byte, restoreStreamWindow+1)
+	none.release(&buf)
+	if buf == nil || none.admit(context.Background()) != nil {
+		t.Fatal("nil hold must be inert")
+	}
+
+	budget := &holdTestBudget{size: 1600, free: 1600}
+	ctx := holdCtx(budget, true)
+	h := newRestoreWindowHold(ctx, blobs)
+	if err := h.admit(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.admit(ctx); err != nil || h.held != 800 { // a replayed Load takes nothing more
+		t.Fatalf("held %d, %v", h.held, err)
+	}
+	// a second window of the additional worker does not fit beside the first
+	waitCtx, cancel := context.WithCancel(ctx)
+	cancel()
+	if err := newRestoreWindowHold(waitCtx, blobs).admit(waitCtx); err != context.Canceled {
+		t.Fatalf("second window: %v", err)
+	}
+	// a configured worker never waits and keeps its window buffer
+	regCtx := holdCtx(budget, false)
+	reg := newRestoreWindowHold(regCtx, blobs)
+	if err := reg.admit(regCtx); err != nil || reg.held != 800 {
+		t.Fatalf("configured worker: %d, %v", reg.held, err)
+	}
+	kept := make([]byte, restoreStreamWindow+1)
+	reg.release(&kept)
+	if kept == nil {
+		t.Fatal("a configured worker keeps its window buffer")
+	}
+	// the final window of a response hands its bytes to the decode
+	adopted := newRestoreWindowHold(context.WithValue(ctx, restoreHoldTakenKey{}, h), blobs)
+	if !adopted.taken || adopted.held != 800 || h.taken || h.held != 0 {
+		t.Fatalf("adoption: %+v from %+v", adopted, h)
+	}
+	h.release(nil) // the giver has nothing left to return
+	big := make([]byte, restoreStreamWindow+1)
+	small := make([]byte, 16)
+	adopted.release(&big)
+	if big != nil {
+		t.Fatal("a window buffer above the ordinary window must not be retained")
+	}
+	adopted.release(&small)
+	if small == nil {
+		t.Fatal("an ordinary window buffer is kept")
+	}
+	a, _ := budget.Acquire(ctx, 800)
+	b, err := budget.Acquire(ctx, 800)
+	if err != nil || a+b != 1600 {
+		t.Fatalf("budget not whole after release: %d, %v", a+b, err)
+	}
+}
diff --git a/internal/repository/save_verify_async_b23_test.go b/internal/repository/save_verify_async_b23_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..880831ba1ab7aae4e313b5bebb09a6557fe3b5dd
--- /dev/null
+++ b/internal/repository/save_verify_async_b23_test.go
@@ -0,0 +1,46 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"sync/atomic"
+	"testing"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+// A rejected asynchronous save must settle its accepted callback and join the
+// uploader without publishing ciphertext or an indexed blob. This uses the
+// complete production pipeline, including its reserved error publisher.
+func TestB23VerifyAsyncRejectedSaveSettlement(t *testing.T) {
+	r, _, _ := TestRepositoryWithVersion(t, 2)
+	data := bytes.Repeat([]byte("complete authenticated compressed verification\n"), 100000)
+	wrong := restic.Hash([]byte("a different complete blob"))
+	want := fmt.Sprintf("Detected data corruption while saving blob %v: hash mismatch\nCorrupted blobs are either caused by hardware issues or software bugs. Please open an issue at https://github.com/restic/restic/issues/new/choose for further troubleshooting.", wrong)
+	var settled atomic.Int64
+	err := r.WithBlobUploader(t.Context(), func(ctx context.Context, u restic.BlobSaverWithAsync) error {
+		result := make(chan error, 1)
+		u.SaveBlobAsync(ctx, restic.DataBlob, data, wrong, true, func(id restic.ID, known bool, size int, err error) {
+			if id != wrong || known || size != 0 || err == nil || err.Error() != want {
+				t.Errorf("callback: %v %v %d %v", id, known, size, err)
+			}
+			settled.Add(1)
+			result <- err
+		})
+		return <-result
+	})
+	if err == nil || err.Error() != want || settled.Load() != 1 {
+		t.Fatalf("return before exact settlement: %v count=%d", err, settled.Load())
+	}
+	if len(r.idx.Lookup(restic.BlobHandle{Type: restic.DataBlob, ID: wrong})) != 0 {
+		t.Fatal("rejected blob was indexed")
+	}
+	packs := 0
+	if err := r.List(t.Context(), restic.PackFile, func(restic.ID, int64) error { packs++; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if packs != 0 {
+		t.Fatal("rejected asynchronous save submitted a pack")
+	}
+}
