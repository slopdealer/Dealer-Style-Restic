+func (p *restoreMetadataPool) waitOldest() error {
+	if len(p.pending) == 0 {
+		return nil
+	}
+	if p.firstErr != nil {
+		return context.Canceled
+	}
+
+	task := p.pending[0]
+	select {
+	case <-task.done:
+	case <-p.ctx.Done():
