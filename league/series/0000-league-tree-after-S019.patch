+	var cases [][]byte
+	for _, prefix := range []string{"", good + ",", good + ", " + good + ", \n\t"} {
+		for _, n := range nodes {
+			cases = append(cases, []byte(`{"extra":{"nested":[null]},"nodes":[`+prefix+n+`],"after":{"nodes":[]}}`))
