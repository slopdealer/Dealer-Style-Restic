+++ b/internal/walker/listing_geometry_test.go
@@ -0,0 +1,87 @@
+package walker
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+// This control retains the candidate's lexical admission, batch array, node and
+// byte limits, and oversized-node path. Only the scheduling differs.
+func listingSerialGeometry(source listingSource) data.TreeNodeIterator {
+	return func(yield func(data.NodeOrError) bool) {
+		defer source.close()
+		for {
+			batch := readListingBatch(source)
+			for i := 0; i < batch.count; i++ {
+				item := batch.items[i]
+				batch.items[i] = data.NodeOrError{}
+				if !yield(item) || item.Error != nil {
+					return
+				}
+			}
+			if batch.end {
+				return
+			}
+			if batch.synchronous {
+				item, ok := source.next()
+				if !ok || !yield(item) || item.Error != nil {
+					return
+				}
+			}
+		}
+	}
+}
+
+func BenchmarkListingMatchedGeometry(b *testing.B) {
+	for _, nodes := range []int{32, 512, 4096} {
+		tree := struct {
+			Nodes []*data.Node `json:"nodes"`
+		}{Nodes: make([]*data.Node, 0, nodes)}
+		for i := 0; i < nodes; i++ {
+			tree.Nodes = append(tree.Nodes, &data.Node{Name: fmt.Sprintf("file-%05d", i), Type: data.NodeTypeFile, Size: 4096, Mode: 0644})
+		}
+		payload, err := json.Marshal(tree)
+		if err != nil {
+			b.Fatal(err)
+		}
+		for _, arm := range []string{"serial", "prepared"} {
+			b.Run(fmt.Sprintf("%d/%s", nodes, arm), func(b *testing.B) {
+				b.ReportAllocs()
+				for i := 0; i < b.N; i++ {
+					loader := &listingTestLoader{payload: payload}
+					r, err := data.LoadTreeNodeReader(context.Background(), loader, restic.ID{})
+					if err != nil {
+						b.Fatal(err)
+					}
+					source := listingSource{next: r.Next, size: r.PreparationSize, close: r.Close}
+					p := newListingPreparation(nil)
+					iterator := listingSerialGeometry(source)
+					if arm == "prepared" {
+						iterator = p.wrap(context.Background(), source)
+					}
+					count := 0
+					for item := range iterator {
+						if item.Error != nil {
+							b.Fatal(item.Error)
+						}
+						// Same output interpretation work in each arm; no sleep or dummy work.
+						out, err := json.Marshal(item.Node)
+						if err != nil || len(out) == 0 {
+							b.Fatal(err)
+						}
+						count++
+					}
+					p.Close()
+					if count != nodes {
+						b.Fatal(count)
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/internal/walker/listing_preparation.go b/internal/walker/listing_preparation.go
new file mode 100644
index 0000000000000000000000000000000000000000..65c6694dee05db079748177885cc8849e5358e87
--- /dev/null
+++ b/internal/walker/listing_preparation.go
@@ -0,0 +1,179 @@
+package walker
+
+import (
+	"context"
+
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+const listingBatchNodes = 128
+const listingBatchJSONBytes = 64 << 10
+const listingNodeJSONBytes = 2 << 10
+
+type listingBatch struct {
+	items                      [listingBatchNodes]data.NodeOrError
+	count                      int
+	end, boundary, synchronous bool
+}
+
+type listingSource struct {
+	next  func() (data.NodeOrError, bool)
+	size  func(int) (int, bool)
+	close func()
+}
+
+type listingRequest struct {
+	source listingSource
+	result chan listingBatch
+}
+
+// One helper belongs to one traversal. There is at most one current and one
+// pending batch, and neither survives directory descent. Raw input is bounded
+// before decoding, including content lists and attributes; a large node never
+// occupies a batch beside another decoded node. The authenticated payload and
+// decoder are the ordinary reader's, rather than a second copy or observation.
+type listingPreparation struct {
+	loader restic.BlobLoader
+	jobs   chan listingRequest
+	done   chan struct{}
+	closed bool
+}
+
+func readListingBatch(source listingSource) listingBatch {
+	var batch listingBatch
+	bytes := 0
+	for batch.count < len(batch.items) {
+		size, small := source.size(listingNodeJSONBytes)
+		if !small {
+			batch.synchronous = true
+			break
+		}
+		if bytes+size > listingBatchJSONBytes {
+			break
+		}
+		item, ok := source.next()
+		if !ok {
+			batch.end = true
+			break
+		}
+		batch.items[batch.count] = item
+		batch.count++
+		bytes += size
+		if item.Error != nil {
+			batch.end = true
+			break
+		}
+		if item.Node.Type == data.NodeTypeDir {
+			batch.boundary = true
+			break
+		}
+	}
+	return batch
+}
+
+func newListingPreparation(loader restic.BlobLoader) *listingPreparation {
+	return &listingPreparation{loader: loader}
+}
+
+// A worker is needed only after a full ordinary first batch exposes useful
+// decode work beside callbacks. Short traversals never acquire a goroutine.
+func (p *listingPreparation) startWorker() {
+	if p.jobs != nil {
+		return
+	}
+	p.jobs = make(chan listingRequest)
+	p.done = make(chan struct{})
+	go func() {
+		defer close(p.done)
+		for job := range p.jobs {
+			job.result <- readListingBatch(job.source)
+		}
+	}()
+}
+
+func (p *listingPreparation) Load(ctx context.Context, id restic.ID) (data.TreeNodeIterator, error) {
+	tree, _, err := p.loadOwned(ctx, id)
+	return tree, err
+}
+
+// A successful ordinary load has an owner even if its visitor rejects the
+// iterator before the first Next. The walker closes that frame; iteration also
+// closes it after joining pending work. TreeNodeReader.Close is idempotent.
+func (p *listingPreparation) loadOwned(ctx context.Context, id restic.ID) (data.TreeNodeIterator, func(), error) {
+	r, err := data.LoadTreeNodeReader(ctx, p.loader, id)
+	if err != nil {
+		return nil, func() {}, err
+	}
+	return p.wrap(ctx, listingSource{next: r.Next, size: r.PreparationSize, close: r.Close}), r.Close, nil
+}
+
+func (p *listingPreparation) wrap(ctx context.Context, source listingSource) data.TreeNodeIterator {
+	started := false
+	return func(yield func(data.NodeOrError) bool) {
+		if started {
+			panic("tree iterator is single use only")
+		}
+		started = true
+		var result chan listingBatch
+		pending := false
+		defer func() {
+			if pending {
+				<-result
+			}
+			source.close()
+		}()
+		start := func() {
+			if result == nil {
+				result = make(chan listingBatch, 1)
+			}
+			p.startWorker()
+			p.jobs <- listingRequest{source: source, result: result}
+			pending = true
+		}
+		batch := readListingBatch(source)
+		for {
+			if !batch.end && !batch.boundary && !batch.synchronous && ctx.Err() == nil {
+				start()
+			}
+			for i := 0; i < batch.count; i++ {
+				item := batch.items[i]
+				batch.items[i] = data.NodeOrError{}
+				if !yield(item) || item.Error != nil {
+					return
+				}
+			}
+			if batch.end {
+				return
+			}
+			if batch.synchronous {
+				// No batch or helper decode is retained across this potentially
+				// oversized node, directory callback, framing or parse error.
+				item, ok := source.next()
+				if !ok || !yield(item) || item.Error != nil {
+					return
+				}
+			}
+			if !pending {
+				// Directory and oversized boundaries cannot overlap. Keep
+				// their following batch on the caller until it is ready.
+				batch = readListingBatch(source)
+			} else {
+				batch = <-result
+				pending = false
+			}
+		}
+	}
+}
+
+func (p *listingPreparation) Close() {
+	if !p.closed {
+		p.closed = true
+		if p.jobs != nil {
+			close(p.jobs)
+		}
+	}
+	if p.done != nil {
+		<-p.done
+	}
+}
diff --git a/internal/walker/listing_preparation_test.go b/internal/walker/listing_preparation_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c188ed2bb55e65f8e2bd9b369d0e4d868809f3d7
--- /dev/null
+++ b/internal/walker/listing_preparation_test.go
@@ -0,0 +1,385 @@
+package walker
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+func TestListingPreparationOverlapAndJoin(t *testing.T) {
+	for _, earlyStop := range []bool{false, true} {
+		p := newListingPreparation(nil)
+		ready := make(chan struct{})
+		var closed atomic.Bool
+		var cursor int
+		parseErr := errors.New("prepared parse error")
+		source := listingSource{
+			size:  func(int) (int, bool) { return 10, true },
+			close: func() { closed.Store(true) },
+			next: func() (data.NodeOrError, bool) {
+				if cursor == listingBatchNodes {
+					close(ready)
+				}
+				if cursor == listingBatchNodes*2 {
+					cursor++
+					return data.NodeOrError{Error: parseErr}, true
+				}
+				if cursor > listingBatchNodes*2 {
+					return data.NodeOrError{}, false
+				}
+				n := &data.Node{Name: "file", Type: data.NodeTypeFile, Inode: uint64(cursor)}
+				cursor++
+				return data.NodeOrError{Node: n}, true
+			},
+		}
+		count := 0
+		for item := range p.wrap(context.Background(), source) {
+			if count == 0 {
+				select {
+				case <-ready:
+				case <-time.After(5 * time.Second):
+					t.Fatal("no decoding while callback is occupied")
+				}
+				if earlyStop {
+					break
+				}
+			}
+			if item.Error != nil {
+				if item.Error != parseErr || count != 2*listingBatchNodes {
+					t.Fatalf("error at wrong position: %d, %v", count, item.Error)
+				}
+				break
+			}
+			if item.Node.Inode != uint64(count) {
+				t.Fatal("node order changed")
+			}
+			count++
+		}
+		if !closed.Load() {
+			t.Fatal("reader not closed after pending decoder joined")
+		}
+		p.Close()
+		p.Close()
+	}
+}
+
+func TestListingPreparationBoundaryAndOversized(t *testing.T) {
+	p := newListingPreparation(nil)
+	defer p.Close()
+	for _, boundary := range []bool{false, true} {
+		var cursor int
+		var ahead atomic.Bool
+		source := listingSource{
+			close: func() {},
+			size:  func(int) (int, bool) { return 10, boundary || cursor != 0 },
+			next: func() (data.NodeOrError, bool) {
+				cursor++
+				if cursor == 1 {
+					typeOfNode := data.NodeTypeFile
+					if boundary {
+						typeOfNode = data.NodeTypeDir
+					}
+					return data.NodeOrError{Node: &data.Node{Name: "first", Type: typeOfNode}}, true
+				}
+				ahead.Store(true)
+				return data.NodeOrError{}, false
+			},
+		}
+		for range p.wrap(context.Background(), source) {
+			if ahead.Load() {
+				t.Fatal("decoder crossed directory/oversized boundary")
+			}
+		}
+	}
+}
+
+type listingTestLoader struct {
+	payload []byte
+	err     error
+	loads   int
+}
+
+func (l *listingTestLoader) LoadBlob(_ context.Context, _ restic.BlobHandle, _ []byte) ([]byte, error) {
+	l.loads++
+	if l.err != nil {
+		return nil, l.err
+	}
+	return append([]byte(nil), l.payload...), nil
+}
+
+func listingEvents(ctx context.Context, load *listingTestLoader, prepared bool, stop string, callbackErr error, root func()) ([]string, error) {
+	events := []string{}
+	visitor := WalkVisitor{
+		ProcessNode: func(_ restic.ID, path string, node *data.Node, err error) error {
+			events = append(events, fmt.Sprintf("%s:%v", path, err))
+			if path == "/" && root != nil {
+				root()
+			}
+			if err != nil {
+				return err
+			}
+			if path == stop {
+				return callbackErr
+			}
+			return nil
+		},
+		LeaveDir: func(path string) error { events = append(events, "leave:"+path); return nil },
+	}
+	var err error
+	if prepared {
+		err = WalkPrepared(ctx, load, restic.ID{}, visitor)
+	} else {
+		err = Walk(ctx, load, restic.ID{}, visitor)
+	}
+	return events, err
+}
+
+func TestListingPreparationMatchesOrdinaryErrorsAndObservation(t *testing.T) {
+	callbackErr := errors.New("callback failed")
+	for _, payload := range []string{
+		`{"nodes":[]}`,
+		`{"nodes":[{"name":"a","type":"file"},{"name":"b","type":"file"}]}`,
+		`{"nodes":[{"name":"a","type":"file"},{"name":1}]}`,
+		`{"nodes":[{"name":"a","type":"file"},{"name":`,
+		`{"nodes":[{"name":"a","type":"file"},{"name":"b","type":"dir"}]}`,
+		`{"nodes":[{"name":"a","type":"file","user":"` + strings.Repeat("x", listingNodeJSONBytes) + `"},{"name":"b","type":"file"}]}`,
+		`{"nodes":[],"tail":`,
+	} {
+		for _, stopErr := range []error{nil, callbackErr, ErrSkipNode} {
+			for _, canceled := range []bool{false, true} {
+				var ordinary []string
+				var ordinaryErr error
+				for _, prepared := range []bool{false, true} {
+					ctx, cancel := context.WithCancel(context.Background())
+					load := &listingTestLoader{payload: []byte(payload)}
+					root := func() {
+						// Post-observation replacement/removal cannot invalidate
+						// the acquired bytes, and must not trigger a second load.
+						load.payload = []byte(`{"nodes":[]}`)
+						load.err = errors.New("external disappearance")
+						if canceled {
+							cancel()
+						}
+					}
+					events, err := listingEvents(ctx, load, prepared, "/a", stopErr, root)
+					cancel()
+					if load.loads != 1 {
+						t.Fatalf("extra observation: %d", load.loads)
+					}
+					if !prepared {
+						ordinary, ordinaryErr = events, err
+						continue
+					}
+					if !reflect.DeepEqual(events, ordinary) || fmt.Sprintf("%T:%v", err, err) != fmt.Sprintf("%T:%v", ordinaryErr, ordinaryErr) {
+						t.Fatalf("observable difference: %v / %v; %v / %v", ordinary, events, ordinaryErr, err)
+					}
+				}
+			}
+		}
+	}
+	// Disappearance before the ordinary read remains an ordinary load failure.
+	for _, prepared := range []bool{false, true} {
+		missing := errors.New("missing before load")
+		load := &listingTestLoader{err: missing}
+		_, err := listingEvents(context.Background(), load, prepared, "", nil, nil)
+		if err != missing || load.loads != 1 {
+			t.Fatal("load failure was substituted")
+		}
+	}
+}
+
+func TestListingPreparationNestedWalkMatchesOrdinary(t *testing.T) {
+	trees, root := BuildTreeMap(TestTree{"a": TestFile{}, "b": TestTree{"a": TestFile{}, "b": TestTree{"c": TestFile{}}}, "z": TestFile{}})
+	var want []string
+	for _, prepared := range []bool{false, true} {
+		var got []string
+		visitor := WalkVisitor{ProcessNode: func(_ restic.ID, p string, _ *data.Node, err error) error { got = append(got, p); return err }, LeaveDir: func(p string) error { got = append(got, "leave:"+p); return nil }}
+		var err error
+		if prepared {
+			err = WalkPrepared(context.Background(), trees, root, visitor)
+		} else {
+			err = Walk(context.Background(), trees, root, visitor)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !prepared {
+			want = got
+		} else if !reflect.DeepEqual(got, want) {
+			t.Fatalf("%v / %v", got, want)
+		}
+	}
+}
+
+func TestListingPreparationPanicJoins(t *testing.T) {
+	p := newListingPreparation(nil)
+	var closed atomic.Bool
+	source := listingSource{size: func(int) (int, bool) { return 10, true }, next: func() (data.NodeOrError, bool) {
+		return data.NodeOrError{Node: &data.Node{Type: data.NodeTypeFile}}, true
+	}, close: func() { closed.Store(true) }}
+	func() {
+		defer func() {
+			if recover() != "visitor" {
+				t.Fatal("panic changed")
+			}
+		}()
+		for range p.wrap(context.Background(), source) {
+			panic("visitor")
+		}
+	}()
+	if !closed.Load() {
+		t.Fatal("panic failed to join and close")
+	}
+	p.Close()
+}
+
+// The first batch uses exactly the same bounds as later prepared batches, but
+// it does not buy a helper until there is a batch to overlap with callbacks.
+func TestListingPreparationShortTraversalStaysSynchronous(t *testing.T) {
+	for _, count := range []int{0, 1, listingBatchNodes - 1} {
+		p := newListingPreparation(nil)
+		cursor := 0
+		closed := false
+		source := listingSource{
+			size: func(int) (int, bool) { return 10, true },
+			next: func() (data.NodeOrError, bool) {
+				if cursor == count {
+					return data.NodeOrError{}, false
+				}
+				cursor++
+				return data.NodeOrError{Node: &data.Node{Type: data.NodeTypeFile}}, true
+			},
+			close: func() { closed = true },
+		}
+		got := 0
+		for range p.wrap(context.Background(), source) {
+			got++
+		}
+		if got != count || !closed || p.jobs != nil {
+			t.Fatalf("count=%d got=%d closed=%v worker=%v", count, got, closed, p.jobs != nil)
+		}
+		p.Close()
+		p.Close()
+	}
+}
+
+func TestListingPreparationCancellationWaitsForPendingDecode(t *testing.T) {
+	p := newListingPreparation(nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	exited := make(chan struct{})
+	var closed atomic.Bool
+	cursor := 0
+	source := listingSource{
+		size:  func(int) (int, bool) { return 10, true },
+		close: func() { closed.Store(true) },
+		next: func() (data.NodeOrError, bool) {
+			if cursor == listingBatchNodes {
+				close(entered)
+				<-release
+				cursor++
+				return data.NodeOrError{Error: errors.New("discarded pending error")}, true
+			}
+			cursor++
+			return data.NodeOrError{Node: &data.Node{Type: data.NodeTypeFile}}, true
+		},
+	}
+	go func() {
+		defer close(exited)
+		for range p.wrap(ctx, source) {
+			<-entered
+			cancel()
+			break
+		}
+		p.Close()
+	}()
+	<-entered
+	// The blocked pending read makes completion impossible until release. Use
+	// an observable reader-close flag, not timing, to check ownership.
+	if closed.Load() {
+		t.Fatal("reader closed while decoder owns it")
+	}
+	select {
+	case <-exited:
+		t.Fatal("returned before pending decode settled")
+	default:
+	}
+	close(release)
+	select {
+	case <-exited:
+	case <-time.After(5 * time.Second):
+		t.Fatal("pending decode did not join")
+	}
+	if !closed.Load() {
+		t.Fatal("reader not closed after join")
+	}
+}
+
+func TestListingPreparedUnconsumedReaderCanClose(t *testing.T) {
+	loader := &listingTestLoader{payload: []byte(`{"nodes":[{"name":"a","type":"file"}]}`)}
+	p := newListingPreparation(loader)
+	defer p.Close()
+	iterator, closeTree, err := p.loadOwned(context.Background(), restic.ID{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	closeTree()
+	closeTree()
+	for range iterator {
+		t.Fatal("closed unconsumed reader retained nodes")
+	}
+	if p.jobs != nil || loader.loads != 1 {
+		t.Fatal("closing an unconsumed reader acquired work")
+	}
+}
+
+func TestListingPreparedSkippedFramesAndLeaveFailure(t *testing.T) {
+	trees, root := BuildTreeMap(TestTree{"a": TestTree{"x": TestFile{}}, "z": TestFile{}})
+	sentinel := errors.New("callback failure")
+	for _, where := range []string{"/", "/a", "leave:/a"} {
+		for _, decision := range []error{ErrSkipNode, sentinel} {
+			var want []string
+			var wantErr error
+			for _, prepared := range []bool{false, true} {
+				var got []string
+				visitor := WalkVisitor{
+					ProcessNode: func(_ restic.ID, p string, _ *data.Node, err error) error {
+						got = append(got, p)
+						if p == where {
+							return decision
+						}
+						return err
+					},
+					LeaveDir: func(p string) error {
+						got = append(got, "leave:"+p)
+						if "leave:"+p == where {
+							return decision
+						}
+						return nil
+					},
+				}
+				var err error
+				if prepared {
+					err = WalkPrepared(context.Background(), trees, root, visitor)
+				} else {
+					err = Walk(context.Background(), trees, root, visitor)
+				}
+				if !prepared {
+					want, wantErr = got, err
+				} else if !reflect.DeepEqual(want, got) || err != wantErr {
+					t.Fatalf("%s: %v / %v; errors %v / %v", where, want, got, wantErr, err)
+				}
+			}
+		}
+	}
+}
