+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	defer unblock()
+	uploaderStarted := make(chan struct{})
+	firstSaveErr := make(chan error, 1)
+	done := make(chan error, 1)
