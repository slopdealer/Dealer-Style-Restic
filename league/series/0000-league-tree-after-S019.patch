@@ -0,0 +1,199 @@
+package archiver
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"testing"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+func TestParentPairHashAdmission(t *testing.T) {
+	lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+	first := b06Payload(2*asyncHashBufferSize+13, 271)
+	second := b06Payload(asyncHashBufferSize+29, 277)
+	job := lane.try(first, second)
+	if job == nil {
+		t.Fatal("large pair rejected")
+	}
+	// A completed but not joined worker still owns its borrowed assembly.
+	<-job.done
+	if lane.try(first, second) != nil {
+		t.Fatal("unjoined worker released admission")
+	}
+	ids, valid := job.finish()
+	if valid != [2]bool{true, true} || ids != [2]restic.ID{restic.Hash(first), restic.Hash(second)} {
+		t.Fatal("pair hash differs from complete SHA256")
+	}
+	if len(lane.active) != 0 || lane.try(first[:asyncHashBufferSize], second[:asyncHashBufferSize]) != nil {
+		t.Fatal("admission was retained or small route was changed")
+	}
+	one := lane.try(first, second[:17])
+	ids, valid = one.finish()
+	if valid != [2]bool{true, false} || ids[0] != restic.Hash(first) {
+		t.Fatal("small side was unexpectedly admitted")
+	}
+}
+
+func b02ReadHashed(ctx context.Context, rd io.Reader, factory b18TrialFactory, parent *data.Node, sizes map[restic.ID]uint, lane *parentPairHashLane) ([]int, []restic.ID, int, error) {
+	g := &parentCutReader{parent: parent, factory: factory, hashes: lane, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+	state := fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: ctx, guided: g}
+	c := factory.NewChunker()
+	scratch := make([]byte, 0, 2*1024*1024)
+	var ends []int
+	var ids []restic.ID
+	offset, admitted := 0, 0
+	for {
+		chunk, err := state.readNextChunk(rd, c, scratch)
+		if err != nil {
+			return ends, ids, admitted, err
+		}
+		id := restic.Hash(chunk)
+		if state.hashed {
+			admitted++
+			if state.chunkID != id {
+				return nil, nil, admitted, errors.New("speculative hash accepted for different bytes")
+			}
+			id = state.chunkID
+		}
+		offset += len(chunk)
+		ends = append(ends, offset)
+		ids = append(ids, id)
+		scratch = chunk
+	}
+}
+
+func TestParentPairHashIndependentBoundaries(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	base := b06Payload(40*1024*1024+173, 281)
+	parent, sizes := b18Guidance(base, pol)
+	mutation := bytes.Clone(base)
+	for i := 3 * 1024 * 1024; i < 3*1024*1024+70013; i++ {
+		mutation[i] ^= 29
+	}
+	insertion := append(bytes.Clone(base[:2100013]), base[:277]...)
+	insertion = append(insertion, base[2100013:]...)
+	var hashed int
+	for _, tc := range []struct {
+		name  string
+		input []byte
+	}{
+		{"unchanged", base}, {"mutation", mutation}, {"insertion", insertion},
+		{"growth", append(bytes.Clone(base), base[:1300013]...)},
+		{"truncation", base[:7*1024*1024+13]}, {"empty", nil},
+		{"zeros", make([]byte, 4*1024*1024+71)},
+	} {
+		for _, bad := range []int{-1, 0, 1} {
+			for _, division := range []int{37, 13001, 524288} {
+				t.Run(fmt.Sprintf("%s/hint%d/read%d", tc.name, bad, division), func(t *testing.T) {
+					local := make(map[restic.ID]uint)
+					for id, n := range sizes {
+						local[id] = n
+					}
+					if bad >= 0 {
+						local[parent.Content[bad]] += 113
+					}
+					lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+					got, ids, count, err := b02ReadHashed(t.Context(), &b18TrialShortReader{r: bytes.NewReader(tc.input), limit: division}, b18TrialFactory{pol}, parent, local, lane)
+					hashed += count
+					want := b18Cuts(tc.input, pol, 13001)
+					if len(tc.input) == 0 {
+						want = nil
+					}
+					if err != io.EOF || !slices.Equal(got, want) || !slices.Equal(ids, b18ContentIDs(tc.input, want)) || len(lane.active) != 0 {
+						t.Fatalf("boundaries, IDs or settlement changed: %v", err)
+					}
+				})
+			}
+		}
+	}
+	if hashed == 0 {
+		t.Fatal("no validated hash was exercised")
+	}
+}
+
+func TestParentPairHashFailureSettlement(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	base := b06Payload(10*1024*1024+13, 283)
+	parent, sizes := b18Guidance(base, pol)
+	for _, cancel := range []bool{false, true} {
+		ctx, stop := context.WithCancel(t.Context())
+		failure := errors.New("terminal file failure")
+		var rd io.Reader = io.MultiReader(bytes.NewReader(base), b18ErrorReader{failure})
+		if cancel {
+			stop()
+			failure = context.Canceled
+		}
+		lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+		_, _, _, err := b02ReadHashed(ctx, rd, b18TrialFactory{pol}, parent, sizes, lane)
+		stop()
+		if !errors.Is(err, failure) || len(lane.active) != 0 {
+			t.Fatalf("failure not joined: %v", err)
+		}
+	}
+}
+
+func TestParentPairHashSaverOwnership(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	original := b06Payload(20*1024*1024+173, 293)
+	parent, sizes := b18Guidance(original, pol)
+	mutated := bytes.Clone(original)
+	for i := 3100013; i < 3170026; i++ {
+		mutated[i] ^= 31
+	}
+	for _, input := range [][]byte{original, mutated} {
+		want := b06ExpectedChunks(input)
+		u := &b18HashUploader{known: make(map[restic.ID]int)}
+		for i, p := range want {
+			if i%2 == 0 {
+				u.known[p.id] = p.size
+			}
+		}
+		factory := b18TrialFactory{pol}
+		s := newFileSaver(t.Context(), nil, u, factory, 0)
+		b18EnableHash(s)
+		lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+		s.NodeFromFileInfo = func(string, string, toNoder, bool) (*data.Node, error) {
+			return &data.Node{Type: data.NodeTypeFile, Size: uint64(len(input))}, nil
+		}
+		state := &fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: t.Context(), guided: &parentCutReader{parent: parent, factory: factory, hashes: lane, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}}
+		file := &b06SaverFile{r: bytes.NewReader(input)}
+		var result futureNodeResult
+		reading, completed := 0, 0
+		s.saveFile(t.Context(), factory.NewChunker(), state, "/file", "file", file, func() {}, func() { reading++ }, func(r futureNodeResult) { result = r; completed++ })
+		if !file.closed || reading != 1 || completed != 0 || len(lane.active) != 0 {
+			t.Fatal("reading or admission settlement changed")
+		}
+		byID := make(map[restic.ID]b06PendingUpload)
+		for _, p := range want {
+			byID[p.id] = p
+		}
+		// Destroy the read/assembly view before delayed callbacks settle. Unknown
+		// upload bytes must have already detached from that storage.
+		if state.guided.root != nil {
+			clear(state.guided.root)
+		}
+		clear(state.readBuf)
+		for i := len(u.pending) - 1; i >= 0; i-- {
+			p := u.pending[i]
+			w, ok := byID[p.id]
+			if !ok || p.size != w.size || (!p.known && !bytes.Equal(p.data, w.data)) {
+				t.Fatal("upload borrowed assembly or used speculative ID")
+			}
+			p.cb(p.id, p.known, p.size, nil)
+		}
+		ids := make([]restic.ID, len(want))
+		for i, p := range want {
+			ids[i] = p.id
+		}
+		if completed != 1 || result.err != nil || !slices.Equal(result.node.Content, ids) {
+			t.Fatal("callbacks changed ordered file completion")
+		}
+	}
+}
diff --git a/internal/archiver/parent_tree_reuse.go b/internal/archiver/parent_tree_reuse.go
new file mode 100644
index 0000000000000000000000000000000000000000..85d9046a0d5c6e992472312690e566d7e960a7b6
--- /dev/null
+++ b/internal/archiver/parent_tree_reuse.go
@@ -0,0 +1,46 @@
+package archiver
+
+import (
+	"sync/atomic"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+// This budget covers extra plaintext lifetime, not the iterator's existing
+// lifetime. A full budget or oversized allocation simply uses ordinary hashing.
+const parentTreeRetentionMax = 1 << 20
+
+type parentTreeBudget struct {
+	used atomic.Int64
+}
+
+type parentTreeBytes struct {
+	id      restic.ID
+	payload []byte
+	budget  *parentTreeBudget
+}
+
+func (b *parentTreeBudget) retain(id restic.ID, payload []byte) *parentTreeBytes {
+	size := int64(cap(payload))
+	if size > parentTreeRetentionMax {
+		return nil
+	}
+	for {
+		used := b.used.Load()
+		if used+size > parentTreeRetentionMax {
+			return nil
+		}
+		if b.used.CompareAndSwap(used, used+size) {
+			return &parentTreeBytes{id: id, payload: payload, budget: b}
+		}
+	}
+}
+
+// The traversal owns this until dispatch; then the tree job owns it. Early
+// traversal exits, cancelled dispatch and completed jobs all release ownership.
+func (p *parentTreeBytes) release() {
+	if p != nil {
+		p.budget.used.Add(-int64(cap(p.payload)))
+		p.payload = nil
+	}
+}
diff --git a/internal/archiver/parent_tree_reuse_test.go b/internal/archiver/parent_tree_reuse_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2ee9dae266d72809b705a1aaab34aeb79130dc0a
--- /dev/null
+++ b/internal/archiver/parent_tree_reuse_test.go
@@ -0,0 +1,278 @@
+package archiver
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+type parentIDCaptureSaver struct {
+	id      restic.ID
+	payload []byte
+	known   bool
+	err     error
+}
+
+func (s *parentIDCaptureSaver) SaveBlobAsync(_ context.Context, _ restic.BlobType, buf []byte, id restic.ID, duplicate bool, cb func(restic.ID, bool, int, error)) {
+	s.id = id
+	s.payload = append([]byte(nil), buf...)
+	cb(restic.Hash(buf), s.known, len(buf), s.err)
+}
+
+func encodeReuseTree(t *testing.T, nodes ...*data.Node) []byte {
+	t.Helper()
+	b := data.NewTreeJSONBuilder()
+	for _, n := range nodes {
+		if err := b.AddNode(n); err != nil {
+			t.Fatal(err)
+		}
+	}
+	buf, err := b.Finalize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return buf
+}
+
+func TestParentTreeByteReuse(t *testing.T) {
+	original := &data.Node{Name: "file", Type: data.NodeTypeFile, ModTime: time.Date(2026, 1, 1, 12, 0, 0, 0, time.UTC), ExtendedAttributes: []data.ExtendedAttribute{{Name: "a", Value: []byte("1")}, {Name: "b", Value: []byte("2")}}}
+	canonical := encodeReuseTree(t, original)
+	changedOffset := *original
+	changedOffset.ModTime = original.ModTime.In(time.FixedZone("other", 3600))
+	changedOrder := *original
+	changedOrder.ExtendedAttributes = []data.ExtendedAttribute{original.ExtendedAttributes[1], original.ExtendedAttributes[0]}
+	emptyContent := *original
+	emptyContent.Content = restic.IDs{}
+	for _, tc := range []struct {
+		name   string
+		node   *data.Node
+		parent []byte
+		reuse  bool
+		known  bool
+	}{
+		{"identical-known", original, canonical, true, true},
+		{"identical-not-indexed", original, canonical, true, false},
+		{"timestamp-offset", &changedOffset, canonical, false, true},
+		{"xattr-order", &changedOrder, canonical, false, true},
+		{"nil-versus-empty-content", &emptyContent, canonical, false, true},
+		{"noncanonical-parent", original, append([]byte(" "), canonical...), false, true},
+		{"omitted-child", nil, canonical, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			budget := new(parentTreeBudget)
+			parent := budget.retain(restic.Hash(tc.parent), tc.parent)
+			saver := &parentIDCaptureSaver{known: tc.known}
+			ts := &treeSaver{uploader: saver, errFn: func(_ string, err error) error { return err }}
+			var children []futureNode
+			if tc.node != nil {
+				children = append(children, newFutureNodeWithResult(futureNodeResult{node: tc.node}))
+			}
+			node, stats, err := ts.save(context.Background(), &saveTreeJob{node: &data.Node{}, nodes: children, parent: parent})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.reuse {
+				if saver.id != restic.Hash(tc.parent) {
+					t.Fatal("parent ID not supplied")
+				}
+			} else if !saver.id.IsNull() {
+				t.Fatal("nonidentical bytes reused")
+			}
+			if *node.Subtree != restic.Hash(saver.payload) {
+				t.Fatal("subtree ID differs from emitted bytes")
+			}
+			if tc.known && stats.TreeBlobs != 0 {
+				t.Fatal("known tree counted as new")
+			}
+			if !tc.known && (stats.TreeBlobs != 1 || stats.TreeSize != uint64(len(saver.payload))) {
+				t.Fatal("new tree accounting lost")
+			}
+			if budget.used.Load() != 0 {
+				t.Fatal("retention not released")
+			}
+		})
+	}
+}
+
+func TestParentTreeReuseFailureAndBudget(t *testing.T) {
+	budget := new(parentTreeBudget)
+	full := make([]byte, parentTreeRetentionMax)
+	parent := budget.retain(restic.Hash(full), full)
+	if parent == nil || budget.retain(restic.ID{}, []byte{1}) != nil {
+		t.Fatal("budget not enforced")
+	}
+	parent.release()
+	oversized := make([]byte, 1, parentTreeRetentionMax+1)
+	if budget.retain(restic.ID{}, oversized) != nil {
+		t.Fatal("capacity not charged")
+	}
+	expected := errors.New("save failed")
+	payload := encodeReuseTree(t)
+	parent = budget.retain(restic.Hash(payload), payload)
+	ts := &treeSaver{uploader: &parentIDCaptureSaver{err: expected}, errFn: func(_ string, err error) error { return err }}
+	_, _, err := ts.save(context.Background(), &saveTreeJob{node: &data.Node{}, parent: parent})
+	if err != expected || budget.used.Load() != 0 {
+		t.Fatal("save error or retention changed")
+	}
+	parent = budget.retain(restic.Hash(payload), payload)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	ts.ch = make(chan saveTreeJob)
+	ts.saveWithParent(ctx, "/", "/", &data.Node{}, nil, nil, parent)
+	if budget.used.Load() != 0 {
+		t.Fatal("cancelled dispatch leaked retention")
+	}
+}
+
+func TestParentTreeReuseOrderedErrorSettlement(t *testing.T) {
+	budget := new(parentTreeBudget)
+	payload := encodeReuseTree(t)
+	parent := budget.retain(restic.Hash(payload), payload)
+	first, second := errors.New("first"), errors.New("second")
+	var seen []error
+	saver := &parentIDCaptureSaver{}
+	ts := &treeSaver{uploader: saver, errFn: func(_ string, err error) error { seen = append(seen, err); return err }}
+	_, _, err := ts.save(context.Background(), &saveTreeJob{node: &data.Node{}, parent: parent, nodes: []futureNode{
+		newFutureNodeWithResult(futureNodeResult{err: first}),
+		newFutureNodeWithResult(futureNodeResult{err: second}),
+	}})
+	if err != first || len(seen) != 1 || seen[0] != first {
+		t.Fatal("error settlement changed")
+	}
+	if saver.payload != nil || budget.used.Load() != 0 {
+		t.Fatal("failed tree saved or retention leaked")
+	}
+	parent = budget.retain(restic.Hash(payload), payload)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	ch := make(chan futureNodeResult)
+	_, _, err = ts.save(ctx, &saveTreeJob{node: &data.Node{}, parent: parent, nodes: []futureNode{{ch: ch}}})
+	if err != context.Canceled || budget.used.Load() != 0 {
+		t.Fatal("child wait cancellation leaked retention")
+	}
+}
+
+// Exercise completion through the worker, after the same child settlement that
+// backup uses. Reuse must neither skip the completion callback nor count a known
+// tree as newly stored when exclusions and ignored errors omit children.
+func TestParentTreeReuseWorkerCompletion(t *testing.T) {
+	for _, known := range []bool{false, true} {
+		for _, reuse := range []bool{false, true} {
+			n := &data.Node{Name: "a", Type: data.NodeTypeFile}
+			payload := encodeReuseTree(t, n)
+			budget := new(parentTreeBudget)
+			var parent *parentTreeBytes
+			if reuse {
+				parent = budget.retain(restic.Hash(payload), payload)
+			}
+			ignored := errors.New("ignored child error")
+			var warnings []error
+			saver := &parentIDCaptureSaver{known: known}
+			ts := &treeSaver{uploader: saver, errFn: func(_ string, err error) error {
+				warnings = append(warnings, err)
+				return nil
+			}}
+			future, result := newFutureNode()
+			jobs := make(chan saveTreeJob, 1)
+			completions := 0
+			var completed ItemStats
+			jobs <- saveTreeJob{node: &data.Node{}, parent: parent, ch: result,
+				complete: func(node *data.Node, stats ItemStats) {
+					completions++
+					completed = stats
+					if node.Subtree == nil || *node.Subtree != restic.Hash(payload) {
+						t.Fatal("completion saw a different subtree")
+					}
+				}, nodes: []futureNode{
+					newFutureNodeWithResult(futureNodeResult{node: n}),
+					newFutureNodeWithResult(futureNodeResult{node: n}),
+					newFutureNodeWithResult(futureNodeResult{}),
+					newFutureNodeWithResult(futureNodeResult{err: ignored}),
+				}}
+			close(jobs)
+			if err := ts.worker(context.Background(), jobs); err != nil {
+				t.Fatal(err)
+			}
+			got := future.take(context.Background())
+			if got.err != nil || completions != 1 || got.stats != completed {
+				t.Fatal("completion or future accounting changed")
+			}
+			if len(warnings) != 2 || !errors.Is(warnings[0], data.ErrTreeNotOrdered) || warnings[1] != ignored {
+				t.Fatal("duplicate warning or ignored error order changed")
+			}
+			if string(saver.payload) != string(payload) || budget.used.Load() != 0 {
+				t.Fatal("emitted bytes or ownership changed")
+			}
+			if known && got.stats.TreeBlobs != 0 || !known && (got.stats.TreeBlobs != 1 || got.stats.TreeSize != uint64(len(payload))) {
+				t.Fatal("known/new tree statistics changed")
+			}
+		}
+	}
+}
+
+type pendingParentSave struct {
+	payload  []byte
+	complete func(restic.ID, bool, int, error)
+}
+type pendingParentSaver struct{ entered chan pendingParentSave }
+
+func (s *pendingParentSaver) SaveBlobAsync(_ context.Context, _ restic.BlobType, buf []byte, _ restic.ID, _ bool, cb func(restic.ID, bool, int, error)) {
+	s.entered <- pendingParentSave{buf, cb}
+}
+
+func TestParentTreeRetentionThroughCanceledSave(t *testing.T) {
+	for _, trailing := range []bool{false, true} {
+		t.Run(map[bool]string{false: "equal", true: "reference-prefix"}[trailing], func(t *testing.T) {
+			n := &data.Node{Name: "a", Type: data.NodeTypeFile}
+			expected := encodeReuseTree(t, n)
+			payload := append([]byte(nil), expected...)
+			if trailing {
+				payload = append(payload, ' ')
+			}
+			budget := new(parentTreeBudget)
+			parent := budget.retain(restic.Hash(payload), payload)
+			charge := budget.used.Load()
+			saver := &pendingParentSaver{make(chan pendingParentSave, 1)}
+			ts := &treeSaver{uploader: saver, errFn: func(_ string, err error) error { return err }}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				_, _, err := ts.save(ctx, &saveTreeJob{node: &data.Node{}, parent: parent, nodes: []futureNode{newFutureNodeWithResult(futureNodeResult{node: n})}})
+				done <- err
+			}()
+			var pending pendingParentSave
+			select {
+			case pending = <-saver.entered:
+			case <-time.After(5 * time.Second):
+				t.Fatal("save did not start")
+			}
+			cancel()
+			select {
+			case err := <-done:
+				if err != context.Canceled {
+					t.Fatalf("save: %v", err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("save did not cancel")
+			}
+			if budget.used.Load() != charge {
+				t.Fatal("in-flight bytes lost retention charge")
+			}
+			if &pending.payload[0] != &payload[0] {
+				t.Fatal("test did not exercise reference-backed output")
+			}
+			if string(pending.payload) != string(expected) {
+				t.Fatal("in-flight bytes changed")
+			}
+			pending.complete(restic.Hash(pending.payload), false, len(pending.payload), nil)
+			if budget.used.Load() != 0 {
+				t.Fatal("completion did not release retention")
+			}
+		})
+	}
+}
diff --git a/internal/archiver/scanner_freshness_test.go b/internal/archiver/scanner_freshness_test.go
