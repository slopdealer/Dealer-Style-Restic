@@ -0,0 +1,126 @@
+package repository
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Keep the verification plan fixed while varying the actual index membership.
+// Authentication and whole-header interpretation must settle before this query.
+func membershipCheckerResult(t *testing.T, key *crypto.Key, data []byte, id restic.ID, plan, stored pack.Blobs, baseline bool) string {
+	t.Helper()
+	r := b11Repository(key, &b11ScriptBackend{data: data}, id, stored)
+	dec, err := zstd.NewReader(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dec.Close()
+	rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+	if baseline {
+		err = b11BaselineCheckPack(context.Background(), r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+	} else {
+		err = checkPack(context.Background(), r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+	}
+	if err == nil {
+		return ""
+	}
+	var pe *ErrPackData
+	if !errors.As(err, &pe) {
+		t.Fatalf("classification changed: %v", err)
+	}
+	return err.Error()
+}
+
+func TestMembershipCheckerLocationSettlement(t *testing.T) {
+	key := crypto.NewRandomKey()
+	data, blobs, id := b11MakePack(key, 4096, "compressed")
+	for _, mode := range []string{"missing", "offset", "length", "uncompressed-length", "type", "id", "duplicate-match"} {
+		t.Run(mode, func(t *testing.T) {
+			b := blobs[0]
+			switch mode {
+			case "offset":
+				b.Offset++
+			case "length":
+				b.Length++
+			case "uncompressed-length":
+				b.UncompressedLength++
+			case "type":
+				b.Type = restic.TreeBlob
+			case "id":
+				b.ID[0] ^= 1
+			}
+			stored := pack.Blobs{b}
+			if mode == "missing" {
+				stored = nil
+			}
+			if mode == "duplicate-match" {
+				wrong := b
+				wrong.Offset++
+				stored = pack.Blobs{wrong, b, wrong, b}
+			}
+			want := membershipCheckerResult(t, key, data, id, blobs, stored, true)
+			got := membershipCheckerResult(t, key, data, id, blobs, stored, false)
+			if got != want {
+				t.Fatalf("got %q want %q", got, want)
+			}
+			if mode == "duplicate-match" {
+				if got != "" {
+					t.Fatal(got)
+				}
+			} else if !strings.Contains(got, "is not contained in index or position is incorrect") {
+				t.Fatalf("wrong membership diagnostic: %s", got)
+			}
+		})
+	}
+}
+
+func TestMembershipMalformedLateHeaderPrecedence(t *testing.T) {
+	key := crypto.NewRandomKey()
+	var out bytes.Buffer
+	p := pack.NewPacker(key, &out)
+	for _, plain := range [][]byte{[]byte("first blob"), []byte("second blob")} {
+		nonce := crypto.NewRandomNonce()
+		ciphertext := key.Seal(append([]byte(nil), nonce...), nonce, plain, nil)
+		if _, err := p.Add(restic.DataBlob, restic.Hash(plain), ciphertext, 0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := p.Finalize(); err != nil {
+		t.Fatal(err)
+	}
+	data := bytes.Clone(out.Bytes())
+	plan, _, err := pack.List(key, bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	n := int(binary.LittleEndian.Uint32(data[len(data)-4:]))
+	start := len(data) - 4 - n
+	cipher := data[start : len(data)-4]
+	header, err := key.Open(nil, cipher[:key.NonceSize()], cipher[key.NonceSize():], nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// First entry is valid and absent from the index. Second is authenticated but
+	// invalid. Stock reports only the complete-header error, no membership error.
+	header[pack.CalculateEntrySize(false)] = 255
+	nonce := crypto.NewRandomNonce()
+	changed := key.Seal(append([]byte(nil), nonce...), nonce, header, nil)
+	copy(data[start:len(data)-4], changed)
+	id := restic.Hash(data)
+	want := membershipCheckerResult(t, key, data, id, plan, nil, true)
+	got := membershipCheckerResult(t, key, data, id, plan, nil, false)
+	if got != want || !strings.Contains(got, "invalid type 255") || strings.Contains(got, "is not contained in index") {
+		t.Fatalf("late header precedence changed: got %q want %q", got, want)
+	}
+	t.Log("executed authenticated late-header failure with earlier missing membership")
+}
diff --git a/internal/repository/checker_owned_tail_contract_test.go b/internal/repository/checker_owned_tail_contract_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1dae5fe500a4cfb66c3742018b2c4b1bba99f648
--- /dev/null
+++ b/internal/repository/checker_owned_tail_contract_test.go
@@ -0,0 +1,166 @@
+package repository
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+type b11OwnedRepeatBackend struct {
+	backend.Backend
+	data   []byte
+	mode   string
+	calls  int
+	cancel context.CancelFunc
+}
+
+func (b *b11OwnedRepeatBackend) Load(_ context.Context, _ backend.Handle, _ int, _ int64, consume func(io.Reader) error) error {
+	b.calls++
+	if b.mode == "two-full-callbacks" {
+		if err := consume(bytes.NewReader(b.data)); err != nil {
+			return err
+		}
+		return consume(bytes.NewReader(b.data))
+	}
+	if b.mode == "full-then-transport-error" && b.calls == 1 {
+		if err := consume(bytes.NewReader(b.data)); err != nil {
+			return err
+		}
+		return fmt.Errorf("transport failed after complete callback")
+	}
+	if b.mode == "cancel-during-tail" {
+		return consume(&b11OwnedCancelReader{data: b.data, at: 0, cancel: b.cancel, tailStart: len(b.data) - int(binary.LittleEndian.Uint32(b.data[len(b.data)-4:])) - 4})
+	}
+	return consume(bytes.NewReader(b.data))
+}
+
+type b11OwnedCancelReader struct {
+	data          []byte
+	at, tailStart int
+	cancel        context.CancelFunc
+}
+
+func (r *b11OwnedCancelReader) Read(dst []byte) (int, error) {
+	if r.at == len(r.data) {
+		return 0, io.EOF
+	}
+	if len(dst) > 16 {
+		dst = dst[:16]
+	}
+	n := copy(dst, r.data[r.at:])
+	r.at += n
+	if r.at > r.tailStart && r.cancel != nil {
+		r.cancel()
+		r.cancel = nil
+	}
+	return n, nil
+}
+func b11OwnedCheckerCall(key *crypto.Key, data []byte, id restic.ID, plan, stored pack.Blobs, mode string, old bool) (string, int) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	be := &b11OwnedRepeatBackend{data: data, mode: mode, cancel: cancel}
+	r := b11Repository(key, be, id, stored)
+	dec, err := zstd.NewReader(nil)
+	if err != nil {
+		panic(err)
+	}
+	defer dec.Close()
+	rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+	if old {
+		err = b11BaselineCheckPack(ctx, r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+	} else {
+		err = checkPack(ctx, r, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+	}
+	if err == nil {
+		return "", be.calls
+	}
+	return fmt.Sprintf("%T:%v", err, err), be.calls
+}
+func b11OwnedCheckerCases() (int, error) {
+	key := crypto.NewRandomKey()
+	cases := 0
+	for _, mode := range []string{"two-full-callbacks", "full-then-transport-error", "cancel-during-tail"} {
+		data, plan, id := b11MakePack(key, 4096, "compressed")
+		saved := bytes.Clone(data)
+		want, wc := b11OwnedCheckerCall(key, data, id, plan, plan, mode, true)
+		got, gc := b11OwnedCheckerCall(key, data, id, plan, plan, mode, false)
+		cases++
+		if want != got || wc != gc || !bytes.Equal(saved, data) {
+			return cases, fmt.Errorf("%s differs: %s/%s calls %d/%d source_mutated=%v", mode, want, got, wc, gc, !bytes.Equal(saved, data))
+		}
+	}
+	var out bytes.Buffer
+	p := pack.NewPacker(key, &out)
+	for _, plain := range [][]byte{[]byte("first"), []byte("second")} {
+		nonce := crypto.NewRandomNonce()
+		ct := key.Seal(append([]byte(nil), nonce...), nonce, plain, nil)
+		if _, err := p.Add(restic.DataBlob, restic.Hash(plain), ct, 0); err != nil {
+			return cases, err
+		}
+	}
+	if err := p.Finalize(); err != nil {
+		return cases, err
+	}
+	data := bytes.Clone(out.Bytes())
+	plan, _, err := pack.List(key, bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return cases, err
+	}
+	n := int(binary.LittleEndian.Uint32(data[len(data)-4:]))
+	start := len(data) - n - 4
+	ct := data[start : len(data)-4]
+	plain, err := key.Open(nil, ct[:key.NonceSize()], ct[key.NonceSize():], nil)
+	if err != nil {
+		return cases, err
+	}
+	plain[pack.CalculateEntrySize(false)] = 255
+	nonce := crypto.NewRandomNonce()
+	changed := key.Seal(append([]byte(nil), nonce...), nonce, plain, nil)
+	copy(ct, changed)
+	id := restic.Hash(data)
+	saved := bytes.Clone(data)
+	want, _ := b11OwnedCheckerCall(key, data, id, plan, nil, "", true)
+	got, _ := b11OwnedCheckerCall(key, data, id, plan, nil, "", false)
+	cases++
+	if want != got || !strings.Contains(got, "invalid type 255") || strings.Contains(got, "is not contained in index") || !bytes.Equal(saved, data) {
+		return cases, fmt.Errorf("late malformed header changed precedence: %s/%s", want, got)
+	}
+	// Hash failure still takes priority over that authenticated malformed header.
+	wrongID := id
+	wrongID[0] ^= 1
+	want, _ = b11OwnedCheckerCall(key, data, wrongID, plan, nil, "", true)
+	got, _ = b11OwnedCheckerCall(key, data, wrongID, plan, nil, "", false)
+	cases++
+	if want != got || !strings.Contains(got, "unexpected pack id") || strings.Contains(got, "invalid type") {
+		return cases, fmt.Errorf("pack-hash priority changed: %s/%s", want, got)
+	}
+	return cases, nil
+}
+func TestOwnedCheckerContract(t *testing.T) {
+	n, err := b11OwnedCheckerCases()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("executed %d ownership/settlement cases", n)
+}
+func b11PrintOwnedCheckerDiagnostic() {
+	n, err := b11OwnedCheckerCases()
+	if err != nil {
+		panic(err)
+	}
+	b, _ := json.Marshal(map[string]any{"label": "B11_OWNED_CHECKER_M004", "cases": n, "two_full_callbacks": true, "retry_after_successful_callback": true, "cancel_during_tail_read": true, "late_header_precedence": true, "pack_hash_precedence": true, "authoritative_bytes_unchanged": true})
+	fmt.Fprintln(os.Stderr, string(b))
+}
diff --git a/internal/repository/checker_pack_sizes.go b/internal/repository/checker_pack_sizes.go
new file mode 100644
index 0000000000000000000000000000000000000000..129cd650ea5a0db8f63952200971c2d92cfd41dd
--- /dev/null
+++ b/internal/repository/checker_pack_sizes.go
@@ -0,0 +1,48 @@
+package repository
+
+import (
+	"context"
+
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+// PreparedPackSizes contains only index-derived information. It performs no
+// backend listing or pack reads, so it can be prepared during lock settlement.
+// The caller owns the result until transferring it to PacksWithPreparedSizes.
+type PreparedPackSizes struct {
+	repo  *Repository
+	sizes map[restic.ID]int64
+	err   error
+}
+
+// ForReadPacks shares the immutable expected sizes with a subsequent read-data
+// pass. PacksWithPreparedSizes only reads this map (it removes matched entries
+// from its separate backend-listing map). The read-data pass must start after
+// pack metadata checking finishes, as its filter may modify the shared map.
+func (p *PreparedPackSizes) ForReadPacks() *PreparedPackSizes {
+	if p == nil {
+		return nil
+	}
+	copy := *p
+	return &copy
+}
+
+func (c *Checker) PreparePackSizes(ctx context.Context) *PreparedPackSizes {
+	sizes, err := pack.Size(ctx, c.repo, false)
+	if err != nil {
+		// A partial size map cannot be used and need not survive cancellation.
+		sizes = nil
+	}
+	return &PreparedPackSizes{repo: c.repo, sizes: sizes, err: err}
+}
+
+func (c *Checker) takePackSizes(ctx context.Context, prepared *PreparedPackSizes) (map[restic.ID]int64, error) {
+	if prepared == nil || prepared.repo != c.repo {
+		return pack.Size(ctx, c.repo, false)
+	}
+	sizes, err := prepared.sizes, prepared.err
+	// Transfer once; another call uses the normal synchronous path.
+	prepared.repo, prepared.sizes, prepared.err = nil, nil, nil
+	return sizes, err
+}
diff --git a/internal/repository/checker_pack_sizes_test.go b/internal/repository/checker_pack_sizes_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..575079a0b06cc1e28270a71cf4f3df1428dec754
--- /dev/null
+++ b/internal/repository/checker_pack_sizes_test.go
@@ -0,0 +1,127 @@
+package repository
+
+import (
+	"context"
+	"path/filepath"
+	"sort"
+	"testing"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+	rtest "github.com/restic/restic/internal/test"
+)
+
+func collectPreparedPackErrors(ctx context.Context, f func(context.Context, chan<- error)) (errs []error) {
+	errChan := make(chan error)
+	go f(ctx, errChan)
+	for err := range errChan {
+		errs = append(errs, err)
+	}
+	return errs
+}
+
+func packErrorStrings(errs []error) []string {
+	result := make([]string, len(errs))
+	for i, err := range errs {
+		result[i] = err.Error()
+	}
+	sort.Strings(result)
+	return result
+}
+
+func TestPreparedPackSizesObserveLaterBackendChanges(t *testing.T) {
+	ctx := context.Background()
+	repo, be := TestFromFixture(t, filepath.Join("..", "checker", "testdata", "checker-test-repo.tar.gz"))
+	rtest.OK(t, repo.LoadIndex(ctx, restic.NoopTerminalCounterFactory))
+	c := newChecker(repo)
+	prepared := c.PreparePackSizes(ctx)
+	expected, err := pack.Size(ctx, repo, false)
+	rtest.OK(t, err)
+	rtest.Equals(t, expected, prepared.sizes)
+	rtest.OK(t, prepared.err)
+
+	// These model changes made by a writer that completes during settlement.
+	// The expected map stays fixed, but actual membership must be read later.
+	var missing restic.ID
+	for id := range expected {
+		missing = id
+		break
+	}
+	rtest.Assert(t, !missing.IsNull(), "fixture has no indexed packs")
+	rtest.OK(t, be.Remove(ctx, backend.Handle{Type: backend.PackFile, Name: missing.String()}))
+	orphan := restic.Hash([]byte("new pack published while confirmation is pending"))
+	rtest.OK(t, be.Save(ctx, backend.Handle{Type: backend.PackFile, Name: orphan.String()}, backend.NewByteReader([]byte("orphan"), be.Hasher())))
+
+	ordinary := collectPreparedPackErrors(ctx, c.Packs)
+	early := collectPreparedPackErrors(ctx, func(ctx context.Context, errs chan<- error) {
+		c.PacksWithPreparedSizes(ctx, prepared, errs)
+	})
+	rtest.Equals(t, packErrorStrings(ordinary), packErrorStrings(early))
+	var sawMissing, sawOrphan bool
+	for _, err := range early {
+		if e, ok := err.(*ErrPackMetadata); ok {
+			sawMissing = sawMissing || (e.ID == missing && e.Missing)
+			sawOrphan = sawOrphan || (e.ID == orphan && e.Orphaned)
+		}
+	}
+	rtest.Assert(t, sawMissing && sawOrphan, "later membership changes were not observed: %v", early)
+	rtest.Assert(t, prepared.repo == nil && prepared.sizes == nil, "prepared result was not transferred")
+	// A transferred object falls back safely if used again.
+	again := collectPreparedPackErrors(ctx, func(ctx context.Context, errs chan<- error) {
+		c.PacksWithPreparedSizes(ctx, prepared, errs)
+	})
+	rtest.Equals(t, packErrorStrings(ordinary), packErrorStrings(again))
+}
+
+func TestPreparedPackSizesCancellationDropsPartialMap(t *testing.T) {
+	repo, _ := TestFromFixture(t, filepath.Join("..", "checker", "testdata", "checker-test-repo.tar.gz"))
+	rtest.OK(t, repo.LoadIndex(context.Background(), restic.NoopTerminalCounterFactory))
+	c := newChecker(repo)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	prepared := c.PreparePackSizes(ctx)
+	rtest.Equals(t, context.Canceled, prepared.err)
+	rtest.Assert(t, prepared.sizes == nil, "canceled preparation retained partial sizes")
+
+	// Drain errors, as callers of the frozen Packs API already must do.
+	errs := collectPreparedPackErrors(ctx, func(ctx context.Context, errs chan<- error) {
+		c.PacksWithPreparedSizes(ctx, prepared, errs)
+	})
+	rtest.Equals(t, 1, len(errs))
+	rtest.Equals(t, context.Canceled, errs[0])
+}
+
+func TestPreparedPackSizesReuseForReadData(t *testing.T) {
+	ctx := context.Background()
+	repo, _ := TestFromFixture(t, filepath.Join("..", "checker", "testdata", "checker-test-repo.tar.gz"))
+	rtest.OK(t, repo.LoadIndex(ctx, restic.NoopTerminalCounterFactory))
+	c := newChecker(repo)
+	prepared := c.PreparePackSizes(ctx)
+	readSizes := prepared.ForReadPacks()
+	expected, err := pack.Size(ctx, repo, false)
+	rtest.OK(t, err)
+	errs := collectPreparedPackErrors(ctx, func(ctx context.Context, errs chan<- error) {
+		c.PacksWithPreparedSizes(ctx, prepared, errs)
+	})
+	rtest.Equals(t, 0, len(errs))
+	rtest.Equals(t, expected, readSizes.sizes)
+
+	// A read-data filter is allowed to alter its map. This is safe only after
+	// metadata checking finishes, and must not alter the loaded index itself.
+	errs = collectPreparedPackErrors(ctx, func(ctx context.Context, errs chan<- error) {
+		c.ReadPacksWithPreparedSizes(ctx, readSizes, func(sizes map[restic.ID]int64) map[restic.ID]int64 {
+			rtest.Equals(t, expected, sizes)
+			for id := range sizes {
+				delete(sizes, id)
+				break
+			}
+			return sizes
+		}, restic.NewNoopPrinter(), errs)
+	})
+	rtest.Equals(t, 0, len(errs))
+	rtest.Assert(t, readSizes.repo == nil && readSizes.sizes == nil, "read-data did not consume the shared descriptor")
+	again, err := pack.Size(ctx, repo, false)
+	rtest.OK(t, err)
+	rtest.Equals(t, expected, again)
+}
diff --git a/internal/repository/checker_reader_release_test.go b/internal/repository/checker_reader_release_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..14238d8e928483ac52ebe659ab0fb51447481f11
--- /dev/null
+++ b/internal/repository/checker_reader_release_test.go
@@ -0,0 +1,73 @@
+package repository
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+)
+
+// Keep each worker's decoder across successful, failed and retried packs.
+// Compare errors and retry counts with the pre-cleanup checker, then verify
+// that a subsequent compressed pack remains readable after each transition.
+func TestCheckerReaderReleaseAndReuse(t *testing.T) {
+	key := crypto.NewRandomKey()
+	for _, concurrency := range []int{1, 4} {
+		t.Run(fmt.Sprint(concurrency), func(t *testing.T) {
+			dec, err := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dec.Close()
+			rd := bufio.NewReaderSize(nil, maxStreamBufferSize)
+			cases := []struct{ kind, mode string }{
+				{"compressed", ""}, {"compressed-corrupt", ""},
+				{"compressed", "backend-retry"}, {"compressed", "partial-good"},
+				{"compressed", "partial-different"}, {"compressed", "partial"},
+				{"compressed", "pack-hash"}, {"auth", ""},
+				{"wrong-hash", ""}, {"compressed", "cancel"},
+				{"ordinary", ""}, {"compressed", ""},
+			}
+			for _, tc := range cases {
+				data, plan, id := b11MakePack(key, 128<<10, tc.kind)
+				run := func(old bool) (string, int) {
+					ctx, cancel := context.WithCancel(context.Background())
+					defer cancel()
+					be := &b11ScriptBackend{data: data, mode: tc.mode, cancel: cancel}
+					repo := b11Repository(key, be, id, plan)
+					var got error
+					if old {
+						oldDec, e := zstd.NewReader(nil, zstd.WithDecoderConcurrency(concurrency))
+						if e != nil {
+							t.Fatal(e)
+						}
+						defer oldDec.Close()
+						got = b11BaselineCheckPack(ctx, repo, id, append(pack.Blobs(nil), plan...), int64(len(data)), bufio.NewReaderSize(nil, maxStreamBufferSize), oldDec)
+					} else {
+						got = checkPack(ctx, repo, id, append(pack.Blobs(nil), plan...), int64(len(data)), rd, dec)
+					}
+					if got == nil {
+						return "", be.calls
+					}
+					return fmt.Sprintf("%T:%v", got, got), be.calls
+				}
+				want, wantCalls := run(true)
+				got, gotCalls := run(false)
+				if got != want || gotCalls != wantCalls {
+					t.Fatalf("%+v: errors %q / %q, attempts %d / %d", tc, got, want, gotCalls, wantCalls)
+				}
+				if rd.Buffered() != 0 {
+					t.Fatalf("%+v: reader retained %d buffered bytes", tc, rd.Buffered())
+				}
+				if _, e := dec.Read(make([]byte, 1)); e != zstd.ErrDecoderNilInput {
+					t.Fatalf("%+v: decoder not detached: %v", tc, e)
+				}
+			}
+			t.Logf("matched %d pack transitions; reusable readers detached", len(cases))
+		})
+	}
+}
diff --git a/internal/repository/checker_reverse_contract_test.go b/internal/repository/checker_reverse_contract_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..aaf67d8742978504b0d9b5c689a691eb210b06d9
--- /dev/null
+++ b/internal/repository/checker_reverse_contract_test.go
@@ -0,0 +1,119 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+type reverseCorruptBackend struct {
+	backend.Backend
+	mu      sync.Mutex
+	first   string
+	loads   map[string]int
+	release chan struct{}
+}
+
+func (b *reverseCorruptBackend) Load(ctx context.Context, h backend.Handle, length int, offset int64, consume func(io.Reader) error) error {
+	if h.Type != backend.PackFile {
+		return b.Backend.Load(ctx, h, length, offset, consume)
+	}
+	b.mu.Lock()
+	if b.first == "" {
+		b.first = h.Name
+	}
+	wait := h.Name == b.first
+	b.loads[h.Name]++
+	b.mu.Unlock()
+	if wait {
+		select {
+		case <-b.release:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return b.Backend.Load(ctx, h, length, offset, func(rd io.Reader) error {
+		buf, err := io.ReadAll(rd)
+		if err != nil {
+			return err
+		}
+		if len(buf) != 0 {
+			buf[len(buf)-1] ^= 0xff
+		}
+		return consume(bytes.NewReader(buf))
+	})
+}
+
+// No FIFO obligation: a later corrupt pack must be reported while the first
+// pack is still blocked. Three packs avoid hiding all later work behind the
+// extra worker's one-entry queue. All packs must be retried and classified as
+// data errors. This test runs against the incumbent and checker additions.
+func TestCheckerReverseCorruptCompletion(t *testing.T) {
+	TestInjectKey(t, restic.TestParseID("7bb3065bfb17da7430dc4dde4741d6db3dd83fdb0829500cf105755e067f879a"), `{"mac":{"k":"W1Y8bmQNJg6TAmuDt7lbpQ==","r":"r43DBmAdmwtQneoBTGAABQ=="},"encrypt":"JuZGBs6joRiLzqkyMWhmbZMLHe8+5oH6MDE5I6M8R/I="}`)
+	repo, be := TestFromFixture(t, checkerTestData)
+	_ = repo
+	b := &reverseCorruptBackend{Backend: be, loads: make(map[string]int), release: make(chan struct{})}
+	r := TestOpenBackend(t, b)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := r.LoadIndex(ctx, restic.NoopTerminalCounterFactory); err != nil {
+		t.Fatal(err)
+	}
+	sizes, err := pack.Size(ctx, r, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chosen := make(map[restic.ID]int64)
+	for id, size := range sizes {
+		chosen[id] = size
+		if len(chosen) == 3 {
+			break
+		}
+	}
+	if len(chosen) != 3 {
+		t.Fatal("fixture needs three packs")
+	}
+	errs := make(chan error)
+	go newChecker(r).ReadPacks(ctx, func(map[restic.ID]int64) map[restic.ID]int64 { return chosen }, restic.NewNoopPrinter(), errs)
+	var first error
+	select {
+	case first = <-errs:
+	case <-ctx.Done():
+		close(b.release)
+		t.Fatal("later corrupt pack was not reported while first was held")
+	}
+	b.mu.Lock()
+	held := b.first
+	b.mu.Unlock()
+	var pe *ErrPackData
+	if !errors.As(first, &pe) || pe.PackID.String() == held {
+		close(b.release)
+		t.Fatalf("wrong first error: %v; held %s", first, held)
+	}
+	close(b.release)
+	seen := restic.NewIDSet(pe.PackID)
+	for e := range errs {
+		if !errors.As(e, &pe) {
+			t.Fatalf("corruption classification changed: %T %v", e, e)
+		}
+		seen.Insert(pe.PackID)
+	}
+	if len(seen) != 3 {
+		t.Fatalf("missing corrupt-pack errors: %v", seen)
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	for id := range chosen {
+		if b.loads[id.String()] != 2 {
+			t.Fatalf("pack %s loads=%d, want verification retry", id, b.loads[id.String()])
+		}
+	}
+}
