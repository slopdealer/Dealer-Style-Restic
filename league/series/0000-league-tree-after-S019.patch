@@ -0,0 +1,42 @@
+package data
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+func TestTreePreparationAdmissionDoesNotInterpret(t *testing.T) {
+	for _, raw := range []string{
+		`{"name":"a","type":"file"}`,
+		`{"name":"[\\\"}]","type":"file","unknown":[{"x":"}"}]}`,
+		`{"name":1}`,
+		`{"name":"a","content":["` + strings.Repeat("0", 64) + `"]}`,
+	} {
+		r, err := LoadTreeNodeReader(context.Background(), readerTestLoader(`{"nodes":[`+raw+`]}`), restic.ID{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := r.PreparationSize(len(raw) - 1); ok {
+			t.Fatal("admitted over budget")
+		}
+		size, ok := r.PreparationSize(len(raw))
+		if !ok || size != len(raw) {
+			t.Fatalf("wrong frame size: %d %v for %s", size, ok, raw)
+		}
+		item, exists := r.Next()
+		ordinary, _ := LoadTree(context.Background(), readerTestLoader(`{"nodes":[`+raw+`]}`), restic.ID{})
+		for want := range ordinary {
+			if !exists || fmt.Sprintf("%#v:%T:%v", item.Node, item.Error, item.Error) != fmt.Sprintf("%#v:%T:%v", want.Node, want.Error, want.Error) {
+				t.Fatal("admission changed decode")
+			}
+		}
+		r.Close()
+		if _, ok := r.PreparationSize(2048); ok {
+			t.Fatal("closed reader admitted work")
+		}
+	}
+}
diff --git a/internal/data/tree_reference_test.go b/internal/data/tree_reference_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ab6e6a45a80ed203f1a24ff4499800a73c8c19fa
--- /dev/null
+++ b/internal/data/tree_reference_test.go
@@ -0,0 +1,180 @@
+package data
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+func referenceTree(t testing.TB, nodes []*Node) []byte {
+	t.Helper()
+	b := NewTreeJSONBuilder()
+	for _, n := range nodes {
+		if err := b.AddNode(n); err != nil {
+			t.Fatal(err)
+		}
+	}
+	buf, err := b.Finalize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return buf
+}
+
+func TestTreeReferenceFragments(t *testing.T) {
+	nodes := []*Node{
+		{Name: "a", Type: NodeTypeFile, ModTime: time.Date(2026, 1, 1, 1, 1, 1, 0, time.UTC)},
+		{Name: "b\n\\\"<&", Type: NodeTypeSymlink, LinkTarget: string([]byte{0xff, 0xfe}), GenericAttributes: map[GenericAttributeType]json.RawMessage{"other.value": json.RawMessage(` { "x": 1 } `)}},
+		{Name: "c", Type: NodeTypeFile, Content: restic.IDs{restic.Hash([]byte("content"))}},
+	}
+	canonical := referenceTree(t, nodes)
+	for _, tc := range []struct {
+		name    string
+		parent  []byte
+		current []*Node
+	}{
+		{"equal", canonical, nodes},
+		{"empty-parent", nil, nodes},
+		{"empty-current", canonical, nil},
+		{"changed-first", append([]byte(" "), canonical...), nodes},
+		{"trailing-parent", append(bytes.Clone(canonical), ' '), nodes},
+		{"truncated-parent", canonical[:len(canonical)-1], nodes},
+		{"omitted-last", canonical, nodes[:2]},
+		{"added-last", referenceTree(t, nodes[:2]), nodes},
+		{"changed-fallback", referenceTree(t, []*Node{nodes[0], {Name: nodes[1].Name, Type: NodeTypeFile}, nodes[2]}), nodes},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			original := bytes.Clone(tc.parent)
+			got := NewTreeJSONBuilderWithReference(tc.parent)
+			for _, n := range tc.current {
+				if err := got.AddNode(n); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if got.Count() != len(tc.current) {
+				t.Fatal("node count changed")
+			}
+			buf, err := got.Finalize()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(buf, referenceTree(t, tc.current)) {
+				t.Fatalf("different bytes: %q", buf)
+			}
+			if !bytes.Equal(tc.parent, original) {
+				t.Fatal("parent modified")
+			}
+			if tc.name == "equal" && &buf[0] != &tc.parent[0] {
+				t.Fatal("matching tree copied")
+			}
+		})
+	}
+}
+
+func TestTreeReferenceErrorOrder(t *testing.T) {
+	for _, nodes := range [][]*Node{
+		{{Name: "a"}, {Name: "a"}},
+		{{Name: "a"}, {Name: "b", GenericAttributes: map[GenericAttributeType]json.RawMessage{"invalid": json.RawMessage(`!`)}}},
+	} {
+		ordinary := NewTreeJSONBuilder()
+		matching := NewTreeJSONBuilderWithReference(referenceTree(t, []*Node{{Name: "a"}}))
+		for _, node := range nodes {
+			want, got := ordinary.AddNode(node), matching.AddNode(node)
+			if fmt.Sprint(got) != fmt.Sprint(want) {
+				t.Fatalf("error differs: %v / %v", got, want)
+			}
+			if got != nil {
+				break
+			}
+		}
+	}
+}
+
+var referenceBenchmarkID restic.ID
+
+// Synthetic discrimination of encoding/buffer/hash work, not workload timing.
+func BenchmarkTreeReference(b *testing.B) {
+	for _, count := range []int{16, 128, 1024} {
+		nodes := make([]*Node, count)
+		for i := range nodes {
+			nodes[i] = &Node{Name: fmt.Sprintf("file-%06d", i), Type: NodeTypeFile, User: strings.Repeat("u", 32), Content: restic.IDs{restic.Hash([]byte("blob"))}}
+		}
+		parent := referenceTree(b, nodes)
+		parentID := restic.Hash(parent)
+		for _, mode := range []string{"ordinary", "complete-compare", "fragment-compare"} {
+			b.Run(fmt.Sprintf("%d/%s", count, mode), func(b *testing.B) {
+				b.ReportAllocs()
+				b.SetBytes(int64(len(parent)))
+				for i := 0; i < b.N; i++ {
+					builder := NewTreeJSONBuilder()
+					if mode == "fragment-compare" {
+						builder = NewTreeJSONBuilderWithReference(parent)
+					}
+					for _, n := range nodes {
+						if err := builder.AddNode(n); err != nil {
+							b.Fatal(err)
+						}
+					}
+					buf, err := builder.Finalize()
+					if err != nil {
+						b.Fatal(err)
+					}
+					if mode != "ordinary" && bytes.Equal(buf, parent) {
+						referenceBenchmarkID = parentID
+					} else {
+						referenceBenchmarkID = restic.Hash(buf)
+					}
+				}
+			})
+		}
+	}
+}
+
+func BenchmarkTreeReferencePartial(b *testing.B) {
+	for _, count := range []int{128, 1024} {
+		nodes := make([]*Node, count)
+		for i := range nodes {
+			nodes[i] = &Node{Name: fmt.Sprintf("file-%06d", i), Type: NodeTypeFile, Content: restic.IDs{restic.Hash([]byte("blob"))}}
+		}
+		parent := referenceTree(b, nodes)
+		for _, position := range []int{0, count / 2, count - 1} {
+			current := append([]*Node(nil), nodes...)
+			changed := *current[position]
+			changed.Size = 1
+			current[position] = &changed
+			expected := referenceTree(b, current)
+			for _, mode := range []string{"complete-compare", "fragment-compare"} {
+				b.Run(fmt.Sprintf("%d/change-%d/%s", count, position, mode), func(b *testing.B) {
+					b.ReportAllocs()
+					for i := 0; i < b.N; i++ {
+						builder := NewTreeJSONBuilder()
+						if mode == "fragment-compare" {
+							builder = NewTreeJSONBuilderWithReference(parent)
+						}
+						for _, node := range current {
+							if err := builder.AddNode(node); err != nil {
+								b.Fatal(err)
+							}
+						}
+						buf, err := builder.Finalize()
+						if err != nil {
+							b.Fatal(err)
+						}
+						if !bytes.Equal(buf, expected) {
+							b.Fatal("changed bytes differ")
+						}
+						if bytes.Equal(buf, parent) {
+							b.Fatal("changed tree reused")
+						}
+						referenceBenchmarkID = restic.Hash(buf)
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/internal/data/tree_scalar_direct_test.go b/internal/data/tree_scalar_direct_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bdbbcf495b105c516a43a833050f18227ffe162b
--- /dev/null
+++ b/internal/data/tree_scalar_direct_test.go
@@ -0,0 +1,133 @@
+package data
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+// Freeze the immediately preceding Encoder path, including failure state.
+func directScalarReferenceAdd(b *TreeJSONBuilder, n *Node) error {
+	if n.Name <= b.lastName {
+		return fmt.Errorf("node %q, last %q: %w", n.Name, b.lastName, ErrTreeNotOrdered)
+	}
+	if b.lastName != "" {
+		_ = b.buf.WriteByte(',')
+	}
+	b.lastName = n.Name
+	if b.encoder == nil {
+		b.encoder = json.NewEncoder(&b.buf)
+	}
+	if err := b.encoder.Encode(n); err != nil {
+		return err
+	}
+	b.buf.Truncate(b.buf.Len() - 1)
+	b.countNodes++
+	return nil
+}
+
+func TestTreeScalarDirectDifferential(t *testing.T) {
+	id := restic.Hash([]byte("content"))
+	cases := []Node{
+		{Name: "a"}, {Name: "a", Content: restic.IDs{}},
+		{Name: "a", Content: restic.IDs{id}, Subtree: &id},
+		{Name: "a\xff<&>\"\\\n", LinkTarget: "\xff\xfe"},
+		{Name: "a", ExtendedAttributes: []ExtendedAttribute{{Name: "x", Value: []byte{0, 255}}}},
+		{Name: "a", GenericAttributes: map[GenericAttributeType]json.RawMessage{"a": []byte(` {"x":1,"x":2} `)}},
+		{Name: "a", GenericAttributes: map[GenericAttributeType]json.RawMessage{"bad": []byte(`{"x":`)}},
+		{Name: "a", Content: make(restic.IDs, 4096)},
+		{Name: "a", Content: make(restic.IDs, 4097)},
+	}
+	for _, year := range []int{-12000, -1, 0, 9999, 10000, 12000} {
+		for _, offset := range []int{-86460, -86400, -86399, -1, 0, 1, 86399, 86400, 86460} {
+			tm := time.Date(year, 2, 29, 1, 2, 3, 999999999, time.FixedZone("odd", offset))
+			cases = append(cases, Node{Name: "a", ModTime: tm, AccessTime: tm.Add(time.Second), ChangeTime: tm.Add(-time.Second)})
+		}
+	}
+	for i := range cases {
+		got, want := NewTreeJSONBuilder(), NewTreeJSONBuilder()
+		for _, n := range []*Node{&cases[i], &cases[i], {Name: "0"}, {Name: "b"}} {
+			before, _ := json.Marshal(n)
+			ge, we := got.AddNode(n), directScalarReferenceAdd(want, n)
+			if testTreeError(ge) != testTreeError(we) || !bytes.Equal(got.buf.Bytes(), want.buf.Bytes()) || got.lastName != want.lastName || got.Count() != want.Count() {
+				t.Fatalf("case %d state/errors differ: %v / %v", i, ge, we)
+			}
+			after, _ := json.Marshal(n)
+			if !bytes.Equal(before, after) {
+				t.Fatalf("case %d input changed", i)
+			}
+		}
+		gb, ge := got.Finalize()
+		wb, we := want.Finalize()
+		if testTreeError(ge) != testTreeError(we) || !bytes.Equal(gb, wb) {
+			t.Fatalf("case %d final bytes differ", i)
+		}
+	}
+	for _, raw := range [][]byte{{}, {1}} {
+		got, want := NewTreeJSONBuilder(), NewTreeJSONBuilder()
+		n := &Node{Name: "a", LinkTargetRaw: raw}
+		panicOf := func(f func() error) (p any) { defer func() { p = recover() }(); _ = f(); return }
+		gp := panicOf(func() error { return got.AddNode(n) })
+		wp := panicOf(func() error { return directScalarReferenceAdd(want, n) })
+		if !reflect.DeepEqual(gp, wp) || !bytes.Equal(got.buf.Bytes(), want.buf.Bytes()) || got.lastName != want.lastName || got.Count() != want.Count() {
+			t.Fatal("manual raw-link panic/state differ")
+		}
+	}
+}
+
+// Use workload-scale node counts without fixture-dependent code in production.
+func TestTreeScalarDirectManyNodes(t *testing.T) {
+	got, want := NewTreeJSONBuilder(), NewTreeJSONBuilder()
+	for i := range 91000 {
+		n := &Node{Name: fmt.Sprintf("file-%06d", i), Type: NodeTypeFile, Mode: 0644, Size: uint64(i)}
+		if i%97 == 0 {
+			n.User = "user<&>"
+		}
+		if ge, we := got.AddNode(n), directScalarReferenceAdd(want, n); ge != nil || we != nil {
+			t.Fatalf("node %d: %v / %v", i, ge, we)
+		}
+	}
+	gb, ge := got.Finalize()
+	wb, we := want.Finalize()
+	if ge != nil || we != nil || !bytes.Equal(gb, wb) || restic.Hash(gb) != restic.Hash(wb) || got.Count() != 91000 {
+		t.Fatal("large tree bytes/count/hash differ")
+	}
+}
+
+func TestTreeScalarAppendDestination(t *testing.T) {
+	for _, n := range []Node{
+		{Name: "a"}, {Name: "a", Content: restic.IDs{}},
+		{Name: "a", User: "<&>"},
+		{Name: "a", GenericAttributes: map[GenericAttributeType]json.RawMessage{"bad": []byte(`{"x":`)}},
+	} {
+		storage := bytes.Repeat([]byte{0xa5}, 4096)
+		prefix := []byte("prefix:")
+		copy(storage, prefix)
+		before := bytes.Clone(storage)
+		got, ok := appendScalarNodeJSON(storage[:len(prefix)], n)
+		want, wantOK := scalarNodeJSON(n)
+		if ok != wantOK {
+			t.Fatal("destination changed eligibility")
+		}
+		if !ok {
+			if !bytes.Equal(storage, before) {
+				t.Fatal("fallback modified destination")
+			}
+			continue
+		}
+		if !bytes.Equal(got[:len(prefix)], prefix) || !bytes.Equal(got[len(prefix):], want) {
+			t.Fatal("destination bytes differ")
+		}
+		if &got[0] != &storage[0] {
+			t.Fatal("spare capacity was not reused")
+		}
+		if !bytes.Equal(storage[len(got):], before[len(got):]) {
+			t.Fatal("unused destination tail modified")
+		}
+	}
+}
diff --git a/internal/data/tree_scalar_scale_test.go b/internal/data/tree_scalar_scale_test.go
new file mode 100644
