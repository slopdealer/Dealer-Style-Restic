+package archiver
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"hash"
+	"io"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+type ordinaryBlockedHash struct {
+	hash.Hash
+	entered chan struct{}
+	release chan struct{}
+	stable  chan bool
+	first   bool
+}
+
+func (h *ordinaryBlockedHash) Write(b []byte) (int, error) {
+	if !h.first {
+		h.first = true
+		before := bytes.Clone(b)
+		close(h.entered)
+		<-h.release
+		h.stable <- bytes.Equal(before, b)
+	}
+	return h.Hash.Write(b)
+}
+
+func TestOrdinaryHashPipelineBlockedBorrower(t *testing.T) {
+	lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+	lane.active <- struct{}{}
+	h := &ordinaryBlockedHash{Hash: sha256.New(), entered: make(chan struct{}), release: make(chan struct{}), stable: make(chan bool, 1)}
+	j := newOrdinaryHashStream(lane, h)
+	data := make([]byte, 100, 200)
+	for i := range data {
+		data[i] = byte(i)
+	}
+	j.write(data)
+	<-h.entered
+	// Next-tile assembly may advance beyond the borrowed prefix. Passing the
+	// next span, growing storage, and returning the chunk must first join it.
+	data = append(data, bytes.Repeat([]byte{71}, 50)...)
+	done := make(chan restic.ID, 1)
+	go func() { j.write(data); done <- j.finish() }()
+	select {
+	case <-done:
+		t.Fatal("settled with a live borrower")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(h.release)
+	select {
+	case id := <-done:
+		if id != restic.Hash(data) || !<-h.stable || len(lane.active) != 0 {
+			t.Fatal("borrowed storage or settlement differs")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("borrower did not join")
+	}
+	clear(data[:cap(data)])
+}
+
+func TestOrdinaryHashPipelineStockBoundaries(t *testing.T) {
+	const pol = chunker.Pol(0x3da3358b4dc173)
+	random := make([]byte, 25*1024*1024+37)
+	x := uint64(37)
+	for i := range random {
+		x ^= x << 13
+		x ^= x >> 7
+		x ^= x << 17
+		random[i] = byte(x)
+	}
+	for _, payload := range [][]byte{nil, random[:17], random[:chunkReadBufSize], random[:3*1024*1024+31], random, make([]byte, len(random))} {
+		for _, reserve := range []int{1024, 2 * 1024 * 1024, chunker.MaxSize} {
+			lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+			s := &fileChunkState{readBuf: make([]byte, chunkReadBufSize), ordinaryHashes: lane}
+			c := b18TrialFactory{pol}.NewChunker()
+			r := &b23ExactTerminalReader{data: payload, err: io.EOF}
+			buf := make([]byte, 0, reserve)
+			var ends []int
+			at := 0
+			for {
+				b, err := s.readNextChunk(r, c, buf)
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !bytes.Equal(b, payload[at:at+len(b)]) {
+					t.Fatal("assembly differs")
+				}
+				if s.hashed && s.chunkID != restic.Hash(b) {
+					t.Fatal("incremental identity differs")
+				}
+				if len(lane.active) != 0 {
+					t.Fatal("lane retained through submission")
+				}
+				at += len(b)
+				ends = append(ends, at)
+				buf = b[:0]
+			}
+			want := b18Cuts(payload, pol, 65537)
+			// The dependency helper reports a zero-sized terminal cut for an
+			// empty input. The ordinary file reader emits no blob for that case.
+			if len(payload) == 0 {
+				want = nil
+			}
+			if !slices.Equal(ends, want) {
+				t.Fatalf("stock endpoints differ input=%d reserve=%d got=%v want=%v", len(payload), reserve, ends, want)
+			}
+		}
+	}
+}
+
+func TestOrdinaryHashPipelineAdmissionAndReuse(t *testing.T) {
+	const size = 3*1024*1024 + 17
+	input := bytes.Repeat([]byte{71}, size*2+31)
+	lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+	for _, busy := range []bool{true, false} {
+		if busy {
+			lane.active <- struct{}{}
+		}
+		s := &fileChunkState{readBuf: make([]byte, chunkReadBufSize), ordinaryHashes: lane}
+		c := bufferTestFactory{size}.NewChunker()
+		r := bufferTestShortReader{bytes.NewReader(input)}
+		buf := make([]byte, 0, 1024)
+		at, hashed := 0, 0
+		for {
+			b, err := s.readNextChunk(r, c, buf)
+			if err == io.EOF {
+				break
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if s.hashed {
+				hashed++
+				if s.chunkID != restic.Hash(b) {
+					t.Fatal("wrong hash after growth or reuse")
+				}
+			}
+			at += len(b)
+			buf = b[:0]
+		}
+		if at != len(input) || (busy && hashed != 0) || (!busy && hashed != 2) {
+			t.Fatalf("busy=%v at=%d hashed=%d", busy, at, hashed)
+		}
+		if busy {
+			<-lane.active
+		}
+		if len(lane.active) != 0 {
+			t.Fatal("admission leaked")
+		}
+	}
+}
+
+func TestOrdinaryHashPipelineTerminalErrorJoins(t *testing.T) {
+	fault := errors.New("terminal read failure")
+	for _, n := range []int{17, 3*1024*1024 + 17, 6 * 1024 * 1024} {
+		lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+		s := &fileChunkState{readBuf: make([]byte, chunkReadBufSize), ordinaryHashes: lane}
+		r := &b23ExactTerminalReader{data: bytes.Repeat([]byte{31}, n), err: fault}
+		b, err := s.readNextChunk(r, bufferTestFactory{8 * 1024 * 1024}.NewChunker(), make([]byte, 0, 1024))
+		if b != nil || !errors.Is(err, fault) || s.hashed || len(lane.active) != 0 {
+			t.Fatalf("error settlement %d: len=%d err=%v hashed=%v", n, len(b), err, s.hashed)
+		}
+	}
+}
+
+func TestOrdinaryHashPipelineStalledSaveCancellation(t *testing.T) {
+	const size = 3*1024*1024 + 17
+	input := bytes.Repeat([]byte{71}, size+31)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	u := &bufferTestKnownUploader{}
+	started, release := make(chan struct{}), make(chan struct{})
+	u.onSave = func() { close(started); <-release }
+	saver := newFileSaver(ctx, nil, u, bufferTestFactory{size}, 0)
+	saver.NodeFromFileInfo = func(string, string, toNoder, bool) (*data.Node, error) {
+		return &data.Node{Type: data.NodeTypeFile, Size: uint64(len(input))}, nil
+	}
+	lane := &parentPairHashLane{active: make(chan struct{}, 1)}
+	s := &fileChunkState{ctx: ctx, readBuf: make([]byte, chunkReadBufSize), ordinaryHashes: lane}
+	returned := make(chan struct{})
+	var result futureNodeResult
+	completed := 0
+	go func() {
+		saver.saveFile(ctx, bufferTestFactory{size}.NewChunker(), s, "/file", "file", &bufferTestFile{r: bytes.NewReader(input)}, func() {}, func() { t.Error("cancelled file reported reading complete") }, func(r futureNodeResult) { result = r; completed++ })
+		close(returned)
+	}()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("save never started")
+	}
+	// The save is blocked and its detached payload is still resident, but it
+	// must retain neither the stream admission nor borrowed assembly.
+	j := lane.tryOrdinary()
+	if j == nil {
+		close(release)
+		t.Fatal("blocked save retained hash admission")
+	}
+	j.write([]byte("another file"))
+	if j.finish() != restic.Hash([]byte("another file")) {
+		t.Fatal("contending file hash differs")
+	}
+	cancel()
+	close(release)
+	select {
+	case <-returned:
+	case <-time.After(5 * time.Second):
+		t.Fatal("cancelled save did not return")
+	}
+	if completed != 1 || !errors.Is(result.err, context.Canceled) || len(u.pending) != 1 || !bytes.Equal(u.pending[0].buf, input[:size]) {
+		t.Fatal("cancelled save settlement or detached payload differs")
+	}
+	if len(lane.active) != 0 {
+		t.Fatal("cancelled save leaked admission")
+	}
+}
diff --git a/internal/archiver/parent_boundary_oracle_test.go b/internal/archiver/parent_boundary_oracle_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2ff335278f2d78d6805ccb1280e4dc71e690f399
--- /dev/null
+++ b/internal/archiver/parent_boundary_oracle_test.go
@@ -0,0 +1,80 @@
+package archiver
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/restic"
+)
+
+// This oracle deliberately calls the pinned dependency, independently of the
+// repository wrapper and file reader. Endpoints include the EOF tail.
+func b18Cuts(payload []byte, pol chunker.Pol, division int) []int {
+	c := chunker.NewBase(pol)
+	var ends []int
+	for offset := 0; offset < len(payload); {
+		end := min(offset+division, len(payload))
+		n := c.NextSplitPoint(payload[offset:end])
+		if n < 0 {
+			offset = end
+		} else {
+			offset += n
+			ends = append(ends, offset)
+		}
+	}
+	if len(ends) == 0 || ends[len(ends)-1] != len(payload) {
+		ends = append(ends, len(payload))
+	}
+	return ends
+}
+
+func TestB18ParentBoundaryProvenance(t *testing.T) {
+	const a = chunker.Pol(0x3DA3358B4DC173)
+	// The reciprocal of an irreducible polynomial is also irreducible.
+	var b chunker.Pol
+	for p := a; p != 0; p >>= 1 {
+		b = (b << 1) | (p & 1)
+	}
+	payload := b06Payload(16*1024*1024+173, 881)
+	parent := b18Cuts(payload, a, 13001)
+	current := b18Cuts(payload, b, 13001)
+	if slices.Equal(parent, current) {
+		t.Fatal("counterexample failed to distinguish polynomials")
+	}
+	start := 0
+	for _, end := range parent {
+		id := restic.Hash(payload[start:end])
+		if id != restic.Hash(slices.Clone(payload[start:end])) {
+			t.Fatal("unchanged parent span did not verify")
+		}
+		start = end
+	}
+	t.Logf("all parent hashes match; polynomial A endpoints %v, polynomial B endpoints %v", parent, current)
+}
+
+func TestB18RestartAtCurrentCuts(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	payload := b06Payload(8*1024*1024+173, 887)
+	want := b18Cuts(payload, pol, 13001)
+	for _, division := range []int{1, 13001, 524288, 600013} {
+		if got := b18Cuts(payload, pol, division); !slices.Equal(got, want) {
+			t.Fatalf("read division %d changed cuts: %v vs %v", division, got, want)
+		}
+		start := 0
+		// The final endpoint may be EOF, and is intentionally not certified.
+		for _, end := range want[:len(want)-1] {
+			got := b18Cuts(payload[start:end], pol, division)
+			if len(got) != 1 || got[0] != end-start {
+				t.Fatalf("restart at %d did not yield next current cut %d", start, end)
+			}
+			// b18Cuts appends EOF, so also require a real cut at the end.
+			c := chunker.NewBase(pol)
+			if split := c.NextSplitPoint(payload[start:end]); split != end-start {
+				t.Fatalf("endpoint %d was not a real cut: %d", end, split)
+			}
+			start = end
+		}
+	}
+	t.Logf("current-cut restart invariant holds across four read divisions; endpoints %v", want)
+}
diff --git a/internal/archiver/parent_cut_long.go b/internal/archiver/parent_cut_long.go
new file mode 100644
index 0000000000000000000000000000000000000000..cf1be4b5c757a932a8cff66568f849d65399fd47
--- /dev/null
+++ b/internal/archiver/parent_cut_long.go
@@ -0,0 +1,80 @@
+package archiver
+
+import (
+	"context"
+	"io"
+	"sync"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/restic"
+)
+
+// readLongPair supplements the original bounded route only for oversized pairs
+// that fit assembly storage already grown by ordinary chunking. It never grows
+// storage to obtain admission. The original route and its minimum-size policy
+// remain intact. Parent lengths predict endpoints, not identities or content.
+func (g *parentCutReader) readLongPair(ctx context.Context, state *fileChunkState, rd io.Reader, ordinary restic.Chunker, assembly []byte) ([]byte, error, bool) {
+	if g.disabled || g.hintOffset != g.offset || g.hint+2 >= len(g.parent.Content) {
+		return nil, nil, false
+	}
+	a, ok := g.span(g.hint)
+	if !ok {
+		return nil, nil, false
+	}
+	b, ok := g.span(g.hint + 1)
+	if !ok || a <= chunker.MinSize || b <= chunker.MinSize || a+b <= 2*1024*1024 || a+b > uint64(cap(assembly)) {
+		return nil, nil, false
+	}
+	// Both spans have already passed the MaxChunkSize bound. Capacity is an
+	// allocation-base capacity, restored by readNext before either route runs.
+	input := assembly[:int(a+b)]
+	g.root = input[:cap(input)]
+	n, err := io.ReadFull(parentCutDrain{state, rd}, input)
+	if err != nil && err != io.EOF && err != io.ErrUnexpectedEOF {
+		return nil, err, true
+	}
+	g.capacity = max(g.capacity, uint64(cap(input)))
+	g.pending = input[:n]
+	g.nextCut = 0
+	g.pendingHashed = false
+	if n < len(input) {
+		ordinary.Reset()
+		out, err := g.pop(state, rd, ordinary)
+		return out, err, true
+	}
+	if g.extra == nil {
+		g.extra = g.factory.NewChunker()
+	}
+	ordinary.Reset()
+	g.extra.Reset()
+	hashJob := g.hashes.try(input[:int(a)], input[int(a):])
+	var second int
+	var wg sync.WaitGroup
+	wg.Add(1)
+	g.scheduled++
+	go func() { defer wg.Done(); second = g.extra.NextSplitPoint(input[int(a):]) }()
+	first := ordinary.NextSplitPoint(input[:int(a)])
+	wg.Wait()
+	ids, hashed := hashJob.finish()
+	if err := ctx.Err(); err != nil {
+		return nil, err, true
+	}
+	if first == int(a) {
+		state.chunkID, state.hashed = ids[0], hashed[0]
+		g.accepted += a
+		if second == int(b) {
+			g.nextCut = int(b)
+			g.pendingID, g.pendingHashed = ids[1], hashed[1]
+			g.accepted += b
+		} else {
+			g.replayed += b
+		}
+		g.pending = input[int(a):]
+		ordinary.Reset()
+		return input[:int(a)], nil, true
+	}
+	g.replayed += a + b
+	ordinary.Reset()
+	out, err := g.pop(state, rd, ordinary)
+	return out, err, true
+}
diff --git a/internal/archiver/parent_cut_long_join_test.go b/internal/archiver/parent_cut_long_join_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3ea4d46e8bc2ad78b44bc36619ad4a06e805a194
--- /dev/null
+++ b/internal/archiver/parent_cut_long_join_test.go
@@ -0,0 +1,114 @@
+package archiver
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/restic"
+)
+
+type b18LongBlockedFactory struct {
+	restic.ChunkerFactory
+	started chan struct{}
+	release chan struct{}
+	checked chan bool
+}
+
+func (f b18LongBlockedFactory) NewChunker() restic.Chunker {
+	return b18LongBlockedChunker{Chunker: f.ChunkerFactory.NewChunker(), started: f.started, release: f.release, checked: f.checked}
+}
+
+type b18LongBlockedChunker struct {
+	restic.Chunker
+	started chan struct{}
+	release chan struct{}
+	checked chan bool
+}
+
+func (c b18LongBlockedChunker) NextSplitPoint(p []byte) int {
+	before := restic.Hash(p)
+	close(c.started)
+	<-c.release
+	c.checked <- (before == restic.Hash(p))
+	return c.Chunker.NextSplitPoint(p)
+}
+
+// Deliberately keep the extra validator reading the borrowed suffix after the
+// ordinary validator finishes. Cancellation and failed-first replay must join,
+// just as the successful path does, before the caller can recycle its storage.
+func TestB18LongPairBlockedValidatorJoin(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input, parent, original := b18LongFixture(t)
+	for _, cancelRead := range []bool{false, true} {
+		t.Run(map[bool]string{false: "failed-first", true: "cancelled"}[cancelRead], func(t *testing.T) {
+			sizes := make(map[restic.ID]uint)
+			for id, n := range original {
+				sizes[id] = n
+			}
+			if !cancelRead {
+				sizes[parent.Content[0]] += 10
+				sizes[parent.Content[1]] -= 10
+			}
+			factory := b18LongBlockedFactory{b18TrialFactory{pol}, make(chan struct{}), make(chan struct{}), make(chan bool, 1)}
+			g := &parentCutReader{parent: parent, factory: factory, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			state := fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: ctx, guided: g}
+			storage := make([]byte, 0, chunker.MaxSize)
+			type result struct {
+				out []byte
+				err error
+			}
+			done := make(chan result, 1)
+			go func() {
+				out, err := state.readNextChunk(bytes.NewReader(input), b18TrialFactory{pol}.NewChunker(), storage)
+				done <- result{out, err}
+			}()
+			select {
+			case <-factory.started:
+			case <-time.After(5 * time.Second):
+				t.Fatal("extra validator did not start")
+			}
+			if cancelRead {
+				cancel()
+			}
+			// This timeout only detects premature settlement; it is not a timing test.
+			select {
+			case <-done:
+				close(factory.release)
+				t.Fatal("reader returned with a live validator")
+			case <-time.After(10 * time.Millisecond):
+			}
+			close(factory.release)
+			var got result
+			select {
+			case got = <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("reader did not join")
+			}
+			if !<-factory.checked {
+				t.Fatal("borrowed suffix changed while validator held it")
+			}
+			if cancelRead {
+				if got.out != nil || !errors.Is(got.err, context.Canceled) {
+					t.Fatal("cancelled read published output", got.err)
+				}
+			} else {
+				want := int(original[parent.Content[0]])
+				if got.err != nil || len(got.out) != want || !bytes.Equal(got.out, input[:want]) || g.replayed == 0 {
+					t.Fatal("failed first certificate replay mismatch", got.err)
+				}
+			}
+			buf := &buffer{Data: storage}
+			g.reclaim(buf)
+			if &buf.Data[0] != &storage[:cap(storage)][0] || cap(buf.Data) != cap(storage) {
+				t.Fatal("joined read lost base")
+			}
+			clear(storage[:cap(storage)])
+		})
+	}
+}
diff --git a/internal/archiver/parent_cut_long_test.go b/internal/archiver/parent_cut_long_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f6e181016436c6915693ef94038dd4efbcdaf6e
--- /dev/null
+++ b/internal/archiver/parent_cut_long_test.go
@@ -0,0 +1,215 @@
+package archiver
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"slices"
+	"testing"
+
+	"github.com/restic/chunker"
+	"github.com/restic/restic/internal/data"
+	"github.com/restic/restic/internal/restic"
+)
+
+// Start at a certified current cut whose following pair exceeds the inherited
+// admission bound. The third endpoint proves the pair is not a parent EOF tail.
+func b18LongFixture(t *testing.T) ([]byte, *data.Node, map[restic.ID]uint) {
+	t.Helper()
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input := b06Payload(32*1024*1024+173, 881)
+	ends := b18Cuts(input, pol, 13001)
+	start := 0
+	for i := 0; i+2 < len(ends); i++ {
+		a, b := ends[i]-start, ends[i+1]-ends[i]
+		if a > chunker.MinSize && b > chunker.MinSize && a+b > 2*1024*1024 && a+b < chunker.MaxSize {
+			input = input[start:]
+			parent, sizes := b18Guidance(input, pol)
+			return input, parent, sizes
+		}
+		start = ends[i]
+	}
+	t.Fatal("no long pair in reference input")
+	return nil, nil, nil
+}
+func b18ReadLong(ctx context.Context, rd io.Reader, factory restic.ChunkerFactory, parent *data.Node, sizes map[restic.ID]uint) ([]int, []restic.ID, *parentCutReader, error) {
+	g := &parentCutReader{parent: parent, factory: factory, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+	state := fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: ctx, guided: g}
+	c := factory.NewChunker()
+	scratch := make([]byte, 0, chunker.MaxSize)
+	var ends []int
+	var ids []restic.ID
+	offset := 0
+	for {
+		out, err := state.readNextChunk(rd, c, scratch)
+		if err != nil {
+			if err == io.EOF {
+				err = nil
+			}
+			return ends, ids, g, err
+		}
+		offset += len(out)
+		ends = append(ends, offset)
+		ids = append(ids, restic.Hash(out))
+		scratch = out
+	}
+}
+func TestB18LongPairIdentity(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	original, parent, sizes := b18LongFixture(t)
+	mutated := bytes.Clone(original)
+	for i := 700000; i < 710000; i++ {
+		mutated[i] ^= 77
+	}
+	inserted := append(bytes.Clone(original[:700000]), []byte("insertion at a parent interior")...)
+	inserted = append(inserted, original[700000:]...)
+	deleted := append(bytes.Clone(original[:700000]), original[710000:]...)
+	grown := append(bytes.Clone(original), original[:900000]...)
+	var other chunker.Pol
+	for p := pol; p != 0; p >>= 1 {
+		other = (other << 1) | (p & 1)
+	}
+	for _, tc := range []struct {
+		name  string
+		input []byte
+		pol   chunker.Pol
+	}{
+		{"unchanged", original, pol}, {"mutated", mutated, pol}, {"inserted", inserted, pol}, {"deleted", deleted, pol},
+		{"grown", grown, pol}, {"truncated-first", original[:900001], pol}, {"truncated-second", original[:sizes[parent.Content[0]]+100], pol},
+		{"other-polynomial", original, other},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			want := b18Cuts(tc.input, tc.pol, 13001)
+			for _, division := range []int{37, 524288, 4000000} {
+				got, ids, g, err := b18ReadLong(t.Context(), &b18TrialShortReader{r: bytes.NewReader(tc.input), limit: division}, b18TrialFactory{tc.pol}, parent, sizes)
+				if err != nil || !slices.Equal(got, want) || !slices.Equal(ids, b18ContentIDs(tc.input, want)) {
+					t.Fatalf("division=%d err=%v endpoints=%v vs %v", division, err, got, want)
+				}
+				if tc.name == "unchanged" && (g.scheduled == 0 || g.accepted == 0) {
+					t.Fatal("long route not exercised")
+				}
+				t.Logf("division=%d accepted=%d replay=%d scheduled=%d capacity=%d", division, g.accepted, g.replayed, g.scheduled, g.capacity)
+			}
+		})
+	}
+}
+func TestB18LongPairRefusal(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input, parent, sizes := b18LongFixture(t)
+	for _, capacity := range []int{2 * 1024 * 1024, int(sizes[parent.Content[0]]+sizes[parent.Content[1]]) - 1} {
+		g := &parentCutReader{parent: parent, factory: b18TrialFactory{pol}, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+		state := fileChunkState{readBuf: make([]byte, chunkReadBufSize)}
+		rd := bytes.NewReader(input)
+		out, err, used := g.readLongPair(t.Context(), &state, rd, b18TrialFactory{pol}.NewChunker(), make([]byte, 0, capacity))
+		if used || err != nil || out != nil || rd.Len() != len(input) || g.extra != nil || g.root != nil {
+			t.Fatal("refused pair consumed or allocated state")
+		}
+	}
+	for _, bad := range []uint{0, chunker.MaxSize + 1, ^uint(0)} {
+		broken := make(map[restic.ID]uint)
+		for id, n := range sizes {
+			broken[id] = n
+		}
+		broken[parent.Content[0]] = bad
+		got, ids, g, err := b18ReadLong(t.Context(), bytes.NewReader(input), b18TrialFactory{pol}, parent, broken)
+		want := b18Cuts(input, pol, 13001)
+		if err != nil || !slices.Equal(got, want) || !slices.Equal(ids, b18ContentIDs(input, want)) || g.scheduled != 0 {
+			t.Fatal("invalid guidance accepted", err)
+		}
+	}
+}
+func TestB18LongPairFallback(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input, parent, sizes := b18LongFixture(t)
+	for _, d := range []int{-1, 10} {
+		broken := make(map[restic.ID]uint)
+		for id, n := range sizes {
+			broken[id] = n
+		}
+		broken[parent.Content[0]] = uint(int(broken[parent.Content[0]]) + d)
+		broken[parent.Content[1]] = uint(int(broken[parent.Content[1]]) - d)
+		got, ids, g, err := b18ReadLong(t.Context(), bytes.NewReader(input), b18TrialFactory{pol}, parent, broken)
+		want := b18Cuts(input, pol, 13001)
+		if err != nil || !slices.Equal(got, want) || !slices.Equal(ids, b18ContentIDs(input, want)) || g.replayed == 0 {
+			t.Fatalf("long fallback mismatch d=%d err=%v scheduled=%d replay=%d got=%v want=%v", d, err, g.scheduled, g.replayed, got, want)
+		}
+	}
+}
+func TestB18LongPairFailureAndJoin(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input, parent, sizes := b18LongFixture(t)
+	sentinel := errors.New("long input failure")
+	for _, at := range []int{0, 700000, int(sizes[parent.Content[0]]) + 100} {
+		_, _, g, err := b18ReadLong(t.Context(), &b18FailReader{r: bytes.NewReader(input), left: at, err: sentinel}, b18TrialFactory{pol}, parent, sizes)
+		if !errors.Is(err, sentinel) || g.root == nil || cap(g.root) != chunker.MaxSize {
+			t.Fatal("failed long read lost allocation base", err)
+		}
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	joined := make(chan struct{})
+	factory := b18CancelFactory{b18TrialFactory{pol}, cancel, joined}
+	g := &parentCutReader{parent: parent, factory: factory, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+	state := fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: ctx, guided: g}
+	storage := make([]byte, 0, chunker.MaxSize)
+	out, err := state.readNextChunk(bytes.NewReader(input), b18TrialFactory{pol}.NewChunker(), storage)
+	if out != nil || !errors.Is(err, context.Canceled) || g.scheduled != 1 {
+		t.Fatal("long validator published after cancellation", err)
+	}
+	select {
+	case <-joined:
+	default:
+		t.Fatal("validator not joined")
+	}
+	buf := &buffer{Data: storage}
+	g.reclaim(buf)
+	if &buf.Data[:cap(buf.Data)][0] != &storage[:cap(storage)][0] || g.root != nil || g.pending != nil {
+		t.Fatal("cancellation failed to reclaim assembly")
+	}
+	clear(storage[:cap(storage)])
+}
+
+// A rejected long certificate may replay beyond the capacity it borrowed.
+// Retain the replacement allocation even when input fails before publication.
+// A nonnil prefix accompanying an error is ownership, not a publishable chunk.
+func TestB18LongReplayGrowthError(t *testing.T) {
+	const pol = chunker.Pol(0x3DA3358B4DC173)
+	input := b06Payload(32*1024*1024+173, 881)
+	ends := b18Cuts(input, pol, 13001)
+	start := 0
+	found := false
+	for _, end := range ends {
+		if end-start > 4*1024*1024 {
+			input = input[start:]
+			found = true
+			break
+		}
+		start = end
+	}
+	if !found {
+		t.Fatal("no naturally long current chunk")
+	}
+	parent := &data.Node{}
+	sizes := make(map[restic.ID]uint)
+	for i, n := range []uint{900000, 1900000, 1000000} {
+		id := restic.Hash([]byte{byte(i)})
+		parent.Content = append(parent.Content, id)
+		sizes[id] = n
+	}
+	g := &parentCutReader{parent: parent, factory: b18TrialFactory{pol}, lookup: func(h restic.BlobHandle) (uint, bool) { n, ok := sizes[h.ID]; return n, ok }}
+	state := fileChunkState{readBuf: make([]byte, chunkReadBufSize), ctx: t.Context(), guided: g}
+	initial := make([]byte, 0, 3*1024*1024)
+	sentinel := errors.New("after long replay growth")
+	rd := &b18FailReader{r: bytes.NewReader(input), left: 4 * 1024 * 1024, err: sentinel}
+	out, err := state.readNextChunk(rd, b18TrialFactory{pol}.NewChunker(), initial)
+	if len(out) == 0 || !errors.Is(err, sentinel) || g.scheduled != 1 || g.replayed == 0 || cap(g.root) <= cap(initial) {
+		t.Fatalf("err=%v scheduled=%d replay=%d cap=%d", err, g.scheduled, g.replayed, cap(g.root))
+	}
+	replacement := g.root
+	buf := &buffer{Data: initial}
+	g.reclaim(buf)
+	if cap(buf.Data) != cap(replacement) || &buf.Data[0] != &replacement[0] || g.pending != nil || g.root != nil {
+		t.Fatal("grown replay base not reclaimed")
+	}
+}
