diff --git a/internal/repository/index/index_load_concurrency_test.go b/internal/repository/index/index_load_concurrency_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..288bddd4fa7043e8fd01a4a538bed13c53d5c5f6
--- /dev/null
+++ b/internal/repository/index/index_load_concurrency_test.go
@@ -0,0 +1,97 @@
+package index
+
+import (
+	"context"
+	"errors"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+type admissionTestLoader struct {
+	restic.LoaderUnpacked
+	entered chan struct{}
+	release chan struct{}
+	active atomic.Int64
+	peak atomic.Int64
+}
+
+func (*admissionTestLoader) Connections() uint { return 32 }
+
+func (r *admissionTestLoader) LoadUnpacked(ctx context.Context, _ restic.FileType, _ restic.ID) ([]byte, error) {
+	n := r.active.Add(1)
+	defer r.active.Add(-1)
+	for old := r.peak.Load(); old < n; old = r.peak.Load() {
+		if r.peak.CompareAndSwap(old, n) {
+			break
+		}
+	}
+	r.entered <- struct{}{}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-r.release:
+		return []byte(`{"packs":[]}`), nil
+	}
+}
+
+type admissionTestLister int
+
+func (l admissionTestLister) List(_ context.Context, _ restic.FileType, fn func(restic.ID, int64) error) error {
+	for i := 0; i < int(l); i++ {
+		var id restic.ID
+		id[0] = byte(i)
+		if err := fn(id, 1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func TestIndexLoadAdmissionAndCancellation(t *testing.T) {
+	width := max(2, runtime.GOMAXPROCS(0))
+	for _, canceled := range []bool{false, true} {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		r := &admissionTestLoader{entered: make(chan struct{}, 4*width), release: make(chan struct{})}
+		var callbacks atomic.Int64
+		done := make(chan error, 1)
+		go func() {
+			done <- ForAllIndexes(ctx, admissionTestLister(3*width), r, func(_ restic.ID, idx *Index, err error) error {
+				if err != nil {
+					return err
+				}
+				if idx == nil || !idx.Final() {
+					return errors.New("missing decoded index")
+				}
+				callbacks.Add(1)
+				return nil
+			})
+		}()
+		for range width {
+			select {
+			case <-r.entered:
+			case <-ctx.Done():
+				t.Fatal("loaders did not fill admission")
+			}
+		}
+		if canceled {
+			cancel()
+		} else {
+			close(r.release)
+		}
+		err := <-done
+		cancel()
+		if canceled && !errors.Is(err, context.Canceled) || !canceled && err != nil {
+			t.Fatalf("canceled=%v err=%v", canceled, err)
+		}
+		if r.peak.Load() > int64(width) || r.active.Load() != 0 {
+			t.Fatalf("peak=%d active=%d width=%d", r.peak.Load(), r.active.Load(), width)
+		}
+		if !canceled && callbacks.Load() != int64(3*width) {
+			t.Fatalf("callbacks=%d", callbacks.Load())
+		}
+	}
+}
diff --git a/internal/repository/index/index_merge.go b/internal/repository/index/index_merge.go
new file mode 100644
index 0000000000000000000000000000000000000000..be25fea0ee23c479d4de19336c2664f3b3cbdbe5
--- /dev/null
+++ b/internal/repository/index/index_merge.go
@@ -0,0 +1,42 @@
+package index
+
+import "github.com/restic/restic/internal/restic"
+
+// addIfMissing combines exact-location lookup and insertion during merge.
+// The caller holds the containing Index lock and supplies its combined pack
+// table. Blob type is implicit in the map; equal IDs in different packs or
+// with different range/encoding fields remain distinct entries.
+func (m *indexMap) addIfMissing(src *indexEntry, packIndex uint32, packs restic.IDs) {
+	if len(m.buckets) == 0 {
+		m.preallocate(1)
+	}
+
+	h := m.hash(src.id)
+	ei := m.buckets[h]
+	for bloomHasID(ei, src.id) {
+		e := m.resolve(ei)
+		if e.id == src.id && e.offset == src.offset && e.length == src.length &&
+			e.uncompressedLength == src.uncompressedLength && packs[e.packIndex] == packs[packIndex] {
+			return
+		}
+		ei = e.next
+	}
+
+	// Master loading normally reserves this capacity. Direct merge callers
+	// need growth support too: a bucket computed before growth is stale.
+	bucketCount := len(m.buckets)
+	m.preallocate(int(m.numentries) + 1)
+	if len(m.buckets) != bucketCount {
+		h = m.hash(src.id)
+	}
+
+	e, entryIndex := m.newEntry()
+	e.id = src.id
+	e.next = m.buckets[h]
+	e.packIndex = packIndex
+	e.offset = src.offset
+	e.length = src.length
+	e.uncompressedLength = src.uncompressedLength
+	m.buckets[h] = bloomInsertID(entryIndex, e.next, src.id)
+	m.numentries++
+}
