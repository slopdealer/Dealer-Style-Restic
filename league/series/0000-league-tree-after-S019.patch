+// Hold both ordinary allocation permits before the bounded worker encounters
+// corruption or decoder promotion. Only the ordinary workers can release
+// those permits. Corruption requires actual indexed alternate-pack recovery.
+func TestB23RepositoryRecoveryAtSaturatedAllocation(t *testing.T) {
+	for _, tc := range []struct {
+		name                        string
+		connections                 uint
+		overflow, disk, understated bool
+	}{
+		{"explicit-one", 1, false, false, false},
+		{"explicit-two", 2, false, false, false},
+		{"default-overflow-mock", 2, true, false, false},
+		{"default-overflow-local", 2, true, true, false},
+		{"understated-one", 1, false, false, true},
+		{"understated-two", 2, false, false, true},
+		{"understated-overflow", 2, true, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			connections := tc.connections
+			key := testKey(t)
+			blobs, data := buildPackfileWithoutHeader([]int{600000, 600000, 600000, 600000, 600000, 600000}, &key, true)
+			corrupt := bytes.Clone(data)
+			for i, b := range blobs {
+				if tc.understated {
+					// Complete authenticated bytes, deliberately understated output
+					// capacity: promotion must yield before saturated admission.
+					blobs[i].UncompressedLength = 1
+				} else {
+					corrupt[b.Offset+16] ^= 1
+				}
+			}
+			originalID, alternateID := restic.Hash(corrupt), restic.Hash(data)
+			m := mock.NewBackend()
+			m.PropertiesFn = func() backend.Properties { return backend.Properties{Connections: connections} }
+			m.OpenReaderFn = func(_ context.Context, h backend.Handle, n int, off int64) (io.ReadCloser, error) {
+				p := corrupt
+				if h.Name == alternateID.String() {
+					p = data
+				}
+				return io.NopCloser(bytes.NewReader(bytes.Clone(p[int(off) : int(off)+n]))), nil
+			}
+			mi := index.NewMasterIndex()
+			idx := index.NewIndex()
+			idx.StorePack(alternateID, blobs)
+			mi.Insert(idx)
+			var limited backend.Backend = m
+			if tc.overflow {
+				limited = b23OverflowBackend{m}
+			}
+			if tc.disk {
+				cfg := local.NewConfig()
+				cfg.Path = t.TempDir()
+				cfg.SetAllowAdditionalLoadSlot(true)
+				lb, err := local.Create(context.Background(), cfg, nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				for _, value := range []struct {
+					id    restic.ID
+					bytes []byte
+				}{{originalID, corrupt}, {alternateID, data}} {
+					if err := lb.Save(context.Background(), backend.Handle{Type: backend.PackFile, Name: value.id.String()}, backend.NewByteReader(value.bytes, lb.Hasher())); err != nil {
+						t.Fatal(err)
+					}
+				}
+				limited = lb
+			}
+			r := &Repository{key: &key, be: sema.NewBackend(limited), idx: mi}
+			defer func() {
+				if r.dec != nil {
+					r.dec.Close()
+				}
+				if r.smallRestoreDecoder != nil {
+					r.smallRestoreDecoder.Close()
+				}
+			}()
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			// Ordinary workers use unmarked contexts exactly as the restorer does.
+			// The repository alone marks the bounded worker for optional overflow.
+			permits := make(chan struct{}, 2)
+			permits <- struct{}{}
+			permits <- struct{}{}
+			promotion := make(chan struct{})
+			admissions, releases := 0, 0
+			boundedCtx := restic.WithSmallRestoreLoad(ctx, func(ctx context.Context) (func(), error) {
+				admissions++
+				close(promotion)
+				select {
+				case permits <- struct{}{}:
+					return func() { <-permits; releases++ }, nil
+				case <-ctx.Done():
+					return nil, ctx.Err()
+				}
+			})
+			results := make(chan error, 3)
+			run := func(workCtx context.Context, ordinary bool) {
+				if ordinary {
+					defer func() { <-permits }()
+				}
+				callbacks := 0
+				err := r.loadBlobsFromPack(workCtx, originalID, append(pack.Blobs(nil), blobs...), func(h restic.BlobHandle, p []byte, e error) error {
+					if e != nil {
+						return e
+					}
+					if callbacks >= len(blobs) || h != blobs[callbacks].BlobHandle || restic.Hash(p) != h.ID {
+						return errors.New("wrong recovered content/order")
+					}
+					callbacks++
+					return nil
+				})
+				if err == nil && callbacks != len(blobs) {
+					err = fmt.Errorf("callbacks=%d", callbacks)
+				}
+				results <- err
+			}
+			go run(boundedCtx, false)
+			select {
+			case <-promotion:
+			case <-ctx.Done():
+				t.Fatal("bounded worker never reached saturated allocation")
+			}
+			go run(ctx, true)
+			go run(ctx, true)
+			for range 3 {
+				select {
+				case err := <-results:
+					if err != nil {
+						t.Errorf("recovery: %v", err)
+					}
+				case <-time.After(6 * time.Second):
+					t.Fatal("recovery workers did not join")
+				}
+			}
+			if admissions != 1 || releases != 1 {
+				t.Fatalf("permit lifetime: admissions=%d releases=%d", admissions, releases)
+			}
+		})
+	}
+}
+
+func (r b23CountReader) Read(p []byte) (int, error) {
+	n, err := r.Reader.Read(p)
+	*r.bytes += n
+	return n, err
+}
+
+// This backend distinguishes a body interruption from failure after the
+// consumer succeeds. The retry and connection admission wrappers are real.
+type b23FaultBackend struct {
+	backend.Backend
+	data         []byte
+	cut          int
+	terminal     bool
+	permanent    bool
+	calls, moved int
+	ranges       [][2]int64
+}
+
+func (b *b23FaultBackend) Load(_ context.Context, _ backend.Handle, n int, off int64, fn func(io.Reader) error) error {
+	b.calls++
+	b.ranges = append(b.ranges, [2]int64{off, int64(n)})
+	if n <= 0 || off < 0 || off+int64(n) > int64(len(b.data)) {
+		return backoff.Permanent(fmt.Errorf("invalid range %d/%d", off, n))
+	}
+	p := bytes.Clone(b.data[int(off) : int(off)+n])
+	if b.calls == 1 && b.cut >= 0 && b.cut < len(p) {
+		p = p[:b.cut]
+	}
+	err := fn(b23CountReader{bytes.NewReader(p), &b.moved})
+	if err != nil {
+		return err
+	}
+	if b.terminal && (b.calls == 1 || b.permanent) {
+		err := errors.New("post-consumer failure")
+		if b.permanent {
+			return backoff.Permanent(err)
+		}
+		return err
+	}
+	return nil
+}
+
+func TestB23StreamFaultMatrix(t *testing.T) {
+	retry.TestFastRetries(t)
+	for _, tc := range []struct {
+		name                string
+		cut, rejectAt       int
+		terminal, permanent bool
+		cancelOnReject      bool
+	}{
+		{name: "partial-first-blob", cut: 17},
+		{name: "after-first-window", cut: 400},
+		{name: "inside-second-window", cut: 650},
+		{name: "post-consumer-transient", cut: -1, terminal: true},
+		{name: "post-consumer-permanent", cut: -1, terminal: true, permanent: true},
+		{name: "handler-rejection", cut: -1, rejectAt: 1},
+		{name: "handler-rejection-after-earlier-delivery", cut: -1, rejectAt: 2},
+		{name: "handler-rejection-with-cancellation", cut: -1, rejectAt: 2, cancelOnReject: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			key := testKey(t)
+			blobs, data := buildPackfileWithoutHeader([]int{350, 350, 350}, &key, false)
+			dec, err := zstd.NewReader(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dec.Close()
+			m := mock.NewBackend()
+			m.PropertiesFn = func() backend.Properties { return backend.Properties{Connections: 1} }
+			fault := &b23FaultBackend{Backend: m, data: data, cut: tc.cut, terminal: tc.terminal, permanent: tc.permanent}
+			be := retry.New(sema.NewBackend(fault), time.Second, nil, nil)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			seen := make(map[restic.ID]int)
+			rejection := errors.New("handler rejected after observable work")
+			callbacks, callsOnReject := 0, 0
+			err = streamPackWithPolicy(sema.WithAdditionalLoadSlot(ctx), be.Load, nil, dec, &key, restic.Hash(data), blobs,
+				func(h restic.BlobHandle, p []byte, blobErr error) error {
+					callbacks++
+					seen[h.ID]++
+					if callbacks > len(blobs) || h != blobs[callbacks-1].BlobHandle {
+						t.Errorf("callback order changed at %d", callbacks)
+					}
+					if seen[h.ID] != 1 {
+						t.Errorf("repeated callback for %v", h)
+					}
+					if blobErr != nil || restic.Hash(p) != h.ID {
+						t.Errorf("bad delivery: %v", blobErr)
+					}
+					if tc.rejectAt != 0 && callbacks == tc.rejectAt {
+						callsOnReject = fault.calls
+						if tc.cancelOnReject {
+							cancel()
+						}
+						return rejection
+					}
+					return nil
+				}, 512, false)
+			if tc.rejectAt != 0 {
+				if !errors.Is(err, rejection) || callbacks != tc.rejectAt || fault.calls != callsOnReject {
+					t.Fatalf("rejection replay: err=%v callbacks=%d loads=%d", err, callbacks, fault.calls)
+				}
+			} else if tc.permanent {
+				if err == nil {
+					t.Fatal("terminal backend failure silently accepted")
+				}
+			} else if err != nil || callbacks != len(blobs) {
+				t.Fatalf("err=%v callbacks=%d want=%d", err, callbacks, len(blobs))
+			}
+			t.Logf("loads=%d consumed_bytes=%d pack_bytes=%d callbacks=%d ranges=%v error=%v", fault.calls, fault.moved, len(data), callbacks, fault.ranges, err)
+		})
+	}
+}
+
+type b23CanceledReader struct {
+	ctx     context.Context
+	prefix  io.Reader
+	entered chan struct{}
+	once    sync.Once
+}
+
+func (r *b23CanceledReader) Read(p []byte) (int, error) {
+	n, err := r.prefix.Read(p)
+	if n != 0 || err != io.EOF {
+		return n, err
+	}
+	r.once.Do(func() { close(r.entered) })
+	<-r.ctx.Done()
+	return 0, r.ctx.Err()
+}
+
+func TestB23StreamCancellationDuringBody(t *testing.T) {
+	retry.TestFastRetries(t)
+	key := testKey(t)
+	blobs, data := buildPackfileWithoutHeader([]int{350, 350, 350}, &key, false)
+	dec, err := zstd.NewReader(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dec.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	entered := make(chan struct{})
+	m := mock.NewBackend()
+	m.OpenReaderFn = func(ctx context.Context, _ backend.Handle, n int, off int64) (io.ReadCloser, error) {
+		end := int(off) + n
+		cut := int(blobs[0].Length) + 2
+		if end > cut {
+			end = cut
+		}
+		if end < int(off) {
+			end = int(off)
+		}
+		return io.NopCloser(&b23CanceledReader{ctx: ctx, prefix: bytes.NewReader(data[int(off):end]), entered: entered}), nil
+	}
+	be := retry.New(sema.NewBackend(m), time.Second, nil, nil)
+	callbacks := 0
+	done := make(chan error, 1)
+	go func() {
+		done <- streamPackWithPolicy(sema.WithAdditionalLoadSlot(ctx), be.Load, nil, dec, &key, restic.Hash(data), blobs,
+			func(h restic.BlobHandle, p []byte, e error) error {
+				callbacks++
+				if e != nil {
+					return e
+				}
+				if restic.Hash(p) != h.ID {
+					return errors.New("bad content")
+				}
+				return nil
+			}, 512, false)
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("body did not block")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) || callbacks != 1 {
+			t.Fatalf("body cancellation: %v callbacks=%d", err, callbacks)
+		}
+	case <-time.After(6 * time.Second):
+		t.Fatal("body cancellation did not join")
+	}
+}
+
+func TestB23StreamCancellationJoinsBorrowedCallback(t *testing.T) {
+	key := testKey(t)
+	blobs, data := buildPackfileWithoutHeader([]int{350, 350, 350}, &key, false)
+	dec, err := zstd.NewReader(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dec.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	entered, unblock := make(chan struct{}), make(chan struct{})
+	callbacks := 0
+	done := make(chan error, 1)
+	load := func(_ context.Context, _ backend.Handle, n int, off int64, fn func(io.Reader) error) error {
+		return fn(bytes.NewReader(bytes.Clone(data[int(off) : int(off)+n])))
+	}
+	go func() {
+		done <- streamPackWithPolicy(ctx, load, nil, dec, &key, restic.Hash(data), blobs, func(h restic.BlobHandle, p []byte, e error) error {
+			callbacks++
+			if e != nil {
+				return e
+			}
+			before := bytes.Clone(p)
+			close(entered)
+			<-unblock
+			if !bytes.Equal(p, before) || restic.Hash(p) != h.ID {
+				return errors.New("borrowed buffer changed before callback return")
+			}
+			return nil
+		}, 512, false)
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("callback did not start")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		t.Fatalf("returned before borrowed callback joined: %v", err)
+	default:
+	}
+	close(unblock)
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) || callbacks != 1 {
+			t.Fatalf("callback cancellation: %v callbacks=%d", err, callbacks)
+		}
+	case <-time.After(6 * time.Second):
+		t.Fatal("callback cancellation did not join")
+	}
+}
+
+// All workers start together and every selected copy is corrupt. Recovery
+// takes the same explicitly bounded connection path to a valid alternate.
+func TestB23StreamSaturatedAlternateRecovery(t *testing.T) {
+	for _, connections := range []uint{1, 2} {
+		t.Run(fmt.Sprint(connections), func(t *testing.T) {
+			key := testKey(t)
+			blobs, data := buildPackfileWithoutHeader([]int{350, 350, 350}, &key, false)
+			corrupt := bytes.Clone(data)
+			for _, b := range blobs {
+				corrupt[b.Offset+16] ^= 1
+			}
+			m := mock.NewBackend()
+			m.PropertiesFn = func() backend.Properties { return backend.Properties{Connections: connections} }
+			m.OpenReaderFn = func(_ context.Context, h backend.Handle, n int, off int64) (io.ReadCloser, error) {
+				p := corrupt
+				if h.Name == "alternate" {
+					p = data
+				}
+				return io.NopCloser(bytes.NewReader(bytes.Clone(p[int(off) : int(off)+n]))), nil
+			}
+			be := sema.NewBackend(m)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			ctx = sema.WithAdditionalLoadSlot(ctx) // cancellable, no overflow enabled
+			start := make(chan struct{})
+			results := make(chan error, 3)
+			var ready sync.WaitGroup
+			ready.Add(3)
+			for range 3 {
+				go func() {
+					dec, err := zstd.NewReader(nil)
+					if err != nil {
+						results <- err
+						ready.Done()
+						return
+					}
+					defer dec.Close()
+					ready.Done()
+					<-start
+					recoverBlob := func(ctx context.Context, h restic.BlobHandle, _ []byte) ([]byte, error) {
+						for _, b := range blobs {
+							if b.BlobHandle != h {
+								continue
+							}
+							var p []byte
+							err := be.Load(ctx, backend.Handle{Type: backend.PackFile, Name: "alternate"}, int(b.Length), int64(b.Offset), func(rd io.Reader) error {
+								cipher := make([]byte, b.Length)
+								if _, err := io.ReadFull(rd, cipher); err != nil {
+									return err
+								}
+								var err error
+								p, err = key.Open(nil, cipher[:key.NonceSize()], cipher[key.NonceSize():], nil)
+								return err
+							})
+							return p, err
+						}
+						return nil, errors.New("unknown handle")
+					}
+					callbacks := 0
+					err = streamPackWithPolicy(ctx, be.Load, recoverBlob, dec, &key, restic.Hash(data), append(blobs[:0:0], blobs...), func(h restic.BlobHandle, p []byte, e error) error {
+						callbacks++
+						if e != nil {
+							return e
+						}
+						if restic.Hash(p) != h.ID {
+							return errors.New("invalid recovered content")
+						}
+						return nil
+					}, 512, false)
+					if err == nil && callbacks != len(blobs) {
+						err = fmt.Errorf("callbacks %d", callbacks)
+					}
+					results <- err
+				}()
+			}
+			ready.Wait()
+			close(start)
+			for range 3 {
+				select {
+				case err := <-results:
+					if err != nil {
+						t.Errorf("saturated recovery: %v", err)
+					}
+				case <-time.After(6 * time.Second):
+					t.Fatal("workers did not join after cancellation")
+				}
+			}
+		})
+	}
+}
+
+// An understated compressed size must release its response before waiting for
+// ordinary allocation admission. Admission itself probes the only connection.
+func TestB23UnderstatedAdmissionReleasesConnection(t *testing.T) {
+	for _, canceled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("cancel=%v", canceled), func(t *testing.T) {
+			key := testKey(t)
+			blobs, data := buildPackfileWithoutHeader([]int{600000, 600000, 600000}, &key, true)
+			for i := range blobs {
+				blobs[i].UncompressedLength = 1
+			}
+			m := mock.NewBackend()
+			m.PropertiesFn = func() backend.Properties { return backend.Properties{Connections: 1} }
+			m.OpenReaderFn = func(_ context.Context, _ backend.Handle, n int, off int64) (io.ReadCloser, error) {
+				return io.NopCloser(bytes.NewReader(bytes.Clone(data[int(off) : int(off)+n]))), nil
+			}
+			be := sema.NewBackend(m)
+			r := &Repository{be: be, key: &key}
+			defer func() {
+				if r.dec != nil {
+					r.dec.Close()
+				}
+				if r.smallRestoreDecoder != nil {
+					r.smallRestoreDecoder.Close()
+				}
+			}()
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			ctx = sema.WithAdditionalLoadSlot(ctx)
+			entered := make(chan struct{})
+			admissions, releases, callbacks := 0, 0, 0
+			ctx = restic.WithSmallRestoreLoad(ctx, func(ctx context.Context) (func(), error) {
+				admissions++
+				// Deadlocks if promotion runs while its response owns the token.
+				if err := be.Load(ctx, backend.Handle{Type: backend.PackFile, Name: "admission-probe"}, 1, 0, func(rd io.Reader) error {
+					var p [1]byte
+					_, err := io.ReadFull(rd, p[:])
+					return err
+				}); err != nil {
+					return nil, err
+				}
+				close(entered)
+				if canceled {
+					<-ctx.Done()
+					return nil, ctx.Err()
+				}
+				return func() { releases++ }, nil
+			})
+			done := make(chan error, 1)
+			go func() {
+				done <- r.loadBlobsFromPack(ctx, restic.Hash(data), blobs, func(h restic.BlobHandle, p []byte, e error) error {
+					callbacks++
+					if e != nil {
+						return e
+					}
+					if restic.Hash(p) != h.ID {
+						return errors.New("wrong decoded content")
+					}
+					return nil
+				})
+			}()
+			select {
+			case <-entered:
+			case <-ctx.Done():
+				t.Fatal("promotion retained the response connection")
+			}
+			if canceled {
+				cancel()
+			}
+			select {
+			case err := <-done:
+				if canceled {
+					if !errors.Is(err, context.Canceled) || callbacks != 0 || releases != 0 {
+						t.Fatalf("cancellation: %v callbacks=%d releases=%d", err, callbacks, releases)
+					}
+				} else if err != nil || callbacks != 3 || admissions != 1 || releases != 1 {
+					t.Fatalf("promotion: %v callbacks=%d admissions=%d releases=%d", err, callbacks, admissions, releases)
+				}
+			case <-time.After(6 * time.Second):
+				t.Fatal("promotion did not join")
+			}
+		})
+	}
+}
diff --git a/internal/repository/stream_pack_coalesced.go b/internal/repository/stream_pack_coalesced.go
new file mode 100644
index 0000000000000000000000000000000000000000..b2fe659d033ea38cbf7591e1b44fdc890fe14e5d
--- /dev/null
+++ b/internal/repository/stream_pack_coalesced.go
@@ -0,0 +1,204 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/errors"
+	"github.com/restic/restic/internal/repository/crypto"
+	"github.com/restic/restic/internal/repository/pack"
+	"github.com/restic/restic/internal/restic"
+)
+
+const maxStreamPackRequestSize = 32 * 1024 * 1024
+
+var errStreamPackYield = fmt.Errorf("release pack response before recovery")
+
+// packRangeEnd preserves the window and gap rules. Request spans use the same
+// rule with a larger limit; an oversized individual blob still travels alone.
+func packRangeEnd(blobs pack.Blobs, limit uint) int {
+	end := blobs[0].Offset + blobs[0].Length
+	for i := 1; i < len(blobs); i++ {
+		if blobs[i].Offset-end > maxUnusedRange ||
+			blobs[i].Offset+blobs[i].Length-blobs[0].Offset >= limit {
+			return i
+		}
+		end = blobs[i].Offset + blobs[i].Length
+	}
+	return len(blobs)
+}
+
+func streamPackCoalesced(ctx context.Context, load backendLoadFn, recoverBlob loadBlobFn, dec *zstd.Decoder, key *crypto.Key, packID restic.ID, blobs pack.Blobs, handle func(restic.BlobHandle, []byte, error) error, window uint, pooled bool) error {
+	if len(blobs) == 0 {
+		return nil
+	}
+	blobs.Sort()
+	end := blobs[0].Offset
+	for _, blob := range blobs {
+		if blob.Offset < end {
+			return fmt.Errorf("overlapping blobs in pack %v", packID)
+		}
+		end = blob.Offset + blob.Length
+	}
+	var data []byte
+	if pooled {
+		data = takeStreamPackBuffer()
+		defer func() { putStreamPackBuffer(data) }()
+	}
+	for len(blobs) > 0 {
+		n := packRangeEnd(blobs, maxStreamPackRequestSize)
+		span := blobs[:n]
+		if packRangeEnd(span, window) == len(span) {
+			// Preserve the existing path when there is no request to eliminate.
+			if err := streamPackPartWithBuffer(ctx, load, recoverBlob, dec, key, packID, span, &data, handle); err != nil {
+				return err
+			}
+		} else if err := streamPackResponse(ctx, load, recoverBlob, dec, key, packID, span, &data, handle, window); err != nil {
+			return err
+		}
+		blobs = blobs[n:]
+	}
+	return nil
+}
+
+// Delivery is committed only after the handler returns nil. A replay consumes
+// that prefix without decoding or delivering it again. This bounds memory but
+// does not avoid retransferring the prefix: retry.Load owns fixed arguments.
+func streamPackResponse(ctx context.Context, load backendLoadFn, recoverBlob loadBlobFn, dec *zstd.Decoder, key *crypto.Key, packID restic.ID, blobs pack.Blobs, data *[]byte, handle func(restic.BlobHandle, []byte, error) error, window uint) error {
+	requestCtx, stop := context.WithCancel(ctx)
+	defer stop()
+	if policy, ok := ctx.Value(smallRestoreDecodeKey{}).(smallRestoreDecodePolicy); ok {
+		// Admission promotion must happen after Load releases its connection.
+		policy.ensureOrdinary = func(context.Context) error { return errStreamPackYield }
+		requestCtx = context.WithValue(requestCtx, smallRestoreDecodeKey{}, policy)
+	}
+	committed := 0
+	var handlerErr error
+	yield := false
+	var finalPart pack.Blobs
+	// The final window is read here and decoded after Load returns: its bytes
+	// are taken here and handed to that decode.
+	var finalHold *restoreWindowHold
+	defer func() { finalHold.release(nil) }()
+	start := blobs[0].Offset
+	end := blobs[len(blobs)-1].Offset + blobs[len(blobs)-1].Length
+	h := backend.Handle{Type: backend.PackFile, Name: packID.String(), IsMetadata: blobs[0].Type.IsMetadata()}
+	err := load(requestCtx, h, int(end-start), int64(start), func(rd io.Reader) error {
+		finalPart = nil
+		position := start
+		for committed < len(blobs) {
+			remaining := blobs[committed:]
+			if _, err := io.CopyN(io.Discard, rd, int64(remaining[0].Offset-position)); err != nil {
+				return err
+			}
+			n := packRangeEnd(remaining, window)
+			part := remaining[:n]
+			if n == len(remaining) {
+				// Keep the final window uncommitted until terminal read/close
+				// succeeds. It can then recover outside the connection as usual.
+				size := int(end - part[0].Offset)
+				// a replayed response may end in a different final window
+				finalHold.release(nil)
+				finalHold = newRestoreWindowHold(ctx, part)
+				if herr := finalHold.admit(requestCtx); herr != nil {
+					return herr
+				}
+				if cap(*data) < size {
+					*data = make([]byte, size)
+				} else {
+					*data = (*data)[:size]
+				}
+				if _, err := io.ReadFull(rd, *data); err != nil {
+					return err
+				}
+				finalPart = part
+				return nil
+			}
+			// Reuse the established window decoder. Its load reads from this
+			// response; alternate-copy recovery is deliberately disabled here.
+			readWindow := func(_ context.Context, _ backend.Handle, _ int, _ int64, consume func(io.Reader) error) error {
+				return consume(rd)
+			}
+			err := streamPackPartWithBuffer(requestCtx, readWindow, nil, dec, key, packID, part, data,
+				func(h restic.BlobHandle, plaintext []byte, blobErr error) error {
+					if blobErr != nil && recoverBlob != nil {
+						yield = true
+						stop()
+						return errStreamPackYield
+					}
+					handlerErr = handle(h, plaintext, blobErr)
+					if handlerErr != nil {
+						stop() // suppress transport retry of a rejected callback
+						return handlerErr
+					}
+					committed++
+					return nil
+				})
+			if err == errStreamPackYield {
+				yield = true
+				stop()
+			}
+			if err != nil {
+				return err
+			}
+			position = part[len(part)-1].Offset + part[len(part)-1].Length
+		}
+		return nil
+	})
+	if handlerErr != nil {
+		return handlerErr
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if yield {
+		// No live response remains here. The original context and policy allow
+		// ordinary admission and alternate loads without a nested-load cycle.
+		for remaining := blobs[committed:]; len(remaining) > 0; {
+			n := packRangeEnd(remaining, window)
+			if err := streamPackPartWithBuffer(ctx, load, recoverBlob, dec, key, packID, remaining[:n], data, handle); err != nil {
+				return err
+			}
+			remaining = remaining[n:]
+		}
+		return nil
+	}
+	if err != nil {
+		// Transport retry has finished. Recover directly, as the original
+		// loader does; do not start a fresh retry budget for the same span.
+		if recoverBlob != nil {
+			for _, entry := range blobs[committed:] {
+				if ctx.Err() != nil {
+					return ctx.Err()
+				}
+				plaintext, blobErr := recoverBlob(ctx, entry.BlobHandle, nil)
+				if ctx.Err() != nil {
+					return ctx.Err()
+				}
+				err = handle(entry.BlobHandle, plaintext, blobErr)
+				if err != nil {
+					break
+				}
+				if ctx.Err() != nil {
+					return ctx.Err()
+				}
+			}
+		}
+		return errors.Wrap(err, "StreamPack")
+	}
+	if len(finalPart) > 0 {
+		readFinal := func(_ context.Context, _ backend.Handle, _ int, _ int64, consume func(io.Reader) error) error {
+			return consume(bytes.NewReader(*data))
+		}
+		finalCtx := ctx
+		if finalHold != nil {
+			finalCtx = context.WithValue(ctx, restoreHoldTakenKey{}, finalHold)
+		}
+		return streamPackPartWithBuffer(finalCtx, readFinal, recoverBlob, dec, key, packID, finalPart, data, handle)
+	}
+	return nil
+}
diff --git a/internal/repository/stream_pack_coalesced_test.go b/internal/repository/stream_pack_coalesced_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1bde583b82a256049d252982f5ae400e304ce1ec
--- /dev/null
+++ b/internal/repository/stream_pack_coalesced_test.go
@@ -0,0 +1,214 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/restic"
+)
+
+func TestCoalescedPackReplay(t *testing.T) {
+	for _, cut := range []int{0, 100, 432, 600, 864, 1100} {
+		t.Run(string(rune('a'+cut/100)), func(t *testing.T) {
+			key := testKey(t)
+			blobs, body := buildPackfileWithoutHeader([]int{400, 400, 400, 400}, &key, false)
+			dec, err := zstd.NewReader(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dec.Close()
+			calls, attempts, delivered := 0, 0, 0
+			load := func(ctx context.Context, _ backend.Handle, length int, offset int64, consume func(io.Reader) error) error {
+				calls++
+				attempts++
+				if err := consume(bytes.NewReader(body[offset : int(offset)+cut])); err == nil {
+					t.Fatal("partial response unexpectedly succeeded")
+				}
+				if ctx.Err() != nil {
+					return ctx.Err()
+				}
+				attempts++
+				return consume(bytes.NewReader(body[offset : int(offset)+length]))
+			}
+			err = streamPackWithPolicy(t.Context(), load, nil, dec, &key, restic.ID{}, blobs,
+				func(h restic.BlobHandle, p []byte, err error) error {
+					if err != nil {
+						return err
+					}
+					if delivered >= len(blobs) || h != blobs[delivered].BlobHandle || restic.Hash(p) != h.ID {
+						t.Fatal("callback repeated, reordered or corrupted")
+					}
+					delivered++
+					return nil
+				}, 900, false)
+			if err != nil || calls != 1 || attempts != 2 || delivered != len(blobs) {
+				t.Fatalf("err %v, calls %d, attempts %d, delivered %d", err, calls, attempts, delivered)
+			}
+		})
+	}
+}
+
+func TestCoalescedPackTerminalFailure(t *testing.T) {
+	for _, retry := range []bool{false, true} {
+		t.Run(map[bool]string{false: "exhausted", true: "retry"}[retry], func(t *testing.T) {
+			key := testKey(t)
+			blobs, body := buildPackfileWithoutHeader([]int{400, 400, 400, 400}, &key, false)
+			dec, err := zstd.NewReader(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dec.Close()
+			terminal := errors.New("terminal close failure")
+			delivered, attempts := 0, 0
+			load := func(_ context.Context, _ backend.Handle, length int, offset int64, consume func(io.Reader) error) error {
+				attempts++
+				if err := consume(bytes.NewReader(body[offset : int(offset)+length])); err != nil {
+					return err
+				}
+				if delivered == len(blobs) {
+					t.Fatal("final delivery preceded response completion")
+				}
+				if retry {
+					attempts++
+					return consume(bytes.NewReader(body[offset : int(offset)+length]))
+				}
+				return terminal
+			}
+			err = streamPackWithPolicy(t.Context(), load, nil, dec, &key, restic.ID{}, blobs,
+				func(h restic.BlobHandle, p []byte, err error) error {
+					if err != nil {
+						return err
+					}
+					if h != blobs[delivered].BlobHandle || restic.Hash(p) != h.ID {
+						t.Fatal("wrong callback")
+					}
+					delivered++
+					return nil
+				}, 900, false)
+			if retry {
+				if err != nil || delivered != 4 || attempts != 2 {
+					t.Fatalf("err %v, delivered %d, attempts %d", err, delivered, attempts)
+				}
+			} else if !errors.Is(err, terminal) || delivered != 2 {
+				t.Fatalf("err %v, delivered %d", err, delivered)
+			}
+		})
+	}
+}
+
+func TestCoalescedPackRejectAndRecover(t *testing.T) {
+	for _, reject := range []bool{false, true} {
+		t.Run(map[bool]string{false: "recover", true: "reject"}[reject], func(t *testing.T) {
+			key := testKey(t)
+			blobs, body := buildPackfileWithoutHeader([]int{400, 400, 400, 400}, &key, false)
+			dec, err := zstd.NewReader(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dec.Close()
+			original := append([]byte(nil), body...)
+			if !reject {
+				body[0] ^= 1
+			}
+			active, delivered, recoveries := false, 0, 0
+			load := func(ctx context.Context, _ backend.Handle, length int, offset int64, consume func(io.Reader) error) error {
+				if active {
+					t.Fatal("nested connection")
+				}
+				active = true
+				defer func() { active = false }()
+				err := consume(bytes.NewReader(body[offset : int(offset)+length]))
+				if err != nil && ctx.Err() == nil {
+					return consume(bytes.NewReader(body[offset : int(offset)+length]))
+				}
+				return err
+			}
+			recoverBlob := func(_ context.Context, h restic.BlobHandle, _ []byte) ([]byte, error) {
+				if active {
+					t.Fatal("recovery while connection held")
+				}
+				recoveries++
+				blob := blobs[0]
+				cipher := append([]byte(nil), original[blob.Offset:blob.Offset+blob.Length]...)
+				return key.Open(cipher[key.NonceSize():key.NonceSize()], cipher[:key.NonceSize()], cipher[key.NonceSize():], nil)
+			}
+			rejected := errors.New("handler rejected after observable work")
+			err = streamPackWithPolicy(t.Context(), load, recoverBlob, dec, &key, restic.ID{}, blobs,
+				func(h restic.BlobHandle, p []byte, err error) error {
+					if err != nil {
+						return err
+					}
+					if delivered >= len(blobs) || h != blobs[delivered].BlobHandle || restic.Hash(p) != h.ID {
+						t.Fatal("wrong callback")
+					}
+					delivered++
+					if reject {
+						return rejected
+					}
+					return nil
+				}, 900, false)
+			if reject {
+				if !errors.Is(err, rejected) || delivered != 1 || recoveries != 0 {
+					t.Fatalf("err %v, delivered %d, recovery %d", err, delivered, recoveries)
+				}
+			} else if err != nil || delivered != 4 || recoveries != 1 {
+				t.Fatalf("err %v, delivered %d, recovery %d", err, delivered, recoveries)
+			}
+		})
+	}
+}
+
+func TestCoalescedPackExhaustionKeepsWindowBound(t *testing.T) {
+	key := testKey(t)
+	blobs, body := buildPackfileWithoutHeader([]int{400, 400, 400, 400}, &key, false)
+	dec, err := zstd.NewReader(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dec.Close()
+	var data []byte
+	loads, delivered, recoveries := 0, 0, 0
+	active := false
+	load := func(_ context.Context, _ backend.Handle, length int, offset int64, consume func(io.Reader) error) error {
+		loads++
+		active = true
+		defer func() { active = false }()
+		if err := consume(bytes.NewReader(body[offset : int(offset)+length])); err != nil {
+			return err
+		}
+		return errors.New("permanent terminal failure")
+	}
+	recovery := func(_ context.Context, h restic.BlobHandle, _ []byte) ([]byte, error) {
+		if active {
+			t.Fatal("recovery owns a live connection")
+		}
+		recoveries++
+		for _, blob := range blobs {
+			if blob.BlobHandle == h {
+				cipher := append([]byte(nil), body[blob.Offset:blob.Offset+blob.Length]...)
+				return key.Open(cipher[key.NonceSize():key.NonceSize()], cipher[:key.NonceSize()], cipher[key.NonceSize():], nil)
+			}
+		}
+		t.Fatal("unknown recovery blob")
+		return nil, nil
+	}
+	err = streamPackResponse(t.Context(), load, recovery, dec, &key, restic.ID{}, blobs, &data,
+		func(h restic.BlobHandle, plaintext []byte, err error) error {
+			if err != nil {
+				return err
+			}
+			if cap(data) > 900 || h != blobs[delivered].BlobHandle || restic.Hash(plaintext) != h.ID {
+				t.Fatal("window exceeded, or delivery repeated")
+			}
+			delivered++
+			return nil
+		}, 900)
+	if err != nil || loads != 1 || recoveries != 2 || delivered != 4 {
+		t.Fatalf("err %v, loads %d, recoveries %d, delivered %d", err, loads, recoveries, delivered)
+	}
+}
diff --git a/internal/repository/stream_rest_fault_b23_test.go b/internal/repository/stream_rest_fault_b23_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ffc85eff8971a0cbc722891c9dbedbbb0e59fd3f
--- /dev/null
+++ b/internal/repository/stream_rest_fault_b23_test.go
@@ -0,0 +1,103 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/restic/restic/internal/backend/rest"
+	"github.com/restic/restic/internal/backend/retry"
+	"github.com/restic/restic/internal/backend/sema"
+	"github.com/restic/restic/internal/restic"
+)
+
+type b23RoundTripper func(*http.Request) (*http.Response, error)
+
+func (f b23RoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type b23TerminalBody struct {
+	*bytes.Reader
+	readErr, closeErr error
+	moved, closes     *int
+}
+
+func (b *b23TerminalBody) Read(p []byte) (int, error) {
+	n, err := b.Reader.Read(p)
+	*b.moved += n
+	if err == io.EOF && b.readErr != nil {
+		return n, b.readErr
+	}
+	return n, err
+}
+func (b *b23TerminalBody) Close() error { *b.closes++; return b.closeErr }
+
+// Use REST.Load itself so its extra EOF read and Close are both exercised,
+// followed by real transport retry and one explicit connection token.
+func TestB23RESTTerminalReadAndClose(t *testing.T) {
+	retry.TestFastRetries(t)
+	for _, failure := range []string{"read", "close"} {
+		t.Run(failure, func(t *testing.T) {
+			key := testKey(t)
+			blobs, data := buildPackfileWithoutHeader([]int{350, 350, 350}, &key, false)
+			dec, err := zstd.NewReader(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dec.Close()
+			attempts, moved, closes, callbacks := 0, 0, 0, 0
+			var ranges [][2]int64
+			rt := b23RoundTripper(func(req *http.Request) (*http.Response, error) {
+				attempts++
+				var first, last int64
+				if _, err := fmt.Sscanf(req.Header.Get("Range"), "bytes=%d-%d", &first, &last); err != nil {
+					return nil, err
+				}
+				if first < 0 || last < first || last >= int64(len(data)) {
+					return nil, fmt.Errorf("bad range %d-%d", first, last)
+				}
+				ranges = append(ranges, [2]int64{first, last - first + 1})
+				body := &b23TerminalBody{Reader: bytes.NewReader(bytes.Clone(data[first : last+1])), moved: &moved, closes: &closes}
+				if attempts == 1 {
+					if failure == "read" {
+						body.readErr = errors.New("terminal EOF frame failed")
+					} else {
+						body.closeErr = errors.New("terminal Close failed")
+					}
+				}
+				return &http.Response{StatusCode: http.StatusPartialContent, Status: "206 Partial Content", Header: make(http.Header), Body: body, ContentLength: last - first + 1, Request: req}, nil
+			})
+			u, err := url.Parse("http://rest.invalid/repository/")
+			if err != nil {
+				t.Fatal(err)
+			}
+			be, err := rest.Open(context.Background(), rest.Config{URL: u, Connections: 1}, rt, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rb := retry.New(sema.NewBackend(be), time.Second, nil, nil)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			err = streamPackWithPolicy(sema.WithAdditionalLoadSlot(ctx), rb.Load, nil, dec, &key, restic.Hash(data), blobs, func(h restic.BlobHandle, p []byte, e error) error {
+				if e != nil {
+					return e
+				}
+				if callbacks >= len(blobs) || h != blobs[callbacks].BlobHandle || restic.Hash(p) != h.ID {
+					return errors.New("replayed/reordered/corrupt callback")
+				}
+				callbacks++
+				return nil
+			}, 512, false)
+			if err != nil || callbacks != len(blobs) || attempts < 2 || closes != attempts {
+				t.Fatalf("REST settlement: %v callbacks=%d attempts=%d closes=%d", err, callbacks, attempts, closes)
+			}
+			t.Logf("REST failure=%s attempts=%d closes=%d consumed_bytes=%d pack_bytes=%d callbacks=%d ranges=%v", failure, attempts, closes, moved, len(data), callbacks, ranges)
+		})
+	}
+}
