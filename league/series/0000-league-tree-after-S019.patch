+func TestEncodeMatchesLegacyPackListEncoding(t *testing.T) {
+	idx := NewIndex()
+	firstPack := restic.NewRandomID()
+	secondPack := restic.NewRandomID()
+	idx.StorePack(firstPack, pack.Blobs{
