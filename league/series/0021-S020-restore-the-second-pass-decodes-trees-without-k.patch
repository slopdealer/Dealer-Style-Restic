diff --git a/internal/data/tree_metadata.go b/internal/data/tree_metadata.go
new file mode 100644
index 0000000000000000000000000000000000000000..fa519fd21507dc2387cba61277970644dfe7169e
--- /dev/null
+++ b/internal/data/tree_metadata.go
@@ -0,0 +1,136 @@
+package data
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"strconv"
+
+	"github.com/restic/restic/internal/errors"
+	"github.com/restic/restic/internal/restic"
+)
+
+// metadataContent validates every content ID without retaining the slice.
+// The outer JSON decoder already validates framing and string escaping. The
+// fast path still calls the ordinary ID parser for every ID. Unusual values use
+// the ordinary slice decoder; semantic errors are replayed at the node boundary.
+type metadataContent struct{}
+
+func (*metadataContent) UnmarshalJSON(raw []byte) error {
+	raw = bytes.TrimSpace(raw)
+	if bytes.Equal(raw, []byte("null")) {
+		return nil
+	}
+	ordinary := func() error {
+		var ids restic.IDs
+		return json.Unmarshal(raw, &ids)
+	}
+	if len(raw) < 2 || raw[0] != '[' {
+		return ordinary()
+	}
+	i := 1
+	skipSpace := func() {
+		for i < len(raw) && (raw[i] == ' ' || raw[i] == '\t' || raw[i] == '\r' || raw[i] == '\n') {
+			i++
+		}
+	}
+	skipSpace()
+	if i == len(raw)-1 && raw[i] == ']' {
+		return nil
+	}
+	for {
+		if i+66 > len(raw) || raw[i] != '"' || raw[i+65] != '"' {
+			return ordinary()
+		}
+		var id restic.ID
+		if err := id.UnmarshalJSON(raw[i : i+66]); err != nil {
+			return err
+		}
+		i += 66
+		skipSpace()
+		if i == len(raw)-1 && raw[i] == ']' {
+			return nil
+		}
+		if i >= len(raw) || raw[i] != ',' {
+			return ordinary()
+		}
+		i++
+		skipSpace()
+	}
+}
+
+type metadataNodeBase Node
+type metadataNodeJSON struct {
+	metadataNodeBase
+	Content metadataContent `json:"content"`
+}
+
+// LoadMetadataTree authenticates and decodes a tree with ordinary field and
+// error interpretation, but returns no file content IDs. It is only for a
+// metadata traversal: planning and verification must keep using LoadTree.
+func LoadMetadataTree(ctx context.Context, loader restic.BlobLoader, content restic.ID) (TreeNodeIterator, error) {
+	payload, err := loader.LoadBlob(ctx, restic.BlobHandle{Type: restic.TreeBlob, ID: content}, nil)
+	if err != nil {
+		return nil, err
+	}
+	return newMetadataTreeIterator(payload)
+}
+
+func newMetadataTreeIterator(payload []byte) (TreeNodeIterator, error) {
+	t := &treeIterator{dec: *json.NewDecoder(bytes.NewReader(payload))}
+	if err := t.init(); err != nil {
+		return nil, err
+	}
+	return func(yield func(NodeOrError) bool) {
+		if t.started {
+			panic("tree iterator is single use only")
+		}
+		t.started = true
+		for {
+			n, err := nextMetadataNode(t, payload)
+			if err != nil && errors.Is(err, io.EOF) {
+				return
+			}
+			if !yield(NodeOrError{Node: n, Error: err}) || err != nil {
+				return
+			}
+		}
+	}, nil
+}
+
+func nextMetadataNode(t *treeIterator, payload []byte) (*Node, error) {
+	if !t.dec.More() {
+		return t.next()
+	}
+	start := t.dec.InputOffset()
+	wire := new(metadataNodeJSON)
+	n := (*Node)(&wire.metadataNodeBase)
+	err := t.dec.Decode(wire)
+	if err != nil {
+		if _, syntax := err.(*json.SyntaxError); syntax || err == io.EOF || err == io.ErrUnexpectedEOF {
+			return nil, err
+		}
+		end := t.dec.InputOffset()
+		raw := bytes.TrimLeft(payload[start:end], " \t\r\n,")
+		ordinary := new(Node)
+		if err := ordinary.UnmarshalJSON(raw); err != nil {
+			return nil, err
+		}
+		ordinary.Content = nil
+		return ordinary, nil
+	}
+	// As in nextParentNode: strconv.Unquote is skipped only for names it
+	// returns unchanged, so a name is rejected exactly when stock rejects it.
+	if !nodeNameIsPlain(n.Name) {
+		n.Name, err = strconv.Unquote(`"` + n.Name + `"`)
+		if err != nil {
+			return nil, errors.Wrap(err, "Unquote")
+		}
+	}
+	if n.LinkTargetRaw != nil {
+		n.LinkTarget = string(n.LinkTargetRaw)
+		n.LinkTargetRaw = nil
+	}
+	return n, nil
+}
diff --git a/internal/data/tree_metadata_name_test.go b/internal/data/tree_metadata_name_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1a5d90d5d613dc0b68f78d4cb90aa15ff93d8ac2
--- /dev/null
+++ b/internal/data/tree_metadata_name_test.go
@@ -0,0 +1,73 @@
+package data
+
+import (
+	"context"
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/restic/restic/internal/restic"
+)
+
+// LoadMetadataTree is a third decoder for tree documents (restore's second
+// pass). Like the direct decoder it may skip strconv.Unquote only for names
+// that the call returns unchanged; for every other name it has to return what
+// stock's Node.UnmarshalJSON returns, error text included. The trees are the
+// adversarial set of TestTreeDecodersAgreeWithStockOnAdversarialNames.
+
+func decodeTreeMetadata(payload []byte) decodedTree {
+	return collectTree(LoadMetadataTree(context.Background(), payloadLoader(payload), restic.Hash(payload)))
+}
+
+func compareMetadataDecoder(t *testing.T, payload []byte) (rejected bool) {
+	t.Helper()
+	stock := decodeTreeStock(payload)
+	if got := decodeTreeMetadata(payload); !equalDecodedTrees(stock, got) {
+		t.Fatalf("tree %q:\nstock            names=%q err=%q\nLoadMetadataTree names=%q err=%q", payload, stock.names, stock.err, got.names, got.err)
+	}
+	return stock.err != ""
+}
+
+func TestMetadataTreeAgreesWithStockOnAdversarialNames(t *testing.T) {
+	// a raw quote and a raw newline in a name: stock rejects both
+	for _, name := range []string{`a\"b`, `a\nb`} {
+		if !compareMetadataDecoder(t, treeWithNames(name)) {
+			t.Errorf("stock accepts the name %s: the test does not test what it should", name)
+		}
+	}
+	if compareMetadataDecoder(t, treeWithNames(`a\\\"b`)) {
+		t.Error("stock rejects a quote as restic writes it")
+	}
+
+	accepted, rejected := 0, 0
+	count := func(wasRejected bool) {
+		if wasRejected {
+			rejected++
+		} else {
+			accepted++
+		}
+	}
+	for _, a := range jsonNamePieces {
+		count(compareMetadataDecoder(t, treeWithNames(a)))
+		for _, b := range jsonNamePieces {
+			count(compareMetadataDecoder(t, treeWithNames(a+b)))
+			count(compareMetadataDecoder(t, treeWithNames(a+"x"+b)))
+		}
+	}
+	rnd := rand.New(rand.NewSource(20261007))
+	for i := 0; i < 30000; i++ {
+		names := make([]string, 1+rnd.Intn(3))
+		for j := range names {
+			var name strings.Builder
+			for n := rnd.Intn(7); n > 0; n-- {
+				name.WriteString(jsonNamePieces[rnd.Intn(len(jsonNamePieces))])
+			}
+			names[j] = name.String()
+		}
+		count(compareMetadataDecoder(t, treeWithNames(names...)))
+	}
+	if accepted < 1000 || rejected < 1000 {
+		t.Fatalf("one-sided sample: %d trees accepted, %d rejected", accepted, rejected)
+	}
+	t.Logf("%d trees accepted and %d rejected by stock, LoadMetadataTree agrees on all", accepted, rejected)
+}
