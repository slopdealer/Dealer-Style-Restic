From 5e1b8a1dbc44ce409e7e1e46adafcb64ea520927 Mon Sep 17 00:00:00 2001
From: slopdealer <326519127+slopdealer@users.noreply.github.com>
Date: Wed, 7 Oct 2026 05:08:05 +0000
Subject: [PATCH 23/49] R4 (cost): the encoder's destination is allocated once
 for blobs that may be stored uncompressed

Since R4 every blob is encoded, also one that does not compress. For
input of 1 MiB and more EncodeAll starts from an empty destination and
appends block by block, so it reallocates and copies the growing
output several times (below 1 MiB once more than needed when the blob
does not compress). On the judge's first backups that was the larger
half of what R4 cost: memmove +0.54 s, madvise +0.24 s and 170 more
collections against +0.74 s in the encoder itself.

From 512 KiB on the destination is now allocated once with the
encoder's own bound for that input size (MaxEncodedSize). The encoder,
its options and its output are unchanged; R4's rule and its test are
untouched. compress_presized_test.go compares the bytes with
EncodeAll(data, nil) in all four compression modes and checks that the
destination is never outgrown.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 internal/repository/compress_presized.go      | 31 +++++++++
 internal/repository/compress_presized_test.go | 63 +++++++++++++++++++
 internal/repository/repository.go             |  2 +-
 3 files changed, 95 insertions(+), 1 deletion(-)
 create mode 100644 internal/repository/compress_presized.go
 create mode 100644 internal/repository/compress_presized_test.go

diff --git a/internal/repository/compress_presized.go b/internal/repository/compress_presized.go
new file mode 100644
index 0000000000000000000000000000000000000000..79cde7c5d0254c2c6e4c8df72b475c2973005d9c
--- /dev/null
+++ b/internal/repository/compress_presized.go
@@ -0,0 +1,31 @@
+package repository
+
+// encodeBlob returns exactly what r.getZstdEncoder().EncodeAll(data, nil)
+// returns.
+//
+// EncodeAll appends to the destination it is given. For input below 1 MiB it
+// starts from a buffer as large as the input; for larger input it starts from
+// an empty one and appends block by block, so the destination is reallocated
+// and copied again and again while it grows. For a blob that does not
+// compress this is several times the blob's size in allocations and copies
+// (and one more reallocation for a smaller blob, whose output is a few bytes
+// longer than its input). Since the decision under CompressionAuto is taken
+// from the encoder's output for the whole blob, every such blob goes through
+// here.
+//
+// From presizedEncodeMinSize on, the destination is therefore allocated once,
+// with room for the largest output the encoder can produce for that input
+// size. Only the capacity of the destination differs: the encoder, its
+// options and the bytes it produces are the same.
+func (r *Repository) encodeBlob(data []byte) []byte {
+	enc := r.getZstdEncoder()
+	if len(data) < presizedEncodeMinSize {
+		return enc.EncodeAll(data, nil)
+	}
+	return enc.EncodeAll(data, make([]byte, 0, enc.MaxEncodedSize(len(data))))
+}
+
+// presizedEncodeMinSize is the smallest blob that is stored uncompressed
+// when it does not compress (autoCompressionMinRawSize): from here on a blob
+// may be incompressible media data in bulk.
+const presizedEncodeMinSize = autoCompressionMinRawSize
diff --git a/internal/repository/compress_presized_test.go b/internal/repository/compress_presized_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7fca3c396880d7af535979ee2cdc22fce64a35e3
--- /dev/null
+++ b/internal/repository/compress_presized_test.go
@@ -0,0 +1,63 @@
+package repository
+
+import (
+	"bytes"
+	"math/rand"
+	"testing"
+)
+
+// encodeBlob must return the bytes of EncodeAll(data, nil) for every input
+// and every compression mode, and from presizedEncodeMinSize on the encoder
+// must never outgrow the destination it was given.
+func TestEncodeBlobEqualsEncodeAll(t *testing.T) {
+	rnd := rand.New(rand.NewSource(20261007))
+	random := func(n int) []byte {
+		buf := make([]byte, n)
+		rnd.Read(buf)
+		return buf
+	}
+	const KiB, MiB = 1 << 10, 1 << 20
+
+	type input struct {
+		name string
+		data []byte
+	}
+	var inputs []input
+	for _, c := range autoCompressionCases() {
+		inputs = append(inputs, input{c.name, c.data})
+	}
+	// sizes around every threshold involved: the smallest raw blob, the
+	// encoder's own 1 MiB limit for an up-front buffer, its 128 KiB block
+	// size, and the largest chunk
+	for _, n := range []int{1, 100, 128 * KiB, 128*KiB + 1, 512*KiB - 1, 512 * KiB, 512*KiB + 1, MiB - 1, MiB, MiB + 1, 3*MiB + 12345, 8 * MiB} {
+		inputs = append(inputs,
+			input{"random", random(n)},
+			input{"zero", make([]byte, n)},
+			input{"half random, half zero", append(random(n/2), make([]byte, n-n/2)...)})
+	}
+
+	for _, mode := range []CompressionMode{CompressionAuto, CompressionMax, CompressionFastest, CompressionBetter} {
+		repo, _, _ := TestRepositoryWithVersion(t, 2)
+		repo.opts.Compression = mode
+		enc := repo.getZstdEncoder()
+		presized := 0
+		for _, in := range inputs {
+			want := enc.EncodeAll(in.data, nil)
+			got := repo.encodeBlob(in.data)
+			if !bytes.Equal(want, got) {
+				t.Fatalf("mode %v, %s, %d bytes: encodeBlob returns %d bytes that differ from EncodeAll's %d",
+					mode, in.name, len(in.data), len(got), len(want))
+			}
+			if len(in.data) >= presizedEncodeMinSize {
+				presized++
+				if limit := enc.MaxEncodedSize(len(in.data)); cap(got) != limit {
+					t.Fatalf("mode %v, %s, %d bytes: the destination was reallocated (capacity %d, allocated %d, output %d)",
+						mode, in.name, len(in.data), cap(got), limit, len(got))
+				}
+			}
+		}
+		if presized < 30 {
+			t.Fatalf("mode %v: only %d inputs took the presized destination", mode, presized)
+		}
+	}
+}
