 	"github.com/restic/restic/internal/backend"
@@ -14,6 +15,10 @@ import (
 
 var errKeyListingFull = errors.New("opening key listing is full")
 
+// errKeySearchRepeats ends the second key search before its first key: the
+// keys are the ones that the first search read and rejected.
+var errKeySearchRepeats = errors.New("key search would repeat the failed one")
+
 // Only an already supplied password, without a hint, has a known first key
 // listing. Leave prompting, hint lookup and one-connection backends unchanged.
 func prepareOpenKeyListing(ctx context.Context, be backend.Backend, opts Options) (backend.Backend, func()) {
@@ -40,6 +45,13 @@ type openKeyListing struct {
 	replayed      bool
 	authenticated bool
 	loadErr       error
+	// names of the staged listing as it was replayed, and whether a key load
+	// of that replay failed
+	replayedNames []string
+	loadFailed    bool
+	// compareNext makes the next key listing, which is the one of the second
+	// search, compare itself with the replayed listing before any key is tried
+	compareNext bool
 }
 
 func startOpenKeyListing(ctx context.Context, ordinary, quiet backend.Backend) (backend.Backend, func()) {
@@ -83,6 +95,10 @@ func (b *openKeyListing) Unwrap() backend.Backend { return b.Backend }
 // Consume staged discovery only at the ordinary key-search position. Loads
 // verify the current key's content hash. A failed search is retried afresh.
 func (b *openKeyListing) List(ctx context.Context, t backend.FileType, fn func(backend.FileInfo) error) error {
+	if t == backend.KeyFile && b.compareNext {
+		b.compareNext = false
+		return b.listForSecondSearch(ctx, fn)
+	}
 	if t != backend.KeyFile || b.used {
 		return b.Backend.List(ctx, t, fn)
 	}
@@ -95,6 +111,10 @@ func (b *openKeyListing) List(ctx context.Context, t backend.FileType, fn func(b
 	}
 	b.replayed = true
 	b.replaying = true
+	b.replayedNames = make([]string, len(files))
+	for i, fi := range files {
+		b.replayedNames[i] = fi.Name
+	}
 	defer func() {
 		b.replaying = false
 		b.loadErr = nil
@@ -127,18 +147,111 @@ func (b *openKeyListing) Load(ctx context.Context, h backend.Handle, length int,
 		// failure must still discard this attempt even if that read succeeds.
 		if b.loadErr == nil {
 			b.loadErr = b.quiet.Load(ctx, h, length, offset, fn)
+			if b.loadErr != nil {
+				b.loadFailed = true
+			}
 		}
 		return b.loadErr
 	}
 	return b.Backend.Load(ctx, h, length, offset, fn)
 }
 
+// listForSecondSearch is the key listing of the search that follows a failed
+// search over the staged listing. It is the ordinary listing of that search,
+// taken as far as a search can use it (maxKeys attempts and the entry that
+// ends it) before a key is tried.
+//
+// When it lists the keys that were replayed, the second search would read the
+// same key files (a key file is named by the hash of its content, and the
+// replay read each one completely) and reject the password for each of them
+// again. The search is then ended with errKeySearchRepeats before its first
+// key derivation. The comparison is by set, since a search that tries every
+// key fails in any order; with more keys than a search tries, the order
+// decides which ones are tried, so the sequence must be the same.
+//
+// Otherwise the listing is handed to the search as the backend delivered it:
+// the same entries in the same order, then the same error.
+func (b *openKeyListing) listForSecondSearch(ctx context.Context, fn func(backend.FileInfo) error) error {
+	var current []backend.FileInfo
+	listErr := b.Backend.List(ctx, backend.KeyFile, func(fi backend.FileInfo) error {
+		if _, err := restic.ParseID(fi.Name); err != nil {
+			// the key search skips such a name
+			return nil
+		}
+		fi.Name = strings.Clone(fi.Name)
+		current = append(current, fi)
+		if len(current) == maxKeys+1 {
+			return errKeyListingFull
+		}
+		return nil
+	})
+	if errors.Is(listErr, errKeyListingFull) {
+		listErr = nil
+	}
+
+	if listErr == nil && sameKeys(current, b.replayedNames) {
+		return errKeySearchRepeats
+	}
+
+	for _, fi := range current {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := fn(fi); err != nil {
+			return err
+		}
+	}
+	if listErr != nil {
+		return listErr
+	}
+	return ctx.Err()
+}
+
+// sameKeys compares a listing with the replayed names, which are distinct.
+func sameKeys(current []backend.FileInfo, replayed []string) bool {
+	if len(current) != len(replayed) {
+		return false
+	}
+	for i, fi := range current {
+		if len(current) > maxKeys {
+			if fi.Name != replayed[i] {
+				return false
+			}
+			continue
+		}
+		if !slices.Contains(replayed, fi.Name) {
+			return false
+		}
+		// equal length and every name among the replayed ones is the same
+		// set only if no name comes twice
+		for _, previous := range current[:i] {
+			if previous.Name == fi.Name {
+				return false
+			}
+		}
+	}
+	return true
+}
+
 func searchOpeningKey(ctx context.Context, s *repository.Repository, password, hint string, listing *openKeyListing) error {
 	err := s.SearchKey(ctx, password, maxKeys, hint)
 	if err != nil && listing != nil && listing.replayed && !listing.authenticated && ctx.Err() == nil {
 		// SearchKey owns its attempt counter and has not installed a master key on
 		// failure. A new call restores fresh listing, order, retries and diagnostics.
-		return s.SearchKey(ctx, password, maxKeys, hint)
+		//
+		// When the first search ended because no key accepted the password, and
+		// every key load of it succeeded, the new search first looks whether
+		// the repository still has exactly these keys. Then it would only
+		// repeat every key derivation with the same result, and the first
+		// result stands: a wrong password costs one search, as in stock.
+		listing.compareNext = !listing.loadFailed &&
+			(errors.Is(err, repository.ErrNoKeyFound) || errors.Is(err, repository.ErrMaxKeysReached))
+		second := s.SearchKey(ctx, password, maxKeys, hint)
+		listing.compareNext = false
+		if errors.Is(second, errKeySearchRepeats) {
+			return err
+		}
+		return second
 	}
 	return err
 }
diff --git a/internal/global/open_key_wrong_password_test.go b/internal/global/open_key_wrong_password_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a8c0bda10e5ab1cd0f79c0e964398213a65a1ea7
--- /dev/null
+++ b/internal/global/open_key_wrong_password_test.go
@@ -0,0 +1,140 @@
+package global
+
+import (
+	"context"
+	"io"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/backend/mem"
+	"github.com/restic/restic/internal/backend/retry"
+	"github.com/restic/restic/internal/backend/sema"
+	"github.com/restic/restic/internal/repository"
+	rtest "github.com/restic/restic/internal/test"
+)
+
+type keyAccessCounter struct {
+	backend.Backend
+	keyLoads atomic.Int64
+	keyLists atomic.Int64
+}
+
+func (b *keyAccessCounter) Load(ctx context.Context, h backend.Handle, length int, offset int64, fn func(io.Reader) error) error {
+	if h.Type == backend.KeyFile {
+		b.keyLoads.Add(1)
+	}
+	return b.Backend.Load(ctx, h, length, offset, fn)
+}
+
+func (b *keyAccessCounter) List(ctx context.Context, t backend.FileType, fn func(backend.FileInfo) error) error {
+	if t == backend.KeyFile {
+		b.keyLists.Add(1)
+	}
+	return b.Backend.List(ctx, t, fn)
+}
+
+func (b *keyAccessCounter) Unwrap() backend.Backend { return b.Backend }
+
+// searchWithCounts opens the repository in raw the way OpenRepository does
+// (staged key listing) or the way stock does (plain SearchKey) and returns
+// the key files loaded and the key listings made.
+func searchWithCounts(t *testing.T, raw backend.Backend, password string, staged bool, afterStaging func()) (loads, lists int64, err error) {
+	ctx := context.Background()
+	counter := &keyAccessCounter{Backend: raw}
+	var be backend.Backend = retry.New(sema.NewBackend(counter), time.Second, nil, nil)
+	var listing *openKeyListing
+	if staged {
+		wrapped, finish := prepareOpenKeyListing(ctx, be, Options{Password: password})
+		defer finish()
+		be = wrapped
+		listing, _ = wrapped.(*openKeyListing)
+		if listing == nil {
+			t.Fatal("no key listing was staged")
+		}
+		<-listing.done
+	}
+	if afterStaging != nil {
+		afterStaging()
+	}
+	repo, err := repository.New(be, repository.Options{})
+	rtest.OK(t, err)
+	if staged {
+		err = searchOpeningKey(ctx, repo, password, "", listing)
+	} else {
+		err = repo.SearchKey(ctx, password, maxKeys, "")
+	}
+	return counter.keyLoads.Load(), counter.keyLists.Load(), err
+}
+
+// A wrong password that is supplied without a prompt (RESTIC_PASSWORD, a
+// password file or command) costs one key search: every key file is loaded
+// and tried once, as in stock. Every attempt is one scrypt derivation.
+func TestOpenKeyWrongPasswordCostsOneSearch(t *testing.T) {
+	for _, keys := range []int{1, 4, maxKeys} {
+		raw := mem.New()
+		setup, _ := repository.TestRepositoryWithBackend(t, raw, 0, repository.Options{})
+		for i := 1; i < keys; i++ {
+			_, err := repository.AddKey(context.Background(), setup, "another password", "user", "host", setup.Key())
+			rtest.OK(t, err)
+		}
+
+		stockLoads, stockLists, stockErr := searchWithCounts(t, raw, "wrong password", false, nil)
+		loads, lists, err := searchWithCounts(t, raw, "wrong password", true, nil)
+		if stockErr == nil || err == nil {
+			t.Fatal("wrong password was accepted")
+		}
+		rtest.Equals(t, stockErr.Error(), err.Error())
+		rtest.Equals(t, int64(keys), stockLoads)
+		rtest.Equals(t, int64(1), stockLists)
+		if loads != stockLoads {
+			t.Errorf("%d keys: %d key files loaded and tried, stock tries %d", keys, loads, stockLoads)
+		}
+		// the staged listing and the one that confirms the keys are unchanged
+		rtest.Equals(t, int64(2), lists)
+
+		// the right password still opens the repository
+		_, _, err = searchWithCounts(t, raw, rtest.TestPassword, true, nil)
+		rtest.OK(t, err)
+	}
+}
+
+// The first result is final only while the repository has the keys that were
+// tried. A key that appears after the staged listing is found by a second
+// search over the new listing; a different set of keys that still does not
+// accept the password is searched again and gives stock's error.
+func TestOpenKeyChangedListingIsSearchedAgain(t *testing.T) {
+	ctx := context.Background()
+	raw := mem.New()
+	setup, _ := repository.TestRepositoryWithBackend(t, raw, 0, repository.Options{})
+	for i := 0; i < 2; i++ {
+		_, err := repository.AddKey(ctx, setup, "another password", "user", "host", setup.Key())
+		rtest.OK(t, err)
+	}
+
+	// a key for the password is added between the staged listing and the search
+	loads, lists, err := searchWithCounts(t, raw, "late password", true, func() {
+		_, err := repository.AddKey(ctx, setup, "late password", "user", "host", setup.Key())
+		rtest.OK(t, err)
+	})
+	rtest.OK(t, err)
+	rtest.Equals(t, int64(2), lists)
+	if loads < 3+1 || loads > 3+4 {
+		t.Errorf("%d key files loaded: the three staged keys once, then up to the four listed ones", loads)
+	}
+
+	// a key for another password is added: both searches fail, the second is complete
+	stockLoads, _, stockErr := searchWithCounts(t, raw, "wrong password", false, nil)
+	rtest.Equals(t, int64(4), stockLoads)
+	loads, lists, err = searchWithCounts(t, raw, "wrong password", true, func() {
+		_, err := repository.AddKey(ctx, setup, "yet another password", "user", "host", setup.Key())
+		rtest.OK(t, err)
+	})
+	if stockErr == nil || err == nil {
+		t.Fatal("wrong password was accepted")
+	}
+	rtest.Equals(t, stockErr.Error(), err.Error())
+	rtest.Equals(t, int64(4+5), loads)
+	rtest.Equals(t, int64(2), lists)
+}
