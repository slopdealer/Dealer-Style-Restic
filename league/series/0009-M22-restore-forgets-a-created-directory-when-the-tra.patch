From a061a11d50f036c3b38bb2461d60a84e5a08561f Mon Sep 17 00:00:00 2001
From: slopdealer <326519127+slopdealer@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:37:08 +0000
Subject: [PATCH 09/49] M22: restore forgets a created directory when the
 traversal leaves it

The first pass kept the target path of every directory it created in a map
until the restore ended: measured here on snapshots of empty directories,
250 to 320 bytes of live heap per directory (stock: about 20), without a
bound.

The entry is only read while the traversal is inside the directory (for the
directory itself and for the files directly in it), so the first pass now
deletes it on leaving. A directory that is not in the map counts as not
fresh, which means that files are verified as usual. The map holds the
directories on the current path.

What remains per directory is the tree ID list for the second-pass prefetch
(32 bytes each); measured 43 to 71 bytes per additional directory.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 internal/restorer/restorer.go                 | 10 +++
 .../restorer/restorer_directory_state_test.go | 88 +++++++++++++++++++
 2 files changed, 98 insertions(+)
 create mode 100644 internal/restorer/restorer_directory_state_test.go

diff --git a/internal/restorer/restorer.go b/internal/restorer/restorer.go
index 2cfdd29103939bd64e6b211e3093f2d4eea9b934..4536b84e580dde33fe15d7669fdfd0cd48f49672 100644
--- a/internal/restorer/restorer.go
+++ b/internal/restorer/restorer.go
@@ -756,6 +756,16 @@ func (res *Restorer) RestoreTo(ctx context.Context, dst string) (uint64, error)
 			return err
 		},
 
+		leaveDir: func(_ *data.Node, target, _ string, _ []string) error {
+			// The traversal does not come back to a directory it has left, so
+			// its entry is not needed any more. Without it the directory counts
+			// as not fresh, which only means that files are verified as usual.
+			// freshDirs then holds the directories on the current path, not one
+			// path string for every directory of the snapshot.
+			delete(freshDirs, target)
+			return nil
+		},
+
 		visitNode: func(node *data.Node, target, location string) error {
 			debug.Log("first pass, visitNode: mkdir %q, leaveDir on second pass should restore metadata", location)
 			parentDir := filepath.Dir(target)
diff --git a/internal/restorer/restorer_directory_state_test.go b/internal/restorer/restorer_directory_state_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..58947573d4871620e3fd4a4ed447136e9805e4c0
--- /dev/null
+++ b/internal/restorer/restorer_directory_state_test.go
@@ -0,0 +1,88 @@
+package restorer
+
+import (
+	"fmt"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/restic/restic/internal/repository"
+	rtest "github.com/restic/restic/internal/test"
+)
+
+// restoreDirectoriesPeak restores a snapshot of parents*(children+1) empty
+// directories into an empty target and returns the number of directories and
+// by how much the live heap grew while the restore ran.
+func restoreDirectoriesPeak(t *testing.T, parents, children int) (dirs int, growth int64) {
+	// long names: a path that is kept per directory shows clearly
+	childName := strings.Repeat("directory-name-", 6)
+	nodes := map[string]Node{}
+	for i := 0; i < parents; i++ {
+		sub := map[string]Node{}
+		for j := 0; j < children; j++ {
+			sub[fmt.Sprintf("%s%05d", childName, j)] = Dir{Nodes: map[string]Node{}}
+		}
+		nodes[fmt.Sprintf("parent-%05d", i)] = Dir{Nodes: sub}
+	}
+	repo := repository.TestRepository(t)
+	sn, _ := saveSnapshot(t, repo, Snapshot{Nodes: nodes}, noopGetGenericAttributes)
+	nodes = nil
+	tempdir := filepath.Join(rtest.TempDir(t), "target")
+
+	liveHeap := func() uint64 {
+		runtime.GC()
+		var m runtime.MemStats
+		runtime.ReadMemStats(&m)
+		return m.HeapAlloc
+	}
+	before := liveHeap()
+
+	var peak atomic.Uint64
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			if live := liveHeap(); live > peak.Load() {
+				peak.Store(live)
+			}
+		}
+	}()
+
+	res := NewRestorer(repo, sn, Options{})
+	_, err := res.RestoreTo(t.Context(), tempdir)
+	close(stop)
+	<-done
+	rtest.OK(t, err)
+	return parents * (children + 1), int64(peak.Load()) - int64(before)
+}
+
+// The restore must not keep a path for every directory it creates: the
+// directories that were created by this restore are remembered only while the
+// traversal is inside them. What remains per directory is the tree ID that
+// the second pass loads ahead (32 bytes). Stock keeps nothing per directory.
+//
+// The bound is on the growth per additional directory, measured between a
+// small and a large snapshot of directories with names of 95 bytes, so that
+// constant costs cancel. With a path per directory it is above 250 bytes.
+func TestRestoreKeepsNoPathPerDirectory(t *testing.T) {
+	if testing.Short() {
+		t.Skip("restores 15,000 directories")
+	}
+	smallDirs, smallGrowth := restoreDirectoriesPeak(t, 10, 300)
+	largeDirs, largeGrowth := restoreDirectoriesPeak(t, 40, 300)
+
+	perDirectory := (largeGrowth - smallGrowth) / int64(largeDirs-smallDirs)
+	t.Logf("%d directories: live heap grows by %d KiB; %d directories: by %d KiB; %d bytes per additional directory",
+		smallDirs, smallGrowth>>10, largeDirs, largeGrowth>>10, perDirectory)
+	if perDirectory > 150 {
+		t.Fatalf("the restore keeps %d bytes per directory", perDirectory)
+	}
+}
